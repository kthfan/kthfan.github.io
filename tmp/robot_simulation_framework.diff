@@ -0,0 +1,156 @@
+"""M6: the Isaac side of the cell seam, pure numpy (D30).
+
+:mod:`sim_cell` runs Isaac; everything it computes about trays, trajectories
+and reports lives here so it is tested without Isaac:
+
+* which slot each tray prim sits in, and the prim's offset from cell_core's
+  tray box (the seat reference the judge uses);
+* whether a trajectory may start from the arm's current joints;
+* the report of one executed trajectory: flange samples, robot contacts and,
+  for every tray that moved, where it rode relative to the flange.
+"""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+#: Largest start mismatch of a trajectory (rad for the arm, m for the jaws).
+START_TOL = 0.01
+#: A tray this far from every slot's tray box is not seated anywhere (m).
+MATCH_TOL = 0.05
+#: Spacing of the flange samples in a report (s).
+SAMPLE_DT = 0.05
+#: A tray that moved less than this did not move (m).
+MOVED_TOL = 0.001
+#: The rack prim of each rack role on the built stage.
+RACK_PRIM = {"incoming": "/Environment/RightRack", "outgoing": "/Environment/LeftRack"}
+
+
+def jig_prim(slot) -> str:
+    """The stage prim of *slot*'s jig, whose pose is the jig origin."""
+    if slot.rack == "table":
+        return "/Environment/Table/Jig"
+    return f"{RACK_PRIM[slot.role]}/Jig_{slot.layer}_{slot.column}"
+
+
+def pose(p, wxyz) -> np.ndarray:
+    """4x4 pose from a position and a ``[w, x, y, z]`` quaternion."""
+    w, x, y, z = (float(v) for v in wxyz)
+    n = math.sqrt(w * w + x * x + y * y + z * z)
+    w, x, y, z = w / n, x / n, y / n, z / n
+    T = np.eye(4)
+    T[:3, :3] = [[1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
+                 [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
+                 [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)]]
+    T[:3, 3] = p
+    return T
+
+
+def inv(T) -> np.ndarray:
+    T = np.asarray(T, dtype=float)
+    out = np.eye(4)
+    out[:3, :3] = T[:3, :3].T
+    out[:3, 3] = -T[:3, :3].T @ T[:3, 3]
+    return out
+
+
+def look_at(eye, target) -> np.ndarray:
+    """Camera-to-world pose of a USD camera (looks down -Z, +Y up) at *eye* viewing *target*, world Z up."""
+    eye, target = np.asarray(eye, dtype=float), np.asarray(target, dtype=float)
+    back = (eye - target) / np.linalg.norm(eye - target)
+    right = np.cross([0.0, 0.0, 1.0], back)
+    right /= np.linalg.norm(right)
+    T = np.eye(4)
+    T[:3, :3] = np.column_stack([right, np.cross(back, right), back])
+    T[:3, 3] = eye
+    return T
+
+
+def match_trays(trays: dict, boxes: dict) -> dict:
+    """``{tray prim: slot key}``: each tray to the slot whose box centre is nearest.
+
+    *trays* and *boxes* map names to 4x4 poses. Raises if a tray is far from
+    every slot or two trays claim one slot.
+    """
+    keys = list(boxes)
+    centres = np.array([np.asarray(boxes[k])[:3, 3] for k in keys])
+    out = {}
+    for name, T in trays.items():
+        d = np.linalg.norm(centres - np.asarray(T)[:3, 3], axis=1)
+        i = int(np.argmin(d))
+        if d[i] > MATCH_TOL:
+            raise ValueError(f"{name} is {d[i] * 1e3:.0f} mm from the nearest slot {keys[i]}")
+        if keys[i] in out.values():
+            raise ValueError(f"two trays in {keys[i]}")
+        out[name] = keys[i]
+    return out
+
+
+def seat_offset(trays: dict, boxes: dict, where: dict) -> np.ndarray:
+    """Mean of ``inv(box) @ prim`` over the seated trays: the prim in the box frame."""
+    rel = [inv(boxes[where[n]]) @ np.asarray(T, dtype=float) for n, T in trays.items()]
+    out = np.eye(4)
+    out[:3, 3] = np.mean([r[:3, 3] for r in rel], axis=0)
+    U, _, Vt = np.linalg.svd(np.mean([r[:3, :3] for r in rel], axis=0))
+    out[:3, :3] = U @ Vt
+    return out
+
+
+def start_error(q_now, q_start) -> float:
+    """Largest difference between the current joints and a trajectory's first point."""
+    return float(np.abs(np.asarray(q_now, dtype=float) - np.asarray(q_start, dtype=float)).max())
+
+
+class Recorder:
+    """Accumulates one trajectory's execution, step by step."""
+
+    def __init__(self, tid: str, robot: str, tray_names, trays0: dict, flange0):
+        self.tid, self.robot = tid, robot
+        self.names = list(tray_names)
+        self.samples = []
+        self.contacts = {}
+        self._next = 0.0
+        self.start = {n: np.asarray(trays0[n], dtype=float) for n in self.names}
+        F0 = inv(flange0)
+        self.rel = {n: [(F0 @ self.start[n])[:3, 3]] for n in self.names}
+        self.last = dict(self.start)
+
+    def step(self, t: float, q_cmd, q_act, flange, link6, trays: dict):
+        """One physics step at trajectory time *t*."""
+        Fi = inv(flange)
+        for n in self.names:
+            T = np.asarray(trays[n], dtype=float)
+            self.last[n] = T
+            self.rel[n].append((Fi @ T)[:3, 3])
+        if t + 1e-9 >= self._next:
+            self.samples.append({"t": float(t), "q_cmd": np.asarray(q_cmd, dtype=float).tolist(),
+                                 "q": np.asarray(q_act, dtype=float).tolist(),
+                                 "flange": np.asarray(flange, dtype=float).tolist(),
+                                 "link6": np.asarray(link6, dtype=float).tolist()})
+            self._next += SAMPLE_DT
+
+    def contact(self, t: float, a0: str, a1: str, c0: str, c1: str, impulse: float):
+        if not (a0.startswith(self.robot) or a1.startswith(self.robot)):
+            return
+        k = (a0, a1)
+        c = self.contacts.get(k)
+        if c is None:
+            c = self.contacts[k] = {"a0": a0, "a1": a1, "colliders": [], "t0": float(t),
+                                    "count": 0, "max_impulse": 0.0}
+        c["count"] += 1
+        c["max_impulse"] = max(c["max_impulse"], float(impulse))
+        if [c0, c1] not in c["colliders"] and len(c["colliders"]) < 4:
+            c["colliders"].append([c0, c1])
+
+    def report(self) -> dict:
+        trays = {}
+        for n in self.names:
+            moved = float(np.linalg.norm(self.last[n][:3, 3] - self.start[n][:3, 3]))
+            if moved < MOVED_TOL:
+                continue
+            r = np.array(self.rel[n])
+            trays[n] = {"end": self.last[n].tolist(), "moved_mm": moved * 1e3,
+                        "rel_start": r[0].tolist(), "rel_end": r[-1].tolist(),
+                        "rel_min": r.min(axis=0).tolist(), "rel_max": r.max(axis=0).tolist()}
+        return {"samples": self.samples, "contacts": list(self.contacts.values()), "trays": trays}
