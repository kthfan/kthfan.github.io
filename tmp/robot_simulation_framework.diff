+"""Cross-check reach_volume against the known slot sweep.
+
+Re-expressing every real strict-preset slot as a (point, approach) pair and
+running it through ``reach_level`` must reproduce the recorded verdict:
+37/37 slots, all 7 phases (memory: strict 259/259).
+"""
+import os
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import reach_volume as RV   # noqa: E402
+
+import cell_core.config as CFG        # noqa: E402
+import cell_core.frames as F          # noqa: E402
+import cell_core.geometry as GEO      # noqa: E402
+import cell_core.sequence as SEQ      # noqa: E402
+import pytest                          # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def env():
+    bot, lo, hi, A = RV.make_solver(RV.DEFAULT_URDF)
+    return bot, lo, hi, A, CFG.load_preset("strict")
+
+
+def _point(slot, origin_z):
+    a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+    p = a * slot.label_plane_dist + F.lateral_axis(a) * slot.lateral
+    p[2] = slot.label_centre_z - origin_z
+    return p, a
+
+
+def test_probe_slot_reproduces_real_poses(env):
+    """The probe slot must regenerate the exact flange poses of the real slot."""
+    _, _, _, _, cfg = env
+    for s in GEO.enumerate_slots(cfg):
+        p, a = _point(s, cfg.robot.origin_z)
+        real = SEQ.grasp_sequence(cfg, s)
+        probe = SEQ.grasp_sequence(cfg, RV.probe_slot(p, a, cfg))
+        for ph in RV.PHASES:
+            R = real[ph].copy()
+            R[2, 3] -= cfg.robot.origin_z
+            assert np.allclose(R, probe[ph], atol=1e-9), (s.key, ph)
+
+
+def test_strict_slots_reach_every_phase(env):
+    bot, lo, hi, A, cfg = env
+    for s in GEO.enumerate_slots(cfg):
+        p, a = _point(s, cfg.robot.origin_z)
+        level, _ = RV.reach_level(bot, lo, hi, A, cfg, p, a)
+        assert level == len(RV.PHASES), s.key
+
+
+def test_unreachable_point_reaches_nothing(env):
+    bot, lo, hi, A, cfg = env
+    assert RV.reach_level(bot, lo, hi, A, cfg, (1.2, 1.4, 1.2))[0] == 0
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/render_variant.py" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/render_variant.py"
