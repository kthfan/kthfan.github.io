diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/program/motion/judge.py" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/program/motion/judge.py"
