+++ "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/program/motion/paths.py"
@@ -0,0 +1,200 @@
+"""M6: joint paths for straight lines, the hub sweep and the jaws (D30).
+
+Straight lines are walked with EAIK: the flange pose is interpolated in small
+steps and each step takes the exact IK branch nearest the previous joints, so
+the arm cannot flip configuration mid-line. Timing comes from :mod:`timing`.
+"""
+from __future__ import annotations
+
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "collision"))
+
+import check_cell as CC  # noqa: E402  (puts the vendored cell_core on the path)
+from cell_core import frames as F  # noqa: E402
+from cell_core import scene as S  # noqa: E402
+
+import timing as TM  # noqa: E402
+
+#: Largest flange step between IK samples (m, rad).
+MAX_STEP = 0.002
+MAX_ANG_STEP = math.radians(0.5)
+#: Largest joint change between IK samples (rad); more means a singularity.
+MAX_JOINT_STEP = 0.1
+#: Sample spacing of the trajectories sent to the cell (s).
+DT = 0.01
+#: Jaw speed (m/s) and the hold after a jaw move (s).
+JAW_SPEED = 0.05
+JAW_SETTLE = 0.5
+
+
+class PathError(RuntimeError):
+    """A straight line the arm cannot follow continuously."""
+
+
+def _log(R) -> np.ndarray:
+    return TM._log_so3(R)
+
+
+def _exp(w) -> np.ndarray:
+    th = float(np.linalg.norm(w))
+    if th < 1e-12:
+        return np.eye(3)
+    k = w / th
+    K = np.array([[0, -k[2], k[1]], [k[2], 0, -k[0]], [-k[1], k[0], 0]])
+    return np.eye(3) + math.sin(th) * K + (1 - math.cos(th)) * K @ K
+
+
+def interp_pose(T0, T1, u: float) -> np.ndarray:
+    """Position linear, rotation along the geodesic, ``u`` in [0, 1]."""
+    T0, T1 = np.asarray(T0, dtype=float), np.asarray(T1, dtype=float)
+    out = np.eye(4)
+    out[:3, :3] = T0[:3, :3] @ _exp(u * _log(T0[:3, :3].T @ T1[:3, :3]))
+    out[:3, 3] = (1 - u) * T0[:3, 3] + u * T1[:3, 3]
+    return out
+
+
+def extent(T0, T1):
+    """``(metres, radians)`` the flange covers from *T0* to *T1*."""
+    T0, T1 = np.asarray(T0, dtype=float), np.asarray(T1, dtype=float)
+    return (float(np.linalg.norm(T1[:3, 3] - T0[:3, 3])),
+            float(np.linalg.norm(_log(T0[:3, :3].T @ T1[:3, :3]))))
+
+
+def fk_world(ik, q, base) -> np.ndarray:
+    """Flange pose in the world, USD convention (inverse of ``CC.to_base``).
+
+    *base* is the arm base's 4x4 world pose (``cfg.robot.base_pose``).
+    """
+    T = np.asarray(ik.bot.fwdKin(np.asarray(q, dtype=float)), dtype=float).copy()
+    T[:3, :3] = T[:3, :3] @ ik.A
+    return np.asarray(base, dtype=float) @ T
+
+
+def _pose_residual(T, Tq) -> np.ndarray:
+    """Position and rotation (world-frame axis-angle) from *Tq* to *T*."""
+    return np.concatenate([T[:3, 3] - Tq[:3, 3], _log(T[:3, :3] @ Tq[:3, :3].T)])
+
+
+def refine(ik, T, q, base, iters: int = 4) -> np.ndarray:
+    """*q* polished by Newton steps on FK until it reaches *T* to ~1e-9.
+
+    EAIK's closed form is off by up to ~0.04 mm / 0.3 mrad in places; finite
+    differences at DT would read that noise as metres per second squared.
+    """
+    q = np.asarray(q, dtype=float).copy()
+    T = np.asarray(T, dtype=float)
+    eps = 1e-7
+    for _ in range(iters):
+        Tq = fk_world(ik, q, base)
+        r = _pose_residual(T, Tq)
+        if float(np.abs(r).max()) < 1e-10:
+            break
+        J = np.empty((6, len(q)))
+        for j in range(len(q)):
+            dq = q.copy()
+            dq[j] += eps
+            J[:, j] = (_pose_residual(fk_world(ik, dq, base), Tq)) / eps
+        q = q + np.linalg.lstsq(J, r, rcond=None)[0]
+    return q
+
+
+def nearest_branch(ik, T, q_prev, base):
+    """The exact in-limit IK solution for *T* nearest *q_prev*, any whole turn."""
+    best, best_d = None, math.inf
+    for q in CC.ik_branches(ik, T, base):
+        for qt in CC._turns(q, ik.lo, ik.hi):
+            d = float(np.abs(qt - q_prev).max())
+            if d < best_d:
+                best, best_d = qt, d
+    if best is not None:
+        best = refine(ik, T, best, base)
+    return best, best_d
+
+
+def walk(ik, T0, T1, q0, base):
+    """``(u, Q)``: joint samples along the straight line *T0* -> *T1* from *q0*."""
+    q0 = np.asarray(q0, dtype=float)
+    dp, dr = F.pose_error(fk_world(ik, q0, base), T0)
+    if dp > 1e-4 or dr > 1e-3:
+        raise PathError(f"start joints are {dp * 1e3:.2f} mm / {math.degrees(dr):.3f} deg off")
+    L, th = extent(T0, T1)
+    n = max(1, math.ceil(L / MAX_STEP), math.ceil(th / MAX_ANG_STEP))
+    us = np.linspace(0.0, 1.0, n + 1)
+    Q = [q0]
+    for u in us[1:]:
+        q, d = nearest_branch(ik, interp_pose(T0, T1, u), Q[-1], base)
+        if q is None or d > MAX_JOINT_STEP:
+            raise PathError(f"no continuous IK at u={u:.3f} (step {d:.3f} rad)")
+        Q.append(q)
+    return us, np.array(Q)
+
+
+def time_line(ik, us, Q, T0, T1, caps: TM.Caps, base, dt: float = DT):
+    """``(t, Q(t))``: the walked line on a trapezoid within *caps*.
+
+    Each time sample is solved exactly, seeded by the walk, so the flange is
+    on the line at the profile's distance (joint interpolation would add
+    curvature that finite differences turn into acceleration).
+    """
+    L, th = extent(T0, T1)
+    t, u = TM.unit_timing(L, th, caps, dt)
+    out = []
+    for ui in u:
+        guess = np.array([np.interp(ui, us, Q[:, j]) for j in range(Q.shape[1])])
+        q, d = nearest_branch(ik, interp_pose(T0, T1, ui), guess, base)
+        if q is None or d > MAX_JOINT_STEP:
+            raise PathError(f"no IK near the walk at u={ui:.3f}")
+        out.append(q)
+    out[0], out[-1] = Q[0], Q[-1]
+    return t, np.array(out)
+
+
+def sweep_delta(q1: float, dq: float, lo: float, hi: float) -> float:
+    """*dq* or a whole turn either way, whichever keeps joint 1 in limits and is shortest."""
+    options = [dq + 2 * math.pi * k for k in (-1, 0, 1) if lo <= q1 + dq + 2 * math.pi * k <= hi]
+    if not options:
+        raise PathError(f"joint 1 cannot sweep {dq:.3f} rad from {q1:.3f}")
+    return min(options, key=abs)
+
+
+def time_sweep(q0, dq: float, radius: float, caps: TM.Caps, dt: float = DT):
+    """``(t, Q)``: joint 1 alone turns *dq*; *radius* is the farthest carried point.
+
+    Speed ``r w``, tangential ``r alpha`` and centripetal ``r w^2`` are kept
+    under the linear caps, the last two with a 1/sqrt(2) share each.
+    """
+    r = max(radius, 1e-6)
+    w = min(caps.w, caps.v / r, math.sqrt(caps.a / (math.sqrt(2.0) * r)))
+    al = min(caps.alpha, caps.a / (math.sqrt(2.0) * r))
+    T = TM.trapezoid(abs(dq), w, al)
+    t = np.linspace(0.0, T, max(1, math.ceil(T / dt)) + 1)
+    Q = np.repeat(np.asarray(q0, dtype=float)[None, :], len(t), axis=0)
+    Q[:, 0] += math.copysign(1.0, dq) * TM.trapezoid_s(abs(dq), w, al, t)
+    return t, Q
+
+
+def carried_radius(T_flange) -> float:
+    """Largest horizontal distance from the base axis of the carried tray's corners."""
+    c = S.carried_tray_box(T_flange).corners()
+    return float(np.hypot(c[:, 0], c[:, 1]).max())
+
+
+def time_jaw(q_arm, j0: float, j1: float, dt: float = DT):
+    """``(t, Q8)``: the arm holds *q_arm*; both jaws ramp *j0* -> *j1*, then hold."""
+    T_move = abs(j1 - j0) / JAW_SPEED
+    T = T_move + JAW_SETTLE
+    t = np.linspace(0.0, T, max(1, math.ceil(T / dt)) + 1)
+    j = j0 + (j1 - j0) * np.clip(t / max(T_move, 1e-9), 0.0, 1.0)
+    Q = np.repeat(np.asarray(q_arm, dtype=float)[None, :], len(t), axis=0)
+    return t, np.column_stack([Q, j, j])
+
+
+def with_jaws(Q, jaw: float) -> np.ndarray:
+    """Arm samples *Q* ``(n, 6)`` with both jaws at *jaw*: ``(n, 8)``."""
+    Q = np.asarray(Q, dtype=float)
+    return np.column_stack([Q, np.full(len(Q), jaw), np.full(len(Q), jaw)])
