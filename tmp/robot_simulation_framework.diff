index 0000000..2840acf
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/settle_check.py"
@@ -0,0 +1,128 @@
+"""Run physics on a built stage, nothing frozen, and report how far each rigid body moves.
+
+    <isaac>/python.sh settle_check.py --stage _stage/strict/cell.usd [--seconds 2] [--hold 0]
+
+Physics is stepped by ``SimulationContext`` at a fixed dt, so the simulated
+time is steps x dt and does not depend on the timeline clock (the first run
+waited on ``timeline.get_current_time()``, which never advanced, and spun for
+half an hour). Poses come from PhysX itself (``get_rigidbody_transformation``),
+not from USD: with Fabric on, the simulation need not write back to the stage,
+and a USD read-back would report "nothing moved" whatever happened.
+
+The WebRTC livestream is enabled, so the run can be watched with the
+"WebRTC Streaming Client". ``--hold`` keeps the app rendering that many wall
+seconds after the report, to leave time to look.
+"""
+import argparse
+import os
+import time
+
+import numpy as np
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--stage", required=True)
+ap.add_argument("--seconds", type=float, default=2.0, help="simulated seconds")
+ap.add_argument("--dt", type=float, default=1.0 / 60.0)
+ap.add_argument("--wall-limit", type=float, default=300.0, help="give up after this many wall seconds")
+ap.add_argument("--hold", type=float, default=0.0, help="wall seconds to keep streaming after the report")
+args = ap.parse_args()
+
+from isaacsim import SimulationApp  # noqa: E402
+
+simulation_app = SimulationApp({"headless": True})
+
+from isaacsim.core.utils.extensions import enable_extension  # noqa: E402
+
+# Default Livestream settings
+simulation_app.set_setting("/app/window/drawMouse", True)
+
+# Enable Livestream extension
+enable_extension("omni.services.livestream.nvcf")
+enable_extension("omni.kit.livestream.webrtc")
+enable_extension("omni.services.transport.server.http")
+
+import omni.physx  # noqa: E402
+import omni.usd  # noqa: E402
+from isaacsim.core.api import SimulationContext  # noqa: E402
+from pxr import Usd, UsdGeom, UsdPhysics  # noqa: E402
+
+ctx = omni.usd.get_context()
+ctx.open_stage(os.path.abspath(args.stage))
+for _ in range(600):
+    simulation_app.update()
+    if not ctx.get_stage_loading_status()[2]:
+        break
+stage = ctx.get_stage()
+bodies = [p for p in stage.Traverse() if p.HasAPI(UsdPhysics.RigidBodyAPI)]
+print("[settle] %d rigid bodies; ground %s; scenes before play %s" % (
+    len(bodies), bool(stage.GetPrimAtPath("/GroundPlane")),
+    [str(p.GetPath()) for p in stage.Traverse() if p.IsA(UsdPhysics.Scene)]), flush=True)
+
+
+def authored(p):
+    m = UsdGeom.Xformable(p).ComputeLocalToWorldTransform(Usd.TimeCode.Default())
+    return np.array(m.ExtractTranslation())
+
+
+px = omni.physx.get_physx_interface()
+
+
+def simulated(p):
+    r = px.get_rigidbody_transformation(str(p.GetPath()))
+    if not r.get("ret_val"):
+        return None
+    return np.array(r["position"]), np.array(r["rotation"])  # rotation xyzw
+
+
+start = {str(p.GetPath()): authored(p) for p in bodies}
+sim = SimulationContext(physics_dt=args.dt, rendering_dt=args.dt, stage_units_in_meters=1.0)
+sim.initialize_physics()
+sim.play()
+print("[settle] scenes after play %s" % [str(p.GetPath()) for p in stage.Traverse()
+                                          if p.IsA(UsdPhysics.Scene)], flush=True)
+sim.step(render=True)
+first = {str(p.GetPath()): simulated(p) for p in bodies}
+n_steps = int(round(args.seconds / args.dt))
+t0 = time.time()
+done = 1
+for i in range(1, n_steps):
+    if time.time() - t0 > args.wall_limit:
+        print("[settle] wall limit %.0f s hit after %d of %d steps" % (args.wall_limit, i, n_steps),
+              flush=True)
+        break
+    sim.step(render=True)
+    done = i + 1
+    if done % 30 == 0:
+        print("[settle] step %d/%d (%.2f s simulated, %.1f s wall)" % (
+            done, n_steps, done * args.dt, time.time() - t0), flush=True)
+final = {str(p.GetPath()): simulated(p) for p in bodies}
+sim.pause()
+
+rows = []
+for path, p0 in start.items():
+    f0, f1 = first[path], final[path]
+    if f1 is None or f0 is None:
+        rows.append((float("inf"), path, "no PhysX pose"))
+        continue
+    d = f1[0] - p0
+    if not np.all(np.isfinite(d)):
+        rows.append((float("inf"), path, "non-finite PhysX pose %s" % (f1[0],)))
+        continue
+    turn = 2 * np.degrees(np.arccos(min(1.0, abs(float(np.dot(f0[1], f1[1]))))))
+    rows.append((float(np.linalg.norm(d)), path,
+                 "dz %+.6f  |d| %.6f m  turn %.4f deg (since first step)" % (
+                     d[2], np.linalg.norm(d), turn)))
+rows.sort(reverse=True)
+print("[settle] %.3f s simulated in %d steps of %.5f s" % (done * args.dt, done, args.dt))
+for n, path, text in rows:
+    print("[settle] %-52s %s" % (path, text))
+finite = [n for n, _, _ in rows if np.isfinite(n)]
+print("[settle] worst displacement %.6f m over %d bodies with a finite PhysX pose; %d without" % (
+    max(finite) if finite else float("nan"), len(finite), len(rows) - len(finite)), flush=True)
+
+if args.hold > 0:
+    print("[settle] holding %.0f s for the livestream" % args.hold, flush=True)
+    t1 = time.time()
+    while time.time() - t1 < args.hold:
+        simulation_app.update()
+simulation_app.close()
