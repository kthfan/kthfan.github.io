++# ─────────────────────────────────────────────────────────────────────────────
++# Sweep
++# ─────────────────────────────────────────────────────────────────────────────
++def run_sweep(bot, lo, hi, origin_z: float, cfg, slots,
++              near_rise: float, A: np.ndarray) -> list[dict]:
++    shoulder = np.array([0.0, 0.0, origin_z + ASSETS.SHOULDER_OFFSET_Z])
++    rows = []
++    for s in slots:
++        for phase, T in SEQ.grasp_sequence(cfg, s, near_rise).items():
++            r = solve(bot, to_base(T, origin_z, A), lo, hi)
++            r.update(
++                slot=s.key, rack=s.rack, layer=s.layer, column=s.column,
++                phase=phase,
++                horiz=round(float(math.hypot(T[0, 3], T[1, 3])), 4),
++                z=round(float(T[2, 3]), 4),
++                shoulder_r=round(float(np.linalg.norm(T[:3, 3] - shoulder)), 4),
++            )
++            rows.append(r)
++    return rows
