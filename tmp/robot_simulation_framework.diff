@@ -0,0 +1,151 @@
+"""M6: the segments of one tray transfer, source slot to destination slot (D30).
+
+A transfer is a fixed list of segments between two approach poses:
+
+* in the source shelf: ``pre_insert``, ``insert``, ``lift`` (jaws open, the
+  tray comes up on the plate), ``close`` (jaws to the tray width),
+  ``withdraw``, [``tilt``], ``retreat`` (RETREAT clear of the shelf face);
+* carried across the cell through two hubs: ``to_hub`` (straight to the
+  source hub), ``sweep`` (joint 1 only, so the plate's attitude holds),
+  ``from_hub``;
+* in the destination shelf: ``arrive``, [``untilt``], ``enter`` (above the
+  columns), ``open`` (the jaws would hit the columns if still at the tray
+  width), ``lower`` (the tray sets down), ``out``, ``back``.
+
+Free moves between transfers are cuRobo's, not listed here. Every pose is
+built from :mod:`cell_core.sequence`, so M3's checked poses are the ones run.
+"""
+from __future__ import annotations
+
+import math
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "vendor"))
+
+from cell_core import assets as A  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import sequence as SEQ  # noqa: E402
+from cell_core.geometry import Slot  # noqa: E402
+
+from timing import CARRY, EMPTY, IN_JIG, Caps  # noqa: E402
+
+#: Stand-off of the approach pose in front of ``pre_insert``, and of the
+#: carried tray in front of ``carry`` before it leaves for the hub (m), at
+#: most; less where it would bring the flange nearer the base than MIN_REACH.
+RETREAT = 0.10
+#: Flange distance from the base axis while the carried tray swings (m). At
+#: 0.40 the tray passed 4.4 mm from a neighbour's jig; at 0.38 and below the
+#: arm folds into itself (cuRobo self collision) (D30).
+HUB_RADIUS = 0.39
+#: Hub radii a move tries in turn, HUB_RADIUS first: at 0.39 every branch
+#: of table/L0/C0 -> outgoing/L0/C0 self-collided (0.6 mm, cuRobo spheres)
+#: (D30). A wider hub is only taken where the narrower one has no branch.
+HUB_RADII = (HUB_RADIUS, 0.40, 0.41, 0.42)
+#: Nearest the flange stands back to the base axis (m); the to_hub chord from
+#: there dips a little inside it, so it is set above HUB_RADIUS (D30).
+MIN_REACH = 0.40
+
+
+@dataclass(frozen=True, eq=False)
+class Seg:
+    name: str
+    kind: str                  #: "line", "sweep" or "jaw"
+    T0: Optional[np.ndarray]   #: flange pose at the start (None for jaw)
+    T1: Optional[np.ndarray]
+    jaw: float                 #: jaw command at the start
+    jaw_end: float             #: jaw command at the end
+    caps: Optional[Caps]
+    target: Optional[str]      #: slot judged at margin 0 (its jig and tray)
+    carried: bool              #: the tray rides on the plate
+    lifting: bool              #: the tray is being lifted off or set down
+    track: bool                #: flange tracking is judged (inside a jig)
+    occupied: frozenset        #: slots holding a tray in the world
+
+
+def _axis(slot: Slot) -> np.ndarray:
+    a = slot.approach_vec
+    return a / np.linalg.norm(a)
+
+
+def _back(slot: Slot, T) -> np.ndarray:
+    """*T* stood back along the approach axis: RETREAT, or to MIN_REACH."""
+    a = _axis(slot)
+    p = np.asarray(T, dtype=float)[:3, 3]
+    pa = float(p[:2] @ a[:2])
+    disc = pa * pa - float(p[:2] @ p[:2]) + MIN_REACH ** 2
+    dist = min(RETREAT, pa - math.sqrt(disc)) if disc >= 0.0 else RETREAT
+    out = np.array(T, dtype=float)
+    out[:3, 3] -= a * dist
+    return out
+
+
+def approach_pose(slot: Slot) -> np.ndarray:
+    """``pre_insert``, RETREAT further out along the approach axis."""
+    return _back(slot, SEQ.pre_insert_pose(slot))
+
+
+def hub_pose(slot: Slot, z: float, tilt_deg: float = 0.0, radius: float = HUB_RADIUS) -> np.ndarray:
+    """On the slot's approach axis at *radius* and height *z*, carry attitude."""
+    a = _axis(slot)
+    return F.make_pose(F.flange_rotation(a, math.radians(tilt_deg)), a * radius + F.UP * z)
+
+
+def sweep_angle(src: Slot, dst: Slot) -> float:
+    """Rotation about world Z taking *src*'s approach axis to *dst*'s, (-pi, pi]."""
+    a, b = _axis(src), _axis(dst)
+    ang = math.atan2(a[0] * b[1] - a[1] * b[0], float(a @ b))
+    return math.pi if ang <= -math.pi else ang
+
+
+def move_segments(cfg, src: Slot, dst: Slot, occupied: frozenset,
+                  hub_radius: float = HUB_RADIUS) -> list:
+    """The segments taking the tray in *src* to *dst*, approach to approach.
+
+    *occupied* is the set of slots holding a tray before the move; the
+    carried tray swings at *hub_radius*.
+    """
+    tilt = cfg.carry_tilt_deg
+    gs, gd = SEQ.grasp_sequence(cfg, src), SEQ.grasp_sequence(cfg, dst)
+    z_hub = (gs["carry"][2, 3] + gd["carry"][2, 3]) / 2.0
+    OPEN, FIT = A.JAW_Q_OPEN, A.JAW_Q_FIT
+    before = frozenset(occupied)
+    riding = before - {src.key}
+    after = riding | {dst.key}
+    out = []
+
+    def line(name, T0, T1, jaw, caps, target, occ, carried=False, lifting=False, track=False,
+             kind="line"):
+        out.append(Seg(name, kind, T0, T1, jaw, jaw, caps, target, carried, lifting, track, occ))
+
+    def jaw(name, j0, j1, target, occ):
+        out.append(Seg(name, "jaw", None, None, j0, j1, None, target, True, False, False, occ))
+
+    s, d = src.key, dst.key
+    line("pre_insert", approach_pose(src), gs["pre_insert"], OPEN, EMPTY, s, before)
+    line("insert", gs["pre_insert"], gs["insert"], OPEN, IN_JIG, s, before, track=True)
+    line("lift", gs["insert"], gs["lift"], OPEN, IN_JIG, s, riding, True, True, True)
+    jaw("close", OPEN, FIT, s, riding)
+    line("withdraw", gs["lift"], gs["withdraw"], FIT, IN_JIG, s, riding, True, track=True)
+    if tilt:
+        line("tilt", gs["withdraw"], gs["carry"], FIT, CARRY, s, riding, True)
+    line("retreat", gs["carry"], _back(src, gs["carry"]), FIT, CARRY, s, riding, True)
+    line("to_hub", _back(src, gs["carry"]), hub_pose(src, z_hub, tilt, hub_radius), FIT, CARRY,
+         None, riding, True)
+    line("sweep", hub_pose(src, z_hub, tilt, hub_radius), hub_pose(dst, z_hub, tilt, hub_radius),
+         FIT, CARRY, None, riding, True, kind="sweep")
+    line("from_hub", hub_pose(dst, z_hub, tilt, hub_radius), _back(dst, gd["carry"]), FIT, CARRY,
+         d, riding, True)
+    line("arrive", _back(dst, gd["carry"]), gd["carry"], FIT, CARRY, d, riding, True)
+    if tilt:
+        line("untilt", gd["carry"], gd["withdraw"], FIT, CARRY, d, riding, True)
+    line("enter", gd["withdraw"], gd["lift"], FIT, IN_JIG, d, riding, True, track=True)
+    jaw("open", FIT, OPEN, d, riding)
+    line("lower", gd["lift"], gd["insert"], OPEN, IN_JIG, d, riding, True, True, True)
+    line("out", gd["insert"], gd["pre_insert"], OPEN, IN_JIG, d, after, track=True)
+    line("back", gd["pre_insert"], approach_pose(dst), OPEN, EMPTY, d, after)
+    return out
