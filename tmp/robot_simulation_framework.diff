+"""M3 probe: what cuRobo exposes on the program host. Read-only."""
+import importlib
+import os
+import sys
+
+print("python", sys.version.split()[0])
+for m in ("numpy", "torch", "curobo", "eaik", "EAIK", "yaml", "trimesh", "warp"):
+    try:
+        mod = importlib.import_module(m)
+        print(f"  OK  {m:9s} {getattr(mod, '__version__', '?'):12s} {getattr(mod, '__file__', '')}")
+    except Exception as e:  # report, never fix
+        print(f"  --  {m:9s} {type(e).__name__}: {str(e)[:100]}")
+
+try:
+    import torch
+    print("cuda", torch.cuda.is_available(), torch.version.cuda)
+    if torch.cuda.is_available():
+        p = torch.cuda.get_device_properties(0)
+        print("gpu", p.name, round(p.total_memory / 2**30, 1), "GiB")
+except Exception as e:
+    print("torch probe failed:", e)
+
+try:
+    import curobo
+except Exception:
+    sys.exit(0)
+
+root = os.path.dirname(curobo.__file__)
+print("\ncurobo root", root)
+d = root
+for _ in range(4):  # git metadata, read as files (no git command)
+    head = os.path.join(d, ".git", "HEAD")
+    if os.path.isfile(head):
+        print("git dir", d, "HEAD:", open(head).read().strip())
+        break
+    d = os.path.dirname(d)
+
+print("\npackages:")
+for dirpath, dirnames, filenames in os.walk(root):
+    dirnames[:] = sorted(x for x in dirnames if not x.startswith(("_", ".")))
+    rel = os.path.relpath(dirpath, root)
+    if rel.count(os.sep) > 1:
+        dirnames[:] = []
+        continue
+    py = sorted(f for f in filenames if f.endswith(".py") and f != "__init__.py")
+    print(f"  {rel}: {' '.join(py)[:300]}")
+
+print("\nsymbols:")
+needles = ("class WorldConfig", "class RobotWorld", "class Cuboid", "class Cylinder",
+           "class MotionGen", "class IKSolver", "def update_link_mesh",
+           "def get_collision_distance", "def get_self_collision", "eaik", "EAIK",
+           "def attach_object", "class RobotConfig", "def from_dict")
+hits = {}
+for dirpath, _, filenames in os.walk(root):
+    for f in filenames:
+        if not f.endswith(".py"):
+            continue
+        p = os.path.join(dirpath, f)
+        try:
+            text = open(p, encoding="utf-8", errors="replace").read()
+        except OSError:
+            continue
+        for n in needles:
+            if n in text:
+                hits.setdefault(n, []).append(os.path.relpath(p, root))
+for n in needles:
+    print(f"  {n!r}: {hits.get(n, [])[:6]}")
+
+print("\nrobot configs:")
+for cand in ("/ReKep-ros/rekep/configs", "/workspace"):
+    if os.path.isdir(cand):
+        for dirpath, dirnames, filenames in os.walk(cand):
+            dirnames[:] = [x for x in dirnames if not x.startswith(".") and x != "node_modules"]
+            if dirpath.count(os.sep) - cand.count(os.sep) > 3:
+                dirnames[:] = []
+            for f in filenames:
+                if f.startswith(("tm5s", "egu50")):
+                    print("  ", os.path.join(dirpath, f))
