+#!/usr/bin/env python3
+"""Row-level diff of two sweep JSONs.
+
+A matching headline count is weak evidence: two runs can agree on 218/222 while
+disagreeing about which 218. This compares every row's verdict and geometry, so
+"the port changed nothing" is a checked claim rather than an impression.
+
+    python3 compare_sweeps.py sweep.json sweep_ported.json
+"""
+from __future__ import annotations
+
+import json
+import sys
+
+#: Geometry agreement tolerance. Both runs round to 4 dp, so anything at or
+#: below this is representation noise rather than a real difference.
+GEOM_TOL = 1e-4
+
+KEYS = ("status", "horiz", "z", "shoulder_r")
+
+
+def load(path: str) -> dict:
+    with open(path) as fh:
+        data = json.load(fh)
+    return {(r["slot"], r["phase"]): r for r in data["rows"]}
+
+
+def main(argv) -> int:
+    if len(argv) != 3:
+        print(__doc__)
+        return 2
+    a_path, b_path = argv[1], argv[2]
+    a, b = load(a_path), load(b_path)
+
+    only_a = sorted(set(a) - set(b))
+    only_b = sorted(set(b) - set(a))
+    diffs = []
+    for key in sorted(set(a) & set(b)):
+        ra, rb = a[key], b[key]
+        for k in KEYS:
+            va, vb = ra.get(k), rb.get(k)
+            if isinstance(va, float) or isinstance(vb, float):
+                if abs(float(va) - float(vb)) > GEOM_TOL:
+                    diffs.append((key, k, va, vb))
+            elif va != vb:
+                diffs.append((key, k, va, vb))
+
+    print("rows: %s=%d  %s=%d  shared=%d"
+          % (a_path, len(a), b_path, len(b), len(set(a) & set(b))))
+    if only_a:
+        print("only in %s (%d): %s" % (a_path, len(only_a), only_a[:8]))
+    if only_b:
+        print("only in %s (%d): %s" % (b_path, len(only_b), only_b[:8]))
+    if diffs:
+        print("DIFFERENCES: %d" % len(diffs))
+        for (slot, phase), field, va, vb in diffs[:30]:
+            print("  %-22s %-11s %-11s %r -> %r" % (slot, phase, field, va, vb))
+        if len(diffs) > 30:
+            print("  ... and %d more" % (len(diffs) - 30))
+    if only_a or only_b or diffs:
+        print()
+        print("VERDICT: the two sweeps disagree.")
+        return 1
+    print()
+    print("VERDICT: identical across %d rows and fields %s" % (len(a), list(KEYS)))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
