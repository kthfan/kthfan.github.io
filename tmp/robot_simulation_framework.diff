@@ -0,0 +1,172 @@
+"""The Isaac Sim environment must be a function of the config, not of literals.
+
+D19 raises the robot 100 mm. If that change means hand-editing the environment
+builder, then the sim and the config can disagree, and every sweep result
+afterwards is suspect. These tests pin the requirement the user stated: the
+environment setup stays configurable, and switching preset is the *only* thing
+that changes.
+"""
+import pytest
+
+import cell_core.config as C
+from cell_core import env_adapter as E
+
+
+@pytest.fixture
+def as_built():
+    return C.load_preset("as_built")
+
+
+@pytest.fixture
+def recommended():
+    return C.load_preset("recommended")
+
+
+def test_only_the_leg_height_differs_between_the_two_presets(as_built, recommended):
+    a = E.generator_kwargs(as_built)
+    b = E.generator_kwargs(recommended)
+    assert a["robot_leg_height"] != b["robot_leg_height"]
+    a.pop("robot_leg_height")
+    b.pop("robot_leg_height")
+    assert a == b
+
+
+def test_the_leg_height_is_passed_through_untouched(as_built, recommended):
+    assert E.generator_kwargs(as_built)["robot_leg_height"] == pytest.approx(0.47)
+    assert E.generator_kwargs(recommended)["robot_leg_height"] == pytest.approx(0.57)
+
+
+def test_the_incoming_rack_becomes_the_right_rack(as_built):
+    kw = E.generator_kwargs(as_built)
+    assert kw["dist_right_rack"] == pytest.approx(
+        as_built.incoming.face_distance + as_built.incoming.depth)
+    assert kw["n_jigs_right"] == as_built.incoming.n_jigs
+    assert kw["right_rack_planes"] == list(as_built.incoming.layer_heights)
+
+
+def test_the_outgoing_rack_becomes_the_left_rack(as_built):
+    kw = E.generator_kwargs(as_built)
+    assert kw["dist_left_rack"] == pytest.approx(
+        as_built.outgoing.face_distance + as_built.outgoing.depth)
+    assert kw["n_jigs_left"] == as_built.outgoing.n_jigs
+    assert kw["left_rack_planes"] == list(as_built.outgoing.layer_heights)
+
+
+def test_the_table_parameters_are_carried_over_unchanged(as_built):
+    kw = E.generator_kwargs(as_built)
+    assert kw["dist_table"] == pytest.approx(0.85)
+    assert kw["table_height"] == pytest.approx(0.7)
+    assert kw["table_jig_x"] == pytest.approx(0.0)
+    assert kw["table_size_y"] == pytest.approx(as_built.table.depth)
+
+
+def test_shelves_are_tall_enough_to_carry_their_top_layer(as_built):
+    kw = E.generator_kwargs(as_built)
+    assert kw["right_rack_height"] >= max(as_built.incoming.layer_heights)
+    assert kw["left_rack_height"] >= max(as_built.outgoing.layer_heights)
+
+
+def _built_widths(cfg):
+    """What the generator *actually* returns, per rack name.
+
+    Every width assertion below goes through this rather than recomputing a
+    width from ``cell_core``'s own formula. Checking the model against itself
+    is what let the two formulas drift apart unnoticed in the first place.
+    """
+    out = E.load_generator()(**E.generator_kwargs(cfg))
+    return {cfg.incoming.name: out["right_rack_size"][0],
+            cfg.outgoing.name: out["left_rack_size"][0]}
+
+
+def test_min_rack_width_agrees_with_the_generator_it_claims_to_mirror():
+    """``config.min_rack_width`` documents itself as mirroring the generator.
+
+    Nothing enforced that. A divergence does not raise: it silently sizes the
+    shared width margin from the wrong rack, and a shelf gets built narrower
+    than the one that was measured. Sweeping the inputs means an edit to
+    either formula has to be made to both.
+    """
+    gen = E.load_generator().__globals__
+    assert "_min_rack_width" in gen, sorted(gen)
+    for n in range(1, 9):
+        for gap in (0.010, 0.016, 0.025):
+            for radius in (0.015, 0.020):
+                assert C.min_rack_width(n, gap, radius) == pytest.approx(
+                    gen["_min_rack_width"](n, gap, radius), abs=1e-12), (n, gap, radius)
+
+
+def test_every_shelf_is_wide_enough_for_its_jigs(as_built):
+    kw = E.generator_kwargs(as_built)
+    for n, rack in ((kw["n_jigs_right"], as_built.incoming),
+                    (kw["n_jigs_left"], as_built.outgoing)):
+        assert C.min_rack_width(n, kw["jig_gap"], kw["cylinder_radius"]) <= rack.width
+
+
+def test_no_shelf_is_built_narrower_than_the_one_that_was_measured(as_built):
+    """The promise ``_size_x_margin`` makes in its own docstring.
+
+    A shelf wider than measured is a visible fidelity note. A shelf *narrower*
+    than measured is a sim whose jigs sit closer together than the real cell's,
+    which quietly flatters every clearance result that follows.
+    """
+    for name, built in _built_widths(as_built).items():
+        rack = getattr(as_built, name)
+        assert built >= rack.width - 1e-9, (
+            f"{name}: generator builds {built:.4f} m, measured {rack.width:.4f} m")
+
+
+def test_the_width_notes_name_the_racks_the_generator_actually_changes(as_built):
+    """The report has to match the stage, not a re-derivation of it.
+
+    Pinned both ways: a rack the generator rebuilds must be named, and a rack
+    it reproduces exactly must not be. A note naming the wrong rack is worse
+    than no note, because it sends the reader to inspect the shelf that is fine.
+    """
+    notes = E.unsupported(as_built)
+    for name, built in _built_widths(as_built).items():
+        rack = getattr(as_built, name)
+        named = any(n.startswith(name + ":") and "width" in n for n in notes)
+        assert named == (abs(built - rack.width) > 1e-9), (
+            f"{name}: built {built:.4f}, configured {rack.width:.4f}, "
+            f"named={named}; notes={notes}")
+
+
+def test_the_reported_width_is_the_width_that_gets_built(as_built):
+    """The number in the note must be the number in the stage."""
+    notes = [n for n in E.unsupported(as_built) if "width" in n]
+    for name, built in _built_widths(as_built).items():
+        for note in notes:
+            if note.startswith(name + ":"):
+                assert f"will be {built:.4f} m" in note, note
+
+
+def test_a_shelf_the_generator_cannot_match_exactly_is_reported(as_built):
+    """The generator has one width margin for both racks; the real racks differ.
+
+    Silence here would be the dangerous outcome: the sim shelf would not be the
+    shelf that was measured and nobody would know.
+    """
+    notes = E.unsupported(as_built)
+    assert any("width" in n.lower() for n in notes)
+    assert all(isinstance(n, str) for n in notes)
+
+
+def test_kwargs_are_accepted_by_the_generator_signature(as_built):
+    import inspect
+    sig = set(inspect.signature(E.load_generator()).parameters)
+    assert set(E.generator_kwargs(as_built)) <= sig
+
+
+def test_the_jig_gap_and_cylinder_radius_come_from_the_rack_config(as_built):
+    kw = E.generator_kwargs(as_built)
+    assert kw["jig_gap"] == pytest.approx(as_built.incoming.jig_gap)
+    assert kw["cylinder_radius"] == pytest.approx(as_built.incoming.cylinder_radius)
+    assert kw["rack_depth"] == pytest.approx(as_built.incoming.depth)
+
+
+def test_mismatched_rack_hardware_is_rejected_rather_than_silently_halved(as_built):
+    import dataclasses
+    odd = dataclasses.replace(as_built, outgoing=dataclasses.replace(
+        as_built.outgoing, jig_gap=as_built.outgoing.jig_gap + 0.004))
+    with pytest.raises(C.CellConfigError, match="jig_gap"):
+        E.generator_kwargs(odd)
