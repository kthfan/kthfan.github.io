+"""M6: the sim side of the seam, without Isaac (pure)."""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "motion"))
+sys.path.insert(0, str(HERE.parent / "vendor"))
+
+import cell_report as R  # noqa: E402
+import cell_core.config as C  # noqa: E402
+import cell_core.geometry as G  # noqa: E402
+import cell_core.scene as S  # noqa: E402
+
+ARM = "/Environment/RobotArmBase/RobotArm"
+
+
+def _T(p=(0, 0, 0), deg=0.0):
+    a = math.radians(deg)
+    T = np.eye(4)
+    T[:3, :3] = [[math.cos(a), -math.sin(a), 0], [math.sin(a), math.cos(a), 0], [0, 0, 1]]
+    T[:3, 3] = p
+    return T
+
+
+def test_look_at_points_the_usd_camera_at_the_target_with_z_up():
+    eye, target = np.array([0.0, -2.6, 2.2]), np.array([0.0, 0.2, 0.9])
+    T = R.look_at(eye, target)
+    assert np.allclose(T[:3, 3], eye)
+    assert np.allclose(T[:3, :3] @ T[:3, :3].T, np.eye(3)) and np.isclose(np.linalg.det(T[:3, :3]), 1.0)
+    view = (target - eye) / np.linalg.norm(target - eye)
+    assert np.allclose(-T[:3, 2], view)  # a USD camera looks down its -Z
+    assert abs(T[2, 0]) < 1e-12 and T[2, 1] > 0  # image x level, image up is world up
+
+
+def test_pose_and_inverse():
+    h = math.radians(40) / 2
+    T = R.pose((1, 2, 3), (math.cos(h), 0, 0, math.sin(h)))
+    assert np.allclose(T, _T((1, 2, 3), 40))
+    assert np.allclose(R.inv(T) @ T, np.eye(4))
+
+
+def test_match_trays_to_the_nearest_slot():
+    boxes = {"a": _T((0, 0, 0)), "b": _T((0.2, 0, 0)), "c": _T((0.4, 0, 0))}
+    trays = {"/T1": _T((0.41, 0, 0.01)), "/T0": _T((0.0, 0.01, -0.02))}
+    assert R.match_trays(trays, boxes) == {"/T1": "c", "/T0": "a"}
+
+
+def test_match_trays_refuses_a_stray_or_a_double():
+    boxes = {"a": _T((0, 0, 0)), "b": _T((0.2, 0, 0))}
+    with pytest.raises(ValueError, match="from the nearest"):
+        R.match_trays({"/T": _T((0.1, 0, 0))}, boxes)
+    with pytest.raises(ValueError, match="two trays"):
+        R.match_trays({"/T0": _T((0.01, 0, 0)), "/T1": _T((-0.01, 0, 0))}, boxes)
+
+
+def test_seat_offset_is_the_prim_in_the_box_frame():
+    off = _T((0.0, 0.0, -0.03), 1.0)
+    boxes = {"a": _T((0, 0, 1), 90), "b": _T((1, 0, 1), 0)}
+    trays = {"/A": boxes["a"] @ off @ _T((0.001, 0, 0)), "/B": boxes["b"] @ off @ _T((-0.001, 0, 0))}
+    got = R.seat_offset(trays, boxes, {"/A": "a", "/B": "b"})
+    assert np.allclose(got, off, atol=1e-9)
+    assert np.allclose(got[:3, :3] @ got[:3, :3].T, np.eye(3))
+
+
+def test_start_error():
+    assert R.start_error([0, 0.02, 0], [0, 0, -0.005]) == pytest.approx(0.02)
+
+
+def test_jig_prims_are_named_by_rack_layer_and_column():
+    by = {s.key: s for s in G.enumerate_slots(C.load_preset("strict"))}
+    assert R.jig_prim(by["incoming/L2/C3"]) == "/Environment/RightRack/Jig_2_3"
+    assert R.jig_prim(by["outgoing/L1/C0"]) == "/Environment/LeftRack/Jig_1_0"
+    assert R.jig_prim(by["table/L0/C0"]) == "/Environment/Table/Jig"
+
+
+def test_the_measured_jigs_locate_every_slot_within_the_accepted_offset():
+    """What sim_cell reports at ready: each jig prim's pose, as found.
+
+    The builder's jigs stand up to 16 mm off cell_core's centreline (accepted
+    2026-09-25, to be removed: user 2026-10-19); depth and height are exact.
+    """
+    stage = json.loads((HERE / "measured" / "strict.json").read_text(encoding="utf-8"))[0]
+    prims = {p["path"]: p for p in stage["prims"]}
+    shifts = []
+    for s in G.enumerate_slots(C.load_preset("strict")):
+        xf = prims[R.jig_prim(s)]["world_xform"]
+        x, y, z, w = xf["quat_xyzw"]
+        moved = S.located(s, R.pose(xf["translation"], (w, x, y, z)))
+        assert moved.label_plane_dist == pytest.approx(s.label_plane_dist, abs=1e-5), s.key
+        assert moved.height == pytest.approx(s.height, abs=1e-5), s.key
+        shifts.append(abs(moved.lateral - s.lateral))
+    assert max(shifts) == pytest.approx(0.016, abs=1e-5)
+
+
+def _rec():
+    trays = {"/T0": _T((1, 0, 0)), "/T1": _T((0, 1, 0))}
+    return R.Recorder("x", ARM, ["/T0", "/T1"], trays, _T((0.9, 0, 0)))
+
+
+def test_recorder_samples_every_sample_dt():
+    rec = _rec()
+    trays = {"/T0": _T((1, 0, 0)), "/T1": _T((0, 1, 0))}
+    for i in range(13):
+        rec.step(i / 120, [0] * 8, [0] * 8, _T((0.9, 0, 0)), _T(), trays)
+    ts = [s["t"] for s in rec.report()["samples"]]
+    assert ts[0] == 0.0 and len(ts) == 3
+    assert np.all(np.diff(ts) >= R.SAMPLE_DT - 1 / 120)
+
+
+def test_recorder_reports_the_moved_tray_relative_to_the_flange():
+    rec = _rec()
+    for i in range(1, 11):
+        x = 0.01 * i
+        flange = _T((0.9 + x, 0, 0))
+        tray = _T((1 + x + (0.002 if i == 5 else 0.0), 0, 0))
+        rec.step(i / 120, [0] * 8, [0] * 8, flange, _T(), {"/T0": tray, "/T1": _T((0, 1, 0))})
+    r = rec.report()["trays"]
+    assert list(r) == ["/T0"]
+    t = r["/T0"]
+    assert t["moved_mm"] == pytest.approx(100.0)
+    assert np.allclose(t["rel_start"], (0.1, 0, 0)) and np.allclose(t["rel_end"], (0.1, 0, 0))
+    assert np.allclose(t["rel_min"], (0.1, 0, 0)) and np.allclose(t["rel_max"], (0.102, 0, 0))
+    assert np.allclose(np.array(t["end"])[:3, 3], (1.1, 0, 0))
+
+
+def test_recorder_keeps_robot_contacts_only_and_aggregates():
+    rec = _rec()
+    rec.contact(0.1, f"{ARM}/link_6", "/Environment/Tray_0_0", "c0", "c1", 2.0)
+    rec.contact(0.2, f"{ARM}/link_6", "/Environment/Tray_0_0", "c0", "c2", 0.5)
+    rec.contact(0.3, "/Environment/Tray_0_0", "/Environment/Rack", "c0", "c1", 9.0)
+    cs = rec.report()["contacts"]
+    assert len(cs) == 1
+    c = cs[0]
+    assert c["t0"] == 0.1 and c["count"] == 2 and c["max_impulse"] == 2.0
+    assert c["colliders"] == [["c0", "c1"], ["c0", "c2"]]
