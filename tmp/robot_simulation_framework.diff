+"""Create a rack shelf composed of four cylinder legs and n shelf planes, and save it as USD."""
+
+from pxr import Usd, UsdGeom, UsdPhysics, Gf, UsdSemantics, Vt
+import argparse
+import os
+
+
+def create_rack_shelf(
+    stage,
+    root_path="/RackShelf",
+    size_x=0.6,
+    size_y=0.4,
+    size_z=1.0,
+    plane_height_list=None,
+    plane_thickness=0.02,
+    cylinder_radius=0.02,
+):
+    """Build a rack shelf under *root_path* on the given USD *stage*.
+
+    The rack occupies the cuboid from (0, 0, 0) to (size_x, size_y, size_z).
+    Four vertical cylinders are placed at the corners and each shelf plane is
+    a flat box spanning the full x-y extent at the specified z heights.
+
+    Parameters
+    ----------
+    stage : Usd.Stage
+    root_path : str
+    size_x, size_y, size_z : float
+        Bounding-box dimensions.
+    plane_height_list : list[float]
+        Z centre of each shelf plane.  Every value must be in [0, size_z].
+    plane_thickness : float
+    cylinder_radius : float
+
+    Returns
+    -------
+    UsdGeom.Xform  –  the root prim of the rack shelf.
+    """
+    if plane_height_list is None:
+        plane_height_list = [0.0, 0.33, 0.66, 1.0]
+
+    for h in plane_height_list:
+        if h < 0.0 or h > size_z:
+            raise ValueError(
+                f"Plane height {h} is outside the valid range [0, {size_z}]"
+            )
+
+    # Root Xform ----------------------------------------------------------
+    root_xform = UsdGeom.Xform.Define(stage, root_path)
+    root_prim = root_xform.GetPrim()
+
+    # Set as default prim -------------------------------------------------
+    stage.SetDefaultPrim(root_prim)
+    
+    # Set rigid body and mass -------------------------------------------------
+    UsdPhysics.RigidBodyAPI.Apply(root_prim)
+    UsdPhysics.MassAPI.Apply(root_prim).GetMassAttr().Set(
+        4 * 70 * size_z * cylinder_radius ** 2 + \
+        len(plane_height_list) * 2000 * size_x * size_y * plane_thickness
+    )
+
+    # Four corner cylinder legs -------------------------------------------
+    corner_positions = [
+        (cylinder_radius, cylinder_radius),
+        (size_x - cylinder_radius, cylinder_radius),
+        (cylinder_radius, size_y - cylinder_radius),
+        (size_x - cylinder_radius, size_y - cylinder_radius),
+    ]
+
+    for i, (cx, cy) in enumerate(corner_positions):
+        cyl_path = f"{root_path}/Leg_{i}"
+        cylinder = UsdGeom.Cylinder.Define(stage, cyl_path)
+        cylinder.GetRadiusAttr().Set(cylinder_radius)
+        cylinder.GetHeightAttr().Set(size_z)
+        cylinder.GetAxisAttr().Set("Z")
+
+        UsdPhysics.CollisionAPI.Apply(cylinder.GetPrim())
+
+        xformable = UsdGeom.Xformable(cylinder)
+        xformable.AddTranslateOp().Set(Gf.Vec3d(cx, cy, size_z / 2.0))
+
+    # Shelf planes --------------------------------------------------------
+    for i, h in enumerate(plane_height_list):
+        plane_path = f"{root_path}/Shelf_{i}"
+        cube = UsdGeom.Cube.Define(stage, plane_path)
+        # Default Cube spans [-1, 1] in each axis (size 2), so we scale by
+        # half the desired dimension on each axis.
+        UsdPhysics.CollisionAPI.Apply(cube.GetPrim())
+
+        xformable = UsdGeom.Xformable(cube)
+        xformable.AddTranslateOp().Set(
+            Gf.Vec3d(size_x / 2.0, size_y / 2.0, h)
+        )
+        xformable.AddScaleOp().Set(
+            Gf.Vec3f(size_x / 2.0, size_y / 2.0, plane_thickness / 2.0)
+        )
+
+    UsdSemantics.LabelsAPI.Apply(root_prim, "class").GetLabelsAttr().Set(Vt.TokenArray(["rack_shelf"]))
+
+    return root_xform
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Create a rack shelf and save as USD")
+    parser.add_argument(
+        "--output", "-o", type=str, default="rack_shelf.usd",
+        help="Output .usd file path",
+    )
+    parser.add_argument("--size_x", type=float, default=0.36)
+    parser.add_argument("--size_y", type=float, default=1.12)
+    parser.add_argument("--size_z", type=float, default=1.2)
+    parser.add_argument(
+        "--plane_heights", type=float, nargs="+",
+        default=[0.25, 0.55, 0.85, 1.15],
+        help="Z positions (centres) for each shelf plane",
+    )
+    parser.add_argument("--plane_thickness", type=float, default=0.03)
+    parser.add_argument("--cylinder_radius", type=float, default=0.015)
+    args = parser.parse_args()
+
+    # Remove existing file because Usd.Stage.CreateNew will fail if it exists
+    if os.path.exists(args.output):
+        os.remove(args.output)
+
+    stage = Usd.Stage.CreateNew(args.output)
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+
+    create_rack_shelf(
+        stage,
+        size_x=args.size_x,
+        size_y=args.size_y,
+        size_z=args.size_z,
+        plane_height_list=args.plane_heights,
+        plane_thickness=args.plane_thickness,
+        cylinder_radius=args.cylinder_radius,
+    )
+
+    stage.GetRootLayer().Save()
+    print(f"Saved rack shelf to {args.output}")
+
+
+if __name__ == "__main__":
+    main()
