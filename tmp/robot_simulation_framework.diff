+def test_the_report_says_which_shelf_will_not_match_the_measurement():
+    """Fidelity notes are printed on every build, not only on request.
+
+    The generator applies one width margin to both racks, so one shelf is always
+    built wider than measured. A build that stayed quiet about it would leave
+    the reader believing the sim reproduces the cell.
+    """
+    cfg, env_kwargs, notes = B.plan("as_built")
+    assert notes, "as_built is known not to be exactly reproducible"
+    report = "\n".join(B.describe(cfg, env_kwargs, notes))
+    for note in notes:
+        assert note in report
