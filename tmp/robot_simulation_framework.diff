+"""Vendoring and drift detection (D8).
+
+`shared/cell_core` is the single editable source. Each consumer repo carries a
+copy under `vendor/`, and must fail loudly if that copy is edited in place or
+falls behind the source.
+"""
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tools"))
+
+import sync_shared as SS  # noqa: E402
+
+
+SOURCE = Path(__file__).resolve().parents[1] / "cell_core"
+
+
+@pytest.fixture
+def vendored(tmp_path):
+    dest = tmp_path / "vendor" / "cell_core"
+    SS.sync(SOURCE, dest)
+    return dest
+
+
+def test_sync_copies_the_python_sources(vendored):
+    assert (vendored / "geometry.py").is_file()
+    assert (vendored / "__init__.py").is_file()
+
+
+def test_no_source_file_carries_a_replacement_character():
+    """An encoding round-trip must not be allowed to eat the source.
+
+    `config.py` was once run through a PowerShell ``Get-Content | Set-Content``
+    pipeline, which decoded its ``U+2500`` separators through a codepage that
+    could not represent them and wrote ``U+FFFD`` back in their place, 616 times.
+
+    Nothing caught it. The file still parsed, every test still passed, and after
+    the round-trip it was once again *valid* UTF-8, so a decoder check could not
+    see the damage either. Only a byte-level diff against the vendored copy
+    revealed it. U+FFFD is never legitimate content, so its mere presence is the
+    signal.
+    """
+    damaged = []
+    for path in sorted(SOURCE.rglob("*.py")) + sorted(SOURCE.rglob("*.yaml")):
+        text = path.read_bytes().decode("utf-8", errors="replace")
+        if "\ufffd" in text:
+            damaged.append(f"{path.name} ({text.count(chr(0xFFFD))})")
+        # The half-repaired form of the same round-trip: cp950 turns U+2500
+        # into '?' + 0x80, and restoring only the 0x80 half leaves a '?' in
+        # front of every box-drawing character. '?' is ASCII, so the check
+        # above cannot see it.
+        if "?\u2500" in text:
+            damaged.append(f"{path.name} ({text.count('?' + chr(0x2500))} '?\u2500' pairs)")
+    assert not damaged, f"replacement characters in: {', '.join(damaged)}"
+
+
+def test_sync_copies_the_presets(vendored):
+    assert (vendored / "presets" / "as_built.yaml").is_file()
+    assert (vendored / "presets" / "recommended.yaml").is_file()
+
+
+def test_sync_writes_a_manifest(vendored):
+    assert (vendored / SS.MANIFEST_NAME).is_file()
+
+
+def test_sync_excludes_caches(tmp_path):
+    src = tmp_path / "src"
+    (src / "__pycache__").mkdir(parents=True)
+    (src / "__pycache__" / "x.pyc").write_bytes(b"junk")
+    (src / "a.py").write_text("x = 1\n")
+    dest = tmp_path / "dst"
+    SS.sync(src, dest)
+    assert not (dest / "__pycache__").exists()
+    assert (dest / "a.py").is_file()
+
+
+def test_a_fresh_vendor_copy_reports_no_drift(vendored):
+    assert SS.verify(vendored) == []
+
+
+def test_editing_a_vendored_file_is_detected(vendored):
+    target = vendored / "geometry.py"
+    # Append bytes: the sources are UTF-8 but the default text encoding on a
+    # Windows host is not, and this test is about hashes, not encodings.
+    with open(target, "ab") as fh:
+        fh.write(b"\n# local edit\n")
+    drift = SS.verify(vendored)
+    assert any(d.path == "geometry.py" and d.kind == "modified" for d in drift)
+
+
+def test_deleting_a_vendored_file_is_detected(vendored):
+    (vendored / "geometry.py").unlink()
+    assert any(d.kind == "missing" for d in SS.verify(vendored))
+
+
+def test_an_untracked_extra_file_is_detected(vendored):
+    (vendored / "sneaky.py").write_text("x = 1\n")
+    assert any(d.path == "sneaky.py" and d.kind == "untracked"
+               for d in SS.verify(vendored))
+
+
+def test_a_vendor_copy_behind_the_source_is_detected(vendored):
+    assert SS.is_current(SOURCE, vendored)
+    stale = SS.manifest(SOURCE)
+    stale["geometry.py"] = "0" * 64
+    assert not SS.manifests_match(stale, SS.manifest(vendored))
+
+
+def test_resync_clears_drift(vendored):
+    (vendored / "geometry.py").write_text("# clobbered\n")
+    assert SS.verify(vendored)
+    SS.sync(SOURCE, vendored)
+    assert SS.verify(vendored) == []
+
+
+def test_sync_removes_files_deleted_from_the_source(tmp_path):
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "a.py").write_text("a = 1\n")
+    (src / "b.py").write_text("b = 2\n")
+    dest = tmp_path / "dst"
