+"""Ground truth for M4 locating: where the detector's board frame is in the stage.
+
+``label_truth`` reads it off the label mesh the renderer draws (points + ``st``
+of the face that sees the camera), not off ``cell_core``, so the locating
+comparison crosses the boundary (D18/D22). The checks here use a second path
+through the same stage (the mesh bounding box) and the builder's own constants.
+
+Board frame (aprilgrid_detector, probed M4 task 5): origin at the top-left
+corner of tag 0 = PNG top-left + (margin, margin); x along PNG columns, y down
+PNG rows, z into the label.
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "locating"))
+
+import label_truth as L  # noqa: E402  (puts build_env and cell_core on the path)
+import create_rack_shelf_with_tray_jig as J  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+
+JIG_USD = HERE.parents[1] / "todo/resources/isaacsim/assets/tray_jig_with_label.usd"
+JIG_AT = np.array([0.1, 0.2, 0.3])
+
+
+def _stage(parent_T=None, texture=None, rotate=None, scale=None):
+    pytest.importorskip("pxr")
+    from pxr import Gf, Sdf, Usd, UsdGeom, UsdShade
+    stage = Usd.Stage.CreateInMemory()
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+    rack = UsdGeom.Xform.Define(stage, "/Environment/Rack")
+    if parent_T is not None:
+        rack.AddTransformOp().Set(Gf.Matrix4d(np.asarray(parent_T).T.tolist()))
+    jig = UsdGeom.Xform.Define(stage, "/Environment/Rack/Jig_0_0")
+    jig.GetPrim().GetReferences().AddReference(str(JIG_USD))
+    jig.AddTranslateOp().Set(Gf.Vec3d(*JIG_AT))
+    shader = UsdShade.Shader.Get(stage, "/Environment/Rack/Jig_0_0/" + L.LABEL_SHADER)
+    if texture is not None:
+        shader.CreateInput("diffuse_texture", Sdf.ValueTypeNames.Asset).Set(Sdf.AssetPath(texture))
+    if rotate is not None:
+        shader.CreateInput("texture_rotate", Sdf.ValueTypeNames.Float).Set(rotate)
+    if scale is not None:
+        shader.CreateInput("texture_scale", Sdf.ValueTypeNames.Float2).Set(Gf.Vec2f(*scale))
+    return stage, "/Environment/Rack/Jig_0_0"
+
+
+def _label_bbox(stage, jig):
+    from pxr import Usd, UsdGeom
+    cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_])
+    r = cache.ComputeWorldBound(stage.GetPrimAtPath(f"{jig}/{L.LABEL_MESH}")).ComputeAlignedRange()
+    return np.array(r.GetMin()), np.array(r.GetMax())
+
+
+def _grid_centre(T):
+    return T[:3, 3] + T[:3, 0] * A.GRID_W / 2 + T[:3, 1] * A.GRID_H / 2
+
+
+def test_the_board_frame_on_the_robot_facing_face():
+    """Jig +y faces the robot, and from there the label reads upright: tag 0
+    at the jig +x end (the viewer's left), board x running towards jig -x,
+    rows running down. The face's st alone would show the PNG
+    rotated 180 degrees; the asset's OmniPBR ``texture_rotate`` 180 turns it
+    back. Seen in the M4 task 6 pilot render: OpenCV found the tags exactly
+    180 degrees from a truth that ignored the shader. The grid centre is the
+    face centre (equal margins). The camera is off-axis, so it also sees the
+    label's top and +x side."""
+    stage, jig = _stage()
+    camera = JIG_AT + np.array([0.1, 0.5, 0.05])
+    T, info = L.board_pose(stage, jig, camera)
+    lo, hi = _label_bbox(stage, jig)
+    assert T[:3, 2] == pytest.approx([0, -1, 0], abs=1e-9)
+    assert T[:3, 0] == pytest.approx([-1, 0, 0], abs=1e-9)
+    assert T[:3, 1] == pytest.approx([0, 0, -1], abs=1e-9)
+    face_centre = [(lo[0] + hi[0]) / 2, hi[1], (lo[2] + hi[2]) / 2]
+    assert _grid_centre(T) == pytest.approx(face_centre, abs=1e-9)
+
+
+def test_without_the_shader_rotation_the_face_st_decides():
+    """texture_rotate 0: the PNG top-left is at st (0, 1)."""
+    stage, jig = _stage(rotate=0.0)
+    T, _ = L.board_pose(stage, jig, JIG_AT + np.array([0.1, 0.5, 0.05]))
+    lo, hi = _label_bbox(stage, jig)
+    assert T[:3, 0] == pytest.approx([1, 0, 0], abs=1e-9)
+    assert T[:3, 1] == pytest.approx([0, 0, 1], abs=1e-9)
+    face_centre = [(lo[0] + hi[0]) / 2, hi[1], (lo[2] + hi[2]) / 2]
+    assert _grid_centre(T) == pytest.approx(face_centre, abs=1e-9)
+
+
+@pytest.mark.parametrize("rotate, scale", [(90.0, None), (0.0, (2.0, 1.0))])
+def test_a_texture_transform_it_does_not_model_is_refused(rotate, scale):
+    stage, jig = _stage(rotate=rotate, scale=scale)
+    with pytest.raises(ValueError, match="texture"):
+        L.board_pose(stage, jig, JIG_AT + np.array([0.0, 0.5, 0.0]))
+
+
+def test_the_label_is_the_png_the_builder_prints():
+    """Mesh width = grid + two builder margins, and the PNG's own aspect."""
+    stage, jig = _stage()
+    _, info = L.board_pose(stage, jig, JIG_AT + np.array([0.0, 0.5, -0.015]))
+    assert info["face_width"] == pytest.approx(A.GRID_W + 2 * J.APRILGRID_MARGIN, abs=1e-9)
+    assert info["face_height"] == pytest.approx(A.GRID_H + 2 * J.APRILGRID_MARGIN, abs=1e-9)
+
+
+def test_the_detector_layout_is_the_grid_the_builder_prints():
+    """locate hands cell_core's layout to the detector; the stage has the builder's."""
+    assert (A.TAGS_X, A.TAGS_Y) == (J.APRILGRID_MARKERS_X, J.APRILGRID_MARKERS_Y)
+    assert A.TAG_SIZE == J.APRILGRID_MARKER_LENGTH
+    assert A.TAG_SEPARATION == J.APRILGRID_MARKER_SEPARATION
+
+
+def test_the_back_face_is_used_when_the_camera_is_behind():
+    stage, jig = _stage()
+    T, _ = L.board_pose(stage, jig, JIG_AT + np.array([0.0, -0.5, -0.015]))
+    lo, _hi = _label_bbox(stage, jig)
+    assert T[:3, 2] == pytest.approx([0, 1, 0], abs=1e-9)
+    assert _grid_centre(T)[1] == pytest.approx(lo[1], abs=1e-9)
+
+
+def test_the_board_frame_moves_with_its_parents():
+    rng = np.random.default_rng(3)
+    stage0, jig = _stage()
+    cam0 = JIG_AT + np.array([0.02, 0.4, 0.01])
+    T0, _ = L.board_pose(stage0, jig, cam0)
+    for _ in range(3):
+        P = F.make_pose(F.quat_to_matrix(rng.normal(size=4)), rng.normal(size=3))
+        stage, _ = _stage(parent_T=P)
+        T, _ = L.board_pose(stage, jig, (P @ np.append(cam0, 1.0))[:3])
+        assert T == pytest.approx(P @ T0, abs=1e-9)
+
+
+def test_the_grid_id_is_read_from_the_texture_on_the_jig():
+    stage, jig = _stage(texture="/some/where/label_images/aprilgrid_17.png")
+    assert L.texture_grid_id(stage, jig) == 17
+
+
+def test_every_slot_names_a_jig_that_the_built_stage_has():
+    (measured,) = json.loads((HERE / "measured" / "strict.json").read_text(encoding="utf-8"))
+    prims = {p["path"] for p in measured["prims"]}
+    slots = G.enumerate_slots(C.load_preset("strict"))
+    paths = [L.jig_prim_path(s) for s in slots]
+    assert len(set(paths)) == len(slots)
+    assert set(paths) <= prims
