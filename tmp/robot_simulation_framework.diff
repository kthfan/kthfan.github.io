+"""D29: the cuRobo gripper (program/robot_config) is the real gripper.
+
+egu50_v2.urdf's gripper_body collision cubes, mounted on link_6 as tm5s_v5.yml
+does (rotation -90 deg about X: gripper (x, y, z) -> flange (x, z, -y)), must
+span the body and plate of ``cell_core.assets``.
+"""
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+import numpy as np
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "collision"))
+
+import check_cell as CC  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+
+CFG = ROOT / "program" / "robot_config"
+HOST = "/workspace/robot-program/robot_config/"
+
+
+def _local(path: str) -> Path:
+    assert path.startswith(HOST), path
+    return CFG / path[len(HOST):]
+
+
+def _cubes():
+    link = next(l for l in ET.parse(CFG / "egu50_v2.urdf").getroot().findall("link")
+                if l.get("name") == "gripper_body")
+    out = []
+    for c in link.findall("collision"):
+        o = c.find("origin")
+        assert [float(v) for v in o.get("rpy").split()] == [0, 0, 0]
+        xyz = np.array([float(v) for v in o.get("xyz").split()])
+        m = c.find("geometry/mesh")
+        assert [float(v) for v in m.get("scale", "1 1 1").split()] == [1, 1, 1]
+        v = np.array([[float(t) for t in ln.split()[1:4]]
+                      for ln in _local(m.get("filename")).read_text().splitlines() if ln.startswith("v ")])
+        g = v + xyz
+        f = np.column_stack([g[:, 0], g[:, 2], -g[:, 1]])
+        out.append((f.min(axis=0), f.max(axis=0)))
+    return sorted(out, key=lambda b: b[1][2])
+
+
+def _gripper_cubes():
+    """The body and plate cubes, nearest first (the D455 sits above the flange)."""
+    return [c for c in _cubes() if c[0][1] < 0.0]
+
+
+def test_check_cell_uses_this_config():
+    assert Path(CC.GRIPPER_YML) == CFG / "egu50_v2.yml"
+
+
+def test_yml_points_at_this_urdf():
+    k = yaml.safe_load((CFG / "egu50_v2.yml").read_text())["kinematics"]
+    assert _local(k["urdf_path"]) == CFG / "egu50_v2.urdf"
+
+
+def test_body_cube_is_the_real_body():
+    lo, hi = _gripper_cubes()[0]
+    assert np.allclose((lo[0], hi[0]), (-A.BODY_FX, A.BODY_FX), atol=1e-6)
+    assert np.allclose((lo[2], hi[2]), (0.0, A.BODY_FZ_FRONT), atol=1e-6)
+
+
+def test_plate_cube_is_the_real_plate():
+    lo, hi = _gripper_cubes()[1]
+    assert np.allclose(lo, (-A.PLATE_FX, A.PLATE_FY_BOT, A.PLATE_FZ_ROOT), atol=1e-6)
+    assert np.allclose(hi, (A.PLATE_FX, A.PLATE_FY_TOP, A.PLATE_FZ_TIP), atol=1e-6)
+
+
+def test_d455_cube_is_the_real_camera_case():
+    # M6: the live run hit a shelf with the D455, which the mesh check lacked.
+    (lo, hi), = [c for c in _cubes() if c[0][1] > 0.0]
+    assert np.allclose(lo, (-A.D455_CASE_HALF_W, A.D455_FY - A.D455_CASE_HALF_H,
+                            A.D455_FZ - A.D455_CASE_DEPTH), atol=1e-6)
+    assert np.allclose(hi, (A.D455_CASE_HALF_W, A.D455_FY + A.D455_CASE_HALF_H, A.D455_FZ),
+                       atol=1e-6)
+    assert len(_cubes()) == 3
+
+
+@pytest.mark.parametrize("name", ["left_gripper", "right_gripper"])
+def test_jaws_unchanged(name):
+    def links(p):
+        return {l.get("name"): ET.tostring(l) for l in ET.parse(p).getroot().findall("link")}
+    src = ROOT / "todo" / "resources" / "robot_config" / "egu50_v2.urdf"
+    assert links(CFG / "egu50_v2.urdf")[name] == links(src)[name]
+
+
+@pytest.mark.parametrize("name", ["left_gripper_joint", "right_gripper_joint"])
+def test_jaw_limits_are_the_real_stroke(name):
+    j = next(j for j in ET.parse(CFG / "egu50_v2.urdf").getroot().findall("joint")
+             if j.get("name") == name)
+    lim = j.find("limit")
+    assert float(lim.get("lower")) == pytest.approx(A.JAW_Q_MIN, abs=1e-6)
+    assert float(lim.get("upper")) == pytest.approx(A.JAW_Q_MAX, abs=1e-6)
+
+
+def test_default_jaw_position_within_the_limits():
+    k = yaml.safe_load((CFG / "egu50_v2.yml").read_text())["kinematics"]
+    for q in k["cspace"]["default_joint_position"]:
+        assert A.JAW_Q_MIN <= q <= A.JAW_Q_MAX
+
+
+def test_check_cell_judges_the_open_command():
+    assert CC.JAW == A.JAW_Q_OPEN
