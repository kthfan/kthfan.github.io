+"""Fail if the vendored copy of ``cell_core`` has been edited or gone stale.
+
+``cell_core`` is maintained once, in the AI-Robotics-V2 workspace under
+``shared/cell_core``, and copied into this repo because the deployment hosts
+are offline and this repo has its own git history. The copy is the risk: an
+edit made here would never reach the other repo, and the sim and the program
+would quietly stop agreeing about where the shelves are.
+
+``MANIFEST.sha256`` travels with the copy. If you need to change something in
+``cell_core``, change it in ``shared/cell_core`` and re-run::
+
+    python tools/sync_shared.py
+
+This test is deliberately dependency-free so it runs on the deployment host.
+"""
+import hashlib
+from pathlib import Path
+
+import pytest
+
+VENDOR = Path(__file__).resolve().parents[1] / "vendor" / "cell_core"
+MANIFEST = VENDOR / "MANIFEST.sha256"
+EXCLUDE_DIRS = {"__pycache__", ".pytest_cache"}
+EXCLUDE_SUFFIXES = {".pyc", ".pyo"}
+
+
+def _tracked():
+    for path in sorted(VENDOR.rglob("*")):
+        if not path.is_file():
+            continue
+        if path.name == MANIFEST.name or path.suffix in EXCLUDE_SUFFIXES:
+            continue
+        rel = path.relative_to(VENDOR)
+        if EXCLUDE_DIRS.intersection(rel.parts):
+            continue
+        yield rel.as_posix(), path
+
+
+def _sha256(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+@pytest.fixture(scope="module")
+def recorded():
+    if not MANIFEST.is_file():
+        pytest.fail(f"{MANIFEST} is missing; run 'python tools/sync_shared.py'")
+    entries = {}
+    for line in MANIFEST.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if line and not line.startswith("#"):
+            digest, _, rel = line.partition("  ")
+            entries[rel] = digest
+    return entries
+
+
+def test_the_vendored_copy_is_not_empty(recorded):
+    assert recorded, "the manifest lists no files; the sync did not work"
+
+
+def test_no_vendored_file_has_been_edited(recorded):
+    actual = dict(_tracked())
+    modified = [rel for rel, digest in recorded.items()
+                if rel in actual and _sha256(actual[rel]) != digest]
+    assert not modified, (
+        f"edited in place: {modified}. Edit shared/cell_core instead, then "
+        f"re-run 'python tools/sync_shared.py'.")
+
+
+def test_no_vendored_file_has_been_deleted(recorded):
+    actual = dict(_tracked())
+    missing = sorted(set(recorded) - set(actual))
+    assert not missing, f"missing from the vendored copy: {missing}"
+
+
+def test_no_untracked_file_has_been_added(recorded):
+    actual = dict(_tracked())
+    extra = sorted(set(actual) - set(recorded))
+    assert not extra, (
+        f"not part of cell_core: {extra}. Anything added here is invisible to "
+        f"the other repo.")
+
+
+def test_the_vendored_package_imports(recorded):
+    import sys
+    sys.path.insert(0, str(VENDOR.parent))
+    import cell_core
+
+    if Path(cell_core.__file__).resolve().parent != VENDOR:
+        pytest.skip("another vendored copy was imported first in this process")
+
+    cfg = cell_core.load_preset("as_built")
+    cell_core.validate(cfg)
+    assert len(cell_core.enumerate_slots(cfg)) == 37
