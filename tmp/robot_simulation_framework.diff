++#!/usr/bin/env python3
++"""Re-key a reach-volume npz from "label centre, base frame" to "tray front-centre-bottom,
++end-effector axes".
++
++Input grid point: AprilGrid centre, robot base frame (x right, y = approach, z up).
++Output grid point: the tray's front-centre-bottom point, on the flange axes used by
++``cell_core.frames.flange_rotation`` for the (+Y) approach:
++
++    x = flange X  lateral, the tray's centre line (0 = tray centred)
++    y = flange Y  up, the tray's underside (the rails resting on the jig columns)
++    z = flange Z  approach, the tray's robot-facing edge
++
++Origin stays the robot base. Levels are unchanged; only the point they are filed
++under moves (a constant offset from the label centre) and the axes are permuted.
++
++    python .agent-workspace/tools/reach_volume/convert_to_tray_frame.py
++"""
++from __future__ import annotations
++
++import argparse
++import os
++import sys
++
++import numpy as np
++
++HERE = os.path.dirname(os.path.abspath(__file__))
++ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))
++RENDERS = os.path.join(ROOT, ".agent-workspace", "renders", "reach_volume")
++sys.path.insert(0, os.path.join(ROOT, "shared"))
++
++import cell_core.assets as A   # noqa: E402
++
++#: Label centre -> tray front-centre-bottom, along approach / up (lateral is 0).
++APPROACH_OFFSET = A.LABEL_PROUD_OF_FACE + A.TRAY_FRONT_DEPTH
++UP_OFFSET = A.TRAY_BOT - A.LABEL_MID_Z
++#: Approach is base +Y, so flange X = up x approach = -base X.
++LEVEL_KEYS = ("levels", "levels_ik")
++
++
++def convert(d) -> dict:
++    """*d*: mapping with xs, ys, zs (base frame), levels[, levels_ik], phases, preset."""
++    out = {
++        "xs": np.round(-np.asarray(d["xs"], dtype=float)[::-1], 6),
++        "ys": np.round(np.asarray(d["zs"], dtype=float) + UP_OFFSET, 6),
++        "zs": np.round(np.asarray(d["ys"], dtype=float) + APPROACH_OFFSET, 6),
++        "phases": d["phases"],
++        "preset": d["preset"],
++        "frame": np.array("tray front-centre-bottom; x lateral, y up, z approach (flange axes)"),
++    }
++    for k in LEVEL_KEYS:
++        if k in d:
++            # (base x, base y, base z) -> flip x to lateral, then (lateral, up, approach)
++            out[k] = np.ascontiguousarray(np.asarray(d[k])[::-1].transpose(0, 2, 1))
++    return out
++
++
++def main() -> int:
++    ap = argparse.ArgumentParser()
++    ap.add_argument("--src", nargs="+", default=[os.path.join(RENDERS, "reach_volume.npz"),
++                                                 os.path.join(RENDERS, "reach_volume_curobo.npz")])
++    args = ap.parse_args()
++    for src in args.src:
++        dst = src[:-4] + "_tray.npz"
++        with np.load(src) as d:
++            out = convert({k: d[k] for k in d.files})
++        np.savez(dst, **out)
++        print(f"wrote {dst}  x[{out['xs'][0]:.3f},{out['xs'][-1]:.3f}] "
++              f"y[{out['ys'][0]:.3f},{out['ys'][-1]:.3f}] z[{out['zs'][0]:.3f},{out['zs'][-1]:.3f}]")
++    return 0
++
++
++if __name__ == "__main__":
++    sys.exit(main())
