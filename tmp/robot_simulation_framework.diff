@@ -0,0 +1,69 @@
+"""Local smoke test for the ported sweep: no EAIK, just the geometry path.
+
+The real sweep only runs on the program host. That makes every typo in the
+config/geometry plumbing cost a remote round-trip, so exercise the non-IK half
+here with a stub robot that declares everything reachable.
+"""
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "vendor"))
+sys.path.insert(0, str(ROOT / ".agent-workspace" / "tools"))
+
+import reach_sweep as RS  # noqa: E402
+import cell_core.config as CFG  # noqa: E402
+import cell_core.geometry as GEO  # noqa: E402
+
+
+class StubBot:
+    """Reports one exact solution at the origin for any pose."""
+
+    def fwdKin(self, q):
+        return np.eye(4)
+
+    def IK(self, T):
+        class Sol:
+            Q = [np.zeros(6)]
+            is_LS_vec = [False]
+        return Sol()
+
+
+def main() -> int:
+    cfg = CFG.load_preset("as_built")
+    CFG.validate(cfg)
+    slots = GEO.enumerate_slots(cfg)
+    lo = -np.ones(6) * 3.0
+    hi = np.ones(6) * 3.0
+
+    rows = RS.run_sweep(StubBot(), lo, hi, cfg.robot.origin_z, cfg, slots,
+                        0.0, np.eye(3))
+
+    assert len(rows) == 222, f"expected 222 rows, got {len(rows)}"
+    required = {"slot", "rack", "layer", "column", "phase", "horiz", "z",
+                "shoulder_r", "status"}
+    missing = required - set(rows[0])
+    assert not missing, f"row is missing keys: {missing}"
+
+    # The shoulder radius is what the margin analysis in findings/04 is built
+    # on; a wrong offset here would silently shift every margin.
+    r0 = rows[0]
+    expect = float(np.linalg.norm(
+        np.array([r0["horiz"], 0.0, r0["z"]])
+        - np.array([0.0, 0.0, cfg.robot.origin_z + 0.1484])))
+    assert abs(r0["shoulder_r"] - expect) < 2e-4, (
+        f"shoulder radius {r0['shoulder_r']} != {expect}")
+
+    probe = RS._racks_at(cfg, 0.85)
+    assert probe.incoming.face_distance == 0.85
+    assert probe.outgoing.face_distance == 0.85
+    assert cfg.incoming.face_distance == 0.792, "the scan mutated the base config"
+
+    print(f"ok: {len(rows)} rows, {len(slots)} slots, keys and shoulder radius sane")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/test_fix_gripper_usd.py" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/test_fix_gripper_usd.py"
