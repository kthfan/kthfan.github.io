@@ -0,0 +1,291 @@
+"""M6: plan tray transfers into joint trajectories, and validate them (D30).
+
+A transfer's segments (:mod:`transfer`) are walked with EAIK from a start
+branch at the source's approach pose; the start branches are tried nearest the
+current joints first, and the first whose whole transfer walks, keeps the
+carried tray within the D14 caps and passes *accept* is taken. Free moves
+between transfers are cuRobo's (:class:`FreePlanner`); every trajectory is
+checked with M3's exact meshes (:class:`Checker`) before it is sent.
+
+The pure part (walking, timing, kinematics, scenarios) runs anywhere EAIK
+does; :class:`Checker` and :class:`FreePlanner` need cuRobo (program host).
+"""
+from __future__ import annotations
+
+import math
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import paths as P  # noqa: E402  (puts collision/ and vendor/ on the path)
+import judge as J  # noqa: E402
+import timing as TM  # noqa: E402
+import transfer as TR  # noqa: E402
+import check_cell as CC  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import scene as S  # noqa: E402
+
+#: Largest joint-1 step between validation samples of a sweep (rad).
+SWEEP_CHECK_STEP = 0.005
+#: Largest joint step between validation samples of a free move (rad).
+FREE_CHECK_STEP = 0.01
+HOME = np.zeros(6)
+
+
+@dataclass(eq=False)
+class Planned:
+    name: str
+    seg: Optional[TR.Seg]      #: None for a free move
+    t: np.ndarray              #: sample times from 0, spacing ``P.DT``
+    Q: np.ndarray              #: ``(len(t), 8)`` arm + both jaws
+    geo: np.ndarray            #: ``(m, 6)`` arm samples dense in space, for collision checks
+    jaws: tuple                #: jaw commands the gripper passes through
+    occupied: frozenset        #: slots holding a tray in the world
+    kin: Optional[dict] = None  #: carried tray's peak kinematics
+
+    @property
+    def q_end(self) -> np.ndarray:
+        return self.Q[-1, :6].copy()
+
+
+def _z_angle(T0, T1) -> float:
+    a, b = np.asarray(T0)[:2, 3], np.asarray(T1)[:2, 3]
+    return math.atan2(a[0] * b[1] - a[1] * b[0], float(a @ b))
+
+
+def carried_kin(ik, base, t, Q6) -> dict:
+    """Peak kinematics of the carried tray's centre along *Q6* at times *t*."""
+    boxes = [S.carried_tray_box(P.fk_world(ik, q, base)) for q in Q6]
+    pts = np.array([b.T[:3, 3] for b in boxes])
+    rots = np.array([b.T[:3, :3] for b in boxes])
+    return {**TM.point_kinematics(t, pts), **TM.angular_kinematics(t, rots)}
+
+
+def plan_segments(ik, base, segs, q0) -> list:
+    """Every segment of a transfer as a trajectory, chained from *q0*."""
+    q = np.asarray(q0, dtype=float)
+    out = []
+    for s in segs:
+        if s.kind == "jaw":
+            t, Q = P.time_jaw(q, s.jaw, s.jaw_end)
+            geo = q[None, :]
+        elif s.kind == "sweep":
+            dq = P.sweep_delta(q[0], _z_angle(s.T0, s.T1), ik.lo[0], ik.hi[0])
+            t, Q6 = P.time_sweep(q, dq, P.carried_radius(s.T0), s.caps)
+            dp, dr = F.pose_error(P.fk_world(ik, Q6[-1], base), s.T1)
+            if dp > 1e-4 or dr > 1e-3:
+                raise P.PathError(f"{s.name}: joint 1 alone misses the hub by {dp * 1e3:.2f} mm")
+            n = max(1, math.ceil(abs(dq) / SWEEP_CHECK_STEP))
+            geo = np.repeat(q[None, :], n + 1, axis=0)
+            geo[:, 0] += np.linspace(0.0, dq, n + 1)
+            Q = P.with_jaws(Q6, s.jaw)
+        else:
+            try:
+                us, geo = P.walk(ik, s.T0, s.T1, q, base)
+            except P.PathError as e:
+                raise P.PathError(f"{s.name}: {e}") from e
+            t, Q6 = P.time_line(ik, us, geo, s.T0, s.T1, s.caps, base)
+            Q = P.with_jaws(Q6, s.jaw)
+        kin = None
+        if s.carried and s.kind != "jaw":
+            kin = carried_kin(ik, base, t, Q[:, :6])
+        out.append(Planned(s.name, s, t, Q, geo, (s.jaw, s.jaw_end), s.occupied, kin))
+        q = out[-1].q_end
+    return out
+
+
+def start_candidates(ik, T, q_ref, base) -> list:
+    """Every in-limit way to reach *T*, nearest *q_ref* first (largest joint move)."""
+    q_ref = np.asarray(q_ref, dtype=float)
+    qs = [P.refine(ik, T, qt, base)
+          for q in CC.ik_branches(ik, T, base) for qt in CC._turns(q, ik.lo, ik.hi)]
+    return sorted(qs, key=lambda q: (float(np.abs(q - q_ref).max()), float(np.abs(q - q_ref).sum())))
+
+
+def plan_transfer(ik, cfg, src, dst, occupied, q_ref, accept=None):
+    """``(planned, tried)``: the first start branch whose transfer is good.
+
+    Each hub radius of ``TR.HUB_RADII`` is tried in turn, every start branch
+    at one before the next. *accept(planned) -> list of problems* (empty:
+    accepted); *tried* records why each earlier branch was dropped. Raises
+    :class:`paths.PathError` if none is good.
+    """
+    base = cfg.robot.base_pose
+    tried = []
+    starts = start_candidates(ik, TR.approach_pose(src), q_ref, base)
+    for hub in TR.HUB_RADII:
+        segs = TR.move_segments(cfg, src, dst, frozenset(occupied), hub_radius=hub)
+        for q0 in starts:
+            why = None
+            try:
+                planned = plan_segments(ik, base, segs, q0)
+            except P.PathError as e:
+                why = str(e)
+            else:
+                over = [p.name for p in planned
+                        if p.kin is not None and not J.caps_ok(p.kin, TM.CARRY)]
+                why = f"caps {over}" if over else (accept(planned) if accept else [])
+            if not why:
+                return planned, tried
+            tried.append({"hub": hub, "q0": q0.tolist(), "why": why})
+    raise P.PathError(f"{src.key} -> {dst.key}: no start branch works: {tried}")
+
+
+def free_geo(Q6, step: float = FREE_CHECK_STEP) -> np.ndarray:
+    """Samples of a joint path no more than *step* apart on any joint."""
+    Q6 = np.asarray(Q6, dtype=float)
+    out = [Q6[0]]
+    for a, b in zip(Q6[:-1], Q6[1:]):
+        n = max(1, math.ceil(float(np.abs(b - a).max()) / step))
+        out += [a + (b - a) * k / n for k in range(1, n + 1)]
+    return np.array(out)
+
+
+def scenario(slots, which: str) -> list:
+    """``[(src_key, dst_key), ...]`` for a run.
+
+    ``first``: the first incoming tray to the table and on to a middle
+    outgoing slot. ``all``: every incoming tray via the table to the first twelve
+    outgoing slots, those on to the other twelve, and those back to the
+    incoming rack, so every slot is grasped from and released into.
+    """
+    inc = [s.key for s in slots if s.role == "incoming"]
+    out = [s.key for s in slots if s.role == "outgoing"]
+    table = next(s.key for s in slots if s.role == "inspection")
+    if which == "first":
+        legs = [(inc[0], out[len(out) // 3])]
+    elif which == "all":
+        a, b = out[: len(inc)], out[len(inc): 2 * len(inc)]
+        legs = list(zip(inc, a)) + list(zip(a, b)) + list(zip(b, inc))
+    else:
+        raise ValueError(f"unknown scenario {which!r}")
+    return [m for s, d in legs for m in ((s, table), (table, d))]
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Program host: cuRobo
+# ─────────────────────────────────────────────────────────────────────────────
+def world_boxes(cfg, occupied, slots) -> list:
+    return S.cell_boxes(cfg, empty=[s.key for s in slots if s.key not in occupied], slots=slots)
+
+
+class Checker:
+    """M3's exact mesh check of every planned sample (D28 margins)."""
+
+    def __init__(self, cfg, slots):
+        base = cfg.robot.base_pose
+        self.cfg, self.slots, self.base = cfg, slots, base
+        self.cus = {A.JAW_Q_OPEN: CC.Curobo(base, jaw=A.JAW_Q_OPEN),
+                    A.JAW_Q_FIT: CC.Curobo(base, jaw=A.JAW_Q_FIT),
+                    "no_jaws": CC.Curobo(base, jaws=False)}
+
+    def _hits(self, mesh, boxes, qs, margin):
+        if not boxes:
+            return []
+        cu = self.cus[mesh]
+        cu.load(boxes)
+        hit, links = cu.mesh_hits(qs, margin)
+        return [(i, links[i]) for i in range(len(qs)) if hit[i]]
+
+    def check(self, p: Planned, ik) -> list:
+        """Problems with *p*, each ``"name: what"``; empty when clear."""
+        key = p.seg.target if p.seg is not None else None
+        boxes = world_boxes(self.cfg, p.occupied, self.slots)
+        grouped = CC.groups(boxes, key or "-")
+        rest = [b for g, bs in grouped.items() if g not in CC.TARGETS for b in bs]
+        qs = list(p.geo)
+        out = []
+        for jaw in sorted(set(p.jaws)):
+            for what, mesh, bs, m in (("rest", jaw, rest, CC.MARGIN),
+                                      ("target jig", jaw, grouped.get("target/jig", []), 0.0),
+                                      ("target tray", "no_jaws", grouped.get("target/tray", []), 0.0)):
+                for i, link in self._hits(mesh, bs, qs, m)[:1]:
+                    out.append(f"{p.name}: {link} hits {what} at sample {i}/{len(qs)} jaw {jaw:.4f}")
+            self.cus[jaw].load(rest)
+            _, self_d = self.cus[jaw].sphere_costs(qs)
+            if float(np.max(self_d)) > 0.0:
+                out.append(f"{p.name}: self collision {float(np.max(self_d)):.4f}")
+        if p.seg is not None and p.seg.carried and p.seg.kind != "jaw":
+            out += self._carried(p, ik, boxes, key)
+        return out
+
+    def _carried(self, p, ik, boxes, key) -> list:
+        centres = np.array([b.T[:3, 3] for b in boxes])
+        radii = np.array([np.linalg.norm(b.size) / 2.0 for b in boxes])
+        worst_t, worst_r, at = math.inf, math.inf, None
+        for i, q in enumerate(p.geo):
+            tray = S.carried_tray_box(P.fk_world(ik, q, self.base))
+            near = np.linalg.norm(centres - tray.T[:3, 3], axis=1) - radii \
+                - np.linalg.norm(tray.size) / 2.0 < 2 * CC.MARGIN
+            c = CC.carried_clearance(tray, [b for b, n in zip(boxes, near) if n], key or "-")
+            if not p.seg.lifting:
+                worst_t = min(worst_t, c["target"])
+            if c["rest"] < worst_r:
+                worst_r, at = c["rest"], (i, c["nearest"])
+        out = []
+        if worst_t < 0.0:
+            out.append(f"{p.name}: carried tray into its jig by {-worst_t * 1e3:.1f} mm")
+        if worst_r < CC.MARGIN:
+            out.append(f"{p.name}: carried tray {worst_r * 1e3:.1f} mm from {at[1]} at sample {at[0]}")
+        return out
+
+
+class FreePlanner:
+    """cuRobo's collision-free joint moves, empty gripper with the jaws open."""
+
+    def __init__(self, cfg, slots):
+        import torch
+        from curobo.config_io import load_yaml
+        from curobo.motion_planner import MotionPlanner, MotionPlannerCfg
+        from curobo.types import DeviceCfg, JointState
+        from curobo._src.types.robot import RobotCfg
+        from curobo._src.robot.kinematics.kinematics import Kinematics
+        from curobo._src.geom.types import SceneCfg
+
+        self.torch, self.JointState, self.SceneCfg = torch, JointState, SceneCfg
+        self.cfg, self.slots, self.base = cfg, slots, cfg.robot.base_pose
+        self.dev = DeviceCfg()
+        robot = load_yaml(CC.ROBOT_YML)
+        k = robot["robot_cfg"]["kinematics"] if "robot_cfg" in robot else robot["kinematics"]
+        k["collision_sphere_buffer"] = {n: (0.0 if n in ("link_0", "link_1", "attached_object") else 0.005)
+                                        for n in k["collision_sphere_buffer"]}
+        world = self._scene(frozenset(s.key for s in slots))
+        self.mp = MotionPlanner(MotionPlannerCfg.create(robot=robot, scene_model=world,
+                                                        collision_cache={"cuboid": CC.MAX_CUBOIDS},
+                                                        use_cuda_graph=False))
+        grip = Kinematics(RobotCfg.create(CC.gripper_cfg(load_yaml(CC.GRIPPER_YML), True), self.dev).kinematics,
+                          compute_link_transforms=True)
+        js = torch.full((1, len(grip.joint_names)), A.JAW_Q_OPEN, **self.dev.as_torch_dict())
+        st = grip.compute_kinematics(JointState.from_position(js, joint_names=grip.joint_names))
+        self.mp.kinematics.config.kinematics_config.update_link_spheres(
+            "gripper", st.robot_spheres.squeeze(0).squeeze(0))
+        self.mp.warmup(enable_graph=False)
+
+    def _scene(self, occupied):
+        boxes = [b for b in world_boxes(self.cfg, occupied, self.slots) if b.name != "mount/plate"]
+        return S.to_curobo_scene(boxes, self.base)
+
+    def plan(self, q0, q1, occupied) -> Planned:
+        self.mp.update_world(self.SceneCfg.create(self._scene(frozenset(occupied))))
+        tt = lambda q: self.JointState.from_position(  # noqa: E731
+            self.torch.as_tensor(np.asarray(q, dtype=np.float32)[None, :], **self.dev.as_torch_dict()),
+            joint_names=self.mp.joint_names)
+        res = self.mp.plan_cspace(tt(q1), tt(q0))
+        if res is None or not bool(res.success.reshape(-1)[0]):
+            raise P.PathError(f"cuRobo found no free move {np.round(q0, 3).tolist()} -> "
+                              f"{np.round(q1, 3).tolist()}")
+        ip = res.interpolated_trajectory
+        last = int(res.interpolated_last_tstep.reshape(-1)[0])
+        Q6 = ip.position.reshape(-1, 6)[: last + 1].cpu().numpy().astype(float)
+        Q6[0], Q6[-1] = q0, q1
+        t = np.arange(len(Q6)) * float(ip.dt.reshape(-1)[0] if hasattr(ip.dt, "reshape") else ip.dt)
+        t = t * TM.joint_retime(t, Q6, TM.JOINT_V, TM.JOINT_A)
+        t, Q6 = TM.resample(t, Q6, P.DT)
+        return Planned("free", None, t, P.with_jaws(Q6, A.JAW_Q_OPEN), free_geo(Q6),
+                       (A.JAW_Q_OPEN, A.JAW_Q_OPEN), frozenset(occupied))
