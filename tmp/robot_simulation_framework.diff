diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/shared/cell_core/presets/strict.yaml" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/shared/cell_core/presets/strict.yaml"
