+"""The locating render's plan: which reads, and where the camera goes for each.
+
+The camera matrix is checked through pxr's own ``GfCamera`` frustum rather than
+by reading the matrix back, so a transposed or mis-flipped matrix fails here
+instead of producing 74 images of the wrong wall.
+"""
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "locating"))
+
+import render_locating as R  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import sequence as S  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def cfg():
+    return C.load_preset("strict")
+
+
+def test_every_slot_is_read_far_then_near(cfg):
+    plan = R.read_plan(cfg)
+    slots = G.enumerate_slots(cfg)
+    assert [(r["slot"], r["read"]) for r in plan] == [
+        (s, read) for s in slots for read in ("far", "near")]
+    ids = G.grid_ids(cfg)
+    for r in plan:
+        standoff = cfg.standoff_far if r["read"] == "far" else cfg.standoff_near
+        assert r["standoff"] == standoff
+        assert r["grid_id"] == ids[r["slot"].key]
+        assert r["camera_T"] == pytest.approx(
+            S.eih_camera_pose(S.sighting_pose(r["slot"], standoff)), abs=1e-12)
+    assert len({R.image_name(r) for r in plan}) == len(plan)
+
+
+def test_the_usd_camera_looks_where_the_optical_frame_does(cfg):
+    pytest.importorskip("pxr")
+    from pxr import Gf, Usd, UsdGeom
+    for r in R.read_plan(cfg)[::7]:
+        T = r["camera_T"]
+        stage = Usd.Stage.CreateInMemory()
+        cam = UsdGeom.Camera.Define(stage, R.CAM_PATH)
+        cam.AddTransformOp().Set(Gf.Matrix4d(R.usd_camera_matrix(T)))
+        frustum = cam.GetCamera(Usd.TimeCode.Default()).frustum
+        assert np.array(frustum.GetPosition()) == pytest.approx(T[:3, 3], abs=1e-9)
+        assert np.array(frustum.ComputeViewDirection()) == pytest.approx(T[:3, 2], abs=1e-9)
+        assert np.array(frustum.ComputeUpVector()) == pytest.approx(-T[:3, 1], abs=1e-9)
+
+
+def test_nothing_falls_while_the_frames_render():
+    """The built stage makes racks, table and trays dynamic rigid bodies, and
+    Replicator's step runs the timeline: in the first full render (M4 task 6)
+    they fell during the run and 67 of 74 frames no longer showed the label
+    truth.json had read from the static attributes. The render freezes every
+    rigid body, in the session layer so the built file is never edited."""
+    pytest.importorskip("pxr")
+    from pxr import Usd, UsdGeom, UsdPhysics
+    stage = Usd.Stage.CreateInMemory()
+    paths = ["/Environment/RightRack", "/Environment/Tray_0_0", "/Environment/Table/TableTop"]
+    for p in paths:
+        UsdPhysics.RigidBodyAPI.Apply(UsdGeom.Xform.Define(stage, p).GetPrim())
+    UsdGeom.Xform.Define(stage, "/Environment/Static")
+    root_before = stage.GetRootLayer().ExportToString()
+
+    frozen = R.freeze_rigid_bodies(stage)
+
+    assert sorted(frozen) == sorted(paths)
+    for p in paths:
+        assert UsdPhysics.RigidBodyAPI(stage.GetPrimAtPath(p)).GetRigidBodyEnabledAttr().Get() is False
+    assert stage.GetRootLayer().ExportToString() == root_before
+
+
+def test_the_renderer_neither_upscales_nor_tone_maps_the_label():
+    """Isaac's defaults, DLSS (aa/op 3) and ACES (tonemap/op 6), shrink each
+    black tag 0.5-0.9 px per edge: +0.2 % depth on every read and a +0.5 deg
+    far-pitch bias (findings/05 §4-5). aa/op 0 alone is silently put back to
+    DLSS unless SimulationApp's anti_aliasing is 0 and limitedOps is off."""
+    assert R.LAUNCH_CONFIG["anti_aliasing"] == 0
+    assert R.RTX_SETTINGS["/rtx/post/aa/op"] == 0
+    assert R.RTX_SETTINGS["/rtx-transient/post/aa/limitedOps"] is False
+    assert R.RTX_SETTINGS["/rtx/post/tonemap/op"] == 1
+
+
+def test_a_setting_the_renderer_did_not_keep_is_reported():
+    wanted = {"/rtx/post/aa/op": 0, "/rtx/post/tonemap/op": 1}
+    kept = {"/rtx/post/aa/op": 0, "/rtx/post/tonemap/op": 1}.get
+    reverted = {"/rtx/post/aa/op": 3, "/rtx/post/tonemap/op": 1}.get
+
+    assert R.settings_drift(wanted, kept) == []
+    assert R.settings_drift(wanted, reverted) == [("/rtx/post/aa/op", 0, 3)]
+
+
+@pytest.mark.parametrize("srgb, linear", [(0, 0), (10, 1), (128, 55), (188, 128), (255, 255)])
+def test_the_detector_gets_linear_light(srgb, linear):
+    """The renderer writes sRGB-encoded values; the detector gets linear light,
+    as from a linear machine-vision camera. Anchors: sRGB 128 is 21.6 %
+    linear, sRGB 188 is 50 %, and the low end is the linear segment."""
+    rgb = np.full((2, 3, 3), srgb, dtype=np.uint8)
+    grey = R.detector_grey(rgb)
+    assert grey.dtype == np.uint8 and grey.shape == (2, 3)
+    assert (grey == linear).all()
+
+
+def test_colour_is_decoded_before_it_is_mixed_to_grey():
+    rgb = np.zeros((1, 1, 3), dtype=np.uint8)
+    rgb[..., 0] = 255                               # pure red: luma weight 0.299
+    assert R.detector_grey(rgb)[0, 0] == 76         # 0.299 * 255, not decode(76) = 18
