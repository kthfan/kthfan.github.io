+"""Tiny mutation runner: apply each (old -> new) to a file, run tests, restore.
+
+    python mutate.py <file> <pytest target> <mutants.json>
+
+mutants.json: [[old, new], ...]. Each old must occur exactly once. A mutant is
+"killed" when the tests fail.
+"""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+path, target, spec = Path(sys.argv[1]), sys.argv[2], json.loads(Path(sys.argv[3]).read_text())
+orig = path.read_text(encoding="utf-8")
+killed = 0
+try:
+    for old, new in spec:
+        if orig.count(old) != 1:
+            print(f"SKIP (found {orig.count(old)}x): {old!r}")
+            continue
+        path.write_text(orig.replace(old, new), encoding="utf-8")
+        r = subprocess.run([sys.executable, "-m", "pytest", target, "-q", "-x", "--import-mode=importlib",
+                            "-p", "no:cacheprovider"], capture_output=True, text=True)
+        ok = r.returncode != 0
+        killed += ok
+        print(("killed  " if ok else "SURVIVED") + f": {old!r} -> {new!r}")
+finally:
+    path.write_text(orig, encoding="utf-8")
+print(f"{killed}/{len(spec)} killed")
