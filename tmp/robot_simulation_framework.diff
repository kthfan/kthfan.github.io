++            continue
++        b = min(blobs, key=lambda bl: min(np.hypot(bl[0][0] - p[0], bl[0][1] - p[1]) for p in (cal, ctr)))[0]
++        rows.append({"pt": [x, y], "blob": [round(b[0], 2), round(b[1], 2)],
++                     "d_cal": [round(b[0] - cal[0], 2), round(b[1] - cal[1], 2)],
++                     "d_centre": [round(b[0] - ctr[0], 2), round(b[1] - ctr[1], 2)]})
++    report["points"] = rows
++    for r in rows:
++        print("[probe]", json.dumps(r), flush=True)
++
++with open(os.path.join(out, "report.json"), "w") as f:
++    json.dump(report, f, indent=1, default=str)
++print("[probe] summary", json.dumps({k: v for k, v in report.items() if k not in ("points",)}, default=str),
++      flush=True)
++print(f"[probe] done {time.time() - t0:.1f}s", flush=True)
++app.close()
