+#!/usr/bin/env python3
+"""Vendor ``shared/cell_core`` into the consumer repos, with drift detection.
+
+Why vendoring (D8): the deployment hosts are air-gapped and ``isaacsim/`` and
+``program/`` are independent git repos. There is no package registry to publish
+to and no submodule that would survive an offline checkout, so each repo carries
+a copy. The risk that creates is that someone edits the copy, and the two repos
+quietly diverge. A SHA-256 manifest travels with each copy and a unit test in
+each repo fails if it stops matching, which converts a silent divergence into a
+loud one.
+
+Usage::
+
+    python tools/sync_shared.py                  # sync into every consumer repo
+    python tools/sync_shared.py --check          # report drift, change nothing
+    python tools/sync_shared.py --dest path/to   # sync into one place
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import shutil
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+SOURCE = REPO_ROOT / "shared" / "cell_core"
+
+#: Repos that carry a vendored copy. Each gets ``<repo>/vendor/cell_core``.
+CONSUMERS = ("isaacsim", "program")
+
+MANIFEST_NAME = "MANIFEST.sha256"
+EXCLUDE_DIRS = {"__pycache__", ".pytest_cache", ".git"}
+EXCLUDE_SUFFIXES = {".pyc", ".pyo"}
+
+
+@dataclass(frozen=True)
+class Drift:
+    """One discrepancy between a vendored file and its manifest entry."""
+
+    path: str
+    kind: str  #: "modified" | "missing" | "untracked"
+
+    def __str__(self) -> str:
+        return f"{self.kind:>9}  {self.path}"
+
+
+def _tracked_files(root: Path):
+    for path in sorted(root.rglob("*")):
+        if not path.is_file():
+            continue
+        if path.name == MANIFEST_NAME or path.suffix in EXCLUDE_SUFFIXES:
+            continue
+        rel = path.relative_to(root)
+        if EXCLUDE_DIRS.intersection(rel.parts):
+            continue
+        yield rel, path
+
+
+def _sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def manifest(root: Path) -> dict:
+    """Map POSIX-style relative path -> SHA-256 of the file content.
+
+    Paths are normalised to forward slashes so a manifest written on Windows
+    verifies on Linux, which is the whole point of the exercise here.
+    """
+    return {rel.as_posix(): _sha256(path) for rel, path in _tracked_files(Path(root))}
+
+
+def manifests_match(a: dict, b: dict) -> bool:
+    return a == b
+
+
+def write_manifest(root: Path) -> dict:
+    entries = manifest(root)
+    lines = [f"{digest}  {path}" for path, digest in sorted(entries.items())]
+    header = (
+        "# Generated by tools/sync_shared.py. Do not edit, and do not edit the\n"
+        "# files it covers: this copy is vendored from shared/cell_core, and a\n"
+        "# unit test fails if it drifts. Change the source and re-run the sync.\n"
+    )
+    (Path(root) / MANIFEST_NAME).write_text(
+        header + "\n".join(lines) + "\n", encoding="utf-8")
+    return entries
+
+
+def read_manifest(root: Path) -> dict:
+    path = Path(root) / MANIFEST_NAME
+    if not path.is_file():
+        raise FileNotFoundError(f"no {MANIFEST_NAME} in {root}; has it been synced?")
+    entries = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        digest, _, rel = line.partition("  ")
+        entries[rel] = digest
+    return entries
+
+
+def sync(source, dest) -> dict:
+    """Mirror *source* into *dest* and write a manifest. Returns the manifest.
+
+    The destination is mirrored, not merged: files deleted from the source are
+    deleted from the copy. A stale module left behind would still be importable,
+    which is exactly the kind of quiet inconsistency this is meant to prevent.
+    """
+    source, dest = Path(source), Path(dest)
+    if not source.is_dir():
+        raise FileNotFoundError(f"source does not exist: {source}")
+    dest.mkdir(parents=True, exist_ok=True)
+
+    wanted = set()
+    for rel, path in _tracked_files(source):
+        target = dest / rel
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(path, target)
+        wanted.add(rel.as_posix())
+
+    for rel, path in list(_tracked_files(dest)):
+        if rel.as_posix() not in wanted:
+            path.unlink()
+    for directory in sorted((p for p in dest.rglob("*") if p.is_dir()), reverse=True):
+        if directory.name in EXCLUDE_DIRS or not any(directory.iterdir()):
+            shutil.rmtree(directory, ignore_errors=True)
+
+    return write_manifest(dest)
+
+
+def verify(dest) -> list:
+    """Report every difference between *dest* and the manifest shipped in it."""
+    dest = Path(dest)
+    recorded = read_manifest(dest)
+    actual = manifest(dest)
+    drift = []
+    for path, digest in sorted(recorded.items()):
+        if path not in actual:
+            drift.append(Drift(path, "missing"))
+        elif actual[path] != digest:
+            drift.append(Drift(path, "modified"))
+    for path in sorted(set(actual) - set(recorded)):
+        drift.append(Drift(path, "untracked"))
+    return drift
+
+
+def is_current(source, dest) -> bool:
+    """Whether the vendored copy matches the current source."""
+    try:
+        return manifests_match(manifest(source), read_manifest(dest))
+    except FileNotFoundError:
+        return False
+
+
+def _dest_for(repo: str) -> Path:
+    return REPO_ROOT / repo / "vendor" / "cell_core"
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--dest", type=Path, action="append",
+                    help="vendor directory (repeatable); defaults to every consumer")
+    ap.add_argument("--check", action="store_true",
+                    help="report drift and exit non-zero; change nothing")
+    args = ap.parse_args(argv)
+
+    dests = args.dest or [_dest_for(r) for r in CONSUMERS]
+    failed = False
+
+    for dest in dests:
+        if args.check:
+            if not dest.exists():
+                print(f"MISSING   {dest} has never been synced")
+                failed = True
+                continue
+            drift = verify(dest)
+            stale = not is_current(SOURCE, dest)
+            if drift:
+                print(f"DRIFT     {dest}")
+                for d in drift:
+                    print(f"          {d}")
+                failed = True
+            elif stale:
+                print(f"STALE     {dest} is behind shared/cell_core")
+                failed = True
+            else:
+                print(f"ok        {dest}")
+        else:
+            entries = sync(SOURCE, dest)
+            print(f"synced    {len(entries)} files -> {dest}")
+
+    if failed:
+        print("\nRun 'python tools/sync_shared.py' to refresh the vendored copies.")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
