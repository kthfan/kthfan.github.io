index 0000000..0b7645b
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/program/motion/judge.py"
@@ -0,0 +1,159 @@
+"""M6: judging one transfer from the cell's reports (D30 pass criteria). Pure.
+
+1. placement within ``SEAT_MM`` / ``SEAT_DEG`` of the seated pose;
+2. slip of the tray on the plate within ``SLIP_MM`` while carried;
+3. no robot contact with racks, jigs, the table or any tray but the carried
+   one (the carried tray may touch the jaws and plate);
+4. flange within ``TRACK_MM`` of the plan inside the jigs;
+5. the carried tray within the D14 caps.
+"""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+from timing import CARRY as _CARRY
+
+SEAT_MM = 2.0
+SEAT_DEG = 1.0
+SLIP_MM = 5.0
+TRACK_MM = 1.0
+#: Robot bodies that sit on the pedestal and may touch it.
+BASE_LINKS = ("base", "link_0", "link_1")
+
+
+def quat_pose(p, wxyz) -> np.ndarray:
+    """4x4 pose from a position and a ``[w, x, y, z]`` quaternion."""
+    w, x, y, z = (float(v) for v in wxyz)
+    n = math.sqrt(w * w + x * x + y * y + z * z)
+    w, x, y, z = w / n, x / n, y / n, z / n
+    T = np.eye(4)
+    T[:3, :3] = [[1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
+                 [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
+                 [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)]]
+    T[:3, 3] = p
+    return T
+
+
+def pose_error(a, b):
+    """``(mm, deg)`` between two 4x4 poses."""
+    a, b = np.asarray(a, dtype=float), np.asarray(b, dtype=float)
+    dp = float(np.linalg.norm(a[:3, 3] - b[:3, 3]))
+    c = max(-1.0, min(1.0, (np.trace(a[:3, :3].T @ b[:3, :3]) - 1.0) / 2.0))
+    return dp * 1e3, math.degrees(math.acos(c))
+
+
+def tracking(planned, actual) -> dict:
+    """Worst flange error over matched samples, ``(n, 4, 4)`` each."""
+    errs = [pose_error(p, a) for p, a in zip(planned, actual)]
+    return {"mm": max(e[0] for e in errs), "deg": max(e[1] for e in errs),
+            "ok": max(e[0] for e in errs) <= TRACK_MM}
+
+
+def _under(path: str, prefix: str) -> bool:
+    return path == prefix or path.startswith(prefix.rstrip("/") + "/")
+
+
+def _link(path: str, robot: str) -> str:
+    return path[len(robot):].strip("/").split("/")[0]
+
+
+def bad_contacts(contacts, robot: str, base: str, carried) -> list:
+    """Robot contacts that break criterion 3.
+
+    *robot* and *base* are the prim path prefixes of the arm and its pedestal;
+    *carried* is the tray prim allowed to touch the gripper (or None).
+    """
+    out = []
+    for c in contacts:
+        a0, a1 = c["a0"], c["a1"]
+        r0, r1 = _under(a0, robot), _under(a1, robot)
+        if not (r0 or r1) or (r0 and r1):
+            continue
+        link, other = (a0, a1) if r0 else (a1, a0)
+        if carried is not None and other == carried:
+            continue
+        if _under(other, base) and _link(link, robot) in BASE_LINKS:
+            continue
+        out.append(c)
+    return out
+
+
+def seated_pose(tray_box_T, offset) -> np.ndarray:
+    """Where a tray's prim sits when seated: the cell_core tray box and the
+    prim's measured offset from it."""
+    return np.asarray(tray_box_T, dtype=float) @ np.asarray(offset, dtype=float)
+
+
+def slip_mm(ref, boxes) -> float:
+    """Farthest the tray can have moved on the plate from *ref*.
+
+    *boxes* are ``(min, max)`` corners of where the tray sat in the flange
+    frame during each carried segment; the farthest corner bounds the slip.
+    """
+    ref = np.asarray(ref, dtype=float)
+    worst = 0.0
+    for lo, hi in boxes:
+        lo, hi = np.asarray(lo, dtype=float), np.asarray(hi, dtype=float)
+        d = np.maximum(np.abs(lo - ref), np.abs(hi - ref))
+        worst = max(worst, float(np.linalg.norm(d)))
+    return worst * 1e3
+
+
+def caps_ok(kin: dict, caps) -> bool:
+    """Peak kinematics of the carried tray within *caps*."""
+    return (kin["v"] <= caps.v * 1.01 and kin["a"] <= caps.a * 1.01
+            and kin.get("w", 0.0) <= caps.w * 1.01
+            and kin.get("alpha", 0.0) <= caps.alpha * 1.01
+            and kin.get("a_down", 0.0) <= caps.a_down * 1.01)
+
+
+def verdict(seat, slip, contacts, track, kin_ok) -> dict:
+    """One transfer: *seat* ``(mm, deg)``, *slip* mm, offending *contacts*,
+    *track* worst tracking mm, *kin_ok* every carried segment within caps."""
+    checks = {
+        "placement": seat[0] <= SEAT_MM and seat[1] <= SEAT_DEG,
+        "slip": slip <= SLIP_MM,
+        "contacts": not contacts,
+        "tracking": track <= TRACK_MM,
+        "caps": bool(kin_ok),
+    }
+    return {"ok": all(checks.values()), "checks": checks,
+            "seat_mm": seat[0], "seat_deg": seat[1], "slip_mm": slip,
+            "track_mm": track, "contacts": list(contacts)}
+
+
+def assess(runs, carried: str, seat_T, robot: str, base: str) -> dict:
+    """The :func:`verdict` of one transfer from its executed segments, in order.
+
+    Each run: ``name``, ``kind``, ``carried``, ``lifting``, ``track``, ``kin``
+    (planned peak kinematics or None), ``planned`` (commanded flange poses at
+    the report's sample times) and ``report`` (the cell's ``done`` status).
+    Slip is measured from where the tray sits on the plate at the end of
+    ``lift``; a carried segment in which the tray did not move with the
+    flange is a dropped tray.
+    """
+    contacts = [c for r in runs for c in r["report"]["contacts"]]
+    lift = next(r for r in runs if r["name"] == "lift")["report"]["trays"].get(carried)
+    slip = math.inf
+    if lift is not None:
+        boxes = []
+        for r in runs:
+            if not r["carried"] or r["lifting"] or r["kind"] == "jaw":
+                continue
+            t = r["report"]["trays"].get(carried)
+            if t is None:
+                boxes = None
+                break
+            boxes.append((t["rel_min"], t["rel_max"]))
+        if boxes is not None:
+            slip = slip_mm(lift["rel_end"], boxes)
+    track = 0.0
+    for r in runs:
+        if r["track"] and r["planned"]:
+            actual = [s["flange"] for s in r["report"]["samples"]]
+            track = max(track, tracking(r["planned"], actual)["mm"])
+    kin_ok = all(caps_ok(r["kin"], _CARRY) for r in runs if r["kin"] is not None)
+    seat = pose_error(runs[-1]["report"]["poses"][carried], seat_T)
+    return verdict(seat, slip, bad_contacts(contacts, robot, base, carried), track, kin_ok)
