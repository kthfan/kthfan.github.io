index 0000000..a381b4b
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/render_variant.py"
@@ -0,0 +1,87 @@
+"""Depth-bias experiment: render_locating with RTX settings overridden.
+
+    <isaac>/python.sh render_variant.py --locating <dir with render_locating.py> \\
+        [--config anti_aliasing=0 ...] [--set /rtx/post/aa/op=0 ...] -- --stage ... --preset strict --out ... --only L1_C2
+
+--config entries are merged into the SimulationApp launch config (Isaac re-applies
+anti_aliasing from it every frame, so --set alone cannot turn DLSS off).
+Prints the watched settings as the app starts and re-applies every --set on
+each app.update(), so a stage open cannot quietly restore a default. Production
+code is untouched: SimulationApp is subclassed before render_locating imports it.
+"""
+import json
+import sys
+
+WATCH = ("/rtx/rendermode", "/rtx/post/aa/op", "/rtx/post/dlss/execMode",
+         "/rtx/post/tonemap/op", "/rtx/post/histogram/enabled", "/rtx/post/tonemap/filmIso",
+         "/rtx/post/tonemap/cm2Factor", "/rtx/post/tonemap/whiteScale",
+         "/rtx/post/tonemap/enableSrgbToGamma", "/rtx/post/sharpen/enabled",
+         "/rtx/post/dlss/sharpness", "/rtx/resetPtAccumOnAnimTimeChange",
+         "/rtx-transient/post/aa/limitedOps")
+
+
+def _value(text):
+    try:
+        return json.loads(text)
+    except ValueError:
+        return text
+
+
+def main():
+    argv = sys.argv[1:]
+    cut = argv.index("--")
+    own, rest = argv[:cut], argv[cut + 1:]
+    sets, config, locating = [], {}, None
+    while own:
+        flag, val = own.pop(0), own.pop(0)
+        if flag == "--locating":
+            locating = val
+        elif flag == "--set":
+            k, v = val.split("=", 1)
+            sets.append((k, _value(v)))
+        elif flag == "--config":
+            k, v = val.split("=", 1)
+            config[k] = _value(v)
+        else:
+            raise SystemExit(f"unknown {flag}")
+    sys.path.insert(0, locating)
+
+    import isaacsim
+    base = isaacsim.SimulationApp
+
+    class App(base):
+        def __init__(self, launch_config=None, *a, **kw):
+            launch_config = {**(launch_config or {}), **config}
+            print(f"[variant] launch config {launch_config}", flush=True)
+            super().__init__(launch_config, *a, **kw)
+            import carb
+            self._s = carb.settings.get_settings()
+            for k in WATCH:
+                print(f"[variant] start {k} = {self._s.get(k)!r}", flush=True)
+            self._checked = False
+            self._apply()
+
+        def _apply(self):
+            for k, v in sets:
+                self._s.set(k, v)
+
+        def update(self):
+            if not self._checked:
+                drift = [(k, self._s.get(k)) for k, v in sets if self._s.get(k) != v]
+                if drift:
+                    print(f"[variant] re-applying {drift}", flush=True)
+            self._apply()
+            super().update()
+
+        def close(self, *a, **kw):
+            for k in WATCH:
+                print(f"[variant] end {k} = {self._s.get(k)!r}", flush=True)
+            return super().close(*a, **kw)
+
+    isaacsim.SimulationApp = App
+    import render_locating
+    render_locating.main(rest)
+
+
+if __name__ == "__main__":
+    main()
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/settle_check.py" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/settle_check.py"
