@@ -0,0 +1,203 @@
+"""Create a table (cuboid) with a tray jig on top, and save as USD."""
+
+from pxr import Usd, UsdGeom, UsdShade, UsdPhysics, Sdf, Gf, UsdSemantics, Vt
+import argparse
+import os
+import sys
+
+import cv2
+import numpy as np
+
+# Jig positioning constants (same as create_rack_shelf_with_tray_jig.py)
+JIG_X_HALF = 0.078
+JIG_Y_OFFSET = 0.135
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+if SCRIPT_DIR not in sys.path:
+    sys.path.insert(0, SCRIPT_DIR)
+
+import asset_paths
+
+# AprilGrid constants
+APRILGRID_MARKERS_X = 4
+APRILGRID_MARKERS_Y = 1
+APRILGRID_MARKER_LENGTH = 0.02
+APRILGRID_MARKER_SEPARATION = 0.0075
+APRILGRID_MARGIN = 0.005
+APRILGRID_DICT_FAMILY = cv2.aruco.DICT_APRILTAG_36h11
+APRILGRID_SCALE = 8000
+
+
+def generate_aprilgrid_image(grid_id, output_path):
+    """Generate an AprilGrid PNG image and save it to *output_path*."""
+    dictionary = cv2.aruco.getPredefinedDictionary(APRILGRID_DICT_FAMILY)
+
+    length_px = int(APRILGRID_SCALE * APRILGRID_MARKER_LENGTH)
+    sep_px = int(APRILGRID_SCALE * APRILGRID_MARKER_SEPARATION)
+    margin_px = int(APRILGRID_SCALE * APRILGRID_MARGIN)
+
+    img_w = APRILGRID_MARKERS_X * length_px + (APRILGRID_MARKERS_X - 1) * sep_px
+    img_h = APRILGRID_MARKERS_Y * length_px + (APRILGRID_MARKERS_Y - 1) * sep_px
+
+    marker_ids = (
+        np.arange(APRILGRID_MARKERS_X * APRILGRID_MARKERS_Y)
+        + grid_id * APRILGRID_MARKERS_X * APRILGRID_MARKERS_Y
+    )
+
+    board = cv2.aruco.GridBoard(
+        size=(APRILGRID_MARKERS_X, APRILGRID_MARKERS_Y),
+        markerLength=APRILGRID_MARKER_LENGTH,
+        markerSeparation=APRILGRID_MARKER_SEPARATION,
+        dictionary=dictionary,
+        ids=marker_ids,
+    )
+
+    img = board.generateImage(outSize=(img_w, img_h))
+
+    img_with_margin = 255 * np.ones(
+        (img_h + 2 * margin_px, img_w + 2 * margin_px), dtype=np.uint8
+    )
+    img_with_margin[margin_px:-margin_px, margin_px:-margin_px] = img
+
+    cv2.imwrite(output_path, img_with_margin)
+    return output_path
+
+
+def create_table_with_jig(
+    stage,
+    jig_usd_path=None,
+    root_path="/Table",
+    size_x=1.0,
+    size_y=0.36,
+    size_z=0.75,
+    jig_x=0.5,
+    jig_grid_id=None,
+    label_image_dir=None,
+    asset_root=None,
+):
+    """Build a table (cuboid) with a tray jig on top.
+
+    The table occupies (0, 0, 0) to (size_x, size_y, size_z).
+    A single tray jig is placed on top at the specified x position.
+
+    Parameters
+    ----------
+    stage : Usd.Stage
+    jig_usd_path : str
+        Path to the tray-jig USD asset.
+    root_path : str
+    size_x, size_y, size_z : float
+        Table dimensions.
+    jig_x : float
+        X position of the jig center on the table (in local frame).
+    jig_grid_id : int | None
+        AprilGrid grid-id for the jig label. If None, no label is applied.
+    label_image_dir : str | None
+        Directory for generated AprilGrid images.
+    asset_root : str or None
+        Directory holding the ``.usd`` assets; see ``asset_paths``.
+    """
+    if jig_usd_path is None:
+        jig_usd_path = asset_paths.asset(asset_paths.JIG_USD, asset_root)
+
+    # Root Xform
+    root_xform = UsdGeom.Xform.Define(stage, root_path)
+    root_prim = root_xform.GetPrim()
+    stage.SetDefaultPrim(root_prim)
+
+    # Table cuboid (Cube scaled to half-extents)
+    table_path = f"{root_path}/TableTop"
+    cube = UsdGeom.Cube.Define(stage, table_path)
+    UsdPhysics.CollisionAPI.Apply(cube.GetPrim())
+    UsdPhysics.RigidBodyAPI.Apply(cube.GetPrim())
+    UsdPhysics.MassAPI.Apply(cube.GetPrim()).GetMassAttr().Set(260 * size_x * size_y * size_z)
+    UsdSemantics.LabelsAPI.Apply(root_prim, "class").GetLabelsAttr().Set(Vt.TokenArray(["table"]))
+
+    xformable = UsdGeom.Xformable(cube)
+    xformable.AddTranslateOp().Set(
+        Gf.Vec3d(0, 0, size_z / 2.0)
+    )
+    xformable.AddScaleOp().Set(
+        Gf.Vec3f(size_x / 2.0, size_y / 2.0, size_z / 2.0)
+    )
+
+    # Tray jig on top
+    jig_usd_abs = os.path.abspath(jig_usd_path)
+    jig_y = size_y / 2 - JIG_Y_OFFSET
+    jig_z = size_z
+
+    jig_path = f"{root_path}/Jig"
+    jig_xform = UsdGeom.Xform.Define(stage, jig_path)
+    jig_prim = jig_xform.GetPrim()
+    jig_prim.GetReferences().AddReference(jig_usd_abs)
+
+    # Apply AprilGrid label if grid_id is provided
+    if jig_grid_id is not None:
+        if label_image_dir is None:
+            root_layer = stage.GetRootLayer()
+            label_image_dir = os.path.join(
+                os.path.dirname(root_layer.identifier), "label_images"
+            )
+        os.makedirs(label_image_dir, exist_ok=True)
+
+        img_path = os.path.join(label_image_dir, f"aprilgrid_{jig_grid_id}.png")
+        generate_aprilgrid_image(jig_grid_id, img_path)
+
+        shader_path = f"{jig_path}/label_base/Looks/OmniPBR/Shader"
+        shader = UsdShade.Shader.Get(stage, shader_path)
+        shader.CreateInput(
+            "diffuse_texture", Sdf.ValueTypeNames.Asset
+        ).Set(Sdf.AssetPath(os.path.abspath(img_path)))
+    else:
+        jig_prim.SetInstanceable(True)
+
+    xf_jig = UsdGeom.Xformable(jig_xform)
+    xf_jig.AddTranslateOp().Set(Gf.Vec3d(jig_x, jig_y, jig_z))
+
+    return root_xform
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Create a table with a tray jig and save as USD"
+    )
+    parser.add_argument(
+        "--output", "-o", type=str, default="table_with_jig.usd",
+        help="Output .usd file path",
+    )
+    parser.add_argument(
+        "--jig_usd", type=str, default=None,
+        help="Path to the tray-jig USD asset",
+    )
+    parser.add_argument("--size_x", type=float, default=1.0)
+    parser.add_argument("--size_y", type=float, default=0.36)
+    parser.add_argument("--size_z", type=float, default=0.75)
+    parser.add_argument("--jig_x", type=float, default=0.5)
+    parser.add_argument("--jig_grid_id", type=int, default=None)
+    parser.add_argument("--label_image_dir", type=str, default=None)
+    args = parser.parse_args()
+
+    if os.path.exists(args.output):
+        os.remove(args.output)
+
+    stage = Usd.Stage.CreateNew(args.output)
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+
+    create_table_with_jig(
+        stage,
+        jig_usd_path=args.jig_usd,
+        size_x=args.size_x,
+        size_y=args.size_y,
+        size_z=args.size_z,
+        jig_x=args.jig_x,
+        jig_grid_id=args.jig_grid_id,
+        label_image_dir=args.label_image_dir,
+    )
+
+    stage.GetRootLayer().Save()
+    print(f"Saved table with jig to {args.output}")
+
+
+if __name__ == "__main__":
+    main()
