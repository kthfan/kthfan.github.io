+"""Create the full rekep environment: robot arm, two rack shelves, and a table with jig.
+
+This module is designed to build geometry directly on the live USD stage (e.g. in
+Isaac Sim) without creating/saving a separate USD file.  When running standalone
+(``python create_environment.py``), it will create and save a USD file for inspection.
+"""
+
+from pxr import Usd, UsdGeom, UsdShade, UsdPhysics, Sdf, Gf
+import math
+import os
+import sys
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+if SCRIPT_DIR not in sys.path:
+    sys.path.insert(0, SCRIPT_DIR)
+
+from create_robot_arm_base import create_robot_arm_base
+from create_rack_shelf_with_tray_jig import (
+    create_rack_shelf_with_tray_jig,
+    JIG_X_HALF,
+    JIG_Y_OFFSET,
+    generate_aprilgrid_image,
+)
+from create_table_with_jig import create_table_with_jig
+import asset_paths
+
+
+def create_environment(
+    stage,
+    root_path="/Environment",
+    asset_root=None,
+    arm_usd_path=None,
+    jig_usd_path=None,
+    tray_usd_path=None,
+    table_height=0.7,
+    table_position=None,
+    table_jig_x=0.0,
+    table_jig_id=None,
+    right_rack_position=None,
+    right_rack_size=None,
+    right_rack_planes=None,
+    right_rack_ids=None,
+    right_rack_jig_mask=None,
+    right_rack_tray_mask=None,
+    left_rack_position=None,
+    left_rack_size=None,
+    left_rack_planes=None,
+    left_rack_ids=None,
+    left_rack_jig_mask=None,
+    left_rack_tray_mask=None,
+    jig_gap=0.015,
+    robot_leg_height=0.5,
+    label_image_dir=None,
+):
+    """Build the full rekep environment on the given USD *stage*.
+
+    This function builds all prims directly on the provided stage.  When used
+    inside Isaac Sim, pass the live stage obtained via
+    ``omni.usd.get_context().get_stage()`` so that geometry is created in-place
+    without needing to save/reload a USD file.
+
+    Layout (Z-up, robot at origin facing +Y):
+        - Robot arm base at origin
+        - Table in front (+Y), edge 0.3 m from robot base center
+        - Right rack shelf (+X side), edge 0.55 m from robot base center
+        - Left rack shelf (-X side), edge 0.55 m from robot base center
+
+    Parameters
+    ----------
+    stage : Usd.Stage
+    root_path : str
+    asset_root : str or None
+        Directory holding the ``.usd`` assets. ``None`` resolves it through
+        ``asset_paths`` (``CELL_ASSET_ROOT``, then the known layouts). Only
+        consulted for asset paths left as ``None``.
+    arm_usd_path : str
+    jig_usd_path : str
+    table_height : float
+        Height of the table cuboid.
+    table_position : tuple of float or None
+        (x, y, z) world position of the table center.
+        Defaults to ``(0.0, 0.85 + table_size_y/2, table_height/2)``.
+    table_jig_x : float
+        World-frame X position of the tray jig on the table.
+    table_jig_id : int or None
+        AprilGrid ID for the table jig label. None means no label.
+    right_rack_position : tuple of float or None
+        (x, y, z) world position of the right rack. Default: (1.185, -0.305, 0.0).
+    right_rack_size : tuple of float or None
+        (size_x, size_y, size_z) of the right rack. Default: (0.61, 0.36, 1.0).
+    right_rack_planes : list of float or None
+        Shelf plane heights for the right rack. Default: [0.55, 0.85].
+    right_rack_ids : list of list or None
+        AprilGrid ID matrix for the right rack jigs.
+    right_rack_jig_mask : list of list of bool or None
+    right_rack_tray_mask : list of list of bool or None
+        Boolean matrix controlling which jig slots on the right rack have a tray.
+    left_rack_position : tuple of float or None
+        (x, y, z) world position of the left rack. Default: (-1.185, 0.56, 0.0).
+    left_rack_size : tuple of float or None
+        (size_x, size_y, size_z) of the left rack. Default: (1.12, 0.36, 1.2).
+    left_rack_planes : list of float or None
+        Shelf plane heights for the left rack. Default: [0.25, 0.55, 0.85, 1.15].
+    left_rack_ids : list of list or None
+        AprilGrid ID matrix for the left rack jigs.
+    left_rack_jig_mask : list of list of bool or None
+        Boolean matrix controlling which jig slots exist on the left rack.
+    left_rack_tray_mask : list of list of bool or None
+        Boolean matrix controlling which jig slots on the left rack have a tray.
+    jig_gap: float
+    robot_leg_height: float
+    label_image_dir : str or None
+        Directory for generated AprilGrid images.
+
+    Returns
+    -------
+    UsdGeom.Xform – the root prim.
+    """
+
+    # ── Asset paths ───────────────────────────────────────────────────────
+    # Resolved before anything is built, so a missing or half-deployed asset
+    # root fails with a list of the directories tried rather than part-way
+    # through a stage.
+    if arm_usd_path is None:
+        arm_usd_path = asset_paths.asset(asset_paths.ARM_USD, asset_root)
+    if jig_usd_path is None:
+        jig_usd_path = asset_paths.asset(asset_paths.JIG_USD, asset_root)
+    if tray_usd_path is None:
+        tray_usd_path = asset_paths.asset(asset_paths.TRAY_USD, asset_root)
+
+    # ── Parameter defaults ────────────────────────────────────────────────
+    _table_size_y = 0.36
+    if table_position is None:
+        table_position = (0.0, 0.85 + _table_size_y / 2.0, 0)
+    if right_rack_position is None:
+        right_rack_position = (1.185, -0.305, 0.0)
+    if right_rack_size is None:
+        right_rack_size = (0.61, 0.36, 1.0)
+    if right_rack_planes is None:
+        right_rack_planes = [0.55, 0.85]
+    if right_rack_ids is None:
+        right_rack_ids = [[9, 10, 11], [6, 7, 8]]
+    if left_rack_position is None:
+        left_rack_position = (-1.185, 0.56, 0.0)
+    if left_rack_size is None:
+        left_rack_size = (1.12, 0.36, 1.2)
+    if left_rack_planes is None:
+        left_rack_planes = [0.25, 0.55, 0.85, 1.15]
+    if left_rack_ids is None:
+        left_rack_ids = [
+            [None, 24, 25, 26, 27, None],
+            [None, 20, 21, 22, 23, None],
+            [None, 16, 17, 18, 19, None],
+            [None, 12, 13, 14, 15, None],
+        ]
+    if left_rack_jig_mask is None:
+        left_rack_jig_mask = [
+            [False, True, True, True, True, False],
+            [False, True, True, True, True, False],
+            [False, True, True, True, True, False],
+            [False, True, True, True, True, False],
+        ]
+
+    # ── Resolve paths ────────────────────────────────────────────────────
+    arm_usd_path = os.path.abspath(arm_usd_path)
+    jig_usd_path = os.path.abspath(jig_usd_path)
+
+    if label_image_dir is None:
+        root_layer = stage.GetRootLayer()
+        layer_dir = os.path.dirname(root_layer.identifier)
+        if not layer_dir:
+            # Live stage (e.g. Isaac Sim) may have no file-backed root layer
+            layer_dir = SCRIPT_DIR
+        label_image_dir = os.path.join(layer_dir, "label_images")
+
+    # ── Environment root ─────────────────────────────────────────────────
+    env_xform = UsdGeom.Xform.Define(stage, root_path)
+
+    # ── Robot arm base ───────────────────────────────────────────────────
+    robot_path = f"{root_path}/RobotArmBase"
+    create_robot_arm_base(
+        stage,
+        arm_usd_path=arm_usd_path,
+        root_path=robot_path,
+        leg_height=robot_leg_height,
+    )
+
+    robot_xformable = UsdGeom.Xformable(
+        stage.GetPrimAtPath(robot_path)
+    )
+
+    robot_xformable.AddRotateZOp(
+        opSuffix="facing"
+    ).Set(180.0)
+
+    # ── Right rack shelf ─────────────────────────────────────────────────
+    # Size: 0.61 x 0.36 x 1.0, 2 planes at [0.55, 0.85], 3 jigs/plane
+    # IDs: [[9,10,11],[6,7,8]]
+    right_rack_path = f"{root_path}/RightRack"
+   
+    create_rack_shelf_with_tray_jig(
+        stage,
+        jig_usd_path=jig_usd_path,
+        root_path=right_rack_path,
+        size_x=right_rack_size[0],
+        size_y=right_rack_size[1],
+        size_z=right_rack_size[2],
+        plane_height_list=right_rack_planes,
+        jig_gap=jig_gap,
+        jig_mask=right_rack_jig_mask,
+        ids=right_rack_ids,
+        label_image_dir=label_image_dir,
+        tray_usd_path=tray_usd_path,
+        tray_mask=right_rack_tray_mask,
+        tray_root_path=root_path,
+        rack_position=right_rack_position,
+        rack_rotation=[0.70710678, 0, 0, 0.70710678],
+    )
+
+    # Position right rack: front edge at x=+0.55, center Y=0
+    # Rotation -90° about Z: local (x,y) → (y, -x)
+    #   Front (local y=0) maps to global x=0; back (y=0.36) maps to x=0.36
+    # Translate so front face is at x=0.55, center Y=0
+    right_xformable = UsdGeom.Xformable(
+        stage.GetPrimAtPath(right_rack_path)
+    )
+    right_xformable.AddTranslateOp(
+        opSuffix="position"
+    ).Set(Gf.Vec3d(*right_rack_position))
+    right_xformable.AddOrientOp().Set(Gf.Quatf(0.70710678, 0, 0, 0.70710678))
+
+    # ── Left rack shelf ──────────────────────────────────────────────────
+    # Size: 1.12 x 0.36 x 1.12, 4 planes at [0.25, 0.55, 0.85, 1.15]
+    # 6 columns max, remove edge columns (0 and 5) → 4 jigs/plane
+    left_rack_path = f"{root_path}/LeftRack"
+
+    create_rack_shelf_with_tray_jig(
+        stage,
+        jig_usd_path=jig_usd_path,
+        root_path=left_rack_path,
+        size_x=left_rack_size[0],
+        size_y=left_rack_size[1],
+        size_z=left_rack_size[2],
+        plane_height_list=left_rack_planes,
+        jig_gap=jig_gap,
+        jig_mask=left_rack_jig_mask,
+        ids=left_rack_ids,
+        label_image_dir=label_image_dir,
+        tray_usd_path=tray_usd_path,
+        tray_mask=left_rack_tray_mask,
+        tray_root_path=root_path,
+        rack_position=left_rack_position,
+        rack_rotation=[0.70710678, 0, 0, -0.70710678],
+    )
+
+    # Position left rack: front edge at x=-0.55, center Y=0
+    # Rotation +90° about Z: local (x,y) → (-y, x)
+    #   Front (local y=0) maps to global x=0; back (y=0.36) maps to x=-0.36
+    # Translate so front face is at x=-0.55, center Y=0
+    left_xformable = UsdGeom.Xformable(
+        stage.GetPrimAtPath(left_rack_path)
+    )
+    left_xformable.AddTranslateOp(
+        opSuffix="position"
+    ).Set(Gf.Vec3d(*left_rack_position))
+    left_xformable.AddOrientOp().Set(Gf.Quatf(0.70710678, 0, 0, -0.70710678))
+
+    # ── Table ────────────────────────────────────────────────────────────
+    # Cuboid: 1.0 x 0.36 x table_height, front edge at y=0.3
+    table_size_x = 1.0
+    table_size_y = 0.36
+    table_path = f"{root_path}/Table"
+    
+    create_table_with_jig(
+        stage,
+        jig_usd_path=jig_usd_path,
+        root_path=table_path,
+        size_x=table_size_x,
+        size_y=table_size_y,
+        size_z=table_height,
+        jig_x=table_jig_x,
+        jig_grid_id=table_jig_id,
+        label_image_dir=label_image_dir,
+    )
+
+    table_xformable = UsdGeom.Xformable(
+        stage.GetPrimAtPath(table_path)
+    )
+
+    table_xformable.AddTranslateOp().Set(
+        Gf.Vec3d(*table_position)
+    )
+    table_xformable.AddRotateZOp(
+        opSuffix="facing"
+    ).Set(180)
+
+    # ── Set default prim ─────────────────────────────────────────────────
+    stage.SetDefaultPrim(env_xform.GetPrim())
+
+    return env_xform
+
+
+def save_environment_usd(output_path, **env_cfg):
+    """Build environment on a temporary stage and save to a USD file.
+
+    This enables referencing the environment as an instanceable asset
+    across multiple sub-environments.
+
+    Parameters
+    ----------
+    output_path : str
+        File path for the output .usd file.
+    **env_cfg
+        Keyword arguments forwarded to :func:`create_environment`.
+
+    Returns
+    -------
+    str – the resolved absolute path of the saved file.
+    """
+    if os.path.exists(output_path):
+        os.remove(output_path)
+    temp_stage = Usd.Stage.CreateNew(output_path)
+    UsdGeom.SetStageUpAxis(temp_stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(temp_stage, 1.0)
+    create_environment(temp_stage, root_path="/Environment", **env_cfg)
+    temp_stage.GetRootLayer().Save()
+    return os.path.abspath(output_path)
+
+
+def build_environment_on_live_stage(
+    root_path="/Environment",
+    table_height=0.7,
+    table_position=None,
+    table_jig_x=0.0,
+    table_jig_id=None,
+    right_rack_position=None,
+    right_rack_size=None,
+    right_rack_planes=None,
+    right_rack_ids=None,
+    right_rack_jig_mask=None,
+    right_rack_tray_mask=None,
+    left_rack_position=None,
+    left_rack_size=None,
+    left_rack_planes=None,
+    left_rack_ids=None,
+    left_rack_jig_mask=None,
+    left_rack_tray_mask=None,
+    jig_gap=0.015,
+    robot_leg_height=0.5,
+    label_image_dir=None,
+):
+    """Convenience wrapper: get the live Isaac Sim stage and build the environment.
+
+    Call this after the World has been created (e.g. after MultiEnvironment init).
+    """
+    import omni.usd
+
+    stage = omni.usd.get_context().get_stage()
+    return create_environment(
+        stage,
+        root_path=root_path,
+        table_height=table_height,
+        table_position=table_position,
+        table_jig_x=table_jig_x,
+        table_jig_id=table_jig_id,
+        right_rack_position=right_rack_position,
+        right_rack_size=right_rack_size,
+        right_rack_planes=right_rack_planes,
+        right_rack_ids=right_rack_ids,
+        right_rack_jig_mask=right_rack_jig_mask,
+        right_rack_tray_mask=right_rack_tray_mask,
+        left_rack_position=left_rack_position,
+        left_rack_size=left_rack_size,
+        left_rack_planes=left_rack_planes,
+        left_rack_ids=left_rack_ids,
+        left_rack_jig_mask=left_rack_jig_mask,
+        left_rack_tray_mask=left_rack_tray_mask,
+        jig_gap=jig_gap,
+        robot_leg_height=robot_leg_height,
+        label_image_dir=label_image_dir,
+    )
+
+
+def main():
+    import argparse
+
+    parser = argparse.ArgumentParser(
+        description="Create the full rekep environment and save as USD"
+    )
+    parser.add_argument(
+        "--output", "-o", type=str, default="rekep_environment.usd",
+        help="Output .usd file path",
+    )
+    parser.add_argument(
+        "--table_height", type=float, default=0.7,
+        help="Height of the table cuboid in metres",
+    )
+    parser.add_argument(
+        "--table_jig_x", type=float, default=0.0,
+        help="World-frame X position of the tray jig on the table",
+    )
+    parser.add_argument(
+        "--table_jig_id", type=int, default=None,
+        help="AprilGrid ID for the table jig label (omit for no label)",
+    )
+    args = parser.parse_args()
+
+    if os.path.exists(args.output):
+        os.remove(args.output)
+
+    stage = Usd.Stage.CreateNew(args.output)
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+
+    create_environment(
+        stage,
+        table_height=args.table_height,
+        table_jig_x=args.table_jig_x,
+        table_jig_id=args.table_jig_id,
+    )
+
+    stage.GetRootLayer().Save()
+    print(f"Saved environment to {args.output}")
+
+
+if __name__ == "__main__":
+    main()
