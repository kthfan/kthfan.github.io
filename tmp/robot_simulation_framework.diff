++"""Fix the EGU50 gripper in tm5s.usd to the real gripper (D29).
++
++The sim asset mounts ``gripper_body`` on ``link_6`` with a stray offset of
++(0, +3.41, -1.76) mm, which egu50_v2.urdf (and so cuRobo) does not have: that
++offset is why the sim plate hung 3.3 mm high and short of the real one (D28).
++This script
++
++* zeroes that mount offset and moves both jaw joints and jaw bodies with it,
++* sizes the body and plate collider cubes to ``cell_core.assets`` (the user's
++  measured gripper),
++* sets both jaw joint ranges to the real stroke and fully-open gap (D30),
++* sets the plate's Teflon material to ``PLATE_FRICTION``, combine mode max
++  (D30: at 0.3/0.1 the carried tray crept 8 mm).
++
++The visual mesh is not edited: with the offset gone it matches the real
++gripper to within 1 mm (plate tip 0.7 mm short).
++
++Usage: python fix_gripper_usd.py SRC.usd DST.usd
++"""
++import os
++import shutil
++import sys
++
++from pxr import Gf, Sdf, Usd, UsdGeom, UsdPhysics
++
++HERE = os.path.dirname(os.path.abspath(__file__))
++sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(HERE)), "shared"))
++from cell_core import assets as A  # noqa: E402
++
++L6 = "/tm5s/link_6"
++GB = L6 + "/gripper_body"
++
++
++def _set_cube(prim, scale, translate):
++    prim.GetAttribute("xformOp:scale").Set(Gf.Vec3f(*scale))
++    prim.GetAttribute("xformOp:translate").Set(Gf.Vec3d(*translate))
++
++
++def fix(stage):
++    """Edit *stage* in place; returns the mount offset removed (link_6 frame)."""
++    gb = stage.GetPrimAtPath(GB)
++    t = gb.GetAttribute("xformOp:translate")
++    d = Gf.Vec3d(t.Get())
++    cache = UsdGeom.XformCache()
++    l6_world = cache.GetLocalToWorldTransform(stage.GetPrimAtPath(L6))
++
++    for side in ("left", "right"):
++        jaw = stage.GetPrimAtPath(f"/tm5s/{side}_gripper")
++        joint = UsdPhysics.Joint(stage.GetPrimAtPath(f"/tm5s/{side}_gripper/{side}_gripper_joint"))
++        assert [str(p) for p in joint.GetBody0Rel().GetTargets()] == [L6]
++        joint.GetLocalPos0Attr().Set(Gf.Vec3f(Gf.Vec3d(joint.GetLocalPos0Attr().Get()) - d))
++        parent_inv = cache.GetLocalToWorldTransform(jaw.GetParent()).GetInverse()
++        origin = cache.GetLocalToWorldTransform(jaw).ExtractTranslation()
++        moved = origin - l6_world.TransformDir(d)
++        jaw.GetAttribute("xformOp:translate").Set(Gf.Vec3d(parent_inv.Transform(moved)))
++        prismatic = UsdPhysics.PrismaticJoint(joint.GetPrim())
++        prismatic.GetLowerLimitAttr().Set(float(A.JAW_Q_MIN))
++        prismatic.GetUpperLimitAttr().Set(float(A.JAW_Q_MAX))
++    t.Set(Gf.Vec3d(0, 0, 0))
++
++    # Collider cubes are unit meshes; gripper frame -> link_6 is (x, y, z) -> (x, z, -y).
++    body = stage.GetPrimAtPath(GB + "/collisions/Cube")
++    sz = body.GetAttribute("xformOp:scale").Get()[2]
++    tz = body.GetAttribute("xformOp:translate").Get()[2]
++    _set_cube(body, (2 * A.BODY_FX, A.BODY_FZ_FRONT, sz), (0, -A.BODY_FZ_FRONT / 2, tz))
++    _set_cube(stage.GetPrimAtPath(GB + "/collisions/Cube_01"),
++              (2 * A.PLATE_FX, A.PLATE_FZ_TIP - A.PLATE_FZ_ROOT, A.PLATE_FY_TOP - A.PLATE_FY_BOT),
++              (0, -(A.PLATE_FZ_TIP + A.PLATE_FZ_ROOT) / 2, (A.PLATE_FY_TOP + A.PLATE_FY_BOT) / 2))
++
++    teflon = stage.GetPrimAtPath(GB + "/Looks/TeflonMaterial")
++    m = UsdPhysics.MaterialAPI(teflon)
++    m.GetStaticFrictionAttr().Set(float(A.PLATE_FRICTION[0]))
++    m.GetDynamicFrictionAttr().Set(float(A.PLATE_FRICTION[1]))
++    teflon.AddAppliedSchema("PhysxMaterialAPI")
++    teflon.CreateAttribute("physxMaterial:frictionCombineMode", Sdf.ValueTypeNames.Token).Set("max")
++    return d
++
++
++def main(src, dst):
++    if os.path.abspath(src) != os.path.abspath(dst):
++        shutil.copyfile(src, dst)
++    stage = Usd.Stage.Open(dst)
++    d = fix(stage)
++    stage.GetRootLayer().Save()
++    print("removed mount offset (link_6 frame): %s" % (tuple(round(v, 7) for v in d),))
++
++
++if __name__ == "__main__":
++    main(*sys.argv[1:3])
