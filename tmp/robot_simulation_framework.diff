++cp_a.attach([rp])
++for _ in range(20):
++    app.update()
++t1 = time.time()
++rep.orchestrator.step(rt_subframes=8)
++print(f"[probe] rendered in {time.time() - t1:.1f}s", flush=True)
++
++rgb = np.asarray(rgb_a.get_data())[:, :, :3]
++params = {k: (np.asarray(v).tolist() if hasattr(v, "__len__") and not isinstance(v, str) else v)
++          for k, v in cp_a.get_data().items()}
++with open(os.path.join(out, "camera_params.json"), "w") as f:
++    json.dump(params, f, indent=1, default=str)
++print("[probe] camera_params", json.dumps(params, default=str), flush=True)
++
++import cv2  # noqa: E402
++
++cv2.imwrite(os.path.join(out, "rgb.png"), cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR))
++gray = rgb.mean(axis=2)
++report = {"shape": list(rgb.shape), "gray_min": float(gray.min()), "gray_max": float(gray.max()),
++          "gray_mean": float(gray.mean()), "attrs": cam_attrs}
++
++if MODE == "synthetic":
++    thr = 0.5 * (float(np.median(gray)) + float(gray.max()))
++    n, _, stats, cents = cv2.connectedComponentsWithStats((gray > thr).astype(np.uint8))
++    blobs = [(tuple(cents[i]), int(stats[i, cv2.CC_STAT_AREA])) for i in range(1, n)
++             if stats[i, cv2.CC_STAT_AREA] > 50]
++    report["threshold"] = thr
++    report["blobs"] = [[round(c[0], 2), round(c[1], 2), a] for c, a in blobs]
