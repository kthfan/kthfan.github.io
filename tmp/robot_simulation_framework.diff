@@ -0,0 +1,153 @@
+"""M4 task 5 probe: does Isaac Sim 5.0 RTX render through the USD camera the way
+the pinhole model says it should?
+
+Run with Isaac Sim's python.sh on the sim host:
+
+    python.sh probe_render.py synthetic <cell.usd> <out_dir>
+    python.sh probe_render.py stage     <cell.usd> <out_dir>
+
+synthetic: copies the eih_camera attributes from <cell.usd> onto a fresh camera
+    at the origin, renders small discs at known optical-frame points, and
+    compares blob centroids against the pinhole projection with the calibrated
+    principal point (model "cal") and with a centred one (model "centre").
+    The two differ by ~65 px in u, so the verdict is unambiguous.
+stage: opens <cell.usd>, adds the env_setup.md lights, renders one frame from
+    the eih_camera as built (home pose), and dumps camera_params.
+
+Both write rgb.png + camera_params.json + report.json into <out_dir>/<mode>/.
+"""
+import json
+import os
+import sys
+import time
+
+MODE, CELL, OUT = sys.argv[1], os.path.abspath(sys.argv[2]), os.path.abspath(sys.argv[3])
+CAM_REL = "/Environment/RobotArmBase/RobotArm/link_6/eih_camera"
+ATTRS = ("focalLength", "horizontalAperture", "verticalAperture",
+         "horizontalApertureOffset", "verticalApertureOffset")
+W, H = 2592, 1944
+FX, FY, CX, CY = 2680.3818359375, 2680.74462890625, 1231.44580078125, 976.5955810546875
+DEPTH = 0.35
+POINTS = [(0.0, 0.0), (0.08, 0.0), (-0.08, 0.0), (0.0, 0.06), (0.0, -0.06),
+          (0.06, 0.045), (-0.06, -0.045)]  # optical (x, y) at DEPTH
+RADIUS = 0.004
+
+t0 = time.time()
+from isaacsim import SimulationApp  # noqa: E402
+
+app = SimulationApp({"headless": True, "renderer": "RayTracedLighting", "width": W, "height": H})
+print(f"[probe] app up {time.time() - t0:.1f}s", flush=True)
+
+import numpy as np  # noqa: E402
+import omni.replicator.core as rep  # noqa: E402
+import omni.usd  # noqa: E402
+from pxr import Gf, Usd, UsdGeom, UsdLux  # noqa: E402
+
+out = os.path.join(OUT, MODE)
+os.makedirs(out, exist_ok=True)
+built = Usd.Stage.Open(CELL)
+cam_attrs = {a: built.GetPrimAtPath(CAM_REL).GetAttribute(a).Get() for a in ATTRS}
+print("[probe] built camera attrs", cam_attrs, flush=True)
+del built
+
+ctx = omni.usd.get_context()
+if MODE == "synthetic":
+    ctx.new_stage()
+    stage = ctx.get_stage()
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+    for p in stage.GetPseudoRoot().GetChildren():
+        print("[probe] default prim present:", p.GetPath(), p.GetTypeName(), flush=True)
+    cam = UsdGeom.Camera.Define(stage, "/World/Cam")
+    for a, v in cam_attrs.items():
+        cam.GetPrim().GetAttribute(a).Set(v)
+    cam.CreateClippingRangeAttr().Set(Gf.Vec2f(0.01, 100.0))
+    light = UsdLux.DistantLight.Define(stage, "/World/Key")  # emits along -Z, same as the camera
+    light.CreateIntensityAttr().Set(3000.0)
+    for i, (x, y) in enumerate(POINTS):
+        # Fronto-parallel discs: a pinhole maps a circle parallel to the image
+        # plane to a circle and its centre to the centre, so the blob centroid
+        # carries no shading or perspective bias (spheres did: ~0.3 % outward).
+        s = UsdGeom.Cylinder.Define(stage, f"/World/S{i}")
+        s.CreateRadiusAttr().Set(RADIUS)
+        s.CreateHeightAttr().Set(0.0005)
+        s.CreateAxisAttr().Set(UsdGeom.Tokens.z)
+        # optical (x, y, z) -> USD camera (x, -y, -z); the camera sits at the origin
+        UsdGeom.Xformable(s).AddTranslateOp().Set(Gf.Vec3d(x, -y, -DEPTH))
+    cam_path = "/World/Cam"
+else:
+    ctx.open_stage(CELL)
+    cam_path = CAM_REL
+    stage = ctx.get_stage()
+    # The built stage carries no lights; the simulator adds them at run time
+    # (env_setup.md "global_objects"). Same values, Isaac orientation is wxyz.
+    UsdLux.DomeLight.Define(stage, "/DomeLight").CreateIntensityAttr().Set(2000.0)
+    key = UsdLux.DistantLight.Define(stage, "/DistantLight")
+    key.CreateIntensityAttr().Set(4000.0)
+    UsdGeom.Xformable(key).AddOrientOp(UsdGeom.XformOp.PrecisionDouble).Set(
+        Gf.Quatd(-0.14644661, 0.35355339, 0.35355339, 0.85355339))
+    try:
+        import yaml  # noqa: F401
+        print("[probe] yaml available", yaml.__version__, flush=True)
+    except ImportError as e:
+        print("[probe] yaml NOT available:", e, flush=True)
+
+for _ in range(600):
+    app.update()
+    if not ctx.get_stage_loading_status()[2]:
+        break
+print(f"[probe] stage ready {time.time() - t0:.1f}s", flush=True)
+
+rp = rep.create.render_product(cam_path, (W, H))
+rgb_a = rep.AnnotatorRegistry.get_annotator("rgb")
+cp_a = rep.AnnotatorRegistry.get_annotator("camera_params")
+rgb_a.attach([rp])
+cp_a.attach([rp])
+for _ in range(20):
+    app.update()
+t1 = time.time()
+rep.orchestrator.step(rt_subframes=8)
+print(f"[probe] rendered in {time.time() - t1:.1f}s", flush=True)
+
+rgb = np.asarray(rgb_a.get_data())[:, :, :3]
+params = {k: (np.asarray(v).tolist() if hasattr(v, "__len__") and not isinstance(v, str) else v)
+          for k, v in cp_a.get_data().items()}
+with open(os.path.join(out, "camera_params.json"), "w") as f:
+    json.dump(params, f, indent=1, default=str)
+print("[probe] camera_params", json.dumps(params, default=str), flush=True)
+
+import cv2  # noqa: E402
+
+cv2.imwrite(os.path.join(out, "rgb.png"), cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR))
+gray = rgb.mean(axis=2)
+report = {"shape": list(rgb.shape), "gray_min": float(gray.min()), "gray_max": float(gray.max()),
+          "gray_mean": float(gray.mean()), "attrs": cam_attrs}
+
+if MODE == "synthetic":
+    thr = 0.5 * (float(np.median(gray)) + float(gray.max()))
+    n, _, stats, cents = cv2.connectedComponentsWithStats((gray > thr).astype(np.uint8))
+    blobs = [(tuple(cents[i]), int(stats[i, cv2.CC_STAT_AREA])) for i in range(1, n)
+             if stats[i, cv2.CC_STAT_AREA] > 50]
+    report["threshold"] = thr
+    report["blobs"] = [[round(c[0], 2), round(c[1], 2), a] for c, a in blobs]
+    rows = []
+    for x, y in POINTS:
+        cal = (FX * x / DEPTH + CX, FY * y / DEPTH + CY)
+        ctr = (FX * x / DEPTH + W / 2, FY * y / DEPTH + H / 2)
+        if not blobs:
+            rows.append({"pt": [x, y], "cal": cal, "centre": ctr, "blob": None})
+            continue
+        b = min(blobs, key=lambda bl: min(np.hypot(bl[0][0] - p[0], bl[0][1] - p[1]) for p in (cal, ctr)))[0]
+        rows.append({"pt": [x, y], "blob": [round(b[0], 2), round(b[1], 2)],
+                     "d_cal": [round(b[0] - cal[0], 2), round(b[1] - cal[1], 2)],
+                     "d_centre": [round(b[0] - ctr[0], 2), round(b[1] - ctr[1], 2)]})
+    report["points"] = rows
+    for r in rows:
+        print("[probe]", json.dumps(r), flush=True)
+
+with open(os.path.join(out, "report.json"), "w") as f:
+    json.dump(report, f, indent=1, default=str)
+print("[probe] summary", json.dumps({k: v for k, v in report.items() if k not in ("points",)}, default=str),
+      flush=True)
+print(f"[probe] done {time.time() - t0:.1f}s", flush=True)
+app.close()
