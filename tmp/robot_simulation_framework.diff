+"""Scheduler interface.
+
+D1: traversal order is top-to-bottom then left-to-right, and the scheduler is
+replaceable. Only the interface and the default policy are pinned here.
+"""
+import pytest
+
+from cell_core import config as C
+from cell_core import geometry as G
+from cell_core import scheduler as SCH
+
+
+@pytest.fixture
+def slots():
+    return G.enumerate_slots(C.load_preset("as_built"))
+
+
+def test_default_scheduler_satisfies_the_protocol(slots):
+    assert isinstance(SCH.SequentialScheduler(slots), SCH.Scheduler)
+
+
+def test_it_serves_the_incoming_rack_only(slots):
+    order = SCH.SequentialScheduler(slots).order()
+    assert {s.rack for s in order} == {"incoming"}
+    assert len(order) == 12
+
+
+def test_it_works_top_down(slots):
+    heights = [s.height for s in SCH.SequentialScheduler(slots).order()]
+    assert heights == sorted(heights, reverse=True)
+
+
+def test_it_works_left_to_right_within_a_layer(slots):
+    order = SCH.SequentialScheduler(slots).order()
+    top = [s for s in order if s.height == max(x.height for x in order)]
+    assert [s.column for s in top] == sorted(s.column for s in top)
+
+
+def test_it_hands_out_each_slot_once_then_stops(slots):
+    sched = SCH.SequentialScheduler(slots)
+    seen = []
+    while (s := sched.next_slot()) is not None:
+        seen.append(s.key)
+    assert len(seen) == len(set(seen)) == 12
+    assert sched.next_slot() is None
+
+
+def test_occupied_slots_can_be_restricted(slots):
+    sched = SCH.SequentialScheduler(slots, occupied={"incoming/L2/C0"})
+    assert [s.key for s in sched.order()] == ["incoming/L2/C0"]
+
+
+def test_destinations_are_the_outgoing_rack_bottom_up(slots):
+    sched = SCH.SequentialScheduler(slots)
+    dests = sched.destinations()
+    assert {s.rack for s in dests} == {"outgoing"}
+    assert [s.height for s in dests] == sorted(s.height for s in dests)
+
+
+def test_a_custom_scheduler_can_replace_the_default(slots):
+    class Reversed:
+        def __init__(self, slots):
+            self._q = list(reversed([s for s in slots if s.rack == "incoming"]))
+
+        def order(self):
+            return list(self._q)
+
+        def next_slot(self):
+            return self._q.pop(0) if self._q else None
+
+        def destinations(self):
+            return []
+
+    assert isinstance(Reversed(slots), SCH.Scheduler)
