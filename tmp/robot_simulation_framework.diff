+"""The built stage's EIH camera must be the calibrated camera, not the asset's.
+
+The ``link_6/eih_camera`` prim in tm5s.usd sits 8 mm off the hand-eye along the
+approach and renders at fx ~3525 px instead of ~2680 (M4). ``build_cell``
+overrides both from the calibration. The pxr tests apply the override to the
+real asset and measure it back through USD composition, so they check what a
+renderer will see, not the arithmetic that produced it.
+"""
+import dataclasses
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "build_env"))
+
+import build_cell as B  # noqa: E402  (puts cell_core on the path)
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+
+ARM_USD = Path(__file__).resolve().parents[2] / "todo/resources/isaacsim/assets/tm5s.usd"
+OPTICAL_TO_USD_CAM = np.diag([1.0, -1.0, -1.0, 1.0])
+
+
+def _hand_eye():
+    return F.make_pose(F.quat_to_matrix(A.CAM_QUAT), (A.CAM_FX, A.CAM_FY, A.CAM_FZ))
+
+
+def _rot_deg(Ra, Rb):
+    return math.degrees(math.acos(np.clip((np.trace(Ra.T @ Rb) - 1) / 2, -1, 1)))
+
+
+def _random_pose(rng):
+    q = rng.normal(size=4)
+    return F.make_pose(F.quat_to_matrix(q), rng.normal(size=3))
+
+
+def test_the_local_xform_puts_the_optical_frame_at_the_hand_eye():
+    rng = np.random.default_rng(7)
+    for _ in range(5):
+        W_parent, W_flange = _random_pose(rng), _random_pose(rng)
+        local = B.eih_camera_local(W_parent, W_flange)
+        optical = W_parent @ local @ OPTICAL_TO_USD_CAM
+        assert optical == pytest.approx(W_flange @ _hand_eye(), abs=1e-12)
+
+
+def test_the_camera_gets_the_focal_config_both_reads_use():
+    cfg = C.load_preset("strict")
+    attrs = B.eih_camera_attributes(cfg, focal_length=28.5)
+    k = A.FOCAL_CONFIGS[A.focal_config_for(cfg.standoff_near)]
+    assert F.intrinsics_from_usd(attrs, A.EIH_WIDTH, A.EIH_HEIGHT) == pytest.approx(
+        {n: k[n] for n in ("fx", "fy", "cx", "cy")}, abs=1e-9)
+
+
+def test_reads_needing_different_focal_configs_are_refused():
+    """One prim carries one set of intrinsics; a silent pick would be wrong for one read."""
+    cfg = dataclasses.replace(C.load_preset("strict"), standoff_near=0.12)
+    with pytest.raises(ValueError, match="focal config"):
+        B.eih_camera_attributes(cfg, focal_length=28.5)
+
+
+@pytest.mark.skipif(not ARM_USD.exists(), reason="tm5s.usd not present")
+def test_the_override_measures_back_through_usd_composition():
+    pytest.importorskip("pxr")
+    from pxr import Usd, UsdGeom
+
+    stage = Usd.Stage.CreateInMemory()
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    base = UsdGeom.Xform.Define(stage, "/Env/Base")
+    base.AddTranslateOp().Set((0.1, -0.2, 0.735))
+    base.AddRotateZOp(opSuffix="facing").Set(180.0)   # as create_environment does
+    arm = stage.DefinePrim("/Env/Base/RobotArm")
+    arm.GetReferences().AddReference(str(ARM_USD))
+
+    path = B.apply_eih_camera(stage, "/Env/Base/RobotArm", C.load_preset("strict"))
+
+    t = Usd.TimeCode.Default()
+    world = lambda p: np.array(  # noqa: E731  (Gf row-vector -> column-vector)
+        UsdGeom.Xformable(stage.GetPrimAtPath(p)).ComputeLocalToWorldTransform(t)).T
+    measured = np.linalg.inv(world("/Env/Base/RobotArm/flange")) @ world(path) @ OPTICAL_TO_USD_CAM
+    assert np.linalg.norm(measured[:3, 3] - _hand_eye()[:3, 3]) < 1e-4
+    assert _rot_deg(measured[:3, :3], _hand_eye()[:3, :3]) < 0.01
+
+    cam = UsdGeom.Camera(stage.GetPrimAtPath(path))
+    attrs = {n: cam.GetPrim().GetAttribute(n).Get() for n in (
+        "focalLength", "horizontalAperture", "verticalAperture",
+        "horizontalApertureOffset", "verticalApertureOffset")}
+    k = A.FOCAL_CONFIGS[6]
+    got = F.intrinsics_from_usd(attrs, A.EIH_WIDTH, A.EIH_HEIGHT)
+    for n in ("fx", "fy", "cx", "cy"):
+        assert abs(got[n] - k[n]) < 0.5, (n, got[n], k[n])
