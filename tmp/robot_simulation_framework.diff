@@ -0,0 +1,53 @@
+"""Measure the EIH camera of a built stage against the calibration.
+
+    python3 measure_eih_camera.py <cell.usd> [<vendor dir holding cell_core>]
+
+Reads the stage through USD composition: flange -> camera optical frame against
+the hand-eye, and the intrinsics the camera attributes imply against the focal
+config. Exits 1 if position >= 0.1 mm, rotation >= 0.01 deg or any intrinsic is
+off by >= 0.5 px (M4 task 4).
+"""
+import math
+import sys
+
+import numpy as np
+from pxr import Usd, UsdGeom
+
+sys.path.insert(0, sys.argv[2] if len(sys.argv) > 2 else "vendor")
+from cell_core import assets as A  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+
+ARM = "/Environment/RobotArmBase/RobotArm"
+stage = Usd.Stage.Open(sys.argv[1])
+t = Usd.TimeCode.Default()
+
+
+def world(path):
+    m = UsdGeom.Xformable(stage.GetPrimAtPath(path)).ComputeLocalToWorldTransform(t)
+    return np.array([[m[i][j] for j in range(4)] for i in range(4)]).T
+
+
+cam_path = ARM + "/link_6/eih_camera"
+T = np.linalg.inv(world(ARM + "/flange")) @ world(cam_path) @ np.diag([1.0, -1, -1, 1])
+he = F.make_pose(F.quat_to_matrix(A.CAM_QUAT), (A.CAM_FX, A.CAM_FY, A.CAM_FZ))
+dpos = float(np.linalg.norm(T[:3, 3] - he[:3, 3]))
+drot = math.degrees(math.acos(np.clip((np.trace(T[:3, :3].T @ he[:3, :3]) - 1) / 2, -1, 1)))
+
+prim = stage.GetPrimAtPath(cam_path)
+attrs = {n: prim.GetAttribute(n).Get() for n in (
+    "focalLength", "horizontalAperture", "verticalAperture",
+    "horizontalApertureOffset", "verticalApertureOffset")}
+got = F.intrinsics_from_usd(attrs, A.EIH_WIDTH, A.EIH_HEIGHT)
+k = A.FOCAL_CONFIGS[6]
+dk = {n: got[n] - k[n] for n in ("fx", "fy", "cx", "cy")}
+
+print("camera   %s" % cam_path)
+print("xformOps %s" % [str(o.GetOpName()) for o in UsdGeom.Xformable(prim).GetOrderedXformOps()])
+print("attrs    %s" % attrs)
+print("flange->optical pos %s  (hand-eye %s)" % (np.round(T[:3, 3], 6), np.round(he[:3, 3], 6)))
+print("dpos %.4f mm  drot %.5f deg" % (dpos * 1e3, drot))
+print("intrinsics %s" % {n: round(v, 4) for n, v in got.items()})
+print("d vs config 6 %s" % {n: round(v, 6) for n, v in dk.items()})
+ok = dpos < 1e-4 and drot < 0.01 and all(abs(v) < 0.5 for v in dk.values())
+print("VERDICT %s" % ("PASS" if ok else "FAIL"))
+sys.exit(0 if ok else 1)
