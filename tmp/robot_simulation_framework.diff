index 0000000..bcf7957
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/isaacsim/locating/label_truth.py"
@@ -0,0 +1,150 @@
+"""Ground truth for the locating renders, read off the stage the renderer draws.
+
+The detector reports the board pose in its own board frame (probed, M4 task 5):
+origin at the top-left corner of tag 0, which is the label PNG's top-left plus
+the builder's margin; x along PNG columns, y down PNG rows, z into the label.
+:func:`board_pose` puts that frame in the world from the label mesh's points
+and ``st`` coordinates, so it inherits whatever the stage really does with the
+texture instead of what ``cell_core`` assumes (D18/D22).
+
+pxr only; no Isaac Sim. Runs in Isaac's python.sh, the sim host's python3 and
+locally.
+"""
+import os
+import re
+import sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+_BUILD_ENV = os.path.join(os.path.dirname(HERE), "build_env")
+if _BUILD_ENV not in sys.path:
+    sys.path.insert(0, _BUILD_ENV)
+
+import build_cell  # noqa: E402,F401  (puts cell_core on the path)
+
+#: Inside a jig prim (tray_jig_with_label.usd referenced by the builder).
+LABEL_MESH = "label_base/Cube"
+LABEL_SHADER = "label_base/Looks/OmniPBR/Shader"
+
+#: Where the builder puts each rack (create_environment: right = incoming).
+RACK_PRIM = {"incoming": "/Environment/RightRack", "outgoing": "/Environment/LeftRack"}
+TABLE_JIG = "/Environment/Table/Jig"
+
+_GRID_PNG = re.compile(r"aprilgrid_(\d+)\.png$")
+
+
+def jig_prim_path(slot) -> str:
+    if slot.rack == "table":
+        return TABLE_JIG
+    return f"{RACK_PRIM[slot.role]}/Jig_{slot.layer}_{slot.column}"
+
+
+def texture_grid_id(stage, jig_path) -> int:
+    """The AprilGrid id whose PNG the builder bound to this jig's label."""
+    from pxr import UsdShade
+    shader = UsdShade.Shader.Get(stage, f"{jig_path}/{LABEL_SHADER}")
+    asset = shader.GetInput("diffuse_texture").Get()
+    m = _GRID_PNG.search(asset.path.replace("\\", "/"))
+    if m is None:
+        raise ValueError(f"{jig_path}: label texture {asset.path!r} is not an aprilgrid PNG")
+    return int(m.group(1))
+
+
+def _texture_turned(stage, jig_path) -> bool:
+    """Whether the label shader turns its texture 180 degrees.
+
+    OmniPBR samples the texture at ``rotate(st) * scale + translate``. The asset
+    sets ``texture_rotate`` 180 (found in the M4 task 6 pilot render); anything
+    beyond 0/180 with unit scale and no shift is not modelled, so it raises.
+    """
+    from pxr import UsdShade
+    shader = UsdShade.Shader.Get(stage, f"{jig_path}/{LABEL_SHADER}")
+
+    def value(name, default):
+        inp = shader.GetInput(name)
+        v = inp.Get() if inp else None
+        return default if v is None else v
+
+    rotate = float(value("texture_rotate", 0.0)) % 360.0
+    scale = tuple(value("texture_scale", (1.0, 1.0)))
+    shift = tuple(value("texture_translate", (0.0, 0.0)))
+    if rotate not in (0.0, 180.0) or scale != (1.0, 1.0) or shift != (0.0, 0.0) \
+            or value("project_uvw", False):
+        raise ValueError(f"{jig_path}: label texture transform not modelled: rotate {rotate}, "
+                         f"scale {scale}, translate {shift}")
+    return rotate == 180.0
+
+
+def _world(prim) -> np.ndarray:
+    from pxr import UsdGeom
+    # Gf matrices are row-vector; transpose to act on column vectors.
+    return np.array(UsdGeom.XformCache().GetLocalToWorldTransform(prim)).T
+
+
+def board_pose(stage, jig_path, camera_pos, margin=None):
+    """World pose of the detector's board frame on the label face *camera_pos* sees.
+
+    Returns ``(T, info)``; *info* holds the face size and the mesh face index.
+    Raises ``ValueError`` if the face shows the PNG mirrored (a detector cannot
+    decode a mirrored tag, so truth for it is meaningless). *margin* defaults to
+    the builder's own; the builder imports pxr, which Isaac Sim only provides
+    once its app is running, hence the late import.
+    """
+    from pxr import UsdGeom
+    if margin is None:
+        import create_rack_shelf_with_tray_jig as J
+        margin = J.APRILGRID_MARGIN
+    prim = stage.GetPrimAtPath(f"{jig_path}/{LABEL_MESH}")
+    mesh = UsdGeom.Mesh(prim)
+    W = _world(prim)
+    pts = np.array(mesh.GetPointsAttr().Get(), dtype=float)
+    pts = (W[:3, :3] @ pts.T).T + W[:3, 3]
+    counts = list(mesh.GetFaceVertexCountsAttr().Get())
+    idx = list(mesh.GetFaceVertexIndicesAttr().Get())
+    st = UsdGeom.PrimvarsAPI(prim).GetPrimvar("st")
+    if st.GetInterpolation() != UsdGeom.Tokens.faceVarying or st.IsIndexed():
+        raise ValueError(f"{jig_path}: expected non-indexed faceVarying st")
+    uv = np.array(st.Get(), dtype=float)
+    cam = np.asarray(camera_pos, dtype=float)
+
+    best = None
+    k = 0
+    for f, n in enumerate(counts):
+        P, S = pts[idx[k:k + n]], uv[k:k + n]
+        k += n
+        c = P.mean(axis=0)
+        # Authored winding (rightHanded) gives the outward normal; were it
+        # inward, the mirrored check below would raise.
+        normal = np.cross(P[1] - P[0], P[2] - P[0])
+        area = np.linalg.norm(normal)
+        normal = normal / area
+        if normal @ (cam - c) <= 0:
+            continue
+        if best is None or area > best[0]:
+            best = (area, f, P, S, c)
+    if best is None:
+        raise ValueError(f"{jig_path}: no label face points at {cam}")
+    _, face, P, S, c = best
+
+    # P = O + u*Eu + v*Ev holds exactly for a rectangle mapped by [0,1]^2.
+    A = np.column_stack([np.ones(len(S)), S])
+    coef, *_ = np.linalg.lstsq(A, P, rcond=None)
+    if np.abs(A @ coef - P).max() > 1e-9:
+        raise ValueError(f"{jig_path}: label st is not an affine map of the face")
+    O, Eu, Ev = coef
+    width, height = np.linalg.norm(Eu), np.linalg.norm(Ev)
+    # USD textures put image (0, 0) at the bottom-left, so the PNG top-left is
+    # st (0, 1), columns run along +u and rows down -v. Turned 180 degrees,
+    # the top-left is st (1, 0), columns run along -u and rows along +v.
+    if _texture_turned(stage, jig_path):
+        top_left, x, y = O + Eu, -Eu / width, Ev / height
+    else:
+        top_left, x, y = O + Ev, Eu / width, -Ev / height
+    z = np.cross(x, y)
+    if z @ (c - cam) <= 0:
+        raise ValueError(f"{jig_path}: face {face} shows the label mirrored to {cam}")
+    origin = top_left + margin * x + margin * y
+    T = np.eye(4)
+    T[:3, 0], T[:3, 1], T[:3, 2], T[:3, 3] = x, y, z, origin
+    return T, {"face": face, "face_width": float(width), "face_height": float(height)}
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/isaacsim/locating/render_locating.py" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/isaacsim/locating/render_locating.py"
