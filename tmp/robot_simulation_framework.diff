@@ -0,0 +1,195 @@
+"""The stage the generator describes must be the cell that was measured.
+
+``generator_kwargs`` is only half the chain. The half that matters is what
+``generate_env_config`` does with those arguments, because that dict is passed
+straight into ``create_environment`` as keyword arguments and becomes the USD
+stage every sweep result is claimed against.
+
+These tests run the real generator. None of them need ``pxr``: the generator is
+pure arithmetic, so the whole config-to-stage contract is checkable on the
+development machine, and only the final USD write needs the sim host.
+
+The failure this file exists to prevent is the one D22 records: a quantity that
+was checked by recomputing it from ``cell_core`` rather than by reading what the
+generator produced, so the check agreed with the bug for as long as the bug
+lived.
+"""
+import pytest
+
+import cell_core.config as C
+import cell_core.geometry as G
+from cell_core import env_adapter as E
+
+
+#: Presets that must differ from as_built in the robot leg and nothing else.
+MOUNT_VARIANTS = ("recommended", "strict")
+
+
+@pytest.fixture(params=("as_built",) + MOUNT_VARIANTS)
+def cfg(request):
+    """Both presets. A contract that holds for only one preset is not a contract."""
+    return C.load_preset(request.param)
+
+
+@pytest.fixture
+def env(cfg):
+    return E.load_generator()(**E.generator_kwargs(cfg))
+
+
+def _racks(cfg):
+    """(rack, generator side prefix, sign of the rack's world x) for both racks."""
+    return ((cfg.incoming, "right", +1.0), (cfg.outgoing, "left", -1.0))
+
+
+# ── the distance every reachability result depends on ────────────────────────
+def test_each_rack_is_placed_by_its_back_corner_one_depth_behind_the_face(cfg, env):
+    """``face_distance`` is the front face; the generator's position is not.
+
+    The generator documents ``*_rack_position[0]`` as the front face, and this
+    test used to pin exactly that. The measured USD disagreed: the builder puts
+    the rack's local origin there, and after the 90 degree turn that origin is
+    the corner at the BACK of the rack. Every shelf stood one depth (308 mm)
+    nearer the robot than the sweep assumed. ``isaacsim/tests/
+    test_measured_stage.py`` is the check that caught it; this one only keeps
+    the adapter from drifting between measurements.
+    """
+    for rack, side, sign in _racks(cfg):
+        assert env[f"{side}_rack_position"][0] == pytest.approx(
+            sign * (rack.face_distance + rack.depth), abs=1e-9)
+
+
+def test_each_rack_is_centred_across_the_robot_axis(cfg, env):
+    """Jigs spread symmetrically about the robot axis.
+
+    ``cell_core`` places columns at offsets symmetric about zero. That is only
+    true of the built stage if the rack is centred in world Y, which the
+    generator does by offsetting the rack by half its own width.
+    """
+    for rack, side, _ in _racks(cfg):
+        width = env[f"{side}_rack_size"][0]
+        expected = -width / 2.0 if side == "right" else width / 2.0
+        assert env[f"{side}_rack_position"][1] == pytest.approx(expected, abs=1e-9)
+        assert env[f"{side}_rack_position"][2] == pytest.approx(0.0, abs=1e-12)
+
+
+def test_each_rack_is_built_to_its_measured_depth(cfg, env):
+    for rack, side, _ in _racks(cfg):
+        assert env[f"{side}_rack_size"][1] == pytest.approx(rack.depth, abs=1e-9)
+
+
+def test_each_rack_is_tall_enough_to_carry_its_own_top_shelf(cfg, env):
+    """A rack shorter than its top plane would put a shelf in mid-air."""
+    for rack, side, _ in _racks(cfg):
+        assert env[f"{side}_rack_size"][2] >= max(rack.layer_heights)
+
+
+# ── shelves ──────────────────────────────────────────────────────────────────
+def test_the_shelf_planes_are_the_measured_layer_heights(cfg, env):
+    """Not merely the same count: the same heights, in the same order.
+
+    Layer heights are what the sweep reached to. A reordering would still pass a
+    length check while silently moving every slot.
+    """
+    for rack, side, _ in _racks(cfg):
+        assert list(env[f"{side}_rack_planes"]) == pytest.approx(
+            list(rack.layer_heights), abs=1e-12)
+
+
+def test_the_stage_holds_exactly_the_slots_that_were_swept(cfg, env):
+    """Ties the built stage to the reachability model.
+
+    ``enumerate_slots`` is what ``evaluate.py`` reports pass/fail over, and it
+    counts the table jig as well. If the stage ever carries a different number
+    of jigs than the sweep enumerated, then a verdict of "37/37 reachable" is a
+    statement about a cell that was never built.
+    """
+    rack_jigs = sum(len(row) for side in ("right", "left")
+                    for row in env[f"{side}_rack_ids"])
+    table_jigs = 1 if env["table_jig_id"] is not None else 0
+    assert rack_jigs + table_jigs == len(G.enumerate_slots(cfg))
+
+
+def test_every_shelf_is_fully_populated_in_the_shape_the_config_asks_for(cfg, env):
+    for rack, side, _ in _racks(cfg):
+        mask = env[f"{side}_rack_jig_mask"]
+        assert len(mask) == len(rack.layer_heights)
+        assert all(len(row) == rack.n_jigs for row in mask)
+        assert all(all(row) for row in mask)
+
+
+# ── labels ───────────────────────────────────────────────────────────────────
+def test_no_two_jigs_in_the_cell_share_an_aprilgrid_id(cfg, env):
+    """A duplicated ID is a pose estimate attached to the wrong shelf.
+
+    The detector reports an ID, not a location. Two jigs with the same ID make
+    the localisation stage silently ambiguous, and the table jig has to be in
+    the comparison because it is issued from the same counter.
+    """
+    ids = [i for side in ("right", "left") for row in env[f"{side}_rack_ids"] for i in row]
+    ids.append(env["table_jig_id"])
+    assert len(ids) == len(set(ids)), sorted(ids)
+
+
+def test_ids_run_bottom_shelf_first_and_left_to_right(cfg, env):
+    """The ordering the label images are generated against."""
+    ids = [i for side in ("right", "left") for row in env[f"{side}_rack_ids"] for i in row]
+    assert ids == sorted(ids)
+    assert ids == list(range(ids[0], ids[0] + len(ids)))
+
+
+def test_cell_core_knows_which_aprilgrid_each_slot_carries(cfg, env):
+    """``grid_ids`` against the generator's own matrices, slot by slot.
+
+    The builder puts ``ids[n][m]`` on prim ``Jig_n_m``, and the measured stage
+    ties ``Jig_n_m`` to ``Slot(layer=n, column=m)`` (test_measured_stage's
+    column-pitch test), so this is the id each slot's label really shows.
+    """
+    ids = G.grid_ids(cfg)
+    side = {"incoming": "right", "outgoing": "left"}
+    for slot in G.enumerate_slots(cfg):
+        if slot.rack == "table":
+            expected = env["table_jig_id"]
+        else:
+            expected = env[f"{side[slot.role]}_rack_ids"][slot.layer][slot.column]
+        assert ids[slot.key] == expected, slot.key
+    assert len(ids) == len(G.enumerate_slots(cfg))
+
+
+# ── trays ────────────────────────────────────────────────────────────────────
+def test_trays_start_on_the_incoming_rack_and_nowhere_else(cfg, env):
+    """The task is to move trays from incoming to outgoing.
+
+    A tray pre-placed on the outgoing shelf would occupy a destination slot, and
+    an incoming shelf without trays gives the robot nothing to pick.
+    """
+    assert all(all(row) for row in env["right_rack_tray_mask"])
+    assert not any(any(row) for row in env["left_rack_tray_mask"])
+
+
+# ── table and mount ──────────────────────────────────────────────────────────
+def test_the_table_presents_its_near_edge_at_the_measured_distance(cfg, env):
+    """The table cube is centred, so its near edge is half a depth in front."""
+    near_edge = env["table_position"][1] - cfg.table.depth / 2.0
+    assert near_edge == pytest.approx(cfg.table.face_distance, abs=1e-9)
+    assert env["table_position"][0] == pytest.approx(cfg.table.jig_x, abs=1e-9)
+    assert env["table_height"] == pytest.approx(cfg.table.height, abs=1e-9)
+
+
+def test_the_mount_height_reaches_the_stage_unmodified(cfg, env):
+    """D19 is a change of exactly one number; this is the number.
+
+    The two presets differ only in leg height, so this is the single value that
+    has to survive the trip from preset to stage for the experiment to mean
+    anything.
+    """
+    assert env["robot_leg_height"] == pytest.approx(cfg.robot.leg_height, abs=1e-12)
+
+
+@pytest.mark.parametrize("variant", MOUNT_VARIANTS)
+def test_switching_preset_is_the_only_thing_that_moves_the_stage(variant):
+    """The user's requirement, checked end to end on the generated stage."""
+    build = {n: E.load_generator()(**E.generator_kwargs(C.load_preset(n)))
+             for n in ("as_built", variant)}
+    differing = {k for k in build["as_built"]
+                 if build["as_built"][k] != build[variant][k]}
+    assert differing == {"robot_leg_height"}, differing
