@@ -0,0 +1,364 @@
+"""Create a rack shelf with tray jigs placed on the shelves, and save as USD."""
+
+from pxr import Usd, UsdGeom, UsdShade, Sdf, Gf
+import argparse
+import json
+import os
+import sys
+
+import cv2
+import numpy as np
+
+from create_rack_shelf import create_rack_shelf
+
+# Jig positioning constants (derived from tray-jig geometry)
+JIG_X_HALF = 0.078  # used in the x-position formula
+JIG_Y_OFFSET = 0.135  # jig y = size_y - JIG_Y_OFFSET
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+if SCRIPT_DIR not in sys.path:
+    sys.path.insert(0, SCRIPT_DIR)
+
+import asset_paths
+
+# AprilGrid constants
+APRILGRID_MARKERS_X = 4
+APRILGRID_MARKERS_Y = 1
+APRILGRID_MARKER_LENGTH = 0.02
+APRILGRID_MARKER_SEPARATION = 0.0075
+APRILGRID_MARGIN = 0.005
+APRILGRID_DICT_FAMILY = cv2.aruco.DICT_APRILTAG_36h11
+APRILGRID_SCALE = 8000
+
+
+def generate_aprilgrid_image(grid_id, output_path):
+    """Generate an AprilGrid PNG image and save it to *output_path*."""
+    dictionary = cv2.aruco.getPredefinedDictionary(APRILGRID_DICT_FAMILY)
+
+    length_px = int(APRILGRID_SCALE * APRILGRID_MARKER_LENGTH)
+    sep_px = int(APRILGRID_SCALE * APRILGRID_MARKER_SEPARATION)
+    margin_px = int(APRILGRID_SCALE * APRILGRID_MARGIN)
+
+    img_w = APRILGRID_MARKERS_X * length_px + (APRILGRID_MARKERS_X - 1) * sep_px
+    img_h = APRILGRID_MARKERS_Y * length_px + (APRILGRID_MARKERS_Y - 1) * sep_px
+
+    marker_ids = (
+        np.arange(APRILGRID_MARKERS_X * APRILGRID_MARKERS_Y)
+        + grid_id * APRILGRID_MARKERS_X * APRILGRID_MARKERS_Y
+    )
+
+    board = cv2.aruco.GridBoard(
+        size=(APRILGRID_MARKERS_X, APRILGRID_MARKERS_Y),
+        markerLength=APRILGRID_MARKER_LENGTH,
+        markerSeparation=APRILGRID_MARKER_SEPARATION,
+        dictionary=dictionary,
+        ids=marker_ids,
+    )
+
+    img = board.generateImage(outSize=(img_w, img_h))
+
+    # Add margin
+    img_with_margin = 255 * np.ones(
+        (img_h + 2 * margin_px, img_w + 2 * margin_px), dtype=np.uint8
+    )
+    img_with_margin[margin_px:-margin_px, margin_px:-margin_px] = img
+
+    cv2.imwrite(output_path, img_with_margin)
+    return output_path
+
+
+def _max_jig_columns(size_x, cylinder_radius, jig_gap):
+    """Return the maximum number of jig columns that fit on the shelf."""
+    # Rightmost edge of jig at column m (0-indexed):
+    #   x(m) + JIG_X_HALF = 2 * JIG_X_HALF + 2*cyl_r + jig_gap + m*(jig_gap + JIG_X_HALF)
+    # Must be <= size_x
+    first_right_edge = 2 * JIG_X_HALF + 2 * cylinder_radius + jig_gap
+    if first_right_edge > size_x:
+        return 0
+    step = jig_gap + 2 * JIG_X_HALF
+    if step <= 0:
+        return 1
+    m_max = int((size_x - first_right_edge) / step)
+    return m_max + 1  # columns are 0-indexed, so count = m_max + 1
+
+
+def _jig_x(m, cylinder_radius, jig_gap):
+    """X position of the jig at column *m*."""
+    return JIG_X_HALF + 2 * cylinder_radius + jig_gap + m * (jig_gap + 2 * JIG_X_HALF)
+
+
+def create_rack_shelf_with_tray_jig(
+    stage,
+    jig_usd_path=None,
+    root_path="/RackShelf",
+    size_x=0.6,
+    size_y=0.4,
+    size_z=1.0,
+    plane_height_list=None,
+    plane_thickness=0.02,
+    cylinder_radius=0.02,
+    jig_gap=0.01,
+    jig_mask=None,
+    ids=None,
+    label_image_dir=None,
+    tray_usd_path=None,
+    tray_mask=None,
+    tray_root_path=None,
+    rack_position=None,
+    rack_rotation=None,
+    asset_root=None,
+):
+    """Build a rack shelf and place tray jigs on it.
+
+    Parameters
+    ----------
+    stage : Usd.Stage
+    jig_usd_path : str or None
+        Absolute or relative path to the tray-jig USD file. ``None`` resolves it
+        from *asset_root*. Note that ``tray_usd_path`` is deliberately *not*
+        resolved this way: there, ``None`` means "place no trays".
+    root_path : str
+    size_x, size_y, size_z : float
+    plane_height_list : list[float]
+    plane_thickness : float
+    cylinder_radius : float
+    jig_gap : float
+        Horizontal gap between adjacent jigs (and before the first jig).
+    jig_mask : list[list[bool]] | None
+        Shape (n_shelves, n_columns).  ``True`` means a jig is placed at that
+        position.  If *None*, all feasible positions are filled.
+    ids : list[list[int | None]] | None
+        Shape (n_shelves, n_columns).  Each non-None value is an AprilGrid
+        grid-id whose generated image is set as the jig's label albedo map.
+    label_image_dir : str | None
+        Directory for generated AprilGrid images.  Defaults to a
+        ``label_images`` folder next to the stage's root layer.
+    tray_root_path : str | None
+        USD prim path under which tray prims are created.  When *None* (the
+        default), trays are placed under *root_path* (the rack root), which
+        creates a nested rigid-body hierarchy if the rack USD also carries a
+        RigidBodyAPI.  Pass a sibling path with the same position/rotation
+        transforms to keep trays in the correct local coordinate frame without
+        nesting them inside the rack prim.
+    """
+    if jig_usd_path is None:
+        jig_usd_path = asset_paths.asset(asset_paths.JIG_USD, asset_root)
+
+    if plane_height_list is None:
+        plane_height_list = [0.0, 0.33, 0.66, 1.0]
+
+    n_shelves = len(plane_height_list)
+    max_cols = _max_jig_columns(size_x, cylinder_radius, jig_gap)
+
+    # Build default jig_mask (all True) if not provided
+    if jig_mask is None:
+        jig_mask = [[True] * max_cols for _ in range(n_shelves)]
+
+    # Validate jig_mask dimensions
+    if len(jig_mask) != n_shelves:
+        raise ValueError(
+            f"jig_mask has {len(jig_mask)} rows but there are "
+            f"{n_shelves} shelves"
+        )
+
+    # Validate that every requested jig fits on the shelf
+    for n, row in enumerate(jig_mask):
+        for m, present in enumerate(row):
+            if not present:
+                continue
+            x = _jig_x(m, cylinder_radius, jig_gap)
+            right_edge = x + JIG_X_HALF
+            if right_edge > size_x:
+                raise ValueError(
+                    f"Jig at shelf {n}, column {m} would extend to x={right_edge:.4f} "
+                    f"which exceeds size_x={size_x}"
+                )
+
+    # Create the rack shelf geometry
+    root_xform = create_rack_shelf(
+        stage,
+        root_path=root_path,
+        size_x=size_x,
+        size_y=size_y,
+        size_z=size_z,
+        plane_height_list=plane_height_list,
+        plane_thickness=plane_thickness,
+        cylinder_radius=cylinder_radius,
+    )
+
+    # Resolve jig USD path (make absolute for the reference)
+    jig_usd_abs = os.path.abspath(jig_usd_path)
+
+    # Prepare label image directory if ids are provided
+    if ids is not None and label_image_dir is None:
+        root_layer = stage.GetRootLayer()
+        label_image_dir = os.path.join(
+            os.path.dirname(root_layer.identifier), "label_images"
+        )
+    if ids is not None:
+        os.makedirs(label_image_dir, exist_ok=True)
+
+    # Place tray jigs
+    jig_y = size_y - JIG_Y_OFFSET
+
+    for n, row in enumerate(jig_mask):
+        h = plane_height_list[n]
+        jig_z = h + plane_thickness / 2.0
+        for m, present in enumerate(row):
+            if not present:
+                continue
+            jig_x = _jig_x(m, cylinder_radius, jig_gap)
+            jig_path = f"{root_path}/Jig_{n}_{m}"
+            jig_xform = UsdGeom.Xform.Define(stage, jig_path)
+            jig_prim = jig_xform.GetPrim()
+            jig_prim.GetReferences().AddReference(jig_usd_abs)
+
+            # Determine if this jig needs a label image
+            grid_id = None
+            if ids is not None and n < len(ids) and m < len(ids[n]):
+                grid_id = ids[n][m]
+
+            if grid_id is not None:
+                # Generate AprilGrid image
+                img_path = os.path.join(
+                    label_image_dir, f"aprilgrid_{grid_id}.png"
+                )
+                generate_aprilgrid_image(grid_id, img_path)
+
+                # Override the label material's albedo map
+                shader_path = f"{jig_path}/label_base/Looks/OmniPBR/Shader"
+                shader = UsdShade.Shader.Get(stage, shader_path)
+                shader.CreateInput(
+                    "diffuse_texture", Sdf.ValueTypeNames.Asset
+                ).Set(Sdf.AssetPath(os.path.abspath(img_path)))
+            else:
+                jig_prim.SetInstanceable(True)
+
+            xformable = UsdGeom.Xformable(jig_xform)
+            xformable.AddTranslateOp().Set(Gf.Vec3d(jig_x, jig_y, jig_z))
+
+    # Place trays
+    if tray_mask is not None and tray_usd_path is not None:
+        # When tray_root_path is given, place trays there to avoid nesting a
+        # rigid body (tray) inside another rigid body (rack) in the hierarchy.
+        _tray_parent = tray_root_path if tray_root_path is not None else root_path
+        tray_usd_abs = os.path.abspath(tray_usd_path)
+        
+        # Compute transform from rack's local space to tray parent's local space
+        need_transform = (tray_root_path is not None and tray_root_path != root_path)
+        if need_transform:
+            rack_to_tray_parent = Gf.Matrix4d()
+            rack_to_tray_parent.SetTransform(
+                Gf.Rotation(Gf.Quatf(*rack_rotation)),
+                Gf.Vec3d(rack_position), 
+            )
+            
+            # Extract rotation from the transform
+            rotation = rack_to_tray_parent.ExtractRotation()
+            tray_rotation = Gf.Quatf(Gf.Rotation(rotation).GetQuat())
+        
+        for n, row in enumerate(tray_mask):
+            h = plane_height_list[n]
+            jig_z = h + plane_thickness / 2.0
+            tray_z = jig_z + 0.0343
+            for m, has_tray in enumerate(row):
+                if not has_tray:
+                    continue
+                tray_x = _jig_x(m, cylinder_radius, jig_gap)
+                tray_path = f"{_tray_parent}/Tray_{n}_{m}"
+                tray_xform = UsdGeom.Xform.Define(stage, tray_path)
+                tray_xform.GetPrim().GetReferences().AddReference(tray_usd_abs)
+                tray_xform.GetPrim().SetInstanceable(True)
+                
+                # Compute tray position and orientation
+                local_tray_pos = Gf.Vec3d(tray_x, jig_y, tray_z)
+                local_tray_pose = Gf.Matrix4d()
+                local_tray_pose.SetTransform(
+                    Gf.Rotation(Gf.Quatf(1, 0, 0, 0)),
+                    local_tray_pos, 
+                )
+                tray_xformable = UsdGeom.Xformable(tray_xform)
+                
+                if need_transform:
+                    # Transform from rack's local space to tray parent's local space
+                    tray_xformable.AddTransformOp().Set(local_tray_pose * rack_to_tray_parent)
+                else:
+                    # Tray is a child of rack, use local position only
+                    tray_xformable.AddTranslateOp().Set(local_tray_pos)
+
+    return root_xform
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Create a rack shelf with tray jigs and save as USD"
+    )
+    parser.add_argument(
+        "--output", "-o", type=str, default="rack_shelf_with_jig.usd",
+        help="Output .usd file path",
+    )
+    parser.add_argument(
+        "--jig_usd", type=str, default=None,
+        help="Path to the tray-jig USD asset",
+    )
+    parser.add_argument("--size_x", type=float, default=1.12)
+    parser.add_argument("--size_y", type=float, default=0.36)
+    parser.add_argument("--size_z", type=float, default=1.2)
+    parser.add_argument(
+        "--plane_heights", type=float, nargs="+",
+        default=[0.25, 0.55, 0.85, 1.15],
+        help="Z positions (centres) for each shelf plane",
+    )
+    parser.add_argument("--plane_thickness", type=float, default=0.03)
+    parser.add_argument("--cylinder_radius", type=float, default=0.015)
+    parser.add_argument("--jig_gap", type=float, default=0.015)
+    parser.add_argument(
+        "--jig_mask", type=str, default=None,
+        help='JSON 2-D array of booleans, e.g. \'[[true,false],[true,true]]\'',
+    )
+    parser.add_argument(
+        "--ids", type=str, default=None,
+        help='JSON 2-D array of int|null grid-ids, e.g. \'[[0,null],[2,3]]\'',
+    )
+    parser.add_argument(
+        "--label_image_dir", type=str, default=None,
+        help="Directory to save generated AprilGrid images",
+    )
+    args = parser.parse_args()
+
+    jig_mask = None
+    if args.jig_mask is not None:
+        jig_mask = json.loads(args.jig_mask)
+
+    ids = None
+    if args.ids is not None:
+        ids = json.loads(args.ids)
+
+    if os.path.exists(args.output):
+        os.remove(args.output)
+
+    stage = Usd.Stage.CreateNew(args.output)
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+
+    create_rack_shelf_with_tray_jig(
+        stage,
+        jig_usd_path=args.jig_usd,
+        size_x=args.size_x,
+        size_y=args.size_y,
+        size_z=args.size_z,
+        plane_height_list=args.plane_heights,
+        plane_thickness=args.plane_thickness,
+        cylinder_radius=args.cylinder_radius,
+        jig_gap=args.jig_gap,
+        jig_mask=jig_mask,
+        ids=ids,
+        label_image_dir=args.label_image_dir,
+    )
+
+    stage.GetRootLayer().Save()
+    print(f"Saved rack shelf with tray jigs to {args.output}")
+
+
+if __name__ == "__main__":
+    main()
