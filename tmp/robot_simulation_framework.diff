++#!/usr/bin/env python3
++"""Slice viewer for ``reach_volume.npz``: step through the volume along x, y, z.
++
++Writes one self-contained HTML with three panels (plotly JS embedded, no network).
++Each panel shows a 2D plane of the volume with a slider along its normal axis;
++cell colour = last step reached, blank = no step reached.
++
++    python .agent-workspace/tools/reach_volume/plot_reach_slices.py
++"""
++from __future__ import annotations
++
++import argparse
++import math
++import os
++
++import numpy as np
++import plotly.graph_objects as go
++
++DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "renders", "reach_volume")
++COLOURS = ["#1f77b4", "#17becf", "#2ca02c", "#bcbd22", "#ff7f0e", "#d62728", "#7f1f7f"]
++
++
++def discrete_scale(n):
++    """Stepped colourscale: level k (1..n) occupies [(k-1)/n, k/n]."""
++    sc = []
++    for k in range(n):
++        sc += [[k / n, COLOURS[k % len(COLOURS)]], [(k + 1) / n, COLOURS[k % len(COLOURS)]]]
++    return sc
++
++
++def fixed_axis(c, dtick=0.2):
++    """Axis settings that depend only on the data extent, never on the slice shown."""
++    half = (c[1] - c[0]) / 2.0
++    lo, hi = float(c[0]) - half, float(c[-1]) + half
++    first = math.ceil(lo / dtick - 1e-9) * dtick
++    return dict(range=[lo, hi], autorange=False, fixedrange=True, tickmode="linear",
++                tick0=round(first, 6), dtick=dtick, tickformat=".1f")
++
++
++def panel(levels, coords, phases, axis):
++    """Figure slicing *levels* perpendicular to *axis* (0=x, 1=y, 2=z)."""
++    names = "xyz"
++    n = len(phases)
++    h_ax, v_ax = [a for a in range(3) if a != axis]     # horizontal / vertical axes
++    steps, traces = [], []
++    for i, c in enumerate(coords[axis]):
++        sl = np.take(levels, i, axis=axis).astype(float)   # shape (h, v)
++        sl[sl == 0] = np.nan
++        traces.append(go.Heatmap(
++            x=coords[h_ax], y=coords[v_ax], z=sl.T, zmin=0.5, zmax=n + 0.5,
++            colorscale=discrete_scale(n), visible=(i == 0), xgap=0, ygap=0,
++            hovertemplate=(f"{names[h_ax]}=%{{x:.3f}}  {names[v_ax]}=%{{y:.3f}}"
++                           "  step=%{z:.0f}<extra></extra>"),
++            colorbar=dict(title="last step", tickvals=list(range(1, n + 1)),
++                          ticktext=[f"{k}: {p}" for k, p in enumerate(phases, 1)], len=0.9)))
++        reached = int(np.isfinite(sl).sum())
++        steps.append(dict(
++            method="update", label=f"{coords[axis][i]:+.3f}",
++            args=[{"visible": [j == i for j in range(len(coords[axis]))]},
++                  {"title": f"{names[axis]} = {coords[axis][i]:+.3f} m   "
++                            f"({reached} points reach a step)"}]))
++    fig = go.Figure(traces)
++    fig.update_layout(
++        title=f"{names[axis]} = {coords[axis][0]:+.3f} m",
++        xaxis=dict(title=f"{names[h_ax]} (m)", constrain="domain", **fixed_axis(coords[h_ax])),
++        yaxis=dict(title=f"{names[v_ax]} (m)", scaleanchor="x", constrain="domain",
++                   **fixed_axis(coords[v_ax])),
++        sliders=[dict(active=0, steps=steps, currentvalue=dict(prefix=f"{names[axis]} = "),
++                      pad=dict(t=40))],
++        height=700, margin=dict(t=60))
++    return fig
++
++
++def main() -> int:
++    ap = argparse.ArgumentParser()
++    ap.add_argument("--npz", default=os.path.join(DATA, "reach_volume.npz"))
++    ap.add_argument("--html", default=os.path.join(DATA, "reach_slices.html"))
++    args = ap.parse_args()
++    d = np.load(args.npz)
++    levels = d["levels"]
++    coords = [d["xs"], d["ys"], d["zs"]]
++    phases = [str(p) for p in d["phases"]]
++
++    parts = []
++    for axis in range(3):
++        parts.append(panel(levels, coords, phases, axis).to_html(
++            full_html=False, include_plotlyjs=(True if axis == 0 else False)))
++    page = ("<html><head><meta charset='utf-8'><title>Reach slices</title></head><body>"
++            "<h2>Reachability slices (grasp point, gripper +Y, robot base frame)</h2>"
++            + "<hr>".join(parts) + "</body></html>")
++    with open(args.html, "w", encoding="utf-8") as fh:
++        fh.write(page)
++    print("wrote", args.html)
++    return 0
++
++
++if __name__ == "__main__":
++    raise SystemExit(main())
