+"""Every converted grid point must equal the tray front-centre-bottom of the slot
+whose label centre sat at the original point, and carry the same level."""
+import os
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import convert_to_tray_frame as C   # noqa: E402
+import reach_volume as RV            # noqa: E402
+
+import cell_core.assets as A          # noqa: E402
+import cell_core.config as CFG        # noqa: E402
+import cell_core.frames as F          # noqa: E402
+
+
+def _fake():
+    xs, ys, zs = np.array([-0.2, 0.0, 0.3]), np.array([0.5, 0.6]), np.array([0.1, 0.4, 0.7, 0.9])
+    levels = np.arange(xs.size * ys.size * zs.size, dtype=np.int8).reshape(xs.size, ys.size, zs.size)
+    return dict(xs=xs, ys=ys, zs=zs, levels=levels, levels_ik=levels + 1,
+                phases=np.array(["a"]), preset=np.array("strict"))
+
+
+def test_points_and_levels_follow_the_slot_geometry():
+    d = _fake()
+    out = C.convert(d)
+    cfg = CFG.load_preset("strict")
+    a = np.array([0.0, 1.0, 0.0])
+    lat = F.lateral_axis(a)
+    for ix, x in enumerate(d["xs"]):
+        for iy, y in enumerate(d["ys"]):
+            for iz, z in enumerate(d["zs"]):
+                p = np.array([x, y, z])
+                s = RV.probe_slot(p, a, cfg)
+                lateral = s.lateral                                   # tray centre line
+                bottom = s.jig_origin_z + A.TRAY_BOT                  # rails' underside
+                front = s.label_plane_dist + A.LABEL_PROUD_OF_FACE + A.TRAY_FRONT_DEPTH
+                jx = int(np.argmin(abs(out["xs"] - lateral)))
+                jy = int(np.argmin(abs(out["ys"] - bottom)))
+                jz = int(np.argmin(abs(out["zs"] - front)))
+                assert np.isclose(out["xs"][jx], lateral) and np.isclose(out["ys"][jy], bottom)
+                assert np.isclose(out["zs"][jz], front)
+                assert out["levels"][jx, jy, jz] == d["levels"][ix, iy, iz]
+                assert out["levels_ik"][jx, jy, jz] == d["levels_ik"][ix, iy, iz]
+    assert np.isclose(lat @ np.array([1.0, 0, 0]), -1.0)              # lateral = -base X
+
+
+def test_axes_ascending_and_shape():
+    out = C.convert(_fake())
+    for k in ("xs", "ys", "zs"):
+        assert np.all(np.diff(out[k]) > 0)
+    assert out["levels"].shape == (3, 4, 2)
