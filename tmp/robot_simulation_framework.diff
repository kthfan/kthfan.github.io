+"""M6: time profiles for the cell's moves (pure)."""
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "motion"))
+
+import timing as P  # noqa: E402
+
+
+def _fd(t, x):
+    v = np.gradient(x, t, axis=0)
+    return v, np.gradient(v, t, axis=0)
+
+
+def test_trapezoid_reaches_cruise_when_long():
+    # 1 m at 0.25 m/s, 1.5 m/s^2: 1/6 s to cruise, T = L/v + v/a
+    assert P.trapezoid(1.0, 0.25, 1.5) == pytest.approx(4.0 + 0.25 / 1.5)
+
+
+def test_trapezoid_is_triangular_when_short():
+    assert P.trapezoid(0.01, 0.25, 1.5) == pytest.approx(2 * math.sqrt(0.01 / 1.5))
+
+
+def test_trapezoid_position_ends_and_is_monotone():
+    T = P.trapezoid(0.3, 0.25, 1.5)
+    t = np.linspace(0, T, 400)
+    s = P.trapezoid_s(0.3, 0.25, 1.5, t)
+    assert s[0] == pytest.approx(0.0) and s[-1] == pytest.approx(0.3)
+    assert np.all(np.diff(s) >= -1e-12)
+    v, a = _fd(t, s)
+    assert v.max() <= 0.25 + 1e-6
+    assert np.abs(a[2:-2]).max() <= 1.5 * 1.05
+
+
+def test_triangular_position_peaks_mid_way():
+    L, v, a = 0.01, 0.25, 1.5
+    T = P.trapezoid(L, v, a)
+    t = np.linspace(0, T, 401)
+    s = P.trapezoid_s(L, v, a, t)
+    assert s[200] == pytest.approx(L / 2, rel=1e-6)
+    vel, _ = _fd(t, s)
+    assert vel.max() == pytest.approx(math.sqrt(L * a), rel=1e-2)
+
+
+def test_unit_timing_respects_the_linear_caps():
+    caps = P.Caps(v=0.25, a=1.5, w=0.5, alpha=3.0)
+    t, u = P.unit_timing(0.4, 0.0, caps, dt=0.002)
+    assert t[0] == 0.0 and u[0] == 0.0 and u[-1] == pytest.approx(1.0)
+    assert np.allclose(np.diff(t), t[1] - t[0])
+    v, a = _fd(t, u * 0.4)
+    assert v.max() <= 0.25 * 1.001
+    assert np.abs(a[2:-2]).max() <= 1.5 * 1.05
+
+
+def test_unit_timing_respects_the_angular_caps_when_they_bind():
+    caps = P.Caps(v=0.25, a=1.5, w=0.5, alpha=3.0)
+    t, u = P.unit_timing(0.01, 1.0, caps, dt=0.002)
+    w, al = _fd(t, u * 1.0)
+    assert w.max() <= 0.5 * 1.001
+    assert w.max() >= 0.5 * 0.95
+    assert np.abs(al[2:-2]).max() <= 3.0 * 1.05
+
+
+def test_unit_timing_rejects_a_null_move():
+    with pytest.raises(ValueError):
+        P.unit_timing(0.0, 0.0, P.CARRY, dt=0.01)
+
+
+def test_joint_retime_scales_only_when_needed():
+    t = np.linspace(0, 1, 101)
+    q = np.column_stack([0.5 * (1 - np.cos(np.pi * t)), np.zeros_like(t)])
+    assert P.joint_retime(t, q, v_max=2.0, a_max=10.0) == 1.0
+    k = P.joint_retime(t, q, v_max=0.25 * np.pi, a_max=10.0)
+    assert k == pytest.approx(np.max(np.gradient(q[:, 0], t)) / (0.25 * np.pi), rel=1e-6)
+    k2 = P.joint_retime(t, q, v_max=10.0, a_max=0.5)
+    _, a = _fd(t * k2, q[:, 0])
+    assert np.abs(a).max() <= 0.5 * 1.0001
+    assert np.abs(a).max() >= 0.5 * 0.999
+
+
+def test_resample_keeps_the_ends_on_a_uniform_grid():
+    t = np.array([0.0, 0.3, 1.0])
+    q = np.array([[0.0, 1.0], [0.3, 1.0], [1.0, 0.0]])
+    t2, q2 = P.resample(t, q, dt=0.1)
+    assert t2[0] == 0.0 and t2[-1] == pytest.approx(1.0)
+    assert np.allclose(np.diff(t2), 0.1)
+    assert np.allclose(q2[0], q[0]) and np.allclose(q2[-1], q[-1])
+    assert np.allclose(q2[np.argmin(abs(t2 - 0.3))], q[1])
+
+
+def test_point_kinematics_of_a_circle():
+    r, w = 0.6, 0.5
+    t = np.linspace(0, 2, 2001)
+    Pts = np.column_stack([r * np.cos(w * t), r * np.sin(w * t), np.zeros_like(t)])
+    k = P.point_kinematics(t, Pts)
+    assert k["v"] == pytest.approx(r * w, rel=1e-3)
+    assert k["a"] == pytest.approx(r * w * w, rel=1e-2)
+    assert k["a_down"] == pytest.approx(0.0, abs=1e-6)
+
+
+def test_point_kinematics_reports_downward_acceleration():
+    t = np.linspace(0, 1, 1001)
+    Pts = np.column_stack([np.zeros_like(t), np.zeros_like(t), -0.5 * 3.0 * t ** 2])
+    assert P.point_kinematics(t, Pts)["a_down"] == pytest.approx(3.0, rel=1e-3)
+
+
+def test_angular_kinematics_of_a_spin():
+    t = np.linspace(0, 1, 1001)
+    th = 0.5 * 2.0 * t ** 2
+    R = np.array([[[math.cos(x), -math.sin(x), 0], [math.sin(x), math.cos(x), 0], [0, 0, 1]]
+                  for x in th])
+    k = P.angular_kinematics(t, R)
+    assert k["w"] == pytest.approx(2.0, rel=1e-2)
+    assert k["alpha"] == pytest.approx(2.0, rel=2e-2)
+
+
+def test_angular_kinematics_of_one_large_step():
+    R1 = np.array([[math.cos(1.0), -math.sin(1.0), 0], [math.sin(1.0), math.cos(1.0), 0], [0, 0, 1]])
+    assert P.angular_kinematics([0.0, 1.0], [np.eye(3), R1])["w"] == pytest.approx(1.0)
+
+
+def test_carry_caps_are_d14():
+    assert (P.CARRY.v, P.CARRY.a, P.CARRY.w, P.CARRY.alpha, P.CARRY.a_down) == (0.25, 1.5, 0.5, 3.0, 4.0)
