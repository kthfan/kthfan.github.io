+"""Reachability volume with cuRobo self-collision (program host).
+
+Same experiment as ``reach_volume.py`` (EAIK, grasp point on a
+grid, gripper +Y, seven phases walked in order, stop at the first failure), but a
+phase now counts as reached only if some exact, in-limit IK branch is also free of
+self-collision under cuRobo (arm + egu50 gripper spheres, jaws open).
+
+Both verdicts come out of one pass:
+
+* ``levels_ik``    - IK only. Must reproduce ``reach_volume.npz`` exactly.
+* ``levels``       - IK and self-collision-free (the new result).
+
+Usage (program host, from /workspace/robot-program)::
+
+    python3 _reach/reach_volume_curobo.py --out _reach/reach_volume_curobo.npz
+"""
+from __future__ import annotations
+
+import argparse
+import math
+import multiprocessing as mp
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "collision"))
+sys.path.insert(0, str(ROOT / "vendor"))
+
+import check_cell as CC                       # noqa: E402
+from cell_core import assets as ASSETS        # noqa: E402
+from cell_core import config as C             # noqa: E402
+from cell_core import frames as F             # noqa: E402
+from cell_core import geometry as G           # noqa: E402
+from cell_core import sequence as SEQ         # noqa: E402
+
+PHASES = SEQ.GRASP_PHASES
+APPROACH_Y = (0.0, 1.0, 0.0)
+CHUNK = 4096                                  # configurations per cuRobo call
+
+_W: dict = {}
+
+
+def probe_slot(point, approach, cfg) -> G.Slot:
+    """A slot whose AprilGrid centre sits at *point* (robot base frame)."""
+    a = np.asarray(approach, dtype=float)
+    a = a / np.linalg.norm(a)
+    p = np.asarray(point, dtype=float)
+    pt = cfg.racks[0].plane_thickness
+    return G.Slot(rack="probe", role="probe", layer=0, column=0,
+                  height=float(p[2]) - ASSETS.LABEL_MID_Z - pt / 2.0,
+                  lateral=float(p @ F.lateral_axis(a)),
+                  approach=tuple(a), label_plane_dist=float(p @ a), plane_thickness=pt)
+
+
+def _init(preset):
+    _W["ik"] = CC.load_ik(CC.URDF)
+    _W["cfg"] = C.load_preset(preset)
+
+
+def _ik_job(args):
+    """IK branches of one phase for a list of (index, point)."""
+    phase, items = args
+    out = []
+    for i, p in items:
+        T = SEQ.grasp_sequence(_W["cfg"], probe_slot(p, APPROACH_Y, _W["cfg"]))[phase]
+        out.append((i, [q.astype(np.float32) for q in CC.ik_branches(_W["ik"], T, 0.0)]))
+    return out
+
+
+def self_collides(cu, qs) -> np.ndarray:
+    """cuRobo self-collision verdict per configuration (True = colliding)."""
+    out = np.zeros(len(qs), dtype=bool)
+    for s in range(0, len(qs), CHUNK):
+        _, self_d = cu.sphere_costs(qs[s:s + CHUNK])
+        out[s:s + CHUNK] = self_d > 0.0           # same criterion as check_cell.pose_ok
+    return out
+
+
+def make_curobo(origin_z):
+    cu = CC.Curobo(origin_z)
+    cu.load([])                                   # world is irrelevant to the self term
+    return cu
+
+
+def run(points, preset, workers, cu):
+    """Return (levels_ik, levels_self, stats) for *points* (N, 3)."""
+    n = len(points)
+    lvl_ik = np.zeros(n, dtype=np.int8)
+    lvl_self = np.zeros(n, dtype=np.int8)
+    alive_ik = np.ones(n, dtype=bool)
+    alive_self = np.ones(n, dtype=bool)
+    stats = []
+    with mp.Pool(workers, initializer=_init, initargs=(preset,)) as pool:
+        for ph, name in enumerate(PHASES):
+            idx = np.flatnonzero(alive_ik)
+            t0 = time.time()
+            jobs = [(name, [(int(i), points[i]) for i in idx[s:s + 256]])
+                    for s in range(0, len(idx), 256)]
+            branches = {}
+            for res in pool.imap_unordered(_ik_job, jobs):
+                branches.update(dict(res))
+            flat = [(i, q) for i in idx for q in branches[int(i)]]
+            hit = (self_collides(cu, np.stack([q for _, q in flat])) if flat
+                   else np.zeros(0, dtype=bool))
+            free_pts = {int(i) for (i, _), h in zip(flat, hit) if not h}
+            ik_pts = {int(i) for i, _ in flat}
+            new_ik = np.zeros(n, dtype=bool)
+            new_self = np.zeros(n, dtype=bool)
+            new_ik[list(ik_pts)] = True
+            new_self[list(free_pts)] = True
+            alive_ik &= new_ik
+            alive_self &= new_self & alive_ik
+            lvl_ik[alive_ik] = ph + 1
+            lvl_self[alive_self] = ph + 1
+            stats.append({"phase": name, "points_in": int(len(idx)), "branches": len(flat),
+                          "branches_self_colliding": int(hit.sum()),
+                          "ik_reached": int(alive_ik.sum()), "self_free_reached": int(alive_self.sum())})
+            print(f"  {name:<11} in={len(idx):6d} branches={len(flat):7d} "
+                  f"self-colliding={int(hit.sum()):6d}  ik={int(alive_ik.sum()):6d} "
+                  f"free={int(alive_self.sum()):6d}  {time.time() - t0:5.0f}s", flush=True)
+    return lvl_ik, lvl_self, stats
+
+
+def validate(cu, preset, workers) -> bool:
+    """Every real slot of *preset* must reach every phase, as check_cell found."""
+    cfg = C.load_preset(preset)
+    pts = []
+    for s in G.enumerate_slots(cfg):
+        a = s.approach_vec / np.linalg.norm(s.approach_vec)
+        p = a * s.label_plane_dist + F.lateral_axis(a) * s.lateral
+        p[2] = s.label_centre_z - cfg.robot.origin_z
+        pts.append(p)
+    # Real approaches are not all +Y, so judge them one at a time with their own approach.
+    ik = CC.load_ik(CC.URDF)
+    ok = True
+    for s, p in zip(G.enumerate_slots(cfg), pts):
+        a = s.approach_vec / np.linalg.norm(s.approach_vec)
+        seq = SEQ.grasp_sequence(cfg, probe_slot(p, a, cfg))
+        for name in PHASES:
+            qs = CC.ik_branches(ik, seq[name], 0.0)
+            good = len(qs) > 0 and not self_collides(cu, np.stack(qs)).all()
+            if not good:
+                print(f"  validation: {s.key} {name} not self-free")
+                ok = False
+    return ok
+
+
+def axis(lo, hi, step):
+    return np.round(np.arange(lo, hi + step / 2, step), 6)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--preset", default="strict")
+    ap.add_argument("--step", type=float, default=0.05)
+    ap.add_argument("--x", type=float, nargs=2, default=(-1.2, 1.2))
+    ap.add_argument("--y", type=float, nargs=2, default=(0.0, 1.4))
+    ap.add_argument("--z", type=float, nargs=2, default=(-1.2, 1.2))
+    ap.add_argument("--workers", type=int, default=8)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    cfg = C.load_preset(args.preset)
+    cu = make_curobo(cfg.robot.origin_z)
+
+    print("validation against the real slots ...", flush=True)
+    if not validate(cu, args.preset, args.workers):
+        print("VERDICT validation_failed")
+        return 2
+    print("  validation ok")
+
+    xs, ys, zs = axis(*args.x, args.step), axis(*args.y, args.step), axis(*args.z, args.step)
+    X, Y, Z = np.meshgrid(xs, ys, zs, indexing="ij")
+    pts = np.stack([X.ravel(), Y.ravel(), Z.ravel()], axis=1)
+    print(f"grid {len(xs)}x{len(ys)}x{len(zs)} = {len(pts)} points, preset {args.preset}, "
+          f"{args.workers} workers", flush=True)
+    lvl_ik, lvl, stats = run(pts, args.preset, args.workers, cu)
+    shape = (len(xs), len(ys), len(zs))
+    Path(args.out).parent.mkdir(parents=True, exist_ok=True)
+    np.savez(args.out, xs=xs, ys=ys, zs=zs, levels=lvl.reshape(shape),
+             levels_ik=lvl_ik.reshape(shape), phases=np.array(PHASES), preset=args.preset)
+    print("level  step         ik_only  self_free")
+    for k in range(len(PHASES) + 1):
+        nm = "none" if k == 0 else PHASES[k - 1]
+        print(f"  {k}    {nm:<11} {int((lvl_ik == k).sum()):7d}  {int((lvl == k).sum()):7d}")
+    print("wrote", args.out)
+    return 0
+
+
+if __name__ == "__main__":
+    mp.freeze_support()
+    sys.exit(main())
