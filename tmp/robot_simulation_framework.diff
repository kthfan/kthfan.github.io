+def _ros_camera_info(config):
+    """``(width, height, K)`` of ``# Config <config>`` in eih_camera_intrinsics.md."""
+    text = INTRINSICS.read_text(encoding="utf-8")
+    block = re.split(r"^# Config (\d+)\s*$", text, flags=re.M)
+    block = dict(zip(block[1::2], block[2::2]))[str(config)]
+    k = re.search(r"^k:\n((?:- .*\n){9})", block, flags=re.M).group(1)
+    k = [float(v[2:]) for v in k.splitlines()]
+    w = int(re.search(r"^width: (\d+)", block, flags=re.M).group(1))
+    h = int(re.search(r"^height: (\d+)", block, flags=re.M).group(1))
+    return w, h, k
+
+
+@pytest.mark.skipif(not INTRINSICS.exists(), reason="calibration file not present")
