@@ -0,0 +1,216 @@
+"""Carrying a tray: the tilted pose, and release as the reverse of grasp.
+
+Two things are pinned here.
+
+**Tilt is a configured capability, not a chosen angle.** The angle depends on
+the friction coefficient, which nobody has measured, so these tests check that
+any angle in a sane range produces a sane pose — not that some particular angle
+is correct. When μ is measured, one config number changes and these tests still
+hold.
+
+**Release reuses grasp's poses.** The four mechanical poses form a rectangle in
+(depth, height); release traverses it backwards. If release ever starts deriving
+its own poses, the two paths can drift apart while both look right, so the tests
+below demand object-level reuse rather than numerical agreement.
+"""
+import dataclasses
+import math
+
+import numpy as np
+import pytest
+
+import cell_core.assets as A
+import cell_core.config as C
+import cell_core.geometry as G
+import cell_core.sequence as S
+
+
+@pytest.fixture
+def slot():
+    cfg = C.load_preset("as_built")
+    return G.enumerate_slots(cfg)[0]
+
+
+@pytest.fixture
+def cfg():
+    return C.load_preset("as_built")
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# The config field
+# ─────────────────────────────────────────────────────────────────────────────
+def test_tilt_defaults_to_zero_so_every_earlier_result_still_holds(cfg):
+    """The presets were swept without tilt. Adding the field must not move them."""
+    assert cfg.carry_tilt_deg == 0.0
+
+
+def test_both_shipped_presets_leave_tilt_unset():
+    for name in C.available_presets():
+        assert C.load_preset(name).carry_tilt_deg == 0.0
+
+
+def test_tilt_survives_a_save_load_round_trip(cfg, tmp_path):
+    tilted = dataclasses.replace(cfg, carry_tilt_deg=7.5)
+    path = tmp_path / "tilted.yaml"
+    C.save_config(tilted, path)
+    assert C.load_config(path).carry_tilt_deg == 7.5
+
+
+def test_a_negative_tilt_is_rejected(cfg):
+    """Tilting the tip down sheds the tray instead of retaining it."""
+    with pytest.raises(C.CellConfigError, match="tilt"):
+        C.validate(dataclasses.replace(cfg, carry_tilt_deg=-5.0))
+
+
+def test_an_absurd_tilt_is_rejected(cfg):
+    with pytest.raises(C.CellConfigError, match="tilt"):
+        C.validate(dataclasses.replace(cfg, carry_tilt_deg=90.0))
+
+
+def test_tilt_is_scannable(cfg):
+    assert "carry_tilt_deg" in C.SCAN_PARAMS
+    assert C.apply_override(cfg, "carry_tilt_deg", 10.0).carry_tilt_deg == 10.0
+    assert cfg.carry_tilt_deg == 0.0, "the original config was mutated"
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# The carry pose
+# ─────────────────────────────────────────────────────────────────────────────
+def test_zero_tilt_carry_is_exactly_the_withdraw_pose(slot):
+    """With no tilt there is nothing to do, and the poses must agree exactly."""
+    assert np.allclose(S.carry_pose(slot, 0.0), S.withdraw_pose(slot))
+
+
+def test_tilt_raises_the_plate_tip(slot):
+    """The retention mechanism: the tip goes up, so the tray settles backwards."""
+    flat = _tip_height(S.carry_pose(slot, 0.0))
+    tilted = _tip_height(S.carry_pose(slot, 10.0))
+    assert tilted > flat + 0.01
+
+
+def test_more_tilt_raises_the_tip_further(slot):
+    heights = [_tip_height(S.carry_pose(slot, d)) for d in (0.0, 5.0, 10.0, 15.0)]
+    assert heights == sorted(heights)
+    assert len(set(heights)) == 4
+
+
+def test_the_tip_rises_by_the_trigonometry_and_not_by_something_else(slot):
+    """Pin the magnitude, not just the direction.
+
+    A sign error or a degrees/radians slip would still raise the tip, just by
+    the wrong amount, so the direction test alone would pass through the bug.
+    """
+    deg = 12.0
+    rise = _tip_height(S.carry_pose(slot, deg)) - _tip_height(S.carry_pose(slot, 0.0))
+    assert rise == pytest.approx(
+        A.PLATE_FZ_TIP * math.sin(math.radians(deg)), abs=1e-6)
+
+
+def test_tilt_pivots_the_flange_without_moving_it(slot):
+    """The wrist stays put and the plate rotates about it.
+
+    If the flange translated too, the tilt would also change how far into the
+    aisle the arm is reaching, and the reachability result would be measuring
+    two changes at once.
+    """
+    flat = S.carry_pose(slot, 0.0)
+    tilted = S.carry_pose(slot, 12.0)
+    assert np.allclose(flat[:3, 3], tilted[:3, 3])
+    assert not np.allclose(flat[:3, :3], tilted[:3, :3])
+
+
+def test_the_carry_pose_stays_a_rigid_transform(slot):
+    R = S.carry_pose(slot, 14.0)[:3, :3]
+    assert np.allclose(R @ R.T, np.eye(3), atol=1e-12)
+    assert np.linalg.det(R) == pytest.approx(1.0)
+
+
+def test_carry_is_outside_the_shelf_which_is_why_tilting_there_is_safe(slot):
+    """Tilt is applied after withdrawal, in free space in front of the rack.
+
+    This is the whole reason the 'does it foul the shelf above' question was
+    deferred rather than answered: at this pose the plate is already clear of
+    the shelf face, so raising the tip has nothing above it to hit.
+    """
+    T = S.carry_pose(slot, 15.0)
+    depth = float(np.dot(T[:3, 3], slot.approach_vec / np.linalg.norm(slot.approach_vec)))
+    tip_depth = depth + A.PLATE_FZ_TIP * math.cos(math.radians(15.0))
+    assert tip_depth < slot.label_plane_dist
+
+
+def _tip_height(T):
+    """World height of the plate tip, given a flange pose.
+
+    The tip sits ``PLATE_FZ_TIP`` along the flange approach axis, so rotating
+    the flange swings it through an arc.
+    """
+    tip = T[:3, 3] + T[:3, :3] @ np.array([0.0, 0.0, A.PLATE_FZ_TIP])
+    return float(tip[2])
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# The sequence
+# ─────────────────────────────────────────────────────────────────────────────
+def test_carry_is_the_last_phase(cfg, slot):
+    assert S.GRASP_PHASES[-1] == "carry"
+    assert list(S.grasp_sequence(cfg, slot)) == list(S.GRASP_PHASES)
+
+
+def test_the_six_original_phases_kept_their_order(cfg, slot):
+    assert S.GRASP_PHASES[:6] == (
+        "sight_far", "sight_near", "pre_insert", "insert", "lift", "withdraw")
+
+
+def test_adding_carry_did_not_disturb_the_swept_poses(cfg, slot):
+    """findings/04 swept six poses. Those six must be bit-identical."""
+    seq = S.grasp_sequence(cfg, slot)
+    for phase, expected in (
+        ("sight_far", S.sighting_pose(slot, cfg.standoff_far)),
+        ("sight_near", S.sighting_pose(slot, cfg.standoff_near)),
+        ("pre_insert", S.pre_insert_pose(slot)),
+        ("insert", S.insert_pose(slot)),
+        ("lift", S.lift_pose(slot)),
+        ("withdraw", S.withdraw_pose(slot)),
+    ):
+        assert np.array_equal(seq[phase], expected), phase
+
+
+def test_the_sequence_takes_its_tilt_from_the_config(cfg, slot):
+    flat = S.grasp_sequence(cfg, slot)["carry"]
+    tilted = S.grasp_sequence(
+        dataclasses.replace(cfg, carry_tilt_deg=9.0), slot)["carry"]
+    assert not np.allclose(flat[:3, :3], tilted[:3, :3])
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Release
+# ─────────────────────────────────────────────────────────────────────────────
+def test_release_traverses_the_same_rectangle_backwards(cfg, slot):
+    assert S.RELEASE_PHASES == (
+        "carry", "withdraw", "lift", "insert", "pre_insert")
+
+
+def test_release_reuses_the_grasp_poses_rather_than_deriving_new_ones(cfg, slot):
+    """Numerically equal is not enough — they must be the same computation.
+
+    Two independently derived pose sets can agree today and drift tomorrow, with
+    nothing to catch it, because both would still look reasonable.
+    """
+    grasp = S.grasp_sequence(cfg, slot)
+    release = S.release_sequence(cfg, slot)
+    for phase in S.RELEASE_PHASES:
+        assert np.array_equal(release[phase], grasp[phase]), phase
+
+
+def test_release_has_no_sighting_phases(cfg, slot):
+    """The slot was read on the way in; there is no label to re-read on the way out."""
+    assert not [p for p in S.release_sequence(cfg, slot) if p.startswith("sight")]
+
+
+def test_release_ends_outside_the_shelf(cfg, slot):
+    """The arm must finish clear of the rack, or the next motion starts in a wall."""
+    release = S.release_sequence(cfg, slot)
+    last = release[S.RELEASE_PHASES[-1]]
+    a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+    tip_depth = float(np.dot(last[:3, 3], a)) + A.PLATE_FZ_TIP
+    assert tip_depth <= slot.label_plane_dist
