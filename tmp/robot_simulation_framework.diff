++def test_probe_slot_reproduces_real_poses(env):
++    """The probe slot must regenerate the exact flange poses of the real slot."""
++    _, _, _, _, cfg = env
++    for s in GEO.enumerate_slots(cfg):
++        p, a = _point(s, cfg.robot.origin_z)
++        real = SEQ.grasp_sequence(cfg, s)
++        probe = SEQ.grasp_sequence(cfg, RV.probe_slot(p, a, cfg))
++        for ph in RV.PHASES:
++            R = real[ph].copy()
++            R[2, 3] -= cfg.robot.origin_z
++            assert np.allclose(R, probe[ph], atol=1e-9), (s.key, ph)
