+"""for_show probe: why table scan views fail."""
+import sys
+import numpy as np
+sys.path.insert(0, "motion")
+import show as SH
+import planner as PL
+import paths as P
+from cell_core import config as C, geometry as G, sequence as SEQ
+
+cfg = C.load_preset("strict")
+slots = G.enumerate_slots(cfg)
+ik = PL.CC.load_ik(PL.CC.URDF)
+base = cfg.robot.base_pose
+table = next(s for s in slots if s.role == "inspection")
+cands = []
+for so in (0.45, 0.35, 0.30, 0.25):
+    for r in (0.0, 0.1, 0.2, 0.3):
+        T = SEQ.sighting_pose(table, so, r)
+        nb = len(PL.CC.ik_branches(ik, T, base))
+        p = T[:3, 3]
+        print("standoff %.2f rise %.1f flange %s radius %.3f branches %d"
+              % (so, r, np.round(p, 3).tolist(), np.hypot(p[0] - base[0, 3], p[1] - base[1, 3]), nb))
+        if nb:
+            cands.append((so, r, T))
+sp = SH.ShowPlanner(cfg, slots, ik)
+occ = frozenset(s.key for s in slots if s.role == "incoming")
+sp._world(occ)
+sp.mp.update_tool_pose_bounds({SH.FRAME: None})
+for so, r, T in [c for c in cands if c[0] <= 0.35][:8]:
+    res = sp.mp.plan_pose(sp._goal(T), sp._js(PL.HOME))
+    print("plan standoff %.2f rise %.1f:" % (so, r), bool(res.success.reshape(-1)[0]),
+          {k: str(getattr(res, k, None))[:150] for k in ("status", "valid_query", "debug_info")})
+print("result fields", [k for k in dir(res) if not k.startswith("_")])
