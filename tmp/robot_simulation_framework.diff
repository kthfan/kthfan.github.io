@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Reachability volume: which grasp step does each point in space reach?
+
+Reuses ``cell_core`` (pose sequence) and ``.agent-workspace/tools/reach_sweep.py``
+(EAIK solve, URDF limits, flange-frame correction), so the verdict means exactly
+what the slot sweep meant.
+
+A grid point is the centre of a tray's AprilGrid, in the robot base frame
+(origin at the base, +Z up). The gripper approaches along +Y, parallel to the
+ground, with the same rotation everywhere. The seven phases of
+``cell_core.sequence.grasp_sequence`` are derived from that point and walked in
+order; a point's level is the number of phases solved before the first failure
+(0 = nothing reached, 7 = whole sequence including carry).
+
+    python .agent-workspace/tools/reach_volume/reach_volume.py              # 50 mm grid, strict preset
+    python .agent-workspace/tools/reach_volume/reach_volume.py --step 0.1   # quick preview
+"""
+from __future__ import annotations
+
+import argparse
+import math
+import multiprocessing as mp
+import os
+import sys
+import time
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))
+RENDERS = os.path.join(ROOT, ".agent-workspace", "renders", "reach_volume")
+sys.path.insert(0, os.path.join(ROOT, "shared"))
+sys.path.insert(0, os.path.join(ROOT, ".agent-workspace", "tools"))
+
+import cell_core.assets as ASSETS            # noqa: E402
+import cell_core.config as CFG               # noqa: E402
+import cell_core.frames as F                 # noqa: E402
+import cell_core.geometry as GEO             # noqa: E402
+import cell_core.sequence as SEQ             # noqa: E402
+import reach_sweep as RS                     # noqa: E402
+
+PHASES = SEQ.GRASP_PHASES                    # level k  <=>  PHASES[k-1] reached
+DEFAULT_URDF = os.path.join(ROOT, "todo", "resources", "robot_config", "tm5s_v4.urdf")
+APPROACH_Y = (0.0, 1.0, 0.0)
+
+# per-process state, filled by _init()
+_S: dict = {}
+
+
+def probe_slot(point, approach, cfg) -> GEO.Slot:
+    """A slot whose AprilGrid centre sits at *point* (robot base frame).
+
+    The robot base is the origin, so ``origin_z`` is 0 everywhere downstream.
+    """
+    a = np.asarray(approach, dtype=float)
+    a = a / np.linalg.norm(a)
+    p = np.asarray(point, dtype=float)
+    pt = cfg.racks[0].plane_thickness
+    return GEO.Slot(
+        rack="probe", role="probe", layer=0, column=0,
+        height=float(p[2]) - ASSETS.LABEL_MID_Z - pt / 2.0,
+        lateral=float(p @ F.lateral_axis(a)),
+        approach=tuple(a), label_plane_dist=float(p @ a), plane_thickness=pt,
+    )
+
+
+def reach_level(bot, lo, hi, A, cfg, point, approach=APPROACH_Y):
+    """(level, per-phase ok flags) for one point; stops at the first failure."""
+    seq = SEQ.grasp_sequence(cfg, probe_slot(point, approach, cfg))
+    flags = []
+    for phase in PHASES:
+        r = RS.solve(bot, RS.to_base(seq[phase], 0.0, A), lo, hi)
+        if r["status"] != "ok":
+            break
+        flags.append(True)
+    return len(flags), flags
+
+
+def make_solver(urdf):
+    from eaik.IK_URDF import UrdfRobot
+    bot = UrdfRobot(RS.strip_urdf(urdf), [])
+    lo, hi, _ = RS.joint_limits(urdf)
+    return bot, lo, hi, RS.frame_correction(bot)
+
+
+def _init(urdf, preset):
+    bot, lo, hi, A = make_solver(urdf)
+    _S.update(bot=bot, lo=lo, hi=hi, A=A, cfg=CFG.load_preset(preset))
+
+
+def _row(args):
+    ix, x, ys, zs = args
+    out = np.zeros((len(ys), len(zs)), dtype=np.int8)
+    for iy, y in enumerate(ys):
+        for iz, z in enumerate(zs):
+            out[iy, iz], _ = reach_level(_S["bot"], _S["lo"], _S["hi"], _S["A"],
+                                         _S["cfg"], (x, y, z))
+    return ix, out
+
+
+def sweep(urdf, preset, xs, ys, zs, workers):
+    levels = np.zeros((len(xs), len(ys), len(zs)), dtype=np.int8)
+    jobs = [(i, x, ys, zs) for i, x in enumerate(xs)]
+    t0 = time.time()
+    with mp.Pool(workers, initializer=_init, initargs=(urdf, preset)) as pool:
+        for n, (ix, out) in enumerate(pool.imap_unordered(_row, jobs), 1):
+            levels[ix] = out
+            print(f"\r  x-slices {n}/{len(jobs)}  {time.time() - t0:5.0f}s", end="", flush=True)
+    print()
+    return levels
+
+
+def axis(lo, hi, step):
+    return np.round(np.arange(lo, hi + step / 2, step), 6)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--urdf", default=DEFAULT_URDF)
+    ap.add_argument("--preset", default="strict", help="cell_core preset (standoffs, carry tilt)")
+    ap.add_argument("--step", type=float, default=0.05, help="grid spacing, m")
+    ap.add_argument("--x", type=float, nargs=2, default=(-1.2, 1.2))
+    ap.add_argument("--y", type=float, nargs=2, default=(0.0, 1.4))
+    ap.add_argument("--z", type=float, nargs=2, default=(-1.2, 1.2))
+    ap.add_argument("--workers", type=int, default=max(1, (os.cpu_count() or 2) - 1))
+    ap.add_argument("--out", default=os.path.join(RENDERS, "reach_volume.npz"))
+    args = ap.parse_args()
+
+    xs, ys, zs = (axis(*args.x, args.step), axis(*args.y, args.step), axis(*args.z, args.step))
+    print(f"grid {len(xs)}x{len(ys)}x{len(zs)} = {len(xs) * len(ys) * len(zs)} points, "
+          f"preset {args.preset}, approach +Y, {args.workers} workers")
+    levels = sweep(args.urdf, args.preset, xs, ys, zs, args.workers)
+
+    print("points per level (0 = nothing reached):")
+    for k in range(len(PHASES) + 1):
+        name = "none" if k == 0 else PHASES[k - 1]
+        print(f"  {k}  {name:<11} {int((levels == k).sum())}")
+    np.savez(args.out, xs=xs, ys=ys, zs=zs, levels=levels, phases=np.array(PHASES),
+             preset=args.preset)
+    print("wrote", args.out)
+    return 0
+
+
+if __name__ == "__main__":
+    mp.freeze_support()
+    sys.exit(main())
