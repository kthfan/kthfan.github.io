+"""Where the ``.usd`` assets live, decided in one place.
+
+The stage builders need four binaries: the arm, the jig, the tray and the
+ground plane. Together they are about 45 MB, which is why they are not copied
+into this repo alongside the scripts that use them. Instead every builder takes
+an ``asset_root`` and this module decides what that means.
+
+Resolution order, most explicit first:
+
+1. the ``asset_root`` passed by the caller,
+2. the ``CELL_ASSET_ROOT`` environment variable,
+3. the first candidate directory that actually contains the assets.
+
+The third step is what makes the scripts work unchanged in two very different
+layouts: on a development machine the assets sit in the resource drop several
+directories up, while on the sim host they are deployed next to ``build_env``.
+A candidate only wins if the file is really there, so a half-deployed host fails
+here with a list of the places that were tried, rather than inside USD with a
+path that means nothing to the reader.
+
+Pure ``os.path``: no ``pxr``, no Isaac Sim, so the resolution rules are testable
+on any machine.
+"""
+import os
+
+#: Overrides every search path when set.
+ASSET_ENV_VAR = "CELL_ASSET_ROOT"
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+
+#: The assets the builders ask for, by role.
+ARM_USD = "tm5s.usd"
+JIG_USD = "tray_jig_with_label.usd"
+TRAY_USD = "tray.usd"
+GROUND_USD = "ground_plane.usd"
+
+#: Used to recognise a directory as an asset root. The jig is the right probe:
+#: every stage has one, and it is the smallest of the four, so the check stays
+#: cheap even over a network mount.
+PROBE_ASSET = JIG_USD
+
+#: Searched in order when nothing explicit is given. Relative to this file so
+#: that the answer does not depend on the working directory the sim was
+#: launched from.
+_RELATIVE_CANDIDATES = (
+    os.path.join(SCRIPT_DIR, "..", "assets"),
+    os.path.join(SCRIPT_DIR, "assets"),
+    os.path.join(SCRIPT_DIR, "..", "..", "todo", "resources", "isaacsim", "assets"),
+    os.path.join(SCRIPT_DIR, "..", "..", "..", "todo", "resources", "isaacsim", "assets"),
+)
+
+
+def candidate_roots(explicit=None):
+    """Every directory that would be consulted, in order, without testing them."""
+    roots = []
+    if explicit:
+        roots.append(explicit)
+    from_env = os.environ.get(ASSET_ENV_VAR)
+    if from_env:
+        roots.append(from_env)
+    roots.extend(_RELATIVE_CANDIDATES)
+    return [os.path.normpath(os.path.abspath(r)) for r in roots]
+
+
+def find_asset_root(explicit=None, probe=PROBE_ASSET):
+    """The first candidate root that really holds the assets.
+
+    An explicit root or ``CELL_ASSET_ROOT`` that does not contain *probe* is a
+    mistake worth reporting rather than silently falling past: it usually means
+    a deploy put the assets somewhere else, and quietly building the stage from
+    a different directory is how a sim stops matching the cell it claims to be.
+    """
+    tried = candidate_roots(explicit)
+    for root in tried:
+        if os.path.isfile(os.path.join(root, probe)):
+            return root
+    raise FileNotFoundError(
+        "could not find the USD assets: no directory below contains %r.\n"
+        "Set %s to the directory holding the .usd files, or pass asset_root.\n"
+        "Tried:\n  %s" % (probe, ASSET_ENV_VAR, "\n  ".join(tried)))
+
+
+def asset(name, root=None):
+    """Absolute path to asset *name*, resolved against the asset root."""
+    path = os.path.join(find_asset_root(root), name)
+    if not os.path.isfile(path):
+        raise FileNotFoundError(
+            "asset %r is missing from the asset root %r" % (name, os.path.dirname(path)))
+    return path
