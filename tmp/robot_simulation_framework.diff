+"""M6: judging a transfer against the D30 pass criteria (pure)."""
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "motion"))
+
+import judge as J  # noqa: E402
+import timing as TM  # noqa: E402
+
+ROBOT = "/Environment/RobotArmBase/RobotArm/tm5s"
+BASE = "/Environment/RobotArmBase"
+TRAY = "/Environment/Trays/Tray_0_0"
+
+
+def _T(p=(0, 0, 0), deg=0.0):
+    a = math.radians(deg)
+    T = np.eye(4)
+    T[:3, :3] = [[math.cos(a), -math.sin(a), 0], [math.sin(a), math.cos(a), 0], [0, 0, 1]]
+    T[:3, 3] = p
+    return T
+
+
+def test_quat_pose_matches_a_rotation_about_z():
+    h = math.radians(30) / 2
+    assert np.allclose(J.quat_pose((1, 2, 3), (math.cos(h), 0, 0, math.sin(h))), _T((1, 2, 3), 30))
+
+
+def test_pose_error_in_mm_and_deg():
+    assert J.pose_error(_T(), _T((0.003, 0, 0.004), 2.0)) == pytest.approx((5.0, 2.0))
+
+
+def test_tracking_reports_the_worst_sample():
+    planned = [_T(), _T((0.1, 0, 0))]
+    actual = [_T((0.0005, 0, 0)), _T((0.1, 0.0012, 0), 0.1)]
+    r = J.tracking(planned, actual)
+    assert r["mm"] == pytest.approx(1.2) and r["deg"] == pytest.approx(0.1)
+    assert not r["ok"]
+    assert J.tracking(planned, planned)["ok"]
+
+
+def _c(a0, a1):
+    return {"a0": a0, "a1": a1}
+
+
+def test_contacts_with_the_carried_tray_are_allowed():
+    cs = [_c(f"{ROBOT}/right_gripper", TRAY), _c(TRAY, f"{ROBOT}/link_6")]
+    assert J.bad_contacts(cs, ROBOT, BASE, TRAY) == []
+
+
+def test_contacts_with_another_tray_or_a_rack_fail():
+    other = "/Environment/Trays/Tray_0_1"
+    rack = "/Environment/RightRack"
+    cs = [_c(f"{ROBOT}/right_gripper", other), _c(rack, f"{ROBOT}/link_6")]
+    assert J.bad_contacts(cs, ROBOT, BASE, TRAY) == cs
+    assert J.bad_contacts([_c(f"{ROBOT}/link_6", TRAY)], ROBOT, BASE, None) == [_c(f"{ROBOT}/link_6", TRAY)]
+
+
+def test_the_base_may_sit_on_its_pedestal_but_the_wrist_may_not_touch_it():
+    plate = f"{BASE}/TopPlate"
+    assert J.bad_contacts([_c(f"{ROBOT}/link_0", plate)], ROBOT, BASE, None) == []
+    assert J.bad_contacts([_c(f"{ROBOT}/link_5", plate)], ROBOT, BASE, None) == [_c(f"{ROBOT}/link_5", plate)]
+
+
+def test_contacts_not_involving_the_robot_or_only_the_robot_are_ignored():
+    cs = [_c(TRAY, "/Environment/RightRack"), _c(f"{ROBOT}/link_6", f"{ROBOT}/right_gripper")]
+    assert J.bad_contacts(cs, ROBOT, BASE, None) == []
+
+
+def test_a_sibling_prim_sharing_the_prefix_is_not_the_robot():
+    c = _c(f"{ROBOT}_ghost/link_6", "/Environment/RightRack")
+    assert J.bad_contacts([c], ROBOT, BASE, None) == []
+    c = _c(f"{ROBOT}/link_0", f"{BASE}Extra/Top")
+    assert J.bad_contacts([c], ROBOT, BASE, None) == [c]
+
+
+def test_seated_pose_composes_the_offset():
+    off = _T((0.01, 0, -0.04))
+    assert np.allclose(J.seated_pose(_T((1, 0, 1), 90), off), _T((1, 0.01, 0.96), 90))
+
+
+def test_slip_bounds_the_farthest_corner():
+    ref = (0.0, 0.0, 0.2)
+    boxes = [((-0.001, 0, 0.2), (0.0, 0, 0.2)), ((0, 0, 0.2), (0.003, 0.004, 0.2))]
+    assert J.slip_mm(ref, boxes) == pytest.approx(5.0)
+    assert J.slip_mm(ref, [((-0.006, 0, 0.2), (0.001, 0, 0.2))]) == pytest.approx(6.0)
+    assert J.slip_mm(ref, []) == 0.0
+
+
+def test_caps_ok():
+    kin = {"v": 0.25, "a": 1.5, "w": 0.5, "alpha": 3.0, "a_down": 4.0}
+    assert J.caps_ok(kin, TM.CARRY)
+    for k in kin:
+        bad = dict(kin)
+        bad[k] *= 1.05
+        assert not J.caps_ok(bad, TM.CARRY), k
+
+
+def _run(name, rel=None, carried=False, lifting=False, track=False, kind="line", kin=None,
+         planned=(), flange=(), contacts=(), poses=None):
+    trays = {} if rel is None else {TRAY: {"rel_start": rel[0], "rel_end": rel[-1],
+                                           "rel_min": np.min(rel, axis=0).tolist(),
+                                           "rel_max": np.max(rel, axis=0).tolist()}}
+    return {"name": name, "kind": kind, "carried": carried, "lifting": lifting, "track": track,
+            "kin": kin, "planned": list(planned),
+            "report": {"samples": [{"t": 0.0, "flange": T.tolist()} for T in flange],
+                       "contacts": list(contacts), "trays": trays,
+                       "poses": poses or {TRAY: _T((1, 0, 0)).tolist()}}}
+
+
+KIN = {"v": 0.2, "a": 1.0, "w": 0.3, "alpha": 1.0, "a_down": 1.0}
+
+
+def _transfer(**over):
+    r = {
+        "insert": _run("insert", track=True, planned=[_T(), _T((0.1, 0, 0))],
+                       flange=[_T(), _T((0.1, 0.0005, 0))]),
+        "lift": _run("lift", rel=[(0.0, 0, 0.01), (0.0, 0, 0.0)], carried=True, lifting=True,
+                     track=True),
+        "close": _run("close", carried=True, kind="jaw"),
+        "withdraw": _run("withdraw", rel=[(0, 0, 0), (0.001, 0, 0)], carried=True, track=True,
+                         kin=KIN),
+        "sweep": _run("sweep", rel=[(0, 0, 0), (0, 0.002, 0)], carried=True, kind="sweep", kin=KIN,
+                      contacts=[_c(f"{ROBOT}/right_gripper", TRAY)]),
+        "lower": _run("lower", rel=[(0, 0, 0), (0, 0, 0.03)], carried=True, lifting=True, track=True),
+        "out": _run("out", track=True, poses={TRAY: _T((1.0005, 0, 0)).tolist()},
+                    planned=[_T()], flange=[_T()]),
+    }
+    r.update(over)
+    return list(r.values())
+
+
+def test_assess_a_good_transfer():
+    v = J.assess(_transfer(), TRAY, _T((1, 0, 0)), ROBOT, BASE)
+    assert v["ok"], v
+    assert v["seat_mm"] == pytest.approx(0.5)
+    assert v["slip_mm"] == pytest.approx(2.0)
+    assert v["track_mm"] == pytest.approx(0.5)
+
+
+def test_assess_catches_each_failure():
+    seat = _T((1, 0, 0))
+    far = _run("out", track=True, poses={TRAY: _T((1.003, 0, 0)).tolist()})
+    assert not J.assess(_transfer(out=far), TRAY, seat, ROBOT, BASE)["checks"]["placement"]
+    slid = _run("sweep", rel=[(0, 0, 0), (0, 0.006, 0)], carried=True, kind="sweep", kin=KIN)
+    assert not J.assess(_transfer(sweep=slid), TRAY, seat, ROBOT, BASE)["checks"]["slip"]
+    left = _run("sweep", carried=True, kind="sweep", kin=KIN)
+    v = J.assess(_transfer(sweep=left), TRAY, seat, ROBOT, BASE)
+    assert not v["checks"]["slip"] and v["slip_mm"] == math.inf
+    hit = _run("sweep", rel=[(0, 0, 0)], carried=True, kind="sweep", kin=KIN,
+               contacts=[_c(f"{ROBOT}/link_6", "/Environment/Tray_1_0")])
+    assert not J.assess(_transfer(sweep=hit), TRAY, seat, ROBOT, BASE)["checks"]["contacts"]
+    off = _run("insert", track=True, planned=[_T()], flange=[_T((0, 0, 0.0011))])
+    assert not J.assess(_transfer(insert=off), TRAY, seat, ROBOT, BASE)["checks"]["tracking"]
+    untracked = _run("insert", planned=[_T()], flange=[_T((0, 0, 0.0011))])
+    assert J.assess(_transfer(insert=untracked), TRAY, seat, ROBOT, BASE)["ok"]
+    fast = _run("withdraw", rel=[(0, 0, 0)], carried=True, track=True, kin={**KIN, "a": 2.0})
+    assert not J.assess(_transfer(withdraw=fast), TRAY, seat, ROBOT, BASE)["checks"]["caps"]
+
+
+def test_verdict_needs_every_criterion():
+    good = dict(seat=(1.9, 0.9), slip=4.9, contacts=[], track=0.9, kin_ok=True)
+    assert J.verdict(**good)["ok"]
+    for k, bad in (("seat", (2.1, 0.0)), ("seat", (0.0, 1.1)), ("slip", 5.1),
+                   ("contacts", [_c("a", "b")]), ("track", 1.1), ("kin_ok", False)):
+        v = J.verdict(**{**good, k: bad})
+        assert not v["ok"], k
