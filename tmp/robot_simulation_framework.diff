+"""M6: the program side of the seam, without ROS (EAIK, local)."""
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "motion"))
+
+import run_cell as RC  # noqa: E402
+import paths as PA  # noqa: E402
+import planner as PL  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import protocol as PR  # noqa: E402
+
+URDF = ROOT / "todo" / "resources" / "robot_config" / "tm5s_v4.urdf"
+BASE = F.make_pose([[-1, 0, 0], [0, -1, 0], [0, 0, 1]], (0.0, 0.0, 0.9))
+
+
+@pytest.fixture(scope="module")
+def ik():
+    return PA.CC.load_ik(str(URDF))
+
+
+def _planned(seg=None):
+    t = np.linspace(0.0, 1.0, 11)
+    Q = np.zeros((11, 8))
+    Q[:, 0] = np.linspace(0.0, 0.5, 11)
+    Q[:, 6:] = 0.05
+    return PL.Planned("free" if seg is None else seg.name, seg, t, Q, Q[:, :6], (0.05, 0.05),
+                      frozenset())
+
+
+def test_payload_is_a_rest_to_rest_trajectory_of_all_joints():
+    p = _planned()
+    d = PR.decode_trajectory(RC.payload("m0", p))
+    assert d["id"] == "m0" and d["joint_names"] == list(PR.JOINTS)
+    assert np.allclose(d["q"], p.Q) and np.allclose(d["t"], p.t)
+    assert np.allclose(d["qd"][[0, -1]], 0.0)
+    assert d["qd"][5, 0] == pytest.approx(0.5)
+
+
+def test_record_plans_the_flange_from_the_commanded_joints(ik):
+    p = _planned()
+    q = [0.3, -0.2, 1.0, 0.1, 0.4, 0.2]
+    rep = {"samples": [{"t": 0.0, "q_cmd": q + [0.05, 0.05]}], "contacts": [], "trays": {}}
+    r = RC.record(p, rep, ik, BASE)
+    assert r["name"] == "free" and r["kind"] == "free"
+    assert not (r["carried"] or r["lifting"] or r["track"]) and r["kin"] is None
+    assert np.allclose(r["planned"][0], PA.fk_world(ik, q, BASE))
+    assert r["report"] is rep
+
+
+def test_record_keeps_the_segment_flags(ik):
+    import transfer as TR
+    seg = TR.Seg("sweep", "sweep", None, None, 0.05, 0.05, None, None, True, False, False, frozenset())
+    p = _planned(seg)
+    p.kin = {"v": 0.1}
+    r = RC.record(p, {"samples": [], "contacts": [], "trays": {}}, ik, BASE)
+    assert (r["name"], r["kind"], r["carried"], r["lifting"], r["track"]) == ("sweep", "sweep", True, False, False)
+    assert r["kin"] == {"v": 0.1}
+    seg = TR.Seg("lift", "line", None, None, 0.05, 0.05, None, "s", False, True, True, frozenset())
+    r = RC.record(_planned(seg), {"samples": [], "contacts": [], "trays": {}}, ik, BASE)
+    assert (r["carried"], r["lifting"], r["track"]) == (False, True, True)
+
+
+def test_tray_follows_the_move():
+    at = {"a": "/T0", "b": "/T1"}
+    assert RC.moved(at, "a", "c") == {"c": "/T0", "b": "/T1"}
+    assert at == {"a": "/T0", "b": "/T1"}
+    with pytest.raises(KeyError):
+        RC.moved(at, "c", "d")
+    with pytest.raises(ValueError):
+        RC.moved(at, "a", "b")
