+"""M6: the segments of one tray transfer (pure)."""
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "motion"))
+
+import transfer as TR  # noqa: E402  (puts the vendored cell_core on the path)
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import sequence as SEQ  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def cfg():
+    return C.load_preset("strict")
+
+
+@pytest.fixture(scope="module")
+def slots(cfg):
+    return {s.key: s for s in G.enumerate_slots(cfg)}
+
+
+@pytest.fixture(scope="module")
+def segs(cfg, slots):
+    occ = frozenset(k for k in slots if k.startswith("incoming/"))
+    return TR.move_segments(cfg, slots["incoming/L0/C0"], slots["table/L0/C0"], occ)
+
+
+def _a(slot):
+    return slot.approach_vec / np.linalg.norm(slot.approach_vec)
+
+
+def test_approach_stands_back_from_pre_insert(slots):
+    s = slots["incoming/L1/C3"]
+    d = SEQ.pre_insert_pose(s)[:3, 3] - TR.approach_pose(s)[:3, 3]
+    assert np.allclose(d, _a(s) * TR.RETREAT)
+    assert np.allclose(TR.approach_pose(s)[:3, :3], SEQ.pre_insert_pose(s)[:3, :3])
+
+
+def _reach(T):
+    return math.hypot(T[0, 3], T[1, 3])
+
+
+def test_standing_back_keeps_the_flange_min_reach_off_the_base_axis(slots):
+    # Nearer the base axis the arm folds into itself (D30).
+    short = 0
+    for s in slots.values():
+        P, T = SEQ.pre_insert_pose(s), TR.approach_pose(s)
+        d = float((P[:3, 3] - T[:3, 3]) @ _a(s))
+        assert np.allclose(P[:3, 3] - T[:3, 3], _a(s) * d)
+        assert 0.0 < d <= TR.RETREAT + 1e-12
+        assert _reach(T) >= TR.MIN_REACH - 1e-9
+        if d < TR.RETREAT - 1e-9:
+            assert _reach(T) == pytest.approx(TR.MIN_REACH)
