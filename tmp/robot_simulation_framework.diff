diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/isaacsim/motion/sim_cell.py" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/isaacsim/motion/sim_cell.py"
