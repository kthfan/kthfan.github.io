@@ -0,0 +1,343 @@
+"""M6: the simulated cell on the ROS2 seam (D30).
+
+    LD_LIBRARY_PATH=$I/exts/isaacsim.ros2.bridge/humble/lib:... RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
+    ROS_DOMAIN_ID=37 $I/python.sh motion/sim_cell.py --stage _stage/strict/cell.usd --preset strict
+
+Opens the stage with the D30 physics (tray 1.2 kg, racks and table kinematic,
+contact reports on the robot), publishes ``/joint_states``, executes each
+``/cell/trajectory`` and answers on ``/cell/status`` (:mod:`cell_core.protocol`).
+Everything it computes lives in :mod:`cell_report`; this file only talks to Isaac.
+"""
+import argparse
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(os.path.dirname(HERE), "vendor"))
+
+import cell_report as R  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import protocol as PR  # noqa: E402
+from cell_core import scene as S  # noqa: E402
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--stage", required=True)
+ap.add_argument("--preset", default="strict")
+ap.add_argument("--wall", type=float, default=36000.0, help="exit after this many seconds")
+ap.add_argument("--settle", type=float, default=1.0, help="physics settle before ready (s)")
+ap.add_argument("--hold", type=float, default=0.5, help="hold after a trajectory before done (s)")
+ap.add_argument("--plate-friction", type=float, nargs=2, metavar=("STATIC", "DYNAMIC"),
+                help="override the arm's physics materials (the Teflon plate), combine mode max")
+ap.add_argument("--stream", action="store_true", help="WebRTC livestream (Isaac Sim WebRTC Streaming Client)")
+ap.add_argument("--record", metavar="MP4", help="record the trajectories (sim time) from a show camera; SIGTERM finalizes")
+ap.add_argument("--record-fps", type=int, default=30)
+ap.add_argument("--record-res", type=int, nargs=2, default=(1280, 720), metavar=("W", "H"))
+ap.add_argument("--cam-eye", type=float, nargs=3, default=(0.0, -2.6, 2.2), metavar=("X", "Y", "Z"))
+ap.add_argument("--cam-target", type=float, nargs=3, default=(0.0, 0.2, 0.9), metavar=("X", "Y", "Z"))
+ap.add_argument("--cam-focal", type=float, default=18.0, help="focal length (mm), 20.955 mm aperture")
+args = ap.parse_args()
+
+from isaacsim import SimulationApp  # noqa: E402
+
+app = SimulationApp({"headless": True})
+
+from isaacsim.core.utils.extensions import enable_extension  # noqa: E402
+
+enable_extension("isaacsim.ros2.bridge")
+if args.stream:
+    app.set_setting("/app/window/drawMouse", True)
+    enable_extension("omni.services.livestream.nvcf")
+    enable_extension("omni.kit.livestream.webrtc")
+    enable_extension("omni.services.transport.server.http")
+if args.record:
+    enable_extension("omni.replicator.core")
+app.update()
+
+import omni.physx  # noqa: E402
+import omni.usd  # noqa: E402
+import rclpy  # noqa: E402
+from isaacsim.core.api import SimulationContext  # noqa: E402
+from isaacsim.core.prims import RigidPrim, SingleArticulation  # noqa: E402
+from isaacsim.core.utils.types import ArticulationAction  # noqa: E402
+from pxr import PhysicsSchemaTools, PhysxSchema, Usd, UsdGeom, UsdPhysics  # noqa: E402
+from sensor_msgs.msg import JointState  # noqa: E402
+from std_msgs.msg import String  # noqa: E402
+
+ARM = "/Environment/RobotArmBase/RobotArm"
+BASE = "/Environment/RobotArmBase"
+HZ = 120
+TRAY_MASS = 1.2
+HOME = np.array([0.0] * 6 + [A.JAW_Q_OPEN] * 2)
+
+
+def log(*a):
+    print("[sim_cell]", *a, flush=True)
+
+
+def usd_world(prim):
+    m = UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(Usd.TimeCode.Default())
+    return np.array([[m[i][j] for j in range(4)] for i in range(4)]).T
+
+
+def first_named(stage, root, name):
+    for p in Usd.PrimRange(stage.GetPrimAtPath(root)):
+        if p.GetName() == name:
+            return p
+    raise RuntimeError(f"no {name} under {root}")
+
+
+def poses(view):
+    p, q = view.get_world_poses()
+    p, q = np.asarray(p, dtype=float), np.asarray(q, dtype=float)
+    return [R.pose(p[i], q[i]) for i in range(len(p))]
+
+
+# ── stage and physics ───────────────────────────────────────────────────────
+ctx = omni.usd.get_context()
+ctx.open_stage(os.path.abspath(args.stage))
+for _ in range(600):
+    app.update()
+    if not ctx.get_stage_loading_status()[2]:
+        break
+stage = ctx.get_stage()
+
+root = [p for p in Usd.PrimRange(stage.GetPrimAtPath(ARM)) if p.HasAPI(UsdPhysics.ArticulationRootAPI)][0]
+bodies = [p for p in stage.Traverse() if p.HasAPI(UsdPhysics.RigidBodyAPI)]
+robot = [p for p in bodies if str(p.GetPath()).startswith(ARM + "/")]
+trays = sorted((p for p in bodies if "/Tray_" in str(p.GetPath())), key=lambda p: str(p.GetPath()))
+fixed = [p for p in bodies if p not in robot and p not in trays and not str(p.GetPath()).startswith(BASE)]
+for p in trays:
+    UsdPhysics.MassAPI.Apply(p).CreateMassAttr(TRAY_MASS)
+for p in fixed:
+    UsdPhysics.RigidBodyAPI(p).CreateKinematicEnabledAttr(True)
+for p in robot:
+    PhysxSchema.PhysxContactReportAPI.Apply(p).CreateThresholdAttr(0.0)
+if args.plate_friction:
+    for p in Usd.PrimRange(stage.GetPrimAtPath(ARM)):
+        if p.HasAPI(UsdPhysics.MaterialAPI):
+            m = UsdPhysics.MaterialAPI(p)
+            m.CreateStaticFrictionAttr(args.plate_friction[0])
+            m.CreateDynamicFrictionAttr(args.plate_friction[1])
+            PhysxSchema.PhysxMaterialAPI.Apply(p).CreateFrictionCombineModeAttr("max")
+            log("friction", p.GetPath(), args.plate_friction, "combine max")
+link6 = first_named(stage, ARM, "link_6")
+flange_in_link6 = R.inv(usd_world(link6)) @ usd_world(first_named(stage, ARM, "flange"))
+tray_names = [str(p.GetPath()) for p in trays]
+log("root", root.GetPath(), "robot bodies", len(robot), "trays", len(trays),
+    "kinematic", [str(p.GetPath()) for p in fixed], "link_6", link6.GetPath())
+
+sim = SimulationContext(physics_dt=1.0 / HZ, rendering_dt=1.0 / HZ, stage_units_in_meters=1.0)
+sim.initialize_physics()
+art = SingleArticulation(prim_path=str(root.GetPath()), name="arm")
+link6_view = RigidPrim(str(link6.GetPath()), name="link6")
+tray_view = RigidPrim(tray_names, name="trays") if tray_names else None
+sim.play()
+art.initialize()
+link6_view.initialize()
+if tray_view is not None:
+    tray_view.initialize()
+names = list(art.dof_names)
+if sorted(names) != sorted(PR.JOINTS):
+    raise RuntimeError(f"stage dofs {names} are not the protocol's {PR.JOINTS}")
+order = [names.index(j) for j in PR.JOINTS]  # protocol index -> dof index
+sim_iface = omni.physx.get_physx_simulation_interface()
+
+
+def q_now():
+    return np.asarray(art.get_joint_positions(), dtype=float)[order]
+
+
+def command(q, qd=None):
+    pos = np.zeros(len(names))
+    pos[order] = q
+    vel = None
+    if qd is not None:
+        vel = np.zeros(len(names))
+        vel[order] = qd
+    art.apply_action(ArticulationAction(joint_positions=pos, joint_velocities=vel))
+
+
+def flange_now():
+    return poses(link6_view)[0] @ flange_in_link6
+
+
+def trays_now():
+    return dict(zip(tray_names, poses(tray_view))) if tray_view is not None else {}
+
+
+def contacts():
+    heads, data = sim_iface.get_contact_report()
+    out = []
+    for h in heads:
+        imp = sum(float(np.linalg.norm(data[k].impulse))
+                  for k in range(h.contact_data_offset, h.contact_data_offset + h.num_contact_data))
+        out.append((str(PhysicsSchemaTools.intToSdfPath(h.actor0)), str(PhysicsSchemaTools.intToSdfPath(h.actor1)),
+                    str(PhysicsSchemaTools.intToSdfPath(h.collider0)),
+                    str(PhysicsSchemaTools.intToSdfPath(h.collider1)), imp))
+    return out
+
+
+held = HOME.copy()
+command(held)
+for _ in range(int(args.settle * HZ)):
+    sim.step(render=False)
+    contacts()
+cfg = C.load_preset(args.preset)
+# M6 (D30): the jigs as built, a ground-truth stand-in for M4 locating.
+jigs = {s.key: usd_world(stage.GetPrimAtPath(R.jig_prim(s))) for s in G.enumerate_slots(cfg)}
+boxes = {s.key: S.tray_box(S.located(s, jigs[s.key])).T for s in G.enumerate_slots(cfg)}
+t0_trays = trays_now()
+where = R.match_trays(t0_trays, boxes)
+offset = R.seat_offset(t0_trays, boxes, where) if where else np.eye(4)
+log("trays", json.dumps(where), "offset", np.round(offset, 5).tolist(), "q", np.round(q_now(), 5).tolist())
+
+# ── show camera ─────────────────────────────────────────────────────────────
+video, annot, frames, stopping = None, None, 0, []
+if args.record:
+    import signal
+    import subprocess
+
+    import omni.replicator.core as replicator
+    from PIL import Image
+    from pxr import Gf, UsdLux
+
+    with Usd.EditContext(stage, stage.GetSessionLayer()):  # the built stage has no lights (render_locating)
+        UsdLux.DomeLight.Define(stage, "/ShowDomeLight").CreateIntensityAttr().Set(2000.0)
+        key = UsdLux.DistantLight.Define(stage, "/ShowDistantLight")
+        key.CreateIntensityAttr().Set(4000.0)
+        UsdGeom.Xformable(key).AddOrientOp(UsdGeom.XformOp.PrecisionDouble).Set(
+            Gf.Quatd(-0.14644661, 0.35355339, 0.35355339, 0.85355339))
+
+    w, h = args.record_res
+    cam = UsdGeom.Camera.Define(stage, "/ShowCamera")
+    cam.CreateFocalLengthAttr(args.cam_focal)
+    cam.CreateHorizontalApertureAttr(20.955)
+    cam.CreateVerticalApertureAttr(20.955 * h / w)
+    cam.CreateClippingRangeAttr(Gf.Vec2f(0.05, 100.0))
+    M = R.look_at(args.cam_eye, args.cam_target)
+    UsdGeom.Xformable(cam).AddTransformOp().Set(Gf.Matrix4d(*[float(v) for v in M.T.flatten()]))
+    annot = replicator.AnnotatorRegistry.get_annotator("rgb")
+    annot.attach([replicator.create.render_product("/ShowCamera", (w, h))])
+    for _ in range(30):
+        sim.render()
+    still = np.asarray(annot.get_data(), dtype=np.uint8)
+    if still.size == w * h * 4:
+        Image.fromarray(still.reshape(h, w, 4)[:, :, :3]).save(os.path.splitext(args.record)[0] + "_preview.png")
+    log("preview", still.shape, "mean", float(still.mean()) if still.size else None)
+    os.makedirs(os.path.dirname(os.path.abspath(args.record)), exist_ok=True)
+    video = subprocess.Popen(["ffmpeg", "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgba",
+                              "-s", f"{w}x{h}", "-r", str(args.record_fps), "-i", "-", "-c:v", "libx264",
+                              "-pix_fmt", "yuv420p", "-crf", "20", args.record], stdin=subprocess.PIPE)
+    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
+    log("recording", args.record, f"{w}x{h}@{args.record_fps}", "eye", args.cam_eye, "target", args.cam_target)
+every = max(1, HZ // args.record_fps)
+
+# ── ROS ─────────────────────────────────────────────────────────────────────
+rclpy.init()
+node = rclpy.create_node("cell_sim")
+js_pub = node.create_publisher(JointState, PR.TOPIC_JOINT_STATES, 10)
+st_pub = node.create_publisher(String, PR.TOPIC_STATUS, 10)
+inbox = []
+node.create_subscription(String, PR.TOPIC_TRAJECTORY, lambda m: inbox.append(m.data), 10)
+
+
+def status(tid, state, **fields):
+    st_pub.publish(String(data=PR.encode_status(tid, state, **fields)))
+
+
+def full(traj):
+    """Expand a decoded trajectory to all protocol joints (missing ones hold)."""
+    idx = [PR.JOINTS.index(n) for n in traj["joint_names"]]
+    n = len(traj["t"])
+    q = np.repeat(held[None, :], n, axis=0)
+    qd = np.zeros_like(q)
+    q[:, idx], qd[:, idx] = traj["q"], traj["qd"]
+    return {**traj, "q": q, "qd": qd, "joint_names": list(PR.JOINTS)}
+
+
+step, tid_last, wall0, ready_at = 0, "", time.time(), 0.0
+active, rec, t_run = None, None, 0.0
+
+
+def publish_js():
+    m = JointState()
+    m.header.stamp.sec = int(step // HZ)
+    m.header.stamp.nanosec = int((step % HZ) / HZ * 1e9)
+    m.name = list(PR.JOINTS)
+    m.position = [float(v) for v in q_now()]
+    js_pub.publish(m)
+
+
+while time.time() - wall0 < args.wall and not stopping:
+    rclpy.spin_once(node, timeout_sec=0.0)
+    if active is None and inbox:
+        text = inbox.pop(0)
+        try:
+            traj = full(PR.decode_trajectory(text))
+        except PR.ProtocolError as e:
+            status("?", "rejected", reason=str(e))
+            log("rejected payload", e)
+            continue
+        err = R.start_error(q_now(), traj["q"][0])
+        if err > R.START_TOL:
+            status(traj["id"], "rejected", reason=f"start is {err:.4f} from the current joints",
+                   q=q_now())
+            log("rejected", traj["id"], err)
+            continue
+        active, t_run = traj, 0.0
+        rec = R.Recorder(traj["id"], ARM, tray_names, trays_now(), flange_now())
+        status(traj["id"], "accepted")
+        log("accepted", traj["id"], "%.2f s" % traj["t"][-1])
+    if active is not None:
+        q, qd = PR.sample(active, t_run)
+        command(q, qd)
+        held = q
+    sim.step(render=False)
+    step += 1
+    if video is not None and active is not None and step % every == 0:
+        sim.render()
+        frame = np.asarray(annot.get_data(), dtype=np.uint8)
+        if frame.size == w * h * 4:
+            video.stdin.write(frame.tobytes())
+            frames += 1
+    if active is not None:
+        t_run += 1.0 / HZ
+        for c in contacts():
+            rec.contact(t_run, *c)
+        L6 = poses(link6_view)[0]
+        rec.step(t_run, held, q_now(), L6 @ flange_in_link6, L6, trays_now())
+        if t_run >= active["t"][-1] + args.hold:
+            rep = rec.report()
+            tn = trays_now()
+            status(active["id"], "done", q=q_now(), poses={n: tn[n] for n in tray_names},
+                   flange=flange_now(), **rep)
+            log("done", active["id"], "contacts", len(rep["contacts"]), "moved", list(rep["trays"]),
+                "frames", frames)
+            tid_last, active = active["id"], None
+    else:
+        contacts()
+        if step % 2 == 0:
+            publish_js()
+        if time.time() >= ready_at:
+            status(tid_last or "-", "ready", q=q_now(), where=where, offset=offset,
+                   poses=trays_now(), flange_in_link6=flange_in_link6, jigs=jigs)
+            ready_at = time.time() + 1.0
+        time.sleep(max(0.0, 1.0 / HZ - 0.002))
+    if active is not None and step % 2 == 0:
+        publish_js()
+
+log("stopped" if stopping else "wall reached", "; exiting")
+if video is not None:
+    video.stdin.close()
+    video.wait(timeout=300)
+    log("video", args.record, "frames", frames, "%.1f s" % (frames / args.record_fps), "ffmpeg rc", video.returncode)
+node.destroy_node()
+rclpy.shutdown()
+app.close()
