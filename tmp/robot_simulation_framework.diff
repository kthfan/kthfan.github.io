@@ -0,0 +1,236 @@
+"""Create a robot-arm assembly: cuboid base -> four cylinder legs -> robot arm (tm5s.usd)."""
+
+from pxr import Usd, UsdGeom, UsdPhysics, Gf, Sdf, UsdSemantics, Vt
+import argparse
+import math
+import os
+import sys
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+if SCRIPT_DIR not in sys.path:
+    sys.path.insert(0, SCRIPT_DIR)
+
+import asset_paths
+
+def has_translate_op(prim):
+    xformable = UsdGeom.Xformable(prim)
+    for op in xformable.GetOrderedXformOps():
+        if op.GetOpType() == UsdGeom.XformOp.TypeTranslate:
+            return True
+    return False
+
+def create_robot_arm_base(
+    stage,
+    arm_usd_path=None,
+    root_path="/RobotArmBase",
+    leg_height=0.5,
+    leg_gap=0.1,
+    asset_root=None,
+):
+    """Build a robot-arm pedestal under *root_path* on the given USD *stage*.
+
+    Layout (bottom to top, Z-up):
+        1. Cuboid base   – 0.55 x 0.55 x 0.25, mass 50000 kg, resting on Z=0
+        2. Four cylinder legs – radius 0.02, height *leg_height*, mass 3 kg each
+        3. Robot arm      – referenced from *arm_usd_path*
+
+    Parameters
+    ----------
+    stage : Usd.Stage
+    arm_usd_path : str or None
+        Path to the robot-arm USD file. ``None`` resolves it from *asset_root*.
+    root_path : str
+    leg_height : float
+        Height of each cylinder leg (metres).
+    leg_gap : float
+        Gap between adjacent leg centres (metres).  Leg centres are placed at
+        ±(leg_gap/2 + leg_radius) from the assembly centre on each axis.
+    asset_root : str or None
+        Directory holding the ``.usd`` assets; see ``asset_paths``.
+
+    Returns
+    -------
+    UsdGeom.Xform – the root prim.
+    """
+    if arm_usd_path is None:
+        arm_usd_path = asset_paths.asset(asset_paths.ARM_USD, asset_root)
+
+    base_sx, base_sy, base_sz = 0.55, 0.55, 0.1765
+    leg_radius = 0.02
+    base_mass = 50000.0
+    leg_mass = 3.0
+
+    # Root Xform ----------------------------------------------------------
+    root_xform = UsdGeom.Xform.Define(stage, root_path)
+    root_prim = root_xform.GetPrim()
+    stage.SetDefaultPrim(root_prim)
+
+    # -- Cuboid base ------------------------------------------------------
+    base_path = f"{root_path}/Base"
+    base_cube = UsdGeom.Cube.Define(stage, base_path)
+    base_prim = base_cube.GetPrim()
+
+    UsdPhysics.CollisionAPI.Apply(base_prim)
+    UsdPhysics.RigidBodyAPI.Apply(base_prim)
+    mass_api = UsdPhysics.MassAPI.Apply(base_prim)
+    mass_api.GetMassAttr().Set(base_mass)
+    UsdSemantics.LabelsAPI.Apply(base_prim, "class").GetLabelsAttr().Set(Vt.TokenArray(["robot_base"]))
+
+    xf = UsdGeom.Xformable(base_cube)
+    # Centre of base at z = base_sz / 2
+    xf.AddTranslateOp().Set(Gf.Vec3d(0.0, 0.0, base_sz / 2.0))
+    # Cube spans [-1,1]^3 by default, scale to half-extents
+    xf.AddScaleOp().Set(Gf.Vec3f(base_sx / 2.0, base_sy / 2.0, base_sz / 2.0))
+
+    # -- Four cylinder legs -----------------------------------------------
+    # Legs sit on top of the base (z = base_sz .. base_sz + leg_height).
+    # leg_gap is the clear space between the two legs on each axis;
+    # leg centres are therefore at ±(leg_gap/2 + leg_radius) from origin.
+    half_span = leg_gap / 2.0 + leg_radius
+    corner_signs = [(-1, -1), (1, -1), (-1, 1), (1, 1)]
+
+    for i, (sx, sy) in enumerate(corner_signs):
+        leg_path = f"{root_path}/Leg_{i}"
+        cyl = UsdGeom.Cylinder.Define(stage, leg_path)
+        cyl.GetRadiusAttr().Set(leg_radius)
+        cyl.GetHeightAttr().Set(leg_height)
+        cyl.GetAxisAttr().Set("Z")
+
+        leg_prim = cyl.GetPrim()
+        UsdPhysics.CollisionAPI.Apply(leg_prim)
+        UsdPhysics.RigidBodyAPI.Apply(leg_prim)
+        leg_mass_api = UsdPhysics.MassAPI.Apply(leg_prim)
+        leg_mass_api.GetMassAttr().Set(leg_mass)
+        UsdSemantics.LabelsAPI.Apply(leg_prim, "class").GetLabelsAttr().Set(Vt.TokenArray(["robot_base"]))
+
+        # Fixed joint to base so legs don't fall off.
+        # Joint anchor in world: (sx*half_span, sy*half_span, base_sz)
+        # localPos0 (Base frame): base has translate(0,0,base_sz/2) + scale(base_sx/2, base_sy/2, base_sz/2)
+        #   => local = (world - translate) / scale
+        # localPos1 (Leg frame):  leg has translate only => local = world - translate
+        joint_path = f"{leg_path}/FixedJoint"
+        joint = UsdPhysics.FixedJoint.Define(stage, joint_path)
+        joint.GetBody0Rel().SetTargets([Sdf.Path(base_path)])
+        joint.GetBody1Rel().SetTargets([Sdf.Path(leg_path)])
+        joint.CreateLocalPos0Attr().Set(
+            Gf.Vec3f(
+                sx * half_span / (base_sx / 2.0),
+                sy * half_span / (base_sy / 2.0),
+                1.0,  # top of the unit cube
+            )
+        )
+        joint.CreateLocalPos1Attr().Set(
+            Gf.Vec3f(0.0, 0.0, -leg_height / 2.0)  # bottom of the cylinder
+        )
+
+        xf_leg = UsdGeom.Xformable(cyl)
+        xf_leg.AddTranslateOp().Set(
+            Gf.Vec3d(sx * half_span, sy * half_span, base_sz + leg_height / 2.0)
+        )
+
+    # -- Top plate (flat cylinder covering all four legs) -----------------
+    # Radius just reaches the outer edge of the diagonal leg.
+    plate_thickness = 0.03
+    plate_radius = math.sqrt(2.0) * half_span + leg_radius
+    plate_z = base_sz + leg_height  # sits on top of legs
+
+    plate_path = f"{root_path}/TopPlate"
+    plate_cyl = UsdGeom.Cylinder.Define(stage, plate_path)
+    plate_cyl.GetRadiusAttr().Set(plate_radius)
+    plate_cyl.GetHeightAttr().Set(plate_thickness)
+    plate_cyl.GetAxisAttr().Set("Z")
+
+    plate_prim = plate_cyl.GetPrim()
+    UsdPhysics.CollisionAPI.Apply(plate_prim)
+    UsdPhysics.RigidBodyAPI.Apply(plate_prim)
+    UsdSemantics.LabelsAPI.Apply(plate_prim, "class").GetLabelsAttr().Set(Vt.TokenArray(["robot_base"]))
+
+    xf_plate = UsdGeom.Xformable(plate_cyl)
+    xf_plate.AddTranslateOp().Set(
+        Gf.Vec3d(0.0, 0.0, plate_z + plate_thickness / 2.0)
+    )
+
+    # Fixed joints: plate to each leg (at top of each leg)
+    for i, (sx, sy) in enumerate(corner_signs):
+        
+        pj_path = f"{plate_path}/JointToLeg_{i}"
+        pj = UsdPhysics.FixedJoint.Define(stage, pj_path)
+        pj.GetBody0Rel().SetTargets([Sdf.Path(f"{root_path}/Leg_{i}")])
+        pj.GetBody1Rel().SetTargets([Sdf.Path(plate_path)])
+        pj.CreateLocalPos0Attr().Set(Gf.Vec3f(0.0, 0.0, leg_height / 2.0))
+        pj.CreateLocalPos1Attr().Set(
+            Gf.Vec3f(sx * half_span, sy * half_span, -plate_thickness / 2.0)
+        )
+        pj.GetJointEnabledAttr().Set(i == 0)
+
+    # -- Robot arm (reference) --------------------------------------------
+    arm_z = plate_z + plate_thickness
+    arm_ref_path = f"{root_path}/RobotArm"
+    arm_ref = UsdGeom.Xform.Define(stage, arm_ref_path)
+    arm_ref_prim = arm_ref.GetPrim()
+    arm_ref_prim.GetReferences().AddReference(arm_usd_path)
+    if has_translate_op(arm_ref):
+        UsdGeom.Xformable(arm_ref).GetTranslateOp().Set(Gf.Vec3d(0.0, 0.0, arm_z))
+    else:
+        UsdGeom.Xformable(arm_ref).AddTranslateOp().Set(Gf.Vec3d(0.0, 0.0, arm_z))
+
+
+    arm_joint_path = f"{plate_path}/FixedJoint"
+    arm_base_path = f"{arm_ref_path}/base"
+    arm_joint = UsdPhysics.FixedJoint.Define(stage, arm_joint_path)
+    arm_joint.GetBody0Rel().SetTargets([Sdf.Path(arm_base_path)])
+    arm_joint.GetBody1Rel().SetTargets([Sdf.Path(plate_path)])
+    arm_joint.CreateLocalPos1Attr().Set(
+        Gf.Vec3f(
+            0.0,
+            0.0,
+            plate_thickness / 2,
+        )
+    )
+    # arm_joint.CreateLocalPos1Attr().Set(Gf.Vec3f(0.0, 0.0, 0.0))
+
+    return root_xform
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Create a robot-arm pedestal (base + legs + arm) and save as USD"
+    )
+    parser.add_argument(
+        "--output", "-o", type=str, default="robot_arm_base.usd",
+        help="Output .usd file path",
+    )
+    parser.add_argument(
+        "--leg_height", type=float, default=0.5,
+        help="Height of each cylinder leg in metres",
+    )
+    parser.add_argument(
+        "--arm_usd", type=str, default=None,
+        help="Path to the robot-arm USD file",
+    )
+    parser.add_argument(
+        "--leg_gap", type=float, default=0.12,
+        help="Clear gap between adjacent leg centres in metres",
+    )
+    args = parser.parse_args()
+
+    if os.path.exists(args.output):
+        os.remove(args.output)
+
+    stage = Usd.Stage.CreateNew(args.output)
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+
+    create_robot_arm_base(
+        stage,
+        arm_usd_path=args.arm_usd,
+        leg_height=args.leg_height,
+        leg_gap=args.leg_gap,
+    )
+
+    stage.GetRootLayer().Save()
+    print(f"Saved robot arm base to {args.output}")
+
+
+if __name__ == "__main__":
+    main()
