@@ -0,0 +1,253 @@
+"""Derived cell geometry.
+
+Every number asserted here was produced by the audited `cell_geometry.py` and
+cross-checked on two hosts. They are pinned so that a change to a measured
+primitive shows up as a specific test failure rather than a silent drift.
+"""
+import dataclasses
+import pathlib
+import re
+
+import pytest
+
+from cell_core import assets as A
+from cell_core import config as C
+from cell_core import geometry as G
+
+EXTRINSICS = (pathlib.Path(__file__).resolve().parents[2]
+              / "todo/resources/isaacsim/camera_param_raw/extrinsics.md")
+INTRINSICS = EXTRINSICS.with_name("eih_camera_intrinsics.md")
+
+
+@pytest.fixture
+def cfg():
+    return C.load_preset("as_built")
+
+
+def _hand_eye(heading):
+    """The ``[x, y, z, qx, qy, qz, qw]`` listed under *heading* in extrinsics.md."""
+    text = EXTRINSICS.read_text(encoding="utf-8")
+    block = text.split(heading, 1)[1]
+    return [float(v) for v in re.search(r"\[([^\]]+)\]", block).group(1).split(",")]
+
+
+# ── measured primitives that later analysis hangs on ─────────────────────────
+@pytest.mark.skipif(not EXTRINSICS.exists(), reason="calibration file not present")
