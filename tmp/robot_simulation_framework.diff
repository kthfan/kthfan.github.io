+"""M6: planning a transfer into chained joint trajectories (EAIK, local)."""
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "motion"))
+
+import planner as PL  # noqa: E402
+import paths as PA  # noqa: E402
+import timing as TM  # noqa: E402
+import transfer as TR  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+
+URDF = ROOT / "todo" / "resources" / "robot_config" / "tm5s_v4.urdf"
+#: test_paths.CHAIN0: M3's chain turned by the 180 deg base yaw.
+CHAIN0 = np.array([-4.225095 + math.pi, -0.237663, -2.132219, -0.769752, 0.485569, -3.139861])
+
+
+@pytest.fixture(scope="module")
+def ik():
+    return PA.CC.load_ik(str(URDF))
+
+
+@pytest.fixture(scope="module")
+def cfg():
+    return C.load_preset("strict")
+
+
+@pytest.fixture(scope="module")
+def slots(cfg):
+    return G.enumerate_slots(cfg)
+
+
+@pytest.fixture(scope="module")
+def first(ik, cfg, slots):
+    by = {s.key: s for s in slots}
+    occ = frozenset(s.key for s in slots if s.role == "incoming")
+    planned, tried = PL.plan_transfer(ik, cfg, by["incoming/L0/C0"], by["table/L0/C0"], occ, CHAIN0)
+    return planned, by
+
+
+def test_start_candidates_are_exact_and_nearest_first(ik, cfg, slots):
+    T = TR.approach_pose(slots[0])
+    qs = PL.start_candidates(ik, T, CHAIN0, cfg.robot.base_pose)
+    assert len(qs) > 1
+    d = [float(np.abs(q - CHAIN0).max()) for q in qs]
+    assert d == sorted(d)
+    for q in qs:
+        dp, dr = F.pose_error(PA.fk_world(ik, q, cfg.robot.base_pose), T)
+        assert dp < 1e-4 and dr < 1e-3
+
+
+def _hub_reach(planned):
+    T = next(p for p in planned if p.name == "sweep").seg.T0
+    return math.hypot(T[0, 3], T[1, 3])
+
+
+def test_transfer_swings_at_hub_radius_when_it_can(first):
+    planned, _ = first
+    assert _hub_reach(planned) == pytest.approx(TR.HUB_RADIUS)
+
+
+def test_transfer_tries_a_wider_hub_when_no_branch_works(ik, cfg, slots):
+    # All-slots run, 2026-10-21: at 0.39 every branch to outgoing/L0/C0 failed
+    # (best one self-collided 0.6 mm at the hub, cuRobo spheres).
+    by = {s.key: s for s in slots}
+    occ = frozenset(s.key for s in slots if s.role == "incoming")
+
+    def accept(planned):
+        r = _hub_reach(planned)
+        return [] if r > TR.HUB_RADII[1] - 1e-6 else [f"sweep: self collision at {r:.3f}"]
+
+    planned, tried = PL.plan_transfer(ik, cfg, by["incoming/L0/C0"], by["table/L0/C0"], occ,
+                                      CHAIN0, accept)
+    assert _hub_reach(planned) == pytest.approx(TR.HUB_RADII[1])
+    assert tried and {t["hub"] for t in tried} == {TR.HUB_RADII[0]}
+
+
+def test_branches_survive_where_eaik_drifts(ik, cfg, slots):
+    # All-slots dry run, 2026-10-21: near the hub of incoming/L0/C3 -> table/L0/C0
+    # EAIK's closed form is 0.3-6 mm off on every branch, so none passed the
+    # tolerance and the timing found "no IK near the walk at u=0.999".
+    by = {s.key: s for s in slots}
+    occ = frozenset(s.key for s in slots if s.role == "incoming")
+    seg = next(s for s in TR.move_segments(cfg, by["incoming/L0/C3"], by["table/L0/C0"], occ)
+               if s.name == "to_hub")
+    base = cfg.robot.base_pose
+    T = PA.interp_pose(seg.T0, seg.T1, 0.9989096061658127)
+    qs = PA.CC.ik_branches(ik, T, base)
+    assert len(qs) >= 4
+    for q in qs:
+        dp, dr = F.pose_error(PA.fk_world(ik, q, base), T)
+        assert dp < PA.CC.POS_TOL and dr < PA.CC.ROT_TOL
+    q, d = PA.nearest_branch(ik, T, np.array([-0.6176, -0.026, -2.5815, -0.5329, 0.9515, 3.1422]),
+                             base)
+    assert d < 0.01
+
+
+def test_transfer_fails_when_no_hub_radius_works(ik, cfg, slots):
+    by = {s.key: s for s in slots}
+    occ = frozenset(s.key for s in slots if s.role == "incoming")
+    with pytest.raises(PA.PathError, match="no start branch works"):
+        PL.plan_transfer(ik, cfg, by["incoming/L0/C0"], by["table/L0/C0"], occ, CHAIN0,
+                         lambda planned: ["never"])
+
+
+def test_transfer_segments_chain_without_jumps(first):
+    planned, _ = first
+    names = [p.name for p in planned]
+    assert names[0] == "pre_insert" and names[-1] == "back" and "sweep" in names
+    for a, b in zip(planned[:-1], planned[1:]):
+        assert np.allclose(a.Q[-1], b.Q[0], atol=1e-9) or a.name in ("close", "open") \
+            or b.name in ("close", "open")
+        assert np.allclose(a.q_end, b.Q[0, :6], atol=1e-9), (a.name, b.name)
+    for p in planned:
+        assert p.Q.shape == (len(p.t), 8)
+        assert p.t[0] == 0.0 and np.allclose(np.diff(p.t), np.diff(p.t)[0])
+        assert np.diff(p.t)[0] <= PA.DT + 1e-12
+        assert float(np.abs(np.diff(p.Q[:, :6], axis=0)).max()) < 0.05, p.name
+
+
+def test_transfer_jaws_open_fit_open(first):
+    planned, _ = first
+    by = {p.name: p for p in planned}
+    assert np.allclose(by["insert"].Q[:, 6:], A.JAW_Q_OPEN)
+    assert np.allclose(by["close"].Q[0, 6:], A.JAW_Q_OPEN)
+    assert np.allclose(by["close"].Q[-1, 6:], A.JAW_Q_FIT)
+    assert np.allclose(by["sweep"].Q[:, 6:], A.JAW_Q_FIT)
+    assert np.allclose(by["open"].Q[-1, 6:], A.JAW_Q_OPEN)
+
+
+def test_transfer_reaches_every_pose_it_lists(ik, cfg, first):
+    planned, by = first
+    base = cfg.robot.base_pose
+    for p in planned:
+        if p.seg.kind == "jaw":
+            continue
+        for q, T in ((p.Q[0, :6], p.seg.T0), (p.q_end, p.seg.T1)):
+            dp, dr = F.pose_error(PA.fk_world(ik, q, base), T)
+            assert dp < 2e-4 and dr < 2e-3, p.name
+        assert np.allclose(p.geo[0], p.Q[0, :6]) and np.allclose(p.geo[-1], p.q_end)
+    dp, _ = F.pose_error(PA.fk_world(ik, planned[-1].q_end, base), TR.approach_pose(by["table/L0/C0"]))
+    assert dp < 1e-4
+
+
+def test_carried_segments_keep_the_d14_caps(first):
+    planned, _ = first
+    kin = [p.kin for p in planned if p.kin is not None]
+    assert len(kin) >= 8
+    for k in kin:
+        assert k["v"] <= TM.CARRY.v * 1.01 and k["a"] <= TM.CARRY.a * 1.01
+        assert k["w"] <= TM.CARRY.w * 1.01 and k["a_down"] <= TM.CARRY.a_down * 1.01
+    assert all(p.kin is None for p in planned if not p.seg.carried or p.seg.kind == "jaw")
+
+
+def test_carried_tray_swings_well_clear_of_the_shelves(ik, cfg, slots, first):
+    from cell_core import scene as S
+    planned, _ = first
+    worst = np.inf
+    for p in planned:
+        if p.name not in ("to_hub", "sweep", "from_hub"):
+            continue
+        boxes = PL.world_boxes(cfg, p.occupied, slots)
+        for q in p.geo[::2]:
+            tray = S.carried_tray_box(PA.fk_world(ik, q, cfg.robot.base_pose))
+            worst = min(worst, PA.CC.carried_clearance(tray, boxes, "-")["rest"])
+    assert worst >= 2 * PA.CC.MARGIN
+
+
+def test_accept_rejects_a_branch_and_the_next_is_tried(ik, cfg, first):
+    _, by = first
+    occ = frozenset(k for k in by if k.startswith("incoming"))
+    seen = []
+
+    def accept(planned):
+        seen.append(planned[0].Q[0, :6].copy())
+        return ["no"] if len(seen) == 1 else []
+
+    planned, tried = PL.plan_transfer(ik, cfg, by["incoming/L0/C0"], by["table/L0/C0"], occ, CHAIN0, accept)
+    assert len(seen) == 2 and not np.allclose(seen[0], seen[1])
+    assert ["no"] in [x["why"] for x in tried]
+    with pytest.raises(PA.PathError):
+        PL.plan_transfer(ik, cfg, by["incoming/L0/C0"], by["table/L0/C0"], occ, CHAIN0, lambda p: ["no"])
+
+
+def test_free_geo_bounds_the_joint_step():
+    Q = np.array([[0.0] * 6, [0.1, 0, 0, 0, 0, -0.05], [0.1, 0, 0, 0, 0, -0.05]])
+    g = PL.free_geo(Q, 0.01)
+    assert np.allclose(g[0], Q[0]) and np.allclose(g[-1], Q[-1])
+    assert float(np.abs(np.diff(g, axis=0)).max()) <= 0.01 + 1e-12
+    assert len(g) == 12
+
+
+def test_the_world_holds_the_jigs_where_they_were_found(cfg, slots):
+    """M6 (D30): the checker and the free planner see the located jigs."""
+    s0 = slots[0]
+    found = PL.S.jig_pose(s0)
+    found[:3, 3] += F.lateral_axis(s0.approach_vec) * -0.016
+    given = [PL.S.located(s0, found)] + slots[1:]
+    boxes = {b.name: b for b in PL.world_boxes(cfg, frozenset({s0.key}), given)}
+    want = PL.S.jig_boxes(given[0]) + [PL.S.tray_box(given[0])]
+    for b in want:
+        assert boxes[b.name].T == pytest.approx(b.T, abs=1e-12), b.name
+
+
+def test_scenarios_go_through_the_table(slots):
+    first = PL.scenario(slots, "first")
+    assert first == [("incoming/L0/C0", "table/L0/C0"), ("table/L0/C0", "outgoing/L1/C2")]
+    legs = PL.scenario(slots, "all")
+    assert len(legs) == 72
+    assert all("table/L0/C0" in m for m in legs)
+    keys = {s.key for s in slots}
+    assert {s for s, _ in legs} == keys and {d for _, d in legs} == keys
+    held = {s.key for s in slots if s.role == "incoming"}
+    for s, d in legs:
+        assert s in held and d not in held
+        held = (held - {s}) | {d}
