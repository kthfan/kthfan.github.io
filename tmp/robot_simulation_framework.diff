+"""M3 probe 2: cuRobo v2 public API for collision checking and scene format. Read-only."""
+import inspect
+import os
+import sys
+
+import curobo
+
+root = os.path.dirname(curobo.__file__)
+repo = os.path.dirname(root)
+print("repo top:", sorted(os.listdir(repo)))
+for d in ("docs", "wiki", "llm-wiki", "llm_wiki"):
+    p = os.path.join(repo, d)
+    if os.path.isdir(p):
+        for dirpath, dirnames, filenames in os.walk(p):
+            dirnames[:] = sorted(x for x in dirnames if not x.startswith("."))
+            if dirpath.count(os.sep) - p.count(os.sep) > 2:
+                dirnames[:] = []
+            print(" ", os.path.relpath(dirpath, repo), sorted(filenames)[:40])
+
+for sub in ("content/configs",):
+    p = os.path.join(root, sub)
+    for dirpath, dirnames, filenames in os.walk(p):
+        if dirpath.count(os.sep) - p.count(os.sep) > 1:
+            dirnames[:] = []
+        print(" ", os.path.relpath(dirpath, root), sorted(filenames)[:30])
+
+import importlib
+for name in ("collision_checking", "config_io", "inverse_kinematics", "kinematics",
+             "robot_builder", "scene" if os.path.exists(os.path.join(root, "scene.py")) else "types"):
+    try:
+        mod = importlib.import_module("curobo." + name)
+    except Exception as e:
+        print(f"\n== curobo.{name}: {type(e).__name__}: {e}")
+        continue
+    print(f"\n== curobo.{name}")
+    doc = (mod.__doc__ or "").strip()
+    print("  doc:", doc[:600].replace("\n", "\n       "))
+    for k, v in sorted(vars(mod).items()):
+        if k.startswith("_") or getattr(v, "__module__", "").split(".")[0] != "curobo":
+            continue
+        if inspect.isclass(v) or inspect.isfunction(v):
+            try:
+                sig = str(inspect.signature(v))
+            except (TypeError, ValueError):
+                sig = "(?)"
+            print(f"  {k}{sig[:400]}  [{v.__module__}]")
+            if inspect.isclass(v):
+                for mk, mv in sorted(vars(v).items()):
+                    if mk.startswith("_") and mk != "__init__":
+                        continue
+                    if callable(mv) or isinstance(mv, (classmethod, staticmethod, property)):
+                        f = mv.__func__ if isinstance(mv, (classmethod, staticmethod)) else mv
+                        try:
+                            s = str(inspect.signature(f))
+                        except (TypeError, ValueError):
+                            s = "" if isinstance(mv, property) else "(?)"
+                        print(f"      .{mk}{s[:300]}")
+
+ex = os.path.join(root, "examples", "getting_started", "motion_planning.py")
+if os.path.isfile(ex):
+    print("\n== examples/getting_started/motion_planning.py (head)")
+    print("".join(open(ex).readlines()[:120]))
