@@ -0,0 +1,221 @@
+"""M6: run tray transfers on the cell over the ROS2 seam, and judge them (D30).
+
+    . /opt/ros/humble/setup.bash
+    ROS_DOMAIN_ID=37 RMW_IMPLEMENTATION=rmw_fastrtps_cpp FASTRTPS_DEFAULT_PROFILES_FILE=motion/fastdds.xml \
+    python3 motion/run_cell.py --preset strict --scenario first --out _m6/run_first
+
+Waits for the cell's ``ready`` (current joints, which tray prim sits in which
+slot, the prim's offset from cell_core's tray box, and each slot's jig as found),
+moves every slot to its found jig (:func:`cell_core.scene.located`; D30: a
+ground-truth stand-in for M4 locating), then for each move of the
+scenario: plans the transfer (:func:`planner.plan_transfer`, every segment
+checked by :class:`planner.Checker`), a cuRobo free move to its start, sends
+each trajectory and waits for ``done``, and judges the transfer
+(:func:`judge.assess`). Ends with a free move home. ``--dry`` plans and checks
+without ROS, in the nominal slots.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import planner as PL  # noqa: E402  (puts collision/ and vendor/ on the path)
+import judge as J  # noqa: E402
+import paths as P  # noqa: E402
+import timing as TM  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import protocol as PR  # noqa: E402
+from cell_core import scene as S  # noqa: E402
+
+ROBOT = "/Environment/RobotArmBase/RobotArm"
+BASE = "/Environment/RobotArmBase"
+#: Extra wait for ``done`` beyond a trajectory's duration (s).
+DONE_SLACK = 60.0
+
+
+def payload(tid: str, p: PL.Planned) -> str:
+    return PR.encode_trajectory(tid, p.t, p.Q, TM.velocities(p.t, p.Q),
+                                meta={"name": p.name})
+
+
+def record(p: PL.Planned, report: dict, ik, base) -> dict:
+    """One executed trajectory as :func:`judge.assess` takes it."""
+    s = p.seg
+    return {"name": p.name, "kind": "free" if s is None else s.kind,
+            "carried": bool(s and s.carried), "lifting": bool(s and s.lifting),
+            "track": bool(s and s.track), "kin": p.kin,
+            "planned": [P.fk_world(ik, np.asarray(x["q_cmd"][:6]), base) for x in report["samples"]],
+            "report": report}
+
+
+def moved(tray_at: dict, src: str, dst: str) -> dict:
+    """``{slot: tray prim}`` after the tray in *src* went to *dst*."""
+    if dst in tray_at:
+        raise ValueError(f"{dst} already holds {tray_at[dst]}")
+    out = dict(tray_at)
+    out[dst] = out.pop(src)
+    return out
+
+
+def log(*a):
+    print("[run_cell]", *a, flush=True)
+
+
+class Cell:
+    """The ROS side: send a trajectory, wait for its status."""
+
+    def __init__(self):
+        import rclpy
+        from std_msgs.msg import String
+
+        self.rclpy, self.String = rclpy, String
+        rclpy.init()
+        self.node = rclpy.create_node("cell_run")
+        self.pub = self.node.create_publisher(String, PR.TOPIC_TRAJECTORY, 10)
+        self.inbox = []
+        self.node.create_subscription(String, PR.TOPIC_STATUS, lambda m: self.inbox.append(m.data), 10)
+
+    def wait(self, pred, timeout: float):
+        end = time.time() + timeout
+        while time.time() < end:
+            self.rclpy.spin_once(self.node, timeout_sec=0.05)
+            while self.inbox:
+                d = PR.decode_status(self.inbox.pop(0))
+                if pred(d):
+                    return d
+        raise TimeoutError(f"no matching status in {timeout:.0f} s")
+
+    def ready(self, timeout: float = 120.0) -> dict:
+        d = self.wait(lambda d: d["state"] == "ready", timeout)
+        end = time.time() + 30.0
+        while self.pub.get_subscription_count() == 0 and time.time() < end:
+            self.rclpy.spin_once(self.node, timeout_sec=0.1)
+        if self.pub.get_subscription_count() == 0:
+            raise TimeoutError("the cell does not subscribe to the trajectory topic")
+        return d
+
+    def run(self, tid: str, p: PL.Planned) -> dict:
+        self.inbox.clear()
+        self.pub.publish(self.String(data=payload(tid, p)))
+        d = self.wait(lambda d: d["id"] == tid and d["state"] in ("done", "rejected"),
+                      float(p.t[-1]) + DONE_SLACK)
+        if d["state"] == "rejected":
+            raise RuntimeError(f"{tid} rejected: {d.get('reason')}")
+        return d
+
+    def close(self):
+        self.node.destroy_node()
+        self.rclpy.shutdown()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--preset", default="strict")
+    ap.add_argument("--scenario", default="first", choices=("first", "all"))
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--dry", action="store_true", help="plan and check only, no ROS")
+    ap.add_argument("--keep-going", action="store_true", help="go on after a failed transfer")
+    args = ap.parse_args()
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+
+    cfg = C.load_preset(args.preset)
+    base = cfg.robot.base_pose
+    slots = G.enumerate_slots(cfg)
+    ik = PL.CC.load_ik(PL.CC.URDF)
+
+    cell = None
+    if args.dry:
+        q = PL.HOME.copy()
+        tray_at = {s.key: s.key for s in slots if s.role == "incoming"}
+        offset = np.eye(4)
+    else:
+        cell = Cell()
+        st = cell.ready()
+        q = np.asarray(st["q"][:6], dtype=float)
+        tray_at = {k: n for n, k in st["where"].items()}
+        offset = np.asarray(st["offset"], dtype=float)
+        slots = [S.located(s, np.asarray(st["jigs"][s.key], dtype=float)) for s in slots]
+        log("cell ready q", np.round(q, 4).tolist(), "trays", len(tray_at),
+            "offset", np.round(offset[:3, 3], 5).tolist())
+    by = {s.key: s for s in slots}
+    t0 = time.time()
+    checker = PL.Checker(cfg, slots)
+    free = PL.FreePlanner(cfg, slots)
+    log("checker and planner ready %.1f s" % (time.time() - t0))
+    reports = open(out / "reports.jsonl", "w")
+    results, failed, k = [], False, 0
+
+    def send(p, label):
+        nonlocal k
+        problems = checker.check(p, ik)
+        if problems:
+            raise RuntimeError(f"{label}: checker: {problems}")
+        if cell is None:
+            return None
+        tid = f"{k:03d}_{label}"
+        k += 1
+        rep = cell.run(tid, p)
+        reports.write(json.dumps({"tid": tid, "report": rep}) + "\n")
+        reports.flush()
+        return rep
+
+    try:
+        for i, (s, d) in enumerate(PL.scenario(slots, args.scenario)):
+            t1 = time.time()
+            occupied = frozenset(tray_at)
+            accept = lambda pl: [x for p in pl for x in checker.check(p, ik)]  # noqa: E731
+            planned, tried = PL.plan_transfer(ik, cfg, by[s], by[d], occupied, q, accept)
+            fm = free.plan(q, planned[0].Q[0, :6], occupied)
+            hub = math.hypot(*next(p for p in planned if p.name == "sweep").seg.T0[:2, 3])
+            log("move %d %s -> %s planned %.1f s (%d branches dropped, hub %.2f m), free %.1f s, "
+                "transfer %.1f s" % (i, s, d, time.time() - t1, len(tried), hub, fm.t[-1],
+                                     sum(p.t[-1] for p in planned)))
+            rep = send(fm, f"m{i}_free")
+            res = {"move": i, "src": s, "dst": d, "tried": len(tried), "hub": hub}
+            if rep is not None:
+                res["free_contacts"] = J.bad_contacts(rep["contacts"], ROBOT, BASE, None)
+            runs = []
+            for p in planned:
+                rep = send(p, f"m{i}_{p.name}")
+                if rep is not None:
+                    runs.append(record(p, rep, ik, base))
+            if cell is not None:
+                seat_T = J.seated_pose(S.tray_box(by[d]).T, offset)
+                v = J.assess(runs, tray_at[s], seat_T, ROBOT, BASE)
+                ok = v["ok"] and not res["free_contacts"]
+                res.update(verdict=v, ok=ok)
+                log("move %d %s: %s seat %.2f mm %.2f deg slip %.2f mm track %.2f mm contacts %d"
+                    % (i, "PASS" if ok else "FAIL", v["checks"], v["seat_mm"], v["seat_deg"],
+                       v["slip_mm"], v["track_mm"], len(v["contacts"]) + len(res["free_contacts"])))
+                failed = failed or not ok
+            results.append(res)
+            tray_at = moved(tray_at, s, d)
+            q = planned[-1].q_end
+            if failed and not args.keep_going:
+                break
+        if not failed:
+            fm = free.plan(q, PL.HOME, frozenset(tray_at))
+            rep = send(fm, "home")
+            if rep is not None:
+                results.append({"move": "home", "free_contacts": J.bad_contacts(rep["contacts"], ROBOT, BASE, None)})
+    finally:
+        reports.close()
+        (out / "results.json").write_text(json.dumps(results, indent=1, default=lambda o: np.asarray(o).tolist()))
+        if cell is not None:
+            cell.close()
+    n_ok = sum(1 for r in results if r.get("ok"))
+    log("done: %d/%d transfers pass" % (n_ok, sum(1 for r in results if "ok" in r)))
+
+
+if __name__ == "__main__":
+    main()
