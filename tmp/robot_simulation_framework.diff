index 0000000..6746e1d
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/isaacsim/locating/render_locating.py"
@@ -0,0 +1,225 @@
+"""Render the EIH camera's view of every slot at both reads, with ground truth.
+
+    <isaac>/python.sh render_locating.py --stage _stage/strict/cell.usd \\
+        --preset strict --out _locating/strict [--only incoming_L0]
+
+Writes ``<out>/<slot>_<read>.png`` (8-bit grey in linear light, what the
+detector takes) and ``<out>/truth.json``. The robot stays at home (M4 design). A free camera
+carrying the built ``eih_camera``'s own attributes is placed where
+``cell_core`` commands the EIH camera for each read.
+
+Truth is read off the stage being rendered (``label_truth``), never off
+``cell_core``: the comparison in task 7 must cross that boundary. Each frame
+also records the view transform the renderer reports, so a frame rendered from
+a stale pose shows up as a number, not as a mysteriously bad read.
+
+:func:`read_plan` and :func:`usd_camera_matrix` are pure and tested locally;
+everything that needs Isaac Sim is inside :func:`main`.
+"""
+import argparse
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+import label_truth as L  # noqa: E402  (puts build_env and cell_core on the path)
+import build_cell as B  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import sequence as S  # noqa: E402
+
+CAM_PATH = "/Locating/Cam"
+BUILT_CAMERA = f"{B.ROBOT_ARM}/{B.EIH_CAMERA}"
+CAM_ATTRS = ("focalLength", "horizontalAperture", "verticalAperture",
+             "horizontalApertureOffset", "verticalApertureOffset")
+READS = ("far", "near")
+#: A rendered view further than this from the commanded one fails the run.
+VIEW_TOL = 1e-5
+
+#: No DLSS and no ACES (D26): both shrink the black tags and bias depth and
+#: far pitch. Isaac puts aa/op back to 3 unless both of these say 0/off.
+LAUNCH_CONFIG = {"headless": True, "renderer": "RayTracedLighting", "anti_aliasing": 0}
+RTX_SETTINGS = {
+    "/rtx-transient/post/aa/limitedOps": False,
+    "/rtx/post/aa/op": 0,
+    "/rtx/post/tonemap/op": 1,
+}
+
+_v = np.arange(256) / 255.0
+_SRGB_TO_LINEAR = np.where(_v <= 0.04045, _v / 12.92, ((_v + 0.055) / 1.055) ** 2.4)
+_LUMA = np.array([0.299, 0.587, 0.114])
+
+
+def detector_grey(rgb):
+    """8-bit linear-light grey from the renderer's sRGB-encoded RGB."""
+    lin = _SRGB_TO_LINEAR[np.asarray(rgb)[..., :3]] @ _LUMA
+    return np.rint(255.0 * lin).astype(np.uint8)
+
+
+def settings_drift(wanted, get):
+    """``(key, wanted, actual)`` for every setting *get* reports differently."""
+    return [(k, v, get(k)) for k, v in wanted.items() if get(k) != v]
+
+
+def read_plan(cfg):
+    """Every slot, far read then near, with its commanded optical-frame pose."""
+    ids = G.grid_ids(cfg)
+    standoffs = {"far": cfg.standoff_far, "near": cfg.standoff_near}
+    return [{"slot": slot, "read": read, "standoff": standoffs[read],
+             "grid_id": ids[slot.key],
+             "camera_T": S.eih_camera_pose(S.sighting_pose(slot, standoffs[read]))}
+            for slot in G.enumerate_slots(cfg) for read in READS]
+
+
+def image_name(r) -> str:
+    return f"{r['slot'].key.replace('/', '_')}_{r['read']}.png"
+
+
+def usd_camera_matrix(camera_T):
+    """``Gf.Matrix4d`` rows for a USD camera at optical pose *camera_T*.
+
+    Gf is row-vector, hence the transpose.
+    """
+    return (np.asarray(camera_T, dtype=float) @ B._OPTICAL_TO_USD_CAM).T.tolist()
+
+
+def freeze_rigid_bodies(stage):
+    """Disable every rigid body, in the session layer; returns their paths.
+
+    Replicator's step runs the timeline, and the built stage's racks, table
+    and trays are dynamic: unfrozen, they fall while the frames render and
+    no longer sit where the truth was read (M4 task 6, first full run).
+    """
+    from pxr import Usd, UsdPhysics
+    bodies = [p for p in stage.Traverse() if p.HasAPI(UsdPhysics.RigidBodyAPI)]
+    with Usd.EditContext(stage, stage.GetSessionLayer()):
+        for p in bodies:
+            UsdPhysics.RigidBodyAPI(p).CreateRigidBodyEnabledAttr().Set(False)
+    return [str(p.GetPath()) for p in bodies]
+
+
+def _add_lights(stage):
+    # The built stage has none; the simulator adds these (env_setup.md).
+    from pxr import Gf, UsdGeom, UsdLux
+    UsdLux.DomeLight.Define(stage, "/DomeLight").CreateIntensityAttr().Set(2000.0)
+    key = UsdLux.DistantLight.Define(stage, "/DistantLight")
+    key.CreateIntensityAttr().Set(4000.0)
+    UsdGeom.Xformable(key).AddOrientOp(UsdGeom.XformOp.PrecisionDouble).Set(
+        Gf.Quatd(-0.14644661, 0.35355339, 0.35355339, 0.85355339))
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--stage", required=True)
+    ap.add_argument("--preset", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--only", default="", help="render images whose name contains this")
+    ap.add_argument("--subframes", type=int, default=8)
+    args = ap.parse_args(argv)
+    out = os.path.abspath(args.out)
+    os.makedirs(out, exist_ok=True)
+    W, H = A.EIH_WIDTH, A.EIH_HEIGHT
+    plan = [r for r in read_plan(C.load_preset(args.preset)) if args.only in image_name(r)]
+    if not plan:
+        raise SystemExit(f"--only {args.only!r} matches no read")
+
+    t0 = time.time()
+    from isaacsim import SimulationApp
+    app = SimulationApp({**LAUNCH_CONFIG, "width": W, "height": H})
+    import carb
+    import cv2
+    import omni.replicator.core as rep
+    import omni.usd
+    from pxr import Gf, UsdGeom
+
+    settings = carb.settings.get_settings()
+
+    def apply_settings():
+        for k, v in RTX_SETTINGS.items():
+            settings.set(k, v)
+
+    apply_settings()
+
+    ctx = omni.usd.get_context()
+    ctx.open_stage(os.path.abspath(args.stage))
+    for _ in range(600):
+        app.update()
+        if not ctx.get_stage_loading_status()[2]:
+            break
+    stage = ctx.get_stage()
+    frozen = freeze_rigid_bodies(stage)
+    print(f"[render] froze {len(frozen)} rigid bodies", flush=True)
+    _add_lights(stage)
+
+    built = stage.GetPrimAtPath(BUILT_CAMERA)
+    attrs = {a: built.GetAttribute(a).Get() for a in CAM_ATTRS}
+    intr = F.intrinsics_from_usd(attrs, W, H)
+    cam = UsdGeom.Camera.Define(stage, CAM_PATH)
+    for a, v in attrs.items():
+        cam.GetPrim().GetAttribute(a).Set(v)
+    cam.CreateClippingRangeAttr().Set(built.GetAttribute("clippingRange").Get())
+    xform = cam.AddTransformOp(UsdGeom.XformOp.PrecisionDouble)
+    print(f"[render] {len(plan)} reads, camera {attrs}, intrinsics {intr}", flush=True)
+
+    rp = rep.create.render_product(CAM_PATH, (W, H))
+    rgb_a = rep.AnnotatorRegistry.get_annotator("rgb")
+    cp_a = rep.AnnotatorRegistry.get_annotator("camera_params")
+    rgb_a.attach([rp])
+    cp_a.attach([rp])
+
+    reads, worst_view = [], 0.0
+    for i, r in enumerate(plan):
+        T = r["camera_T"]
+        xform.Set(Gf.Matrix4d(usd_camera_matrix(T)))
+        apply_settings()
+        app.update()
+        rep.orchestrator.step(rt_subframes=args.subframes)
+        drift = settings_drift(RTX_SETTINGS, settings.get)
+        if drift:
+            raise SystemExit(f"renderer did not keep {drift} for {image_name(r)}")
+        grey = detector_grey(np.asarray(rgb_a.get_data()))
+        cv2.imwrite(os.path.join(out, image_name(r)), grey)
+        # cameraViewTransform: world -> USD camera, Gf row-vector layout.
+        view = np.array(cp_a.get_data()["cameraViewTransform"], dtype=float).reshape(4, 4)
+        rendered = np.linalg.inv(view.T) @ B._OPTICAL_TO_USD_CAM
+        view_err = float(np.abs(rendered - T).max())
+        worst_view = max(worst_view, view_err)
+
+        slot = r["slot"]
+        jig = L.jig_prim_path(slot)
+        board_T, face = L.board_pose(stage, jig, T[:3, 3])
+        reads.append({
+            "image": image_name(r), "slot": slot.key, "read": r["read"],
+            "standoff": r["standoff"], "grid_id": r["grid_id"],
+            "texture_grid_id": L.texture_grid_id(stage, jig), "jig": jig,
+            "camera_T": T.tolist(), "board_T": board_T.tolist(), "label_face": face,
+            "view_err": view_err, "grey_mean": float(grey.mean()),
+        })
+        print(f"[render] {i + 1}/{len(plan)} {image_name(r)} view_err {view_err:.2e} "
+              f"grey {grey.mean():.0f} ({time.time() - t0:.0f}s)", flush=True)
+
+    truth = {"preset": args.preset, "stage": os.path.abspath(args.stage),
+             "width": W, "height": H, "camera_attrs": attrs, "intrinsics": intr,
+             "board_frame": "aprilgrid_detector: origin tag-0 top-left, x along PNG "
+                            "columns, y down rows, z into the label",
+             "render_settings": {"launch": LAUNCH_CONFIG, "rtx": RTX_SETTINGS,
+                                 "image": "grey = luma of sRGB-decoded RGB (linear light)"},
+             "reads": reads}
+    with open(os.path.join(out, "truth.json"), "w") as f:
+        json.dump(truth, f, indent=1)
+    print(f"[render] wrote {len(reads)} reads to {out}; worst view_err {worst_view:.2e}", flush=True)
+    app.close()
+    if worst_view > VIEW_TOL:
+        raise SystemExit(f"rendered view differs from the commanded pose by {worst_view:.2e}")
+
+
+if __name__ == "__main__":
+    main()
