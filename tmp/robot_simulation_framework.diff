index 0000000..3185116
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/trim_geometry.py"
@@ -0,0 +1,43 @@
+"""Cut a ``dump_usd_geometry.py`` measurement down to the cell layout.
+
+    python trim_geometry.py <geometry.json> <out.json>
+
+Keeps every prim at most three levels under the root (``/Environment/<fixture>/
+<part>``) with its record unchanged, and drops everything deeper: the arm's
+links and the referenced jig and tray meshes. Those come from the vendor assets
+and not from the preset, so they say nothing about whether the stage is the
+configured cell, and they make up nearly all of the half-megabyte dump.
+
+The result is still a measurement: prims are dropped whole and none is edited.
+"""
+import json
+import sys
+
+MAX_DEPTH = 3
+
+
+def trim(stages):
+    out = []
+    for stage in stages:
+        if "error" in stage:
+            raise SystemExit(f"{stage['path']}: dump failed:\n{stage['error']}")
+        kept = [p for p in stage["prims"] if p["path"].count("/") <= MAX_DEPTH]
+        out.append(dict(stage, prims=kept))
+    return out
+
+
+def main(argv):
+    if len(argv) != 2:
+        raise SystemExit(__doc__)
+    with open(argv[0], encoding="utf-8") as fh:
+        stages = json.load(fh)
+    trimmed = trim(stages)
+    with open(argv[1], "w", encoding="utf-8", newline="\n") as fh:
+        json.dump(trimmed, fh, indent=1, sort_keys=True)
+        fh.write("\n")
+    for s in trimmed:
+        print(f"{s['path']}: kept {len(s['prims'])} prims")
+
