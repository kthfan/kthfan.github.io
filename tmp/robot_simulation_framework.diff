+"""The gripper jaws (D30): real stroke and gap, the open and width-fit commands."""
+import pytest
+
+from cell_core import assets as A
+
+
+def test_fully_open_is_the_real_gap():
+    assert A.jaw_gap(A.JAW_Q_MAX) == pytest.approx(0.173, abs=1e-6)
+
+
+def test_stroke_is_the_real_stroke():
+    assert A.JAW_Q_MAX - A.JAW_Q_MIN == pytest.approx(0.051, abs=1e-9)
+
+
+def test_gap_and_q_invert():
+    for q in (A.JAW_Q_MIN, 0.03, A.JAW_Q_MAX):
+        assert A.jaw_q(A.jaw_gap(q)) == pytest.approx(q, abs=1e-12)
+    assert A.jaw_gap(0.0) == pytest.approx(A.JAW_X_IN * 2)
+
+
+def test_fit_close_clears_the_tray_by_the_fit_clearance():
+    assert A.jaw_gap(A.JAW_Q_FIT) == pytest.approx(A.TRAY_X + 2 * A.JAW_FIT_CLEARANCE)
+    assert A.JAW_Q_MIN < A.JAW_Q_FIT < A.JAW_Q_OPEN
+
+
+def _corridor(jig_gap):
+    """Own front column's outer face and the neighbour's inner face, jig x."""
+    s = A.JIG_BOXES["col_pp"]
+    own = s[0][0] + s[1][0] / 2.0
+    return own, 2 * A.JIG_X_HALF + jig_gap - own
+
+
+@pytest.mark.parametrize("jig_gap", [A.DEFAULT_JIG_GAP, 0.020])
+def test_open_jaws_are_centred_between_the_columns(jig_gap):
+    q = A.jaw_open_q(jig_gap)
+    own, neighbour = _corridor(jig_gap)
+    inner, outer = A.JAW_X_IN + q, A.JAW_X_OUT + q
+    assert inner - own == pytest.approx(neighbour - outer, abs=1e-9)
+    assert inner > own and outer < neighbour
+
+
+def test_default_open_keeps_5mm_from_both_columns():
+    own, neighbour = _corridor(A.DEFAULT_JIG_GAP)
+    q = A.JAW_Q_OPEN
+    assert A.JAW_X_IN + q - own >= 0.005
+    assert neighbour - (A.JAW_X_OUT + q) >= 0.005
+
+
+def test_open_never_beyond_the_stroke():
+    assert A.jaw_open_q(0.2) == A.JAW_Q_MAX
