@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+"""Re-derive EIH-camera and bottom-plate offsets in the FLANGE frame from tm5s.usd.
+
+Run on the isaacsim host (needs `pxr`). Read-only.
+
+Motivation: findings/02 quoted the EIH camera at flange +Y 0.0752 / +Z 0.0442,
+but the prim translations in the geometry dump imply different values. The
+lower-layer insertion-clearance result (D2/D15) depends directly on the
+camera-to-plate-bottom distance, so this must be settled from the source.
+
+Emits JSON to stdout after a human-readable report.
+"""
+import json
+import sys
+
+from pxr import Usd, UsdGeom, Gf
+
+ASSETS = "/home/largan/_p0_assets/assets/"
+
+
+def world_xform(prim):
+    return UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(Usd.TimeCode.Default())
+
+
+def to_flange(p_world, flange_inv):
+    """USD uses the row-vector convention: world = local * M."""
+    return flange_inv.Transform(p_world)
+
+
+def main():
+    stage = Usd.Stage.Open(ASSETS + "tm5s.usd")
+
+    flange = stage.GetPrimAtPath("/tm5s/flange")
+    M = world_xform(flange)
+    Minv = M.GetInverse()
+    t = M.ExtractTranslation()
+
+    print("flange world T = (%.6f, %.6f, %.6f)" % (t[0], t[1], t[2]))
+    print("flange basis images in world (USD rows):")
+    for i, name in enumerate("XYZ"):
+        r = M.GetRow3(i)
+        print("  flange %s -> world (%+.4f, %+.4f, %+.4f)" % (name, r[0], r[1], r[2]))
+    print()
+
+    out = {}
+
+    # ---- EIH camera: several candidate reference points -------------------
+    print("=== EIH camera candidates, in the FLANGE frame ===")
+    print("  %-46s %10s %10s %10s" % ("prim", "fx", "fy(up)", "fz(appr)"))
+    cam_paths = [
+        "/tm5s/link_6/rsd455_v1",
+        "/tm5s/link_6/rsd455_v1/Camera",
+        "/tm5s/link_6/rsd455_v1/Visual/Glass",
+        "/tm5s/link_6/rsd455_v1/Visual/Front_mask",
+        "/tm5s/link_6/rsd455_v1/Visual/Camera_module",
+    ]
+    cams = {}
+    for path in cam_paths:
+        prim = stage.GetPrimAtPath(path)
+        if not prim or not prim.IsValid():
+            print("  %-46s  (missing)" % path)
+            continue
+        pw = world_xform(prim).ExtractTranslation()
+        pf = to_flange(pw, Minv)
+        cams[path] = [pf[0], pf[1], pf[2]]
+        print("  %-46s %10.4f %10.4f %10.4f" % (path.split("/")[-1], pf[0], pf[1], pf[2]))
+
+    # Mesh-accurate extent of the glass (the true optical aperture plane).
+    glass = stage.GetPrimAtPath("/tm5s/link_6/rsd455_v1/Visual/Glass")
+    if glass and glass.IsValid():
+        pts = UsdGeom.Mesh(glass).GetPointsAttr().Get()
+        W = world_xform(glass)
+        F = [to_flange(W.Transform(Gf.Vec3d(*p)), Minv) for p in pts]
+        ys = [p[1] for p in F]
+        zs = [p[2] for p in F]
+        print()
+        print("  Glass mesh extent: fy [%.4f, %.4f]  fz [%.4f, %.4f]"
+              % (min(ys), max(ys), min(zs), max(zs)))
+        out["glass_fy"] = [min(ys), max(ys)]
+        out["glass_fz"] = [min(zs), max(zs)]
+        out["glass_fy_mid"] = 0.5 * (min(ys) + max(ys))
+        out["glass_fz_max"] = max(zs)
+    out["camera_prims"] = cams
+    print()
+
+    # ---- Bottom plate: exact extent in the flange frame -------------------
+    print("=== bottom plate (gripper_body mesh, flange z > 0.10) ===")
+    body = stage.GetPrimAtPath("/tm5s/link_6/gripper_body/visuals/mesh_23")
+    pts = UsdGeom.Mesh(body).GetPointsAttr().Get()
+    W = world_xform(body)
+    F = [to_flange(W.Transform(Gf.Vec3d(*p)), Minv) for p in pts]
+    plate = [p for p in F if p[2] > 0.10]
+    if plate:
+        ys = [p[1] for p in plate]
+        xs = [p[0] for p in plate]
+        zs = [p[2] for p in plate]
+        print("  plate fy [%.4f, %.4f] (thick %.4f)" % (min(ys), max(ys), max(ys) - min(ys)))
+        print("  plate fx [%.4f, %.4f] (width %.4f)" % (min(xs), max(xs), max(xs) - min(xs)))
+        print("  plate fz [%.4f, %.4f] (tip   %.4f)" % (min(zs), max(zs), max(zs)))
+        out["plate_fy"] = [min(ys), max(ys)]
+        out["plate_fx"] = [min(xs), max(xs)]
+        out["plate_fz"] = [min(zs), max(zs)]
+
+    allz = [p[2] for p in F]
+    ally = [p[1] for p in F]
+    print("  whole gripper body: fz [%.4f, %.4f]  fy [%.4f, %.4f]"
+          % (min(allz), max(allz), min(ally), max(ally)))
+    out["body_fz"] = [min(allz), max(allz)]
+    out["body_fy"] = [min(ally), max(ally)]
+    print()
+
+    # ---- Jaws --------------------------------------------------------------
+    print("=== jaws (at home position) ===")
+    for side in ("left", "right"):
+        p = stage.GetPrimAtPath("/tm5s/%s_gripper/visuals/mesh___" % side)
+        if not p or not p.IsValid():
+            continue
+        pts = UsdGeom.Mesh(p).GetPointsAttr().Get()
+        W = world_xform(p)
+        F = [to_flange(W.Transform(Gf.Vec3d(*q)), Minv) for q in pts]
+        xs = [q[0] for q in F]
+        ys = [q[1] for q in F]
+        zs = [q[2] for q in F]
+        print("  %-6s fx [%.4f, %.4f]  fy [%.4f, %.4f]  fz [%.4f, %.4f]"
+              % (side, min(xs), max(xs), min(ys), max(ys), min(zs), max(zs)))
+        out["jaw_%s_fx" % side] = [min(xs), max(xs)]
+        out["jaw_%s_fy" % side] = [min(ys), max(ys)]
+        out["jaw_%s_fz" % side] = [min(zs), max(zs)]
+    print()
+
+    # ---- The number that actually matters ---------------------------------
+    print("=== camera -> plate-bottom vertical distance (flange -Y) ===")
+    plate_bottom = out.get("plate_fy", [None])[0]
+    for label, key in (("rsd455_v1 origin", "/tm5s/link_6/rsd455_v1"),
+                       ("Camera prim", "/tm5s/link_6/rsd455_v1/Camera")):
+        if key in cams and plate_bottom is not None:
+            d = cams[key][1] - plate_bottom
+            print("  using %-18s : %.4f m" % (label, d))
+            out["cam_to_plate_bottom__%s" % label.replace(" ", "_")] = d
+    if "glass_fy_mid" in out and plate_bottom is not None:
+        d = out["glass_fy_mid"] - plate_bottom
+        print("  using %-18s : %.4f m" % ("Glass mid", d))
+        out["cam_to_plate_bottom__glass"] = d
+
+    print()
+    print("### JSON ###")
+    print(json.dumps(out, indent=1, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
