+#!/usr/bin/env python3
+"""Evaluate a cell configuration, end to end, from one command.
+
+    python3 evaluate.py --preset recommended
+    python3 evaluate.py --preset as_built --json as_built.json
+    python3 evaluate.py --preset as_built --baseline as_built.json
+    python3 evaluate.py --preset as_built --scan origin_z=0.60:0.85:0.025
+
+Why this exists
+---------------
+The cell is going to keep changing: the shelf moves, the arm goes up, the table
+gets measured. Every time that happens, every previous conclusion is suspect.
+If re-checking them costs a day of hand-run scripts, it will not be done, and
+the project will quietly carry on standing on numbers that stopped being true.
+
+So re-checking has to cost one command. That is the whole point of this file.
+
+What it reports
+---------------
+Two layers, and it always tells you which of them ran:
+
+*   **Geometry** (:mod:`cell_core.audit`) — pure arithmetic, runs anywhere.
+*   **Reachability** — analytic IK over every slot and phase. Needs EAIK, which
+    only exists on the program host.
+
+A pass that silently skipped reachability would be worse than no answer at all,
+so a skipped layer is printed as loudly as a failed one, and the verdict line
+always states what was and was not checked.
+"""
+from __future__ import annotations
+
+import argparse
+import datetime
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def _locate_cell_core() -> str:
+    """Find the directory that ``cell_core`` lives in, and return it.
+
+    Deliberately not ``PYTHONPATH``: setting that in a remote command file trips
+    the privileged-execution prompt, and a tool that needs a hand-set
+    environment variable is a tool that gets run wrongly. On the program host
+    ``cell_core`` is copied in beside this file; in the repo it is under
+    ``shared/``. Look for both, nearest first.
+    """
+    d = HERE
+    while True:
+        for cand in (d, os.path.join(d, "shared")):
+            if os.path.isdir(os.path.join(cand, "cell_core")):
+                return cand
+        parent = os.path.dirname(d)
+        if parent == d:
+            raise SystemExit(
+                "cannot find the cell_core package. Copy it next to "
+                f"{os.path.basename(__file__)}, or run from the repo.")
+        d = parent
+
+
+sys.path.insert(0, HERE)
+sys.path.insert(0, _locate_cell_core())
+
+import cell_core.audit as AUDIT      # noqa: E402
+import cell_core.config as CFG       # noqa: E402
+import cell_core.geometry as GEO     # noqa: E402
+import cell_core.sequence as SEQ     # noqa: E402
+
+SCHEMA = 1
+
+#: Numbers closer than this are the same number, for diffing purposes.
+DIFF_TOL = 1e-6
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Reachability
+# ─────────────────────────────────────────────────────────────────────────────
+def run_reach(cfg, urdf: str, near_rise: float = 0.0) -> dict:
+    """Sweep every slot and phase with analytic IK.
+
+    Returns a summary dict with ``ran`` false and a human-readable ``reason``
+    when the sweep could not be attempted, rather than raising: an evaluation
+    that cannot reach the robot should still produce a geometry report.
+    """
+    try:
+        import numpy as np
+        import reach_sweep as RS
+        from eaik.IK_URDF import UrdfRobot
+    except Exception as exc:                          # noqa: BLE001
+        return {"ran": False, "reason": f"{type(exc).__name__}: {exc}"}
+
+    if not os.path.exists(urdf):
+        return {"ran": False, "reason": f"URDF not found: {urdf}"}
+
+    try:
+        bot = UrdfRobot(RS.strip_urdf(urdf), [])
+        lo, hi, _ = RS.joint_limits(urdf)
+        A = RS.frame_correction(bot)
+        T0 = np.asarray(bot.fwdKin(np.zeros(6)), dtype=float)
+        reach = float(np.linalg.norm(
+            T0[:3, 3] - np.array([0.0, 0.0, RS.ASSETS.SHOULDER_OFFSET_Z])))
+        slots = GEO.enumerate_slots(cfg)
+        rows = RS.run_sweep(bot, lo, hi, cfg.robot.origin_z, cfg, slots,
+                            near_rise, A)
+    except Exception as exc:                          # noqa: BLE001
+        return {"ran": False, "reason": f"sweep failed: {type(exc).__name__}: {exc}"}
+
+    return summarise_reach(rows, reach, len(slots))
+
+
+def summarise_reach(rows, reach: float, n_slots: int) -> dict:
+    """Condense a sweep into the handful of numbers worth diffing."""
+    blocked = [r for r in rows if r["status"] != "ok"]
+    bad_slots = sorted({r["slot"] for r in blocked})
+    ok_rows = [r for r in rows if r["status"] == "ok"]
+
+    tightest = max(ok_rows, key=lambda r: r["shoulder_r"]) if ok_rows else None
+    shortfall = max((r["shoulder_r"] - reach for r in blocked), default=None)
+
+    return {
+        "ran": True,
+        "geometric_reach": round(reach, 4),
+        "slots_total": n_slots,
+        "slots_ok": n_slots - len(bad_slots),
+        "poses_total": len(rows),
+        "poses_ok": len(ok_rows),
+        "blocked_slots": bad_slots,
+        "blocked": [{"slot": r["slot"], "phase": r["phase"],
+                     "status": r["status"], "shoulder_r": r["shoulder_r"]}
+                    for r in blocked],
+        # How far the tightest *passing* pose sits inside the q=0 reach sphere.
+        #
+        # NOT a true margin, and it can go negative on a cell where every slot
+        # is reachable. The real workspace is not a sphere about the shoulder:
+        # the joint-1 and wrist offsets let the arm reach slightly further in
+        # some directions than its own fully-extended radius. So treat this as a
+        # sensitive trend indicator -- it moves long before the pass/fail flips
+        # -- and not as clearance. Pass/fail comes from the IK, never from here.
+        "reach_sphere_margin": (round(reach - tightest["shoulder_r"], 4)
+                                if tightest else None),
+        "tightest_pose": (f"{tightest['slot']}/{tightest['phase']}"
+                          if tightest else None),
+        # And how much is missing from the worst failing pose, which is what a
+        # fix has to buy.
+        "worst_shortfall": round(shortfall, 4) if shortfall is not None else None,
+    }
+
+
+def reach_check(reach: dict) -> AUDIT.Check:
+    """Fold the sweep into the same Check vocabulary as the geometry audit."""
+    if not reach.get("ran"):
+        return AUDIT.Check("reachability", AUDIT.SKIP,
+                           f"not evaluated ({reach.get('reason', 'unknown')}); "
+                           f"this host cannot say whether the arm can reach the cell")
+    ok, total = reach["slots_ok"], reach["slots_total"]
+    if ok == total:
+        return AUDIT.Check(
+            "reachability", AUDIT.PASS,
+            f"all {total} slots serviceable through every phase; tightest pose "
+            f"{reach['tightest_pose']} sits "
+            f"{reach['reach_sphere_margin'] * 1000:.1f} mm inside the q=0 reach "
+            f"sphere (a trend figure, not clearance)",
+            reach["reach_sphere_margin"])
+    return AUDIT.Check(
+        "reachability", AUDIT.FAIL,
+        f"{total - ok} of {total} slots unreachable "
+        f"({', '.join(reach['blocked_slots'])}); the worst pose is "
+        f"{reach['worst_shortfall'] * 1000:.1f} mm beyond the arm",
+        reach["reach_sphere_margin"])
+
+
+def collision_check(path: str = None, preset: str = None, n_slots: int = None) -> AUDIT.Check:
+    """Fold a program/collision/check_cell.py report into the Check vocabulary."""
+    if not path:
+        return AUDIT.Check("collision", AUDIT.SKIP,
+                           "not evaluated (no --collision-report); run "
+                           "collision/check_cell.py on the program host")
+    with open(path) as fh:
+        rep = json.load(fh)
+    if preset and rep.get("preset") != preset:
+        return AUDIT.Check("collision", AUDIT.SKIP,
+                           f"report is for preset {rep.get('preset')!r}, not {preset!r}")
+    slots = rep["slots"]
+    bad = [s["slot"] for s in slots if not s["ok"]]
+    margin = rep["margin"] * 1000
+    if not bad and n_slots is not None and len(slots) != n_slots:
+        return AUDIT.Check("collision", AUDIT.SKIP,
+                           f"report covers {len(slots)} of {n_slots} slots")
+    if not bad:
+        return AUDIT.Check(
+            "collision", AUDIT.PASS,
+            f"all {len(slots)} slots collision-free through every grasp phase "
+            f"(mesh, {margin:.0f} mm to everything but the target jig and tray)",
+            len(slots))
+    return AUDIT.Check(
+        "collision", AUDIT.FAIL,
+        f"{len(bad)} of {len(slots)} slots collide or lose the {margin:.0f} mm "
+        f"margin ({', '.join(bad)})", len(slots) - len(bad))
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Report
+# ─────────────────────────────────────────────────────────────────────────────
+def evaluate(cfg, source: str, urdf: str = None, near_rise: float = 0.0,
+             want_reach: bool = True, collision_report: str = None) -> dict:
+    """Run every layer and assemble one report."""
+    checks = AUDIT.audit(cfg)
+
+    if want_reach:
+        reach = run_reach(cfg, urdf, near_rise)
+    else:
+        reach = {"ran": False, "reason": "disabled with --no-reach"}
+    checks.append(reach_check(reach))
+    checks.append(collision_check(collision_report,
+                                  None if source.endswith((".yaml", ".yml")) else source,
+                                  len(GEO.enumerate_slots(cfg))))
+
+    return {
+        "schema": SCHEMA,
+        "meta": {                         # excluded from diffs on purpose
+            "generated": datetime.datetime.now().isoformat(timespec="seconds"),
+            "source": source,
+            "urdf": urdf,
+        },
+        "cell": cfg.name,
+        "config": CFG.to_dict(cfg),
+        # Derived quantities are recomputed here rather than stored in the
+        # config, but they are the numbers a reader actually reasons about, so
+        # the report carries them and the diff watches them.
+        "derived": {
+            "origin_z": round(cfg.robot.origin_z, 6),
+            "shoulder_z": round(GEO.shoulder_z(cfg), 6),
+            "incoming_label_plane": round(cfg.incoming.label_plane_distance, 6),
+            "outgoing_label_plane": round(cfg.outgoing.label_plane_distance, 6),
+            "n_slots": len(GEO.enumerate_slots(cfg)),
+            "n_phases": len(SEQ.GRASP_PHASES),
+        },
+        "checks": AUDIT.to_dict(checks),
+        "reach": reach,
+        "verdict": AUDIT.verdict(checks),
+        "skipped": AUDIT.skipped(checks),
+    }
+
+
+def print_report(report: dict) -> None:
+    cfg, der = report["config"], report["derived"]
+    print(f"cell: {report['cell']}   ({report['meta']['source']})")
+    print(f"  shoulder {der['origin_z']:.4f} m | "
+          f"racks {cfg['incoming']['face_distance']:.3f} m | "
+          f"standoffs {cfg['standoff_near']:.4f} / {cfg['standoff_far']:.3f} m | "
+          f"{der['n_slots']} slots")
+    print()
+
+    width = max(len(c["name"]) for c in report["checks"])
+    for c in report["checks"]:
+        print(f"  [{c['status'].upper():<4}] {c['name']:<{width}}  {c['detail']}")
+    print()
+
+    r = report["reach"]
+    if r.get("ran"):
+        print(f"  reachability: {r['slots_ok']}/{r['slots_total']} slots, "
+              f"{r['poses_ok']}/{r['poses_total']} poses")
+        for b in r["blocked"]:
+            print(f"    blocked  {b['slot']:<22} {b['phase']:<12} "
+                  f"{b['status']:<12} r={b['shoulder_r']:.4f}")
+        print()
+
+    verdict = report["verdict"]
+    skipped = report["skipped"]
+    print(f"VERDICT: {verdict.upper()}")
+    if skipped:
+        # Said plainly, because a pass with a hole in it is the failure mode
+        # this whole tool exists to prevent.
+        print(f"  NOT CHECKED: {', '.join(skipped)}")
+        print("  This verdict covers only what was checked.")
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Diff
+# ─────────────────────────────────────────────────────────────────────────────
+def _same(a, b) -> bool:
+    """Equality that survives a JSON round-trip.
+
+    A baseline has been through ``json.dump``, so its tuples came back as lists
+    and its floats may differ in the last bit. Reporting those as changes would
+    bury the one line that actually matters under a screenful of noise.
+    """
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(_same(x, y) for x, y in zip(a, b))
+    if isinstance(a, (int, float)) and isinstance(b, (int, float)) \
+            and not isinstance(a, bool) and not isinstance(b, bool):
+        return abs(a - b) <= DIFF_TOL
+    return a == b
+
+
+def _flatten(prefix: str, value, out: dict) -> None:
+    if isinstance(value, dict):
+        for k, v in value.items():
+            _flatten(f"{prefix}.{k}" if prefix else k, v, out)
+    elif isinstance(value, (list, tuple)):
+        out[prefix] = [
+            json.dumps(v, sort_keys=True) if isinstance(v, dict) else v
+            for v in value
+        ]
+    else:
+        out[prefix] = value
+
+
+def diff(old: dict, new: dict) -> list:
+    """Name everything that moved between two reports.
+
+    Configuration first, because a changed result with an unchanged config means
+    something quite different from a changed result with a changed config.
+    """
+    lines = []
+
+    a, b = {}, {}
+    _flatten("", old.get("config", {}), a)
+    _flatten("", new.get("config", {}), b)
+    for key in sorted(set(a) | set(b)):
+        if not _same(a.get(key), b.get(key)):
+            lines.append(f"config  {key}: {a.get(key)!r} -> {b.get(key)!r}")
+
+    for key in sorted(set(old.get("derived", {})) | set(new.get("derived", {}))):
+        o, n = old.get("derived", {}).get(key), new.get("derived", {}).get(key)
+        if not _same(o, n):
+            lines.append(f"derived {key}: {o!r} -> {n!r}")
+
+    old_c = {c["name"]: c for c in old.get("checks", [])}
+    new_c = {c["name"]: c for c in new.get("checks", [])}
+    for name in sorted(set(old_c) | set(new_c)):
+        o, n = old_c.get(name), new_c.get(name)
+        if o is None:
+            lines.append(f"check   {name}: new check, {n['status']}")
+        elif n is None:
+            lines.append(f"check   {name}: no longer run (was {o['status']})")
+        else:
+            if o["status"] != n["status"]:
+                lines.append(f"check   {name}: {o['status']} -> {n['status']}"
+                             f"  ({n['detail']})")
+            elif not _same(o.get("value"), n.get("value")):
+                lines.append(f"margin  {name}: {o.get('value')!r} -> "
+                             f"{n.get('value')!r}  ({n['status']})")
+
+    for key in ("slots_ok", "poses_ok", "reach_sphere_margin", "worst_shortfall",
+                "tightest_pose", "ran"):
+        o, n = old.get("reach", {}).get(key), new.get("reach", {}).get(key)
+        if not _same(o, n):
+            lines.append(f"reach   {key}: {o!r} -> {n!r}")
+
+    ob = set(old.get("reach", {}).get("blocked_slots") or [])
+    nb = set(new.get("reach", {}).get("blocked_slots") or [])
+    for s in sorted(nb - ob):
+        lines.append(f"reach   {s}: became unreachable")
+    for s in sorted(ob - nb):
+        lines.append(f"reach   {s}: became reachable")
+
+    if old.get("verdict") != new.get("verdict"):
+        lines.append(f"VERDICT {old.get('verdict')} -> {new.get('verdict')}")
+    return lines
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Scan
+# ─────────────────────────────────────────────────────────────────────────────
+def parse_scan(text: str):
+    """``name=lo:hi:step`` -> (name, [values])."""
+    if "=" not in text:
+        raise SystemExit(f"--scan wants name=lo:hi:step, got {text!r}")
+    name, spec = text.split("=", 1)
+    name = name.strip()
+    if name not in CFG.SCAN_PARAMS:
+        raise SystemExit(f"unknown scan parameter {name!r}; available: "
+                         f"{', '.join(sorted(CFG.SCAN_PARAMS))}")
+    try:
+        lo, hi, step = (float(x) for x in spec.split(":"))
+    except ValueError:
+        raise SystemExit(f"--scan wants name=lo:hi:step, got {text!r}")
+    if step <= 0:
+        raise SystemExit("--scan step must be positive")
+
+    values, v, n = [], lo, 0
+    while v <= hi + step * 1e-6:       # accumulate by multiplication, not by
+        values.append(round(v, 9))     # repeated addition, so 0.025 stays 0.025
+        n += 1
+        v = lo + n * step
+    return name, values
+
+
+def run_scan(cfg, name: str, values, urdf, near_rise, want_reach) -> list:
+    """Evaluate the cell once per value and tabulate the outcome."""
+    print(f"scanning {name} over {len(values)} values")
+    print()
+    print(f"  {name:>12}  {'verdict':<8} {'slots':>7}  {'sphere':>9}  notes")
+    results = []
+    for v in values:
+        try:
+            probe = CFG.apply_override(cfg, name, v)
+        except CFG.CellConfigError as exc:
+            print(f"  {v:>12.4f}  {'-':<8} {'-':>7}  {'-':>9}  {exc}")
+            results.append({name: v, "verdict": "invalid", "detail": str(exc)})
+            continue
+
+        rep = evaluate(probe, f"scan {name}={v}", urdf, near_rise, want_reach)
+        r = rep["reach"]
+        slots = f"{r['slots_ok']}/{r['slots_total']}" if r.get("ran") else "-"
+        margin = (f"{r['reach_sphere_margin'] * 1000:>7.1f}mm"
+                  if r.get("ran") and r.get("reach_sphere_margin") is not None
+                  else "-")
+        notes = "; ".join(c["name"] for c in rep["checks"]
+                          if c["status"] == AUDIT.FAIL) or "-"
+        print(f"  {v:>12.4f}  {rep['verdict']:<8} {slots:>7}  {margin:>9}  {notes}")
+        results.append({
+            name: v, "verdict": rep["verdict"],
+            "slots_ok": r.get("slots_ok"), "slots_total": r.get("slots_total"),
+            "reach_sphere_margin": r.get("reach_sphere_margin"), "failed": notes,
+        })
+    return results
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--preset", default="as_built")
+    ap.add_argument("--config", help="cell config YAML, overrides --preset")
+    ap.add_argument("--urdf", default="tm5s_v4.urdf")
+    ap.add_argument("--near-rise", type=float, default=0.0)
+    ap.add_argument("--no-reach", action="store_true",
+                    help="geometry only; the verdict will say so")
+    ap.add_argument("--json", help="write the machine-readable report here")
+    ap.add_argument("--baseline", help="diff this run against an earlier report")
+    ap.add_argument("--scan", help="sweep one parameter: name=lo:hi:step")
+    ap.add_argument("--collision-report",
+                    help="JSON from program/collision/check_cell.py (else: skipped)")
+    args = ap.parse_args(argv)
+
+    source = args.config or args.preset
+    try:
+        cfg = (CFG.load_config(args.config) if args.config
+               else CFG.load_preset(args.preset))
+    except (CFG.CellConfigError, FileNotFoundError, OSError) as exc:
+        print(f"could not load {source}: {exc}")
+        return 2
+
+    if args.scan:
+        name, values = parse_scan(args.scan)
+        rows = run_scan(cfg, name, values, args.urdf, args.near_rise,
+                        not args.no_reach)
+        if args.json:
+            with open(args.json, "w") as fh:
+                json.dump({"scan": name, "results": rows}, fh, indent=1)
+            print()
+            print("wrote", args.json)
+        return 0
+
+    report = evaluate(cfg, source, args.urdf, args.near_rise, not args.no_reach,
+                      args.collision_report)
+    print_report(report)
+
+    if args.json:
+        with open(args.json, "w") as fh:
+            json.dump(report, fh, indent=1)
+        print()
+        print("wrote", args.json)
+
+    if args.baseline:
+        print()
+        with open(args.baseline) as fh:
+            old = json.load(fh)
+        lines = diff(old, report)
+        print(f"DIFF against {args.baseline}")
+        if not lines:
+            print("  nothing moved.")
+        for line in lines:
+            print("  " + line)
+
+    return 0 if report["verdict"] == AUDIT.PASS else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
