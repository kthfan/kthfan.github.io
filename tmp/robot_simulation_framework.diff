+"""The sim/real seam (D9, D30): topic names and the JSON payloads on them."""
+import json
+
+import numpy as np
+import pytest
+
+from cell_core import protocol as P
+
+
+def _traj(n=4, names=P.JOINTS):
+    t = np.linspace(0.0, 0.3, n)
+    q = np.outer(t, np.arange(1, len(names) + 1))
+    return t, q, np.gradient(q, t, axis=0)
+
+
+def test_joint_names_are_the_stage_dofs():
+    assert P.ARM_JOINTS == ("joint_1", "joint_2", "joint_3", "joint_4", "joint_5", "joint_6")
+    assert P.JAW_JOINTS == ("right_gripper_joint", "left_gripper_joint")
+    assert P.JOINTS == P.ARM_JOINTS + P.JAW_JOINTS
+
+
+def test_trajectory_round_trips():
+    t, q, qd = _traj()
+    msg = P.decode_trajectory(P.encode_trajectory("m1/s2", t, q, qd, meta={"segment": "insert"}))
+    assert msg["id"] == "m1/s2"
+    assert msg["joint_names"] == list(P.JOINTS)
+    np.testing.assert_allclose(msg["t"], t)
+    np.testing.assert_allclose(msg["q"], q)
+    np.testing.assert_allclose(msg["qd"], qd)
+    assert msg["meta"] == {"segment": "insert"}
+
+
+def test_missing_velocities_are_zero():
+    t, q, _ = _traj()
+    msg = P.decode_trajectory(P.encode_trajectory("a", t, q))
+    assert np.all(msg["qd"] == 0.0)
+
+
+def test_a_subset_of_joints_is_allowed():
+    names = P.JAW_JOINTS
+    t, q, qd = _traj(names=names)
+    assert P.decode_trajectory(P.encode_trajectory("j", t, q, qd, joint_names=names))["joint_names"] == list(names)
+
+
+@pytest.mark.parametrize("mutate", [
+    lambda d: d.update(version=99),
+    lambda d: d.update(id=""),
+    lambda d: d.update(joint_names=["joint_1", "joint_1"] + list(P.JOINTS[2:])),
+    lambda d: d.update(joint_names=["elbow"] + list(P.JOINTS[1:])),
+    lambda d: d.update(t=[0.1, 0.2, 0.3, 0.4]),
+    lambda d: d.update(t=[0.0, 0.2, 0.2, 0.3]),
+    lambda d: d.update(q=d["q"][:3]),
+    lambda d: d["q"][1].__setitem__(0, float("nan")),
+    lambda d: d.update(qd=[row[:-1] for row in d["qd"]]),
+])
+def test_malformed_trajectories_are_rejected(mutate):
+    t, q, qd = _traj()
+    d = json.loads(P.encode_trajectory("x", t, q, qd))
+    mutate(d)
+    with pytest.raises(P.ProtocolError):
+        P.decode_trajectory(json.dumps(d))
+
+
+def test_sample_interpolates_and_holds_the_end():
+    t = np.array([0.0, 1.0, 2.0])
+    q = np.array([[0.0], [1.0], [3.0]])
+    qd = np.array([[1.0], [1.5], [2.0]])
+    msg = {"t": t, "q": q, "qd": qd}
+    got_q, got_qd = P.sample(msg, 1.5)
+    assert got_q[0] == pytest.approx(2.0) and got_qd[0] == pytest.approx(1.75)
+    got_q, got_qd = P.sample(msg, 5.0)
+    assert got_q[0] == pytest.approx(3.0) and got_qd[0] == 0.0
+    got_q, _ = P.sample(msg, -1.0)
+    assert got_q[0] == pytest.approx(0.0)
+
+
+def test_status_round_trips_and_checks_the_state():
+    s = P.decode_status(P.encode_status("m1/s2", "done", t_end=1.25, contacts=[]))
+    assert s["id"] == "m1/s2" and s["state"] == "done" and s["t_end"] == 1.25
+    with pytest.raises(P.ProtocolError):
+        P.encode_status("m1/s2", "finished")
+    with pytest.raises(P.ProtocolError):
+        P.decode_status(json.dumps({"version": P.VERSION, "id": "m1/s2", "state": "finished"}))
