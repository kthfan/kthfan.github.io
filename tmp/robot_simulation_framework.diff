@@ -0,0 +1,221 @@
+"""The USD stage that was built must be the cell the reach sweep was run on.
+
+Every other check on the stage stops at the generator's dict. This one reads
+what the sim host measured in the saved ``cell.usd`` (``dump_usd_geometry.py``,
+trimmed by ``trim_geometry.py``) and compares it against ``cell_core``, which is
+the model the reachability verdicts are claims about.
+
+That gap is not theoretical. The generator documents ``*_rack_position[0]`` as
+the rack's front face, and a test pinned the dict to it. The first measured
+stage showed the builder puts the rack's *back* there: every shelf stood one
+rack depth (308 mm) nearer the robot than the sweep assumed (D22).
+
+The fixtures are measurements, so they go stale when the builder or the adapter
+changes. Rebuild both presets on the sim host, re-measure, and re-trim.
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "build_env"))
+
+import build_cell  # noqa: E402  (puts cell_core on the path)
+import cell_core.assets as A  # noqa: E402
+import cell_core.frames as F  # noqa: E402
+import cell_core.geometry as G  # noqa: E402
+
+MEASURED = HERE / "measured"
+
+#: Rack prim for each rack role.
+RACK_PRIM = {"incoming": "/Environment/RightRack", "outgoing": "/Environment/LeftRack"}
+
+#: Positions agree to float precision; anything larger is a real offset.
+TOL = 1e-5
+
+#: Accepted, not fixed (user decision 2026-09-25). The builder's ``_jig_x`` puts
+#: a leg and a gap on one side of the jig row and the remainder on the other, so
+#: the columns sit 16 mm off the centreline ``cell_core`` assumes. Which one the
+#: real rack matches is unmeasured; localisation absorbs it either way.
+LATERAL_TOL = 0.016 + TOL
+
+#: Presets that must differ from as_built in the robot mount and nothing else.
+MOUNT_VARIANTS = ("recommended", "strict")
+
+
+@pytest.fixture(params=("as_built",) + MOUNT_VARIANTS)
+def case(request):
+    stages = json.loads((MEASURED / f"{request.param}.json").read_text(encoding="utf-8"))
+    assert len(stages) == 1
+    stage = stages[0]
+    assert stage["path"].endswith(f"_stage/{request.param}/cell.usd"), stage["path"]
+    prims = {p["path"]: p for p in stage["prims"]}
+    cfg, _, _ = build_cell.plan(request.param)
+    return cfg, stage, prims
+
+
+def _translation(prim):
+    return np.asarray(prim["world_xform"]["translation"], dtype=float)
+
+
+def _rotate(quat_xyzw, v):
+    """Rotate *v* by a unit quaternion given as (x, y, z, w)."""
+    q = np.asarray(quat_xyzw[:3], dtype=float)
+    w = float(quat_xyzw[3])
+    v = np.asarray(v, dtype=float)
+    return v + 2.0 * np.cross(q, np.cross(q, v) + w * v)
+
+
+def _jig_prim(prims, slot):
+    if slot.rack == "table":
+        return prims["/Environment/Table/Jig"]
+    return prims[f"{RACK_PRIM[slot.role]}/Jig_{slot.layer}_{slot.column}"]
+
+
+def _rack_slots(cfg):
+    return [s for s in G.enumerate_slots(cfg) if s.rack != "table"]
+
+
+# ── the stage itself ─────────────────────────────────────────────────────────
+def test_the_stage_is_z_up_in_metres(case):
+    _, stage, _ = case
+    assert stage["up_axis"] == "Z"
+    assert stage["meters_per_unit"] == 1.0
+    assert stage["default_prim"] == "/Environment"
+
+
+def test_the_stage_holds_a_jig_for_every_swept_slot_and_no_other(case):
+    cfg, _, prims = case
+    jigs = {p for p in prims if p.rsplit("/", 1)[-1].startswith("Jig")}
+    expected = {_jig_prim(prims, s)["path"] for s in G.enumerate_slots(cfg)}
+    assert jigs == expected
+
+
+# ── the distance every reachability result depends on ────────────────────────
+def test_each_rack_presents_its_front_face_at_the_configured_distance(case):
+    """The robot-facing extreme of the legs, measured along the approach."""
+    cfg, _, prims = case
+    for rack in cfg.racks:
+        a = np.asarray(rack.approach, dtype=float)
+        legs = [p for path, p in prims.items()
+                if path.startswith(RACK_PRIM[rack.role] + "/Leg_")]
+        assert len(legs) == 4
+        near = min(min(a @ np.asarray(p["world_bbox"]["min"]),
+                       a @ np.asarray(p["world_bbox"]["max"])) for p in legs)
+        far = max(max(a @ np.asarray(p["world_bbox"]["min"]),
+                      a @ np.asarray(p["world_bbox"]["max"])) for p in legs)
+        assert near == pytest.approx(rack.face_distance, abs=TOL), rack.name
+        assert far - near == pytest.approx(rack.depth, abs=TOL), rack.name
+
+
+def test_every_jig_sits_where_the_sweep_put_it(case):
+    """Depth and height exact; lateral within the accepted builder offset."""
+    cfg, _, prims = case
+    for slot in G.enumerate_slots(cfg):
+        a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+        lat = F.lateral_axis(a)
+        face = slot.label_plane_dist + A.LABEL_PROUD_OF_FACE
+        t = _translation(_jig_prim(prims, slot))
+        assert a @ t == pytest.approx(face + A.JIG_Y_OFFSET, abs=TOL), slot.key
+        assert t[2] == pytest.approx(slot.jig_origin_z, abs=TOL), slot.key
+        assert abs(lat @ t - slot.lateral) <= LATERAL_TOL, (slot.key, lat @ t, slot.lateral)
+
+
+def test_the_columns_keep_the_configured_pitch(case):
+    """The lateral tolerance is for one shared offset, not for loose columns."""
+    cfg, _, prims = case
+    by_key = {(s.rack, s.layer, s.column): s for s in _rack_slots(cfg)}
+    for slot in _rack_slots(cfg):
+        if slot.column == 0:
+            continue
+        prev = by_key[(slot.rack, slot.layer, slot.column - 1)]
+        lat = F.lateral_axis(slot.approach_vec)
+        step = lat @ (_translation(_jig_prim(prims, slot))
+                      - _translation(_jig_prim(prims, prev)))
+        assert step == pytest.approx(slot.lateral - prev.lateral, abs=TOL), slot.key
+
+
+def test_every_label_faces_the_robot(case):
+    """The label is on the jig's +y side, which must point back along the approach."""
+    cfg, _, prims = case
+    for slot in G.enumerate_slots(cfg):
+        a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+        facing = _rotate(_jig_prim(prims, slot)["world_xform"]["quat_xyzw"], (0, 1, 0))
+        assert facing == pytest.approx(-a, abs=TOL), slot.key
+
+
+# ── shelves ──────────────────────────────────────────────────────────────────
+def test_the_shelf_plates_are_the_configured_planes(case):
+    cfg, _, prims = case
+    for rack in cfg.racks:
+        for i, height in enumerate(rack.layer_heights):
+            bb = prims[f"{RACK_PRIM[rack.role]}/Shelf_{i}"]["world_bbox"]
+            assert bb["center"][2] == pytest.approx(height, abs=TOL), (rack.name, i)
+            assert bb["size"][2] == pytest.approx(rack.plane_thickness, abs=TOL), (rack.name, i)
+        assert f"{RACK_PRIM[rack.role]}/Shelf_{len(rack.layer_heights)}" not in prims
+
+
+# ── trays ────────────────────────────────────────────────────────────────────
+def test_trays_sit_in_the_incoming_jigs_and_nowhere_else(case):
+    cfg, _, prims = case
+    trays = {p for p in prims if p.startswith("/Environment/Tray_")}
+    incoming = [s for s in _rack_slots(cfg) if s.role == "incoming"]
+    assert trays == {f"/Environment/Tray_{s.layer}_{s.column}" for s in incoming}
+    for s in incoming:
+        tray = _translation(prims[f"/Environment/Tray_{s.layer}_{s.column}"])
+        jig = _translation(_jig_prim(prims, s))
+        assert tray[:2] == pytest.approx(jig[:2], abs=TOL), s.key
+        assert tray[2] > jig[2], s.key
+
+
+# ── table and mount ──────────────────────────────────────────────────────────
+def test_the_table_presents_its_near_edge_at_the_configured_distance(case):
+    cfg, _, prims = case
+    t = cfg.table
+    a = np.asarray(t.approach, dtype=float)
+    bb = prims["/Environment/Table/TableTop"]["world_bbox"]
+    near = min(a @ np.asarray(bb["min"]), a @ np.asarray(bb["max"]))
+    assert near == pytest.approx(t.face_distance, abs=TOL)
+    assert bb["max"][2] == pytest.approx(t.height, abs=TOL)
+
+
+def test_the_arm_stands_at_the_configured_origin(case):
+    cfg, _, prims = case
+    t = _translation(prims["/Environment/RobotArmBase/RobotArm"])
+    assert t == pytest.approx([0.0, 0.0, cfg.robot.origin_z], abs=TOL)
+
+
+def test_the_arm_faces_the_way_the_config_says(case):
+    """M6: the builder turns the arm half a turn on its base (RotateZ 180).
+
+    The planner assumed an unturned base, and the first live transfer sent the
+    arm to the mirror slot in the outgoing rack.
+    """
+    cfg, _, prims = case
+    arm = prims["/Environment/RobotArmBase/RobotArm"]
+    T = cfg.robot.base_pose
+    assert _translation(arm) == pytest.approx(T[:3, 3], abs=TOL)
+    for i in range(3):
+        got = _rotate(arm["world_xform"]["quat_xyzw"], np.eye(3)[i])
+        assert got == pytest.approx(T[:3, i], abs=1e-6), i
+
+
+@pytest.mark.parametrize("variant", MOUNT_VARIANTS)
+def test_the_arm_is_the_only_thing_the_preset_moves(variant):
+    """D19 end to end, on the measured stages rather than on the dict."""
+    def load(name):
+        (stage,) = json.loads((MEASURED / f"{name}.json").read_text(encoding="utf-8"))
+        return {p["path"]: p for p in stage["prims"]}
+
+    a, b = load("as_built"), load(variant)
+    assert set(a) == set(b)
+    moved = {path for path in a
+             if a[path].get("world_xform") and not np.allclose(
+                 _translation(a[path]), _translation(b[path]), atol=TOL)}
+    assert moved and all(p.startswith("/Environment/RobotArmBase") for p in moved), moved
+    assert not math.isclose(_translation(a["/Environment/RobotArmBase/RobotArm"])[2],
+                            _translation(b["/Environment/RobotArmBase/RobotArm"])[2])
