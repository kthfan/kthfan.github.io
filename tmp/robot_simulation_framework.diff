+"""Config schema and presets.
+
+The governing requirement (user, D19): raising the robot mounting height must
+not destroy the record of the real as-built cell, and the layout must stay
+configurable. These tests pin both halves of that.
+"""
+import dataclasses
+
+import pytest
+
+from cell_core import config as C
+
+
+# ── presets exist and carry the measured cell ────────────────────────────────
+def test_every_shipped_preset_is_available():
+    assert set(C.available_presets()) >= {"as_built", "recommended", "strict"}
+
+
+def test_as_built_preserves_the_measured_robot_mount():
+    cfg = C.load_preset("as_built")
+    assert cfg.robot.base_size == pytest.approx(0.1765)
+    assert cfg.robot.leg_height == pytest.approx(0.47)
+    assert cfg.robot.plate_thickness == pytest.approx(0.03)
+    assert cfg.robot.origin_z == pytest.approx(0.6765)
+
+
+def test_the_arm_stands_half_a_turn_round_on_its_mount():
+    # The stage builder turns the arm with RotateZ 180: its base +x faces world
+    # -x. Every preset inherits it (isaacsim test_measured_stage checks it).
+    for name in ("as_built", "recommended", "strict"):
+        assert C.load_preset(name).robot.base_yaw_deg == pytest.approx(180.0), name
+
+
+def test_base_pose_is_the_turned_arm_origin_in_world():
+    T = C.RobotMount(0.2, 0.5, 0.03, base_yaw_deg=90.0).base_pose
+    assert T[:3, 3] == pytest.approx((0.0, 0.0, 0.73))
+    assert T[:3, 0] == pytest.approx((0.0, 1.0, 0.0), abs=1e-12)
+    assert T[:3, 1] == pytest.approx((-1.0, 0.0, 0.0), abs=1e-12)
+    assert T[:3, 2] == pytest.approx((0.0, 0.0, 1.0))
+    assert T[3] == pytest.approx((0.0, 0.0, 0.0, 1.0))
+
+
+def test_as_built_preserves_the_measured_rack_layout():
+    cfg = C.load_preset("as_built")
+    assert cfg.incoming.face_distance == pytest.approx(0.792)
+    assert cfg.incoming.width == pytest.approx(0.800)
+    assert cfg.incoming.layer_heights == (0.82, 1.07, 1.32)
+    assert cfg.incoming.n_jigs == 4
+    assert cfg.outgoing.face_distance == pytest.approx(0.792)
+    assert cfg.outgoing.width == pytest.approx(1.160)
+    assert cfg.outgoing.layer_heights == (0.55, 0.80, 1.05, 1.30)
+    assert cfg.outgoing.n_jigs == 6
+
+
+def test_table_parameters_are_left_at_the_generator_defaults():
+    # User instruction: "Just keep the original table parameters."
+    cfg = C.load_preset("as_built")
+    assert cfg.table.face_distance == pytest.approx(0.85)
+    assert cfg.table.height == pytest.approx(0.7)
+    assert cfg.table.confirmed is False
+
+
+# ── D19: recommended raises the mount and changes nothing else ───────────────
+def test_recommended_raises_the_mount_to_the_swept_height():
+    cfg = C.load_preset("recommended")
+    assert cfg.robot.origin_z == pytest.approx(0.7765)
+
+
+def test_recommended_differs_from_as_built_only_in_leg_height():
+    built = C.load_preset("as_built")
+    rec = C.load_preset("recommended")
+    a, b = C.to_dict(built), C.to_dict(rec)
+    a.pop("name"), b.pop("name")
+    a.pop("description"), b.pop("description")
+    assert a["robot"].pop("leg_height") != b["robot"].pop("leg_height")
+    assert a == b
+
+
+def test_recommended_clears_the_reachability_threshold():
+    assert C.load_preset("recommended").robot.origin_z >= C.ORIGIN_Z_THRESHOLD
+
+
+# ── strict: the lowest mount that services every slot (user, 2026-09-29) ─────
+def test_strict_mounts_the_robot_at_0_735():
+    cfg = C.load_preset("strict")
+    assert cfg.robot.origin_z == pytest.approx(0.735, abs=1e-12)
+
+
+def test_strict_differs_from_as_built_only_in_leg_height():
+    a, b = C.to_dict(C.load_preset("as_built")), C.to_dict(C.load_preset("strict"))
+    for d in (a, b):
+        d.pop("name"), d.pop("description")
+    assert a["robot"].pop("leg_height") != b["robot"].pop("leg_height")
+    assert a == b
+
+
+def test_strict_sits_below_recommended_and_above_the_threshold():
+    strict = C.load_preset("strict").robot.origin_z
+    assert C.ORIGIN_Z_THRESHOLD <= strict < C.load_preset("recommended").robot.origin_z
+
+
+# ── configurability ──────────────────────────────────────────────────────────
+def test_mount_height_is_configurable_without_touching_a_preset():
+    cfg = C.load_preset("as_built")
+    raised = C.replace_mount(cfg, leg_height=0.62)
+    assert raised.robot.origin_z == pytest.approx(0.8265)
+    assert cfg.robot.origin_z == pytest.approx(0.6765), "preset must be immutable"
+
+
+def test_config_round_trips_through_a_dict():
+    cfg = C.load_preset("as_built")
+    assert C.from_dict(C.to_dict(cfg)) == cfg
+
+
+def test_config_round_trips_through_yaml(tmp_path):
+    cfg = C.load_preset("recommended")
+    path = tmp_path / "cell.yaml"
+    C.save_config(cfg, path)
+    assert C.load_config(path) == cfg
+
+
+def test_config_is_frozen():
+    cfg = C.load_preset("as_built")
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        cfg.robot.leg_height = 1.0
+
+
+# ── validation ───────────────────────────────────────────────────────────────
+def test_validate_rejects_a_rack_too_narrow_for_its_jigs():
+    cfg = C.load_preset("as_built")
+    bad = dataclasses.replace(cfg, incoming=dataclasses.replace(cfg.incoming, width=0.5))
+    with pytest.raises(C.CellConfigError, match="incoming"):
+        C.validate(bad)
+
+
+def test_validate_rejects_layers_too_close_to_stack_a_tray():
+    cfg = C.load_preset("as_built")
+    bad = dataclasses.replace(
+        cfg, outgoing=dataclasses.replace(cfg.outgoing, layer_heights=(0.55, 0.60)))
+    with pytest.raises(C.CellConfigError, match="gap"):
+        C.validate(bad)
+
+
+def test_validate_rejects_a_near_standoff_that_drives_the_plate_into_the_shelf():
+    cfg = C.load_preset("as_built")
+    bad = dataclasses.replace(cfg, standoff_near=0.12)
+    with pytest.raises(C.CellConfigError, match="standoff"):
+        C.validate(bad)
+
+
+def test_validate_rejects_unsorted_layer_heights():
+    cfg = C.load_preset("as_built")
+    bad = dataclasses.replace(
+        cfg, incoming=dataclasses.replace(cfg.incoming, layer_heights=(1.07, 0.82)))
+    with pytest.raises(C.CellConfigError, match="ascending"):
+        C.validate(bad)
+
+
+def test_shipped_presets_validate():
+    for name in C.available_presets():
+        C.validate(C.load_preset(name))
+
+
+def test_unknown_preset_names_the_alternatives():
+    with pytest.raises(C.CellConfigError, match="as_built"):
+        C.load_preset("no_such_preset")
