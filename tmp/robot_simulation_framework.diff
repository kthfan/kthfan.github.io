+#!/usr/bin/env python3
+"""3D view of ``reach_volume.npz``: one dot per point, coloured by step reached.
+
+Points that reach no step are not drawn. Writes an interactive HTML (plotly);
+falls back to matplotlib if plotly is missing.
+
+    python .agent-workspace/tools/reach_volume/plot_reach_volume.py
+"""
+from __future__ import annotations
+
+import argparse
+import os
+
+import numpy as np
+
+DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "renders", "reach_volume")
+COLOURS = ["#1f77b4", "#17becf", "#2ca02c", "#bcbd22", "#ff7f0e", "#d62728", "#7f1f7f"]
+
+
+def load(path):
+    d = np.load(path)
+    xs, ys, zs, lv = d["xs"], d["ys"], d["zs"], d["levels"]
+    X, Y, Z = np.meshgrid(xs, ys, zs, indexing="ij")
+    return X, Y, Z, lv, [str(p) for p in d["phases"]]
+
+
+def plot_plotly(X, Y, Z, lv, phases, html, lost=None):
+    import plotly.graph_objects as go
+    fig = go.Figure()
+    if lost is not None and lost.any():
+        fig.add_trace(go.Scatter3d(
+            x=X[lost], y=Y[lost], z=Z[lost], mode="markers", visible="legendonly",
+            name=f"lost to self-collision ({int(lost.sum())})",
+            marker=dict(size=2, color="#999999")))
+    for k, name in enumerate(phases, 1):
+        m = lv == k
+        if not m.any():
+            continue
+        fig.add_trace(go.Scatter3d(
+            x=X[m], y=Y[m], z=Z[m], mode="markers", name=f"{k}: {name} ({int(m.sum())})",
+            marker=dict(size=2.5, color=COLOURS[(k - 1) % len(COLOURS)])))
+    fig.update_layout(
+        title="Reachability by last step reached (grasp point, gripper +Y, base frame)",
+        scene=dict(xaxis_title="x (m)", yaxis_title="y (m)", zaxis_title="z (m)",
+                   aspectmode="data"),
+        legend_title="last step reached")
+    fig.write_html(html)
+    return fig
+
+
+def plot_mpl(X, Y, Z, lv, phases):
+    import matplotlib.pyplot as plt
+    fig = plt.figure(figsize=(9, 8))
+    ax = fig.add_subplot(projection="3d")
+    for k, name in enumerate(phases, 1):
+        m = lv == k
+        if m.any():
+            ax.scatter(X[m], Y[m], Z[m], s=4, c=COLOURS[(k - 1) % len(COLOURS)],
+                       label=f"{k}: {name}")
+    ax.set_xlabel("x (m)"); ax.set_ylabel("y (m)"); ax.set_zlabel("z (m)")
+    ax.set_box_aspect((np.ptp(X), np.ptp(Y), np.ptp(Z)))
+    ax.legend()
+    return fig
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--npz", default=os.path.join(DATA, "reach_volume.npz"))
+    ap.add_argument("--html", default=os.path.join(DATA, "reach_volume.html"))
+    ap.add_argument("--matplotlib", action="store_true", help="force matplotlib window")
+    args = ap.parse_args()
+    X, Y, Z, lv, phases = load(args.npz)
+    lost = None
+    d = np.load(args.npz)
+    if "levels_ik" in d.files:   # self-collision run: points that IK alone would have completed
+        lost = (d["levels_ik"] == len(phases)) & (lv < len(phases))
+    try:
+        if args.matplotlib:
+            raise ImportError
+        plot_plotly(X, Y, Z, lv, phases, args.html, lost)
+        print("wrote", args.html)
+    except ImportError:
+        import matplotlib.pyplot as plt
+        plot_mpl(X, Y, Z, lv, phases)
+        plt.show()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
