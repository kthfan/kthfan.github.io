++"""M4 task 5 probe: does Isaac Sim 5.0 RTX render through the USD camera the way
++the pinhole model says it should?
++
++Run with Isaac Sim's python.sh on the sim host:
++
++    python.sh probe_render.py synthetic <cell.usd> <out_dir>
++    python.sh probe_render.py stage     <cell.usd> <out_dir>
++
++synthetic: copies the eih_camera attributes from <cell.usd> onto a fresh camera
++    at the origin, renders small discs at known optical-frame points, and
++    compares blob centroids against the pinhole projection with the calibrated
++    principal point (model "cal") and with a centred one (model "centre").
++    The two differ by ~65 px in u, so the verdict is unambiguous.
++stage: opens <cell.usd>, adds the env_setup.md lights, renders one frame from
++    the eih_camera as built (home pose), and dumps camera_params.
++
++Both write rgb.png + camera_params.json + report.json into <out_dir>/<mode>/.
++"""
++import json
++import os
++import sys
++import time
++
++MODE, CELL, OUT = sys.argv[1], os.path.abspath(sys.argv[2]), os.path.abspath(sys.argv[3])
++CAM_REL = "/Environment/RobotArmBase/RobotArm/link_6/eih_camera"
++ATTRS = ("focalLength", "horizontalAperture", "verticalAperture",
++         "horizontalApertureOffset", "verticalApertureOffset")
++W, H = 2592, 1944
++FX, FY, CX, CY = 2680.3818359375, 2680.74462890625, 1231.44580078125, 976.5955810546875
++DEPTH = 0.35
++POINTS = [(0.0, 0.0), (0.08, 0.0), (-0.08, 0.0), (0.0, 0.06), (0.0, -0.06),
++          (0.06, 0.045), (-0.06, -0.045)]  # optical (x, y) at DEPTH
++RADIUS = 0.004
++
++t0 = time.time()
++from isaacsim import SimulationApp  # noqa: E402
++
++app = SimulationApp({"headless": True, "renderer": "RayTracedLighting", "width": W, "height": H})
++print(f"[probe] app up {time.time() - t0:.1f}s", flush=True)
++
++import numpy as np  # noqa: E402
++import omni.replicator.core as rep  # noqa: E402
++import omni.usd  # noqa: E402
++from pxr import Gf, Usd, UsdGeom, UsdLux  # noqa: E402
++
++out = os.path.join(OUT, MODE)
++os.makedirs(out, exist_ok=True)
++built = Usd.Stage.Open(CELL)
++cam_attrs = {a: built.GetPrimAtPath(CAM_REL).GetAttribute(a).Get() for a in ATTRS}
++print("[probe] built camera attrs", cam_attrs, flush=True)
++del built
++
++ctx = omni.usd.get_context()
++if MODE == "synthetic":
++    ctx.new_stage()
++    stage = ctx.get_stage()
++    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
++    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
++    for p in stage.GetPseudoRoot().GetChildren():
++        print("[probe] default prim present:", p.GetPath(), p.GetTypeName(), flush=True)
++    cam = UsdGeom.Camera.Define(stage, "/World/Cam")
++    for a, v in cam_attrs.items():
++        cam.GetPrim().GetAttribute(a).Set(v)
++    cam.CreateClippingRangeAttr().Set(Gf.Vec2f(0.01, 100.0))
++    light = UsdLux.DistantLight.Define(stage, "/World/Key")  # emits along -Z, same as the camera
++    light.CreateIntensityAttr().Set(3000.0)
++    for i, (x, y) in enumerate(POINTS):
++        # Fronto-parallel discs: a pinhole maps a circle parallel to the image
++        # plane to a circle and its centre to the centre, so the blob centroid
++        # carries no shading or perspective bias (spheres did: ~0.3 % outward).
++        s = UsdGeom.Cylinder.Define(stage, f"/World/S{i}")
++        s.CreateRadiusAttr().Set(RADIUS)
++        s.CreateHeightAttr().Set(0.0005)
++        s.CreateAxisAttr().Set(UsdGeom.Tokens.z)
++        # optical (x, y, z) -> USD camera (x, -y, -z); the camera sits at the origin
++        UsdGeom.Xformable(s).AddTranslateOp().Set(Gf.Vec3d(x, -y, -DEPTH))
++    cam_path = "/World/Cam"
