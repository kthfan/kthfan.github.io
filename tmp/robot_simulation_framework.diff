+def _z_range(stage, prim):
+    from pxr import Usd, UsdGeom
+    cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), ["default", "render"])
+    r = cache.ComputeWorldBound(prim).ComputeAlignedRange()
+    return r.GetMin()[2], r.GetMax()[2]
+
+
+def test_the_built_stage_has_the_ground_plane_asset_as_its_floor(built_strict):
+    """Without a floor the dynamic bodies fall as soon as the timeline runs."""
+    from pxr import UsdGeom, UsdPhysics
+    ground = built_strict.GetPrimAtPath(B.GROUND)
+    assert ground, "no ground plane in the built stage"
+    layers = {os.path.normcase(s.layer.realPath) for s in ground.GetPrimStack()}
+    assert os.path.normcase(AP.asset(AP.GROUND_USD)) in layers
+    colliders = [p for p in built_strict.Traverse()
+                 if p.GetPath().HasPrefix(ground.GetPath())
+                 and p.HasAPI(UsdPhysics.CollisionAPI)]
+    assert colliders, "the ground has no collider"
+    for p in colliders:
+        assert UsdGeom.Plane(p).GetAxisAttr().Get() == "Z"
+        m = UsdGeom.Xformable(p).ComputeLocalToWorldTransform(0)
+        assert tuple(m.ExtractTranslation()) == pytest.approx((0, 0, 0), abs=1e-12)
+        assert tuple(m.TransformDir((0, 0, 1))) == pytest.approx((0, 0, 1), abs=1e-12)
+    assert _z_range(built_strict, ground) == pytest.approx((0.0, 0.0), abs=1e-12)
+
+
+def test_the_floor_standing_bodies_rest_on_the_ground_and_nothing_is_below_it(built_strict):
+    """cell_core's world has the floor at z = 0; so does the ground asset."""
+    from pxr import UsdPhysics
+    touching, lowest = set(), 0.0
+    for p in built_strict.Traverse():
+        if not p.HasAPI(UsdPhysics.RigidBodyAPI):
+            continue
+        lo, hi = _z_range(built_strict, p)
+        if lo > hi:  # an empty bound: a link with no geometry of its own
+            continue
+        lowest = min(lowest, lo)
+        if abs(lo) < 1e-6:
+            touching.add(str(p.GetPath()))
+    assert lowest > -1e-6
+    assert touching == ON_THE_FLOOR
+
+
+def test_every_tray_rests_on_a_collider_at_the_height_it_was_placed(built_strict):
+    """A tray over nothing solid falls as soon as physics runs.
+
+    Seen on the sim host: with a jig asset that had no colliders, every tray fell
+    35 mm through its jig onto the shelf (M4 6b).
+    """
+    from pxr import Usd, UsdGeom, UsdPhysics
+    cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), ["default", "render"])
+
+    def box(p):
+        r = cache.ComputeWorldBound(p).ComputeAlignedRange()
+        return r.GetMin(), r.GetMax()
+
+    colliders = [(p.GetPath(), box(p))
+                 for p in built_strict.Traverse(Usd.TraverseInstanceProxies())
+                 if p.HasAPI(UsdPhysics.CollisionAPI)
+                 and UsdPhysics.CollisionAPI(p).GetCollisionEnabledAttr().Get() is not False]
+    trays = [p.GetPath() for p in built_strict.Traverse()
+             if p.GetName().startswith("Tray_") and p.HasAPI(UsdPhysics.RigidBodyAPI)]
+    assert len(trays) == 12
+    for tray in trays:
+        own = [b for path, b in colliders if path.HasPrefix(tray)]
+        assert own, "%s has no collider" % tray
+        bottom = min(lo[2] for lo, _ in own)
+        x0, y0 = min(lo[0] for lo, _ in own), min(lo[1] for lo, _ in own)
+        x1, y1 = max(hi[0] for _, hi in own), max(hi[1] for _, hi in own)
+        tops = [hi[2] for path, (lo, hi) in colliders
+                if not path.HasPrefix(tray)
+                and lo[0] < x1 and hi[0] > x0 and lo[1] < y1 and hi[1] > y0
+                and hi[2] <= bottom + 1e-6]
+        assert tops, "nothing under %s" % tray
+        assert max(tops) == pytest.approx(bottom, abs=1e-6), tray
