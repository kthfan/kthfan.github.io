+"""Build the Isaac Sim stage for a named preset.
+
+    python build_cell.py --preset as_built --output /tmp/as_built.usd
+
+This is the join between the two halves of the project: ``cell_core`` holds the
+measured cell and decides every distance, and ``create_environment`` turns those
+distances into USD. Keeping the join in one script is what makes D19 a preset
+swap rather than a code edit.
+
+Everything except the final USD write is plain arithmetic, and it lives in
+:func:`plan` so it can be tested on a machine with no Isaac Sim. ``pxr`` is
+imported inside :func:`build`, not at module scope, for the same reason.
+
+Fidelity notes are printed on every build, never suppressed. The generator
+cannot reproduce every measured dimension -- it applies one width margin to both
+racks, so one of them comes out wider than the shelf that was measured -- and a
+build that did not say so would leave the reader believing the sim is the cell.
+"""
+import argparse
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+
+def _locate_cell_core():
+    """Find ``cell_core`` from whichever repo layout this script is deployed in.
+
+    Walks up rather than assuming: this repo keeps it under ``vendor/`` while
+    the development checkout also has it at ``shared/``. Deliberately not
+    PYTHONPATH -- setting that trips the remote approval prompt.
+    """
+    here = os.path.abspath(__file__)
+    for _ in range(6):
+        here = os.path.dirname(here)
+        for sub in ("vendor", "shared", ""):
+            candidate = os.path.join(here, sub) if sub else here
+            if os.path.isdir(os.path.join(candidate, "cell_core")):
+                return candidate
+    raise ImportError("could not find cell_core next to build_cell.py")
+
+
+sys.path.insert(0, _locate_cell_core())
+
+import numpy as np  # noqa: E402
+
+import asset_paths  # noqa: E402
+import cell_core.config as C  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import env_adapter as E  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+
+#: Where ``create_environment`` references tm5s.usd, and the prims inside it.
+ROBOT_ARM = "/Environment/RobotArmBase/RobotArm"
+EIH_CAMERA = "link_6/eih_camera"
+FLANGE = "flange"
+
+#: The floor: ground_plane.usd, whose surface and collider are at z = 0, which
+#: is cell_core's floor. Path as in the resource drop's env_setup.md.
+GROUND = "/GroundPlane"
+
+#: Optical frame (+Z forward, +Y image-down) -> USD camera (-Z forward, +Y up).
+_OPTICAL_TO_USD_CAM = np.diag([1.0, -1.0, -1.0, 1.0])
+
+
+def plan(preset=None, config_path=None):
+    """Everything decided before a single prim exists.
+
+    Returns the config, the keyword arguments ``create_environment`` will be
+    called with, and the fidelity notes. No USD, no Isaac Sim, no file writes.
+    """
+    if config_path:
+        cfg = C.load_config(config_path)
+    else:
+        cfg = C.load_preset(preset or "as_built")
+    env_kwargs = E.load_generator()(**E.generator_kwargs(cfg))
+    return cfg, env_kwargs, E.unsupported(cfg)
+
+
+def describe(cfg, env_kwargs, notes):
+    """The build report, as a list of lines."""
+    lines = [
+        "cell: %s" % cfg.name,
+        "  robot origin %.4f m (leg %.3f m)" % (cfg.robot.origin_z, cfg.robot.leg_height),
+        "  incoming  face %.3f m  width %.3f m  %d jigs x %d layers"
+        % (cfg.incoming.face_distance, env_kwargs["right_rack_size"][0],
+           cfg.incoming.n_jigs, len(cfg.incoming.layer_heights)),
+        "  outgoing  face %.3f m  width %.3f m  %d jigs x %d layers"
+        % (cfg.outgoing.face_distance, env_kwargs["left_rack_size"][0],
+           cfg.outgoing.n_jigs, len(cfg.outgoing.layer_heights)),
+        "  table     face %.3f m  height %.3f m"
+        % (cfg.table.face_distance, cfg.table.height),
+    ]
+    if notes:
+        lines.append("")
+        lines.append("the stage will not match the configuration exactly:")
+        lines.extend("  - %s" % n for n in notes)
+    return lines
+
+
+def eih_camera_local(W_parent, W_flange):
+    """Local transform for the USD camera prim that realises the hand-eye.
+
+    *W_parent* and *W_flange* are world poses (column-vector 4x4) of the
+    camera's parent link and of the flange, at whatever configuration the stage
+    is authored in: only their relative pose matters.
+    """
+    hand_eye = F.make_pose(F.quat_to_matrix(A.CAM_QUAT), (A.CAM_FX, A.CAM_FY, A.CAM_FZ))
+    return np.linalg.inv(W_parent) @ W_flange @ hand_eye @ _OPTICAL_TO_USD_CAM
+
+
+def eih_camera_attributes(cfg, focal_length):
+    """USD camera attributes for the focal config both sighting reads use."""
+    near = A.focal_config_for(cfg.standoff_near)
+    far = A.focal_config_for(cfg.standoff_far)
+    if near != far:
+        raise ValueError(
+            "the reads need different focal configs (%d at %.4f m, %d at %.4f m); "
+            "one camera prim cannot carry both"
+            % (near, cfg.standoff_near, far, cfg.standoff_far))
+    k = A.FOCAL_CONFIGS[near]
+    return F.usd_camera_attributes(k["fx"], k["fy"], k["cx"], k["cy"],
+                                   A.EIH_WIDTH, A.EIH_HEIGHT, focal_length)
+
+
+def apply_eih_camera(stage, robot_root, cfg):
+    """Override the asset's EIH camera with the calibrated pose and intrinsics.
+
+    The asset's focal length is kept; the apertures carry the calibration.
+    Returns the camera prim path.
+    """
+    from pxr import Gf, Usd, UsdGeom
+
+    cam_prim = stage.GetPrimAtPath("%s/%s" % (robot_root, EIH_CAMERA))
+    flange = stage.GetPrimAtPath("%s/%s" % (robot_root, FLANGE))
+    if not (cam_prim and cam_prim.IsA(UsdGeom.Camera)) or not flange:
+        raise RuntimeError("no %s camera or %s under %s" % (EIH_CAMERA, FLANGE, robot_root))
+
+    t = Usd.TimeCode.Default()
+
+    def world(prim):
+        m = UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(t)
+        return np.array([[m[i][j] for j in range(4)] for i in range(4)]).T
+
+    local = Gf.Matrix4d(*eih_camera_local(world(cam_prim.GetParent()),
+                                          world(flange)).T.flatten().tolist())
+    xf = UsdGeom.Xformable(cam_prim)
+    xf.ClearXformOpOrder()
+    xf.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble, "calibrated").Set(
+        local.ExtractTranslation())
+    xf.AddOrientOp(UsdGeom.XformOp.PrecisionDouble, "calibrated").Set(
+        local.ExtractRotationQuat())
+
+    cam = UsdGeom.Camera(cam_prim)
+    for name, value in eih_camera_attributes(cfg, cam.GetFocalLengthAttr().Get()).items():
+        cam_prim.GetAttribute(name).Set(value)
+    return str(cam_prim.GetPath())
+
+
+def add_ground(stage, asset_root=None):
+    """Reference the ground plane asset, untransformed, at :data:`GROUND`."""
+    from pxr import UsdGeom
+
+    prim = UsdGeom.Xform.Define(stage, GROUND).GetPrim()
+    prim.GetReferences().AddReference(asset_paths.asset(asset_paths.GROUND_USD, asset_root))
+    return GROUND
+
+
+def build(cfg, env_kwargs, output, asset_root=None, label_image_dir=None):
+    """Create the stage and save it. The only part that needs Isaac Sim."""
+    from pxr import Usd, UsdGeom
+    from create_environment import create_environment
+
+    stage = Usd.Stage.CreateNew(output)
+    UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.z)
+    UsdGeom.SetStageMetersPerUnit(stage, 1.0)
+    create_environment(
+        stage,
+        asset_root=asset_root,
+        label_image_dir=label_image_dir,
+        **env_kwargs)
+    apply_eih_camera(stage, ROBOT_ARM, cfg)
+    add_ground(stage, asset_root)
+    stage.GetRootLayer().Save()
+    return output
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    source = parser.add_mutually_exclusive_group()
+    source.add_argument("--preset", help="named preset, e.g. as_built")
+    source.add_argument("--config", help="path to a config YAML")
+    parser.add_argument("--output", help="where to write the .usd stage")
+    parser.add_argument("--asset-root", default=None,
+                        help="directory holding the .usd assets (default: %s "
+                             "or a known layout)" % asset_paths.ASSET_ENV_VAR)
+    parser.add_argument("--label-image-dir", default=None,
+                        help="directory for generated AprilGrid images")
+    parser.add_argument("--dry-run", action="store_true",
+                        help="report what would be built without needing Isaac Sim")
+    args = parser.parse_args(argv)
+
+    cfg, env_kwargs, notes = plan(args.preset, args.config)
+    for line in describe(cfg, env_kwargs, notes):
+        print(line)
+
+    if args.dry_run:
+        print("\ndry run: nothing written")
+        return 0
+    if not args.output:
+        parser.error("--output is required unless --dry-run is given")
+
+    # Resolved before the stage is created so a bad asset root fails with a list
+    # of directories rather than half a stage on disk.
+    root = asset_paths.find_asset_root(args.asset_root)
+    print("\nassets: %s" % root)
+    build(cfg, env_kwargs, args.output, root, args.label_image_dir)
+    print("wrote %s" % args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
