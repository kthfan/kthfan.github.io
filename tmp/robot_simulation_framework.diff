+"""Grasp phase sequencing.
+
+The six phases here are exactly the ones swept in findings/04. The sweep is only
+meaningful if these poses stay the poses that were swept.
+"""
+import dataclasses
+
+import numpy as np
+import pytest
+
+from cell_core import assets as A
+from cell_core import config as C
+from cell_core import frames as F
+from cell_core import geometry as G
+from cell_core import sequence as S
+
+
+@pytest.fixture
+def cfg():
+    return C.load_preset("as_built")
+
+
+@pytest.fixture
+def slot(cfg):
+    return next(s for s in G.enumerate_slots(cfg) if s.key == "incoming/L0/C0")
+
+
+def depth(slot, T):
+    """How far along the approach axis the flange sits, from the robot axis."""
+    return float(np.dot(T[:3, 3], slot.approach))
+
+
+def test_the_first_six_phases_are_the_ones_findings_04_swept():
+    """The swept six must keep their identity and their order.
+
+    ``carry`` was appended later (task 3a). Appending is safe; inserting or
+    reordering would silently invalidate findings/04, which is why this pins the
+    prefix rather than the whole tuple.
+    """
+    assert S.GRASP_PHASES[:6] == (
+        "sight_far", "sight_near", "pre_insert", "insert", "lift", "withdraw")
+
+
+def test_grasp_sequence_yields_one_pose_per_phase(cfg, slot):
+    poses = S.grasp_sequence(cfg, slot)
+    assert list(poses) == list(S.GRASP_PHASES)
+    assert all(T.shape == (4, 4) for T in poses.values())
+
+
+def test_every_pose_is_a_valid_rigid_transform(cfg, slot):
+    for T in S.grasp_sequence(cfg, slot).values():
+        R = T[:3, :3]
+        assert R @ R.T == pytest.approx(np.eye(3), abs=1e-12)
+        assert np.linalg.det(R) == pytest.approx(1.0)
+        assert T[3] == pytest.approx([0, 0, 0, 1])
+
+
+def test_the_camera_closes_in_then_the_plate_advances_and_retreats(cfg, slot):
+    p = {k: depth(slot, T) for k, T in S.grasp_sequence(cfg, slot).items()}
+    assert p["sight_far"] < p["sight_near"]
+    assert p["pre_insert"] < p["insert"]
+    assert p["withdraw"] < p["insert"]
+    assert p["withdraw"] == pytest.approx(p["pre_insert"])
+
+
+def test_the_flange_is_not_monotonic_because_the_plate_is_long(cfg, slot):
+    """A deliberate guard on a counter-intuitive fact.
+
+    The close read pushes the flange *further* into the shelf than pre-insert
+    does. The camera sits 0.044 m ahead of the flange but the plate tip sits
+    0.321 m ahead, so once the camera is at the 0.277 m close standoff the tip
+    is already level with the label plane, and pre-insert must pull back to
+    leave its 10 mm gap. Anyone tempted to "fix" the ordering should see this
+    fail first.
+    """
+    p = {k: depth(slot, T) for k, T in S.grasp_sequence(cfg, slot).items()}
+    assert p["sight_near"] > p["pre_insert"]
+    tip = {k: d + A.PLATE_FZ_TIP for k, d in p.items()}
+    assert tip["sight_far"] < slot.label_plane_dist
+    assert tip["sight_near"] == pytest.approx(slot.label_plane_dist, abs=2e-4)
+
+
+def test_lift_raises_the_tray_without_moving_it_in_or_out(cfg, slot):
+    seq = S.grasp_sequence(cfg, slot)
+    assert seq["lift"][2, 3] - seq["insert"][2, 3] == pytest.approx(S.LIFT_HEIGHT)
+    assert depth(slot, seq["lift"]) == pytest.approx(depth(slot, seq["insert"]))
+
+
+def test_the_plate_is_centred_in_the_jig_corridor_at_insertion(cfg, slot):
+    seq = S.grasp_sequence(cfg, slot)
+    plate_mid_z = seq["insert"][2, 3] + A.PLATE_MID_FY
+    corridor_mid = slot.jig_origin_z + (A.CORRIDOR_BOT + A.CORRIDOR_TOP) / 2
+    assert plate_mid_z == pytest.approx(corridor_mid, abs=1e-9)
+
+
+def _tray_back(slot):
+    return slot.label_plane_dist + (A.LABEL_JIG_Y - A.JIG_Y_OFFSET) + A.TRAY_BACK_DEPTH
+
+
+def _front_column_face(slot):
+    """Distance from the robot axis to the front face of the jig's front columns."""
+    front = max(c[1] + s[1] / 2 for part, (c, s) in A.JIG_BOXES.items()
+                if part.startswith("col"))
+    face = slot.label_plane_dist + (A.LABEL_JIG_Y - A.JIG_Y_OFFSET)
+    return face + A.JIG_Y_OFFSET - front
+
+
+def test_insertion_stops_with_the_body_front_margin_short_of_the_jig(cfg, slot):
+    """User 2026-10-06 (D28): 'if touched, stop it earlier'.
+
+    The 122 mm body cannot enter the 106 mm pocket, so it stops in front of the
+    front columns, keeping FRONT_MARGIN as the plate tip keeps BACK_MARGIN.
+    """
+    body_front = depth(slot, S.insert_pose(slot)) + A.BODY_FZ_FRONT
+    assert _front_column_face(slot) - body_front == pytest.approx(S.FRONT_MARGIN, abs=1e-9)
+
+
+def test_the_front_margin_matches_the_back_margin():
+    """A depth error eats either margin alike, so neither is the weaker one."""
+    assert S.FRONT_MARGIN == S.BACK_MARGIN == 0.010
+
+
+def test_insertion_never_passes_the_back_margin(cfg, slot):
+    tip = depth(slot, S.insert_pose(slot)) + A.PLATE_FZ_TIP
+    assert _tray_back(slot) - tip >= S.BACK_MARGIN - 1e-12
+
+
+def test_without_the_body_in_the_way_the_back_margin_governs(slot, monkeypatch):
+    monkeypatch.setattr(A, "BODY_FZ_FRONT", 0.0)
+    tip = depth(slot, S.insert_pose(slot)) + A.PLATE_FZ_TIP
+    assert _tray_back(slot) - tip == pytest.approx(S.BACK_MARGIN, abs=1e-9)
+
+
+def test_the_stopped_plate_still_carries_the_tray_past_its_centre(cfg, slot):
+    tip = depth(slot, S.insert_pose(slot)) + A.PLATE_FZ_TIP
+    tray_centre = _tray_back(slot) - A.TRAY_Y / 2
+    assert tip - tray_centre > 0.05
+
+
+def test_the_insert_tip_depth_is_the_one_the_pose_uses(cfg, slot):
+    face = slot.label_plane_dist + (A.LABEL_JIG_Y - A.JIG_Y_OFFSET)
+    tip = depth(slot, S.insert_pose(slot)) + A.PLATE_FZ_TIP
+    assert tip - face == pytest.approx(S.insert_tip_depth(), abs=1e-12)
+
+
+def test_the_lift_is_the_derived_21_mm():
+    """D28: recess gap + the M4 vertical limit + LIFT_CLEARANCE (test_scene)."""
+    assert S.LIFT_HEIGHT == pytest.approx(0.02125, abs=1e-12)
+
+
+def test_the_camera_sits_at_the_commanded_standoff_from_the_label(cfg, slot):
+    seq = S.grasp_sequence(cfg, slot)
+    cam = depth(slot, seq["sight_far"]) + A.CAM_FZ
+    assert slot.label_plane_dist - cam == pytest.approx(cfg.standoff_far, abs=1e-9)
+
+
+def test_the_camera_is_level_with_the_label_when_no_rise_is_asked_for(cfg, slot):
+    seq = S.grasp_sequence(cfg, slot)
+    assert seq["sight_far"][2, 3] + A.CAM_FY == pytest.approx(slot.label_centre_z)
+
+
+def test_a_rise_lifts_only_the_close_sighting_pose(cfg, slot):
+    base = S.grasp_sequence(cfg, slot)
+    lifted = S.grasp_sequence(cfg, slot, near_rise=0.02)
+    assert lifted["sight_near"][2, 3] - base["sight_near"][2, 3] == pytest.approx(0.02)
+    assert lifted["sight_far"][2, 3] == pytest.approx(base["sight_far"][2, 3])
+    assert lifted["insert"][2, 3] == pytest.approx(base["insert"][2, 3])
+
+
+def test_poses_follow_the_rack_approach_direction(cfg):
+    slots = G.enumerate_slots(cfg)
+    inc = next(s for s in slots if s.rack == "incoming")
+    out = next(s for s in slots if s.rack == "outgoing")
+    assert S.grasp_sequence(cfg, inc)["insert"][0, 3] > 0
+    assert S.grasp_sequence(cfg, out)["insert"][0, 3] < 0
+
+
+def test_the_sequence_honours_a_configured_standoff(cfg, slot):
+    far = dataclasses.replace(cfg, standoff_far=0.40)
+    seq = S.grasp_sequence(far, slot)
+    cam = depth(slot, seq["sight_far"]) + A.CAM_FZ
+    assert slot.label_plane_dist - cam == pytest.approx(0.40, abs=1e-9)
+
+
+def test_the_swept_sequence_is_untilted(cfg, slot):
+    # findings/04 swept these poses with the plate level; carry tilt belongs to
+    # the transit phase, which is not slot-relative and is not generated here.
+    for T in S.grasp_sequence(cfg, slot).values():
+        assert T[2, 2] == pytest.approx(0.0, abs=1e-12)
+
+
+# -- the EIH camera as a pose (M4) --------------------------------------------
+# Optical convention: +Z looks forward, +X is image-right, +Y is image-down.
+def _project(T_world_cam, point, k):
+    p = np.linalg.inv(T_world_cam) @ np.append(point, 1.0)
+    return k["fx"] * p[0] / p[2] + k["cx"], k["fy"] * p[1] / p[2] + k["cy"], p[2]
+
+
+def _label_centre(slot):
+    a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+    return (a * slot.label_plane_dist + F.lateral_axis(a) * slot.lateral
+            + F.UP * slot.label_centre_z)
+
+
+@pytest.mark.parametrize("phase", ["sight_far", "sight_near"])
+def test_the_label_centre_lands_near_the_middle_of_the_image(cfg, phase):
+    """The sighting pose puts the grid where the detector can see all of it.
+
+    Not exactly on the principal point: the hand-eye rotation is 0.39 deg off
+    the flange axis, about 18 px at this focal length.
+    """
+    standoff = cfg.standoff_far if phase == "sight_far" else cfg.standoff_near
+    k = A.FOCAL_CONFIGS[A.focal_config_for(standoff)]
+    for slot in G.enumerate_slots(cfg):
+        T = S.eih_camera_pose(S.grasp_sequence(cfg, slot)[phase])
+        u, v, z = _project(T, _label_centre(slot), k)
+        assert z == pytest.approx(standoff, abs=1e-3), slot.key
+        assert abs(u - k["cx"]) < 25 and abs(v - k["cy"]) < 25, (slot.key, u, v)
+
+
+def test_world_up_is_image_up_and_flange_x_is_image_left(cfg, slot):
+    """A camera rolled 180 deg would still see the label centre centred."""
+    T = S.eih_camera_pose(S.grasp_sequence(cfg, slot)["sight_near"])
+    k = A.FOCAL_CONFIGS[6]
+    c = _label_centre(slot)
+    _, v_mid, _ = _project(T, c, k)
+    _, v_up, _ = _project(T, c + 0.02 * F.UP, k)
+    assert v_up < v_mid - 100
+    # The hand-eye is ~180 deg about flange Z, so flange +X is image-left.
+    u_mid, _, _ = _project(T, c, k)
+    u_fx, _, _ = _project(T, c + 0.02 * F.lateral_axis(slot.approach_vec), k)
+    assert u_fx < u_mid - 100
+
+
+def test_the_camera_pose_is_a_rigid_transform(cfg, slot):
+    R = S.eih_camera_pose(S.grasp_sequence(cfg, slot)["sight_far"])[:3, :3]
+    assert R @ R.T == pytest.approx(np.eye(3), abs=1e-9)
+    assert np.linalg.det(R) == pytest.approx(1.0)
