@@ -0,0 +1,162 @@
+"""The collision world (``cell_core.scene``) must be the stage that was built.
+
+``test_measured_stage`` pins the measured USD stage to the reach model. This
+pins the M3 collision boxes to the same measurements: every native solid the
+builder made (shelves, rack legs, table top, pedestal) must have a scene box
+with the same world bounding box, and every jig and tray must stand where the
+stage has it. Cylinders are modelled as their enclosing boxes, whose bounding
+box is the cylinder's.
+
+Jigs and trays carry only poses in the fixtures (they are referenced assets);
+their shape is pinned by ``test_scene`` against ``assets.JIG_BOXES``, measured
+from ``tray_jig_with_label.usd``.
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "build_env"))
+
+import build_cell  # noqa: E402  (puts cell_core on the path)
+import cell_core.assets as A  # noqa: E402
+import cell_core.frames as F  # noqa: E402
+import cell_core.geometry as G  # noqa: E402
+import cell_core.scene as S  # noqa: E402
+
+MEASURED = HERE / "measured"
+RACK_PRIM = {"incoming": "/Environment/RightRack", "outgoing": "/Environment/LeftRack"}
+TOL = 1e-5
+#: The accepted builder offset of the jig row (see test_measured_stage).
+LATERAL_TOL = 0.016 + TOL
+#: Lowest point of the tray mesh above the Tray prim origin, from tray.usd.
+TRAY_MESH_Z_MIN = 0.0007
+
+
+@pytest.fixture(params=("as_built", "recommended", "strict"))
+def case(request):
+    (stage,) = json.loads((MEASURED / f"{request.param}.json").read_text(encoding="utf-8"))
+    prims = {p["path"]: p for p in stage["prims"]}
+    cfg, _, _ = build_cell.plan(request.param)
+    return cfg, prims, {b.name: b for b in S.cell_boxes(cfg)}
+
+
+def _aabb(box):
+    c = box.corners()
+    return c.min(axis=0), c.max(axis=0)
+
+
+def _assert_same_bbox(box, prim):
+    lo, hi = _aabb(box)
+    bb = prim["world_bbox"]
+    assert lo == pytest.approx(bb["min"], abs=TOL), (box.name, prim["path"])
+    assert hi == pytest.approx(bb["max"], abs=TOL), (box.name, prim["path"])
+
+
+def _assert_same_bboxes(boxes, prims):
+    """Unordered: the builder and the scene number legs differently."""
+    def key(lo_hi):
+        return tuple(np.round(np.concatenate(lo_hi), 4))
+    got = sorted(key(_aabb(b)) for b in boxes)
+    want = sorted(key((np.asarray(p["world_bbox"]["min"]), np.asarray(p["world_bbox"]["max"])))
+                  for p in prims)
+    assert len(got) == len(want)
+    for g, w in zip(got, want):
+        assert g == pytest.approx(w, abs=1e-4)
+
+
+def _translation(prim):
+    return np.asarray(prim["world_xform"]["translation"], dtype=float)
+
+
+def _jig_prim(prims, slot):
+    if slot.rack == "table":
+        return prims["/Environment/Table/Jig"]
+    return prims[f"{RACK_PRIM[slot.role]}/Jig_{slot.layer}_{slot.column}"]
+
+
+def _rotate(quat_xyzw, v):
+    q = np.asarray(quat_xyzw[:3], dtype=float)
+    w = float(quat_xyzw[3])
+    v = np.asarray(v, dtype=float)
+    return v + 2.0 * np.cross(q, np.cross(q, v) + w * v)
+
+
+# ── native solids ────────────────────────────────────────────────────────────
+def test_every_shelf_is_the_built_shelf(case):
+    cfg, prims, boxes = case
+    for rack in cfg.racks:
+        for i in range(len(rack.layer_heights)):
+            _assert_same_bbox(boxes[f"rack/{rack.name}/shelf{i}"],
+                              prims[f"{RACK_PRIM[rack.role]}/Shelf_{i}"])
+
+
+def test_the_rack_legs_enclose_the_built_legs(case):
+    cfg, prims, boxes = case
+    for rack in cfg.racks:
+        root = RACK_PRIM[rack.role] + "/Leg_"
+        _assert_same_bboxes([b for n, b in boxes.items() if n.startswith(f"rack/{rack.name}/leg")],
+                            [p for path, p in prims.items() if path.startswith(root)])
+
+
+def test_the_table_top_is_the_built_table_top(case):
+    _, prims, boxes = case
+    _assert_same_bbox(boxes["table/top"], prims["/Environment/Table/TableTop"])
+
+
+def test_the_pedestal_is_the_built_pedestal(case):
+    _, prims, boxes = case
+    _assert_same_bbox(boxes["mount/base"], prims["/Environment/RobotArmBase/Base"])
+    _assert_same_bbox(boxes["mount/plate"], prims["/Environment/RobotArmBase/TopPlate"])
+    _assert_same_bboxes([b for n, b in boxes.items() if n.startswith("mount/leg")],
+                        [p for path, p in prims.items()
+                         if path.startswith("/Environment/RobotArmBase/Leg_")])
+
+
+def test_every_built_solid_has_a_scene_box(case):
+    """A solid added to the builder must be added to the collision world too."""
+    _, prims, _ = case
+    solids = {p["path"] for p in prims.values() if "world_bbox" in p}
+    covered = ({f"{r}/Shelf_{i}" for r in RACK_PRIM.values() for i in range(8)}
+               | {f"{r}/Leg_{i}" for r in RACK_PRIM.values() for i in range(4)}
+               | {"/Environment/Table/TableTop", "/Environment/RobotArmBase/Base",
+                  "/Environment/RobotArmBase/TopPlate"}
+               | {f"/Environment/RobotArmBase/Leg_{i}" for i in range(4)})
+    assert solids <= covered, sorted(solids - covered)
+
+
+# ── jigs and trays ───────────────────────────────────────────────────────────
+def test_every_jig_box_stands_on_the_built_jig(case):
+    """Depth and height exact, lateral within the builder offset, same orientation."""
+    cfg, prims, _ = case
+    for slot in G.enumerate_slots(cfg):
+        prim = _jig_prim(prims, slot)
+        T = S.jig_pose(slot)
+        lat = F.lateral_axis(slot.approach_vec / np.linalg.norm(slot.approach_vec))
+        d = T[:3, 3] - _translation(prim)
+        assert d @ lat == pytest.approx(0.0, abs=LATERAL_TOL), slot.key
+        assert d - (d @ lat) * lat == pytest.approx(np.zeros(3), abs=TOL), slot.key
+        for i, axis in enumerate(np.eye(3)):
+            built = _rotate(prim["world_xform"]["quat_xyzw"], axis)
+            assert T[:3, i] == pytest.approx(built, abs=TOL), (slot.key, i)
+
+
+def test_every_built_tray_has_its_box(case):
+    """The stage only puts trays on the incoming rack; the scene fills every slot."""
+    cfg, prims, boxes = case
+    for slot in G.enumerate_slots(cfg):
+        if slot.role != "incoming" or slot.rack == "table":
+            continue
+        built = _translation(prims[f"/Environment/Tray_{slot.layer}_{slot.column}"])
+        box = boxes[f"tray/{slot.key}"]
+        lat = F.lateral_axis(slot.approach_vec / np.linalg.norm(slot.approach_vec))
+        d = box.T[:3, 3] - built
+        assert d @ lat == pytest.approx(0.0, abs=LATERAL_TOL), slot.key
+        d = d - (d @ lat) * lat
+        assert d[:2] == pytest.approx((0.0, 0.0), abs=TOL), slot.key
+        bottom = _aabb(box)[0][2]
+        assert bottom == pytest.approx(built[2] + TRAY_MESH_Z_MIN, abs=1e-4), slot.key
+        assert _aabb(box)[1][2] - bottom == pytest.approx(A.TRAY_Z, abs=TOL), slot.key
