+"""For show: the pure parts of the cuRobo-only workflow demo (local)."""
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "motion"))
+
+import show as SH  # noqa: E402
+import timing as TM  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import sequence as SEQ  # noqa: E402
+
+CFG = C.load_preset("strict")
+SLOTS = G.enumerate_slots(CFG)
+BY = {s.key: s for s in SLOTS}
+INC = [s for s in SLOTS if s.role == "incoming"]
+OUT = [s for s in SLOTS if s.role == "outgoing"]
+TABLE = next(s for s in SLOTS if s.role == "inspection")
+
+
+def test_tilt_roll_of_a_level_flange_is_a_right_angle_twice():
+    t, r = SH.tilt_roll(F.flange_rotation((1.0, 0.0, 0.0)))
+    assert math.isclose(t, math.pi / 2, abs_tol=1e-9) and math.isclose(r, math.pi / 2, abs_tol=1e-9)
+
+
+def test_carry_tilt_and_roll_are_one_pair_in_every_workspace():
+    """So one carry bound (base anchored) holds the plate from source to destination."""
+    pairs = [SH.tilt_roll(SEQ.carry_pose(s, 10.0)[:3, :3]) for s in (INC[0], TABLE, OUT[-1])]
+    for t, r in pairs:
+        assert math.isclose(t, math.radians(80.0), abs_tol=1e-9)
+        assert math.isclose(r, pairs[0][1], abs_tol=1e-9)
+    # the tip goes up: flange Z rises
+    assert SEQ.carry_pose(INC[0], 10.0)[2, 2] > 0
+
+
+def test_tilt_roll_tells_a_roll_apart():
+    R = F.flange_rotation((0.0, 1.0, 0.0), math.radians(10.0))
+    c, s = math.cos(0.1), math.sin(0.1)
+    Rz = np.array([[c, -s, 0], [s, c, 0], [0, 0, 1]])
+    t0, r0 = SH.tilt_roll(R)
+    t1, r1 = SH.tilt_roll(R @ Rz)
+    assert math.isclose(t0, t1, abs_tol=1e-9)
+    assert math.isclose(abs(r1 - r0), 0.1, abs_tol=1e-9)
+
+
+def test_transfer_steps_follow_plan_md():
+    occ = frozenset(s.key for s in INC)
+    steps = SH.transfer_steps(INC[1], TABLE, occ, 10.0)
+    names = [s.name for s in steps]
+    assert names == [f"to_{INC[1].key}", "pre_insert", "insert", "lift", "close", "withdraw", "tilt",
+                     "retreat", "carry", "arrive", "untilt", "enter", "open", "lower", "out", "back"]
+    by = {s.name: s for s in steps}
+    assert by["close"].jaw == A.JAW_Q_OPEN and by["close"].jaw_end == A.JAW_Q_FIT
+    assert by["open"].jaw == A.JAW_Q_FIT and by["open"].jaw_end == A.JAW_Q_OPEN
+    # the tray is cuRobo's attached object from withdraw to enter, and in no world then
+    att = [s.name for s in steps if s.attached and s.kind != "jaw"]
+    assert att == ["withdraw", "tilt", "retreat", "carry", "arrive", "untilt", "enter"]
+    for s in steps:
+        if s.attached or s.name in ("lift", "lower"):
+            assert INC[1].key not in s.occupied and TABLE.key not in s.occupied
+    assert INC[1].key in by["pre_insert"].occupied and TABLE.key in by["back"].occupied
+    assert INC[1].key not in by["insert"].occupied and TABLE.key not in by["out"].occupied
+    assert by["carry"].kind == "carry" and by["tilt"].kind == "turn" and by["untilt"].kind == "turn"
+    assert np.allclose(by["carry"].T[:3, :3], by["arrive"].T[:3, :3])
+    assert np.allclose(by["untilt"].T, SEQ.withdraw_pose(TABLE))
+
+
+def test_no_tilt_no_turns():
+    names = [s.name for s in SH.transfer_steps(INC[0], TABLE, frozenset([INC[0].key]), 0.0)]
+    assert "tilt" not in names and "untilt" not in names
+
+
+def test_every_workspace_has_scan_views():
+    for role in ("incoming", "inspection", "outgoing"):
+        views = SH.scan_views(SLOTS, role)
+        assert len(views) >= SH.SCAN_VIEWS
+        assert len({n for n, _ in views}) == len(views)
+
+
+def test_scan_views_look_down_from_far_tilted_toward_the_workspace():
+    for role in ("incoming", "inspection", "outgoing"):
+        ws = [s for s in SLOTS if s.role == role]
+        a = np.asarray(ws[0].approach_vec, float)
+        a = a / np.linalg.norm(a)
+        for name, T in SH.scan_views(SLOTS, role):
+            cam = SEQ.eih_camera_pose(T)
+            z, p = cam[:3, 2], cam[:3, 3]
+            down = math.degrees(math.acos(-z[2]))
+            assert math.isclose(down, SH.SCAN_TILT_DEG, abs_tol=1e-6), name
+            assert z[:2] @ a[:2] > 0, name  # leans toward the workspace
+            assert p[2] - SH.scan_target(ws)[2] > 0.4, name  # far above what it views
+
+
+def test_preference_starts_in_the_middle():
+    best = SH.preference(OUT)[0]
+    layers = sorted({s.layer for s in OUT})
+    cols = sorted({s.column for s in OUT})
+    assert best.layer in layers[1:-1] and best.column in cols[1:-1]
+
+
+def test_locate_goes_straight_in_and_back():
+    st = SH.locate_steps(CFG, OUT[0], frozenset())
+    assert [s.kind for s in st] == ["free", "line", "line"]
+    assert np.allclose(st[0].T, st[2].T)
+    a = OUT[0].approach_vec
+    assert float((st[1].T[:3, 3] - st[0].T[:3, 3]) @ a) > 0
+
+
+def _frames(Q):
+    out = np.repeat(np.eye(4)[None], len(Q), axis=0)
+    out[:, :3, 3] = 0.2 * Q[:, :3]
+    return out
+
+
+def test_retime_keeps_the_caps_on_what_is_sent():
+    t = np.linspace(0.0, 0.5, 21)
+    Q = np.zeros((21, 6))
+    Q[:, 0] = 0.5 * (1 - np.cos(np.pi * t / 0.5))
+    tr, Qr = SH.retime(t, Q, TM.IN_JIG, _frames)
+    assert np.allclose(np.diff(tr), tr[1] - tr[0]) and tr[1] - tr[0] <= SH.P.DT + 1e-9
+    assert np.allclose(Qr[0], Q[0]) and np.allclose(Qr[-1], Q[-1])
+    assert SH.cap_scale(tr, _frames(Qr), TM.IN_JIG) <= 1.0 + 1e-6
+    assert TM.joint_retime(tr, Qr, TM.JOINT_V, TM.JOINT_A) <= 1.0 + 1e-6
+
+
+@pytest.fixture(scope="module")
+def ik():
+    return SH.P.CC.load_ik(str(ROOT / "todo" / "resources" / "robot_config" / "tm5s_v4.urdf"))
+
+
+def test_straight_moves_are_exact_lines_and_turns_within_caps(ik):
+    """pre_insert .. retreat walked by EAIK: on the line, turning in place."""
+    base = CFG.robot.base_pose
+    src = INC[1]
+    steps = [s for s in SH.transfer_steps(src, TABLE, frozenset([src.key]), 10.0)
+             if s.name in ("insert", "lift", "withdraw", "tilt", "retreat")]
+    assert {s.kind for s in steps} == {"line", "turn"}
+    q = SH.PL.start_candidates(ik, SEQ.pre_insert_pose(src), SH.PL.HOME, base)[0]
+    fk = lambda Q: np.array([SH.P.fk_world(ik, x, base) for x in Q])  # noqa: E731
+    for s in steps:
+        T0 = SH.P.fk_world(ik, q, base)
+        t, Q6 = SH.straight(ik, base, s, q, fk)
+        fr = fk(Q6)
+        assert np.allclose(Q6[0], q)
+        dp, dr = F.pose_error(fr[-1], s.T)
+        assert dp < 1e-4 and dr < 1e-3, s.name
+        st = SH.path_stats(s.kind, fr, T0, s.T)
+        if s.kind == "line":
+            assert st["line_mm"] < 0.05, (s.name, st)
+        else:
+            assert st["drift_mm"] < 0.05, (s.name, st)
+        assert np.allclose(np.diff(t), t[1] - t[0])
+        assert SH.cap_scale(t, fr, s.caps) <= 1.0 + 1e-6, s.name
+        q = Q6[-1]
+
+
+def test_path_stats_measure_the_constraints():
+    T0 = F.make_pose(np.eye(3), (0.0, 0.0, 0.0))
+    T1 = F.make_pose(np.eye(3), (0.1, 0.0, 0.0))
+    fr = np.repeat(T0[None], 11, axis=0)
+    fr[:, 0, 3] = np.linspace(0.0, 0.1, 11)
+    fr[5, 1, 3] = 0.002
+    st = SH.path_stats("line", fr, T0, T1)
+    assert math.isclose(st["line_mm"], 2.0, abs_tol=1e-6) and st["turn_deg"] < 1e-6
+    assert SH.stats_ok("line", st)
+    fr[5, 1, 3] = (SH.LINE_MAX_MM + 1.0) * 1e-3
+    assert not SH.stats_ok("line", SH.path_stats("line", fr, T0, T1))
+    C0 = SEQ.carry_pose(INC[0], 10.0)
+    fr = np.repeat(C0[None], 3, axis=0)
+    fr[1, :3, :3] = F.flange_rotation(INC[0].approach_vec, math.radians(15.0))
+    st = SH.path_stats("carry", fr, C0, C0)
+    assert math.isclose(st["tilt_deg"], 5.0, abs_tol=1e-6) and not SH.stats_ok("carry", st)
