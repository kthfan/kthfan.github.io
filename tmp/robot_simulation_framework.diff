+"""The audit must fail loudly on cells that cannot work, and stay quiet on cells that can.
+
+A check that never fires is decoration. Each test below pushes one parameter
+past its limit and demands the corresponding check notices, so the audit's
+silence on a good config actually means something.
+"""
+import dataclasses
+import types
+
+import pytest
+
+import cell_core.assets as A
+import cell_core.audit as AU
+import cell_core.config as C
+
+
+@pytest.fixture
+def as_built():
+    return C.load_preset("as_built")
+
+
+@pytest.fixture
+def recommended():
+    return C.load_preset("recommended")
+
+
+def status_of(checks, name):
+    for c in checks:
+        if c.name == name:
+            return c.status
+    raise AssertionError(f"no check named {name!r}; have {[c.name for c in checks]}")
+
+
+def test_the_package_export_does_not_shadow_this_module():
+    """``cell_core.audit`` must stay a module, not become the audit function.
+
+    Re-exporting ``audit()`` from ``cell_core/__init__.py`` rebinds the package
+    attribute and every ``import cell_core.audit`` then yields a function, with
+    a baffling AttributeError at the first use. It has happened once already.
+    """
+    import cell_core
+
+    assert isinstance(AU, types.ModuleType)
+    assert not callable(cell_core.audit)
+    assert callable(cell_core.audit.audit)
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Shape of the result
+# ─────────────────────────────────────────────────────────────────────────────
+def test_every_check_reports_a_known_status(as_built):
+    checks = AU.audit(as_built)
+    assert checks
+    assert all(c.status in AU.STATUSES for c in checks)
+    assert all(c.detail for c in checks), "a check with no detail cannot be acted on"
+
+
+def test_check_names_are_unique(as_built):
+    names = [c.name for c in AU.audit(as_built)]
+    assert len(names) == len(set(names))
+
+
+def test_verdict_is_pass_only_when_nothing_failed():
+    ok = [AU.Check("a", "pass", "fine"), AU.Check("b", "warn", "hmm")]
+    bad = [AU.Check("a", "pass", "fine"), AU.Check("b", "fail", "broken")]
+    assert AU.verdict(ok) == "pass"
+    assert AU.verdict(bad) == "fail"
+
+
+def test_a_warning_does_not_mask_a_failure():
+    """Warnings are advisory; one failure must still sink the verdict."""
+    checks = [AU.Check(f"w{i}", "warn", "advisory") for i in range(10)]
+    checks.append(AU.Check("real", "fail", "this matters"))
+    assert AU.verdict(checks) == "fail"
+
+
+def test_a_skipped_check_never_counts_as_a_pass():
+    """A skipped reachability check must not be mistaken for a clean bill."""
+    checks = [AU.Check("reach", "skip", "EAIK unavailable")]
+    assert AU.verdict(checks) == "pass"
+    assert AU.skipped(checks) == ["reach"]
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# The shipped presets
+# ─────────────────────────────────────────────────────────────────────────────
+def test_both_shipped_presets_are_geometrically_sound(as_built, recommended):
+    for cfg in (as_built, recommended):
+        checks = AU.audit(cfg)
+        failures = [c for c in checks if c.status == "fail"]
+        assert not failures, f"{cfg.name}: {[(c.name, c.detail) for c in failures]}"
+
+
+def test_the_unmeasured_table_is_flagged_on_every_run(as_built):
+    """The table numbers are generator defaults. Silence would let that be forgotten."""
+    assert status_of(AU.audit(as_built), "table_confirmed") == "warn"
+
+
+def test_confirming_the_table_clears_the_warning(as_built):
+    confirmed = dataclasses.replace(
+        as_built, table=dataclasses.replace(as_built.table, confirmed=True))
+    assert status_of(AU.audit(confirmed), "table_confirmed") == "pass"
+
+
+def test_the_as_built_mount_is_flagged_as_below_the_reach_threshold(as_built):
+    assert status_of(AU.audit(as_built), "mount_height") == "warn"
+
+
+def test_the_recommended_mount_clears_the_threshold(recommended):
+    assert status_of(AU.audit(recommended), "mount_height") == "pass"
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Each check earns its place
+# ─────────────────────────────────────────────────────────────────────────────
+def test_a_rack_too_narrow_for_its_jigs_fails(as_built):
+    narrow = dataclasses.replace(
+        as_built, incoming=dataclasses.replace(as_built.incoming, width=0.30))
+    assert status_of(AU.audit(narrow), "rack_width/incoming") == "fail"
+
+
+def test_layers_too_close_to_withdraw_the_plate_fail(as_built):
+    cramped = dataclasses.replace(
+        as_built,
+        incoming=dataclasses.replace(as_built.incoming,
+                                     layer_heights=(0.82, 0.90, 0.98)))
+    assert status_of(AU.audit(cramped), "layer_gap/incoming") == "fail"
+
+
+def test_a_standoff_that_buries_the_plate_in_the_shelf_fails(as_built):
+    buried = dataclasses.replace(as_built, standoff_near=0.12)
+    assert status_of(AU.audit(buried), "standoff_plate_free") == "fail"
+
+
+def test_the_close_read_standoff_margin_is_reported(as_built):
+    """How far the plate sits outside the shelf, not just that it does."""
+    check = [c for c in AU.audit(as_built) if c.name == "standoff_plate_free"][0]
+    assert check.value == pytest.approx(as_built.standoff_near - A.PLATE_AHEAD_OF_CAM)
+
+
+def test_a_grid_that_overflows_the_camera_frame_fails(as_built):
+    """Too close and the AprilGrid no longer fits in view — undetectable."""
+    too_close = dataclasses.replace(as_built, standoff_near=0.05, standoff_far=0.06)
+    assert status_of(AU.audit(too_close), "grid_in_view/near") == "fail"
+
+
+def test_a_grid_too_small_in_pixels_to_locate_fails(as_built):
+    far = dataclasses.replace(as_built, standoff_far=8.0)
+    assert status_of(AU.audit(far), "grid_pixels/far") == "fail"
+
+
+def test_the_shipped_standoffs_give_a_comfortable_pixel_count(as_built):
+    checks = AU.audit(as_built)
+    assert status_of(checks, "grid_pixels/near") == "pass"
+    assert status_of(checks, "grid_pixels/far") == "pass"
+
+
+def test_an_unbuildable_config_fails_rather_than_raising(as_built):
+    """The audit reports; it does not explode. A crash cannot be compared to a baseline."""
+    broken = dataclasses.replace(
+        as_built, incoming=dataclasses.replace(as_built.incoming, n_jigs=0))
+    checks = AU.audit(broken)
+    assert status_of(checks, "config_valid") == "fail"
+    assert AU.verdict(checks) == "fail"
+
+
+def test_the_tolerance_budget_is_reported_without_the_recess(as_built):
+    """D17: design to the flat underside; the 2.5 mm recess is headroom, not budget."""
+    check = [c for c in AU.audit(as_built) if c.name == "tolerance_pitch"][0]
+    flat = AU.G.tolerance_budget(use_recess=False)
+    assert check.value == pytest.approx(flat["pitch_deg"])
+
+
+def test_a_plate_thicker_than_the_corridor_fails(monkeypatch, as_built):
+    monkeypatch.setattr(AU.A, "PLATE_THICK", A.CORRIDOR_H_FLAT + 0.001)
+    assert status_of(AU.audit(as_built), "tolerance_pitch") == "fail"
+
+
+def test_generator_fidelity_gaps_are_surfaced(as_built):
+    assert status_of(AU.audit(as_built), "generator_fidelity") == "warn"
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Scan overrides
+# ─────────────────────────────────────────────────────────────────────────────
+def test_origin_z_override_moves_the_leg_not_the_hardware(as_built):
+    moved = C.apply_override(as_built, "origin_z", 0.90)
+    assert moved.robot.origin_z == pytest.approx(0.90)
+    assert moved.robot.base_size == as_built.robot.base_size
+    assert moved.robot.plate_thickness == as_built.robot.plate_thickness
+    assert as_built.robot.origin_z == pytest.approx(0.6765), "original was mutated"
+
+
+def test_an_origin_z_below_the_fixed_hardware_is_rejected(as_built):
+    floor = as_built.robot.base_size + as_built.robot.plate_thickness
+    with pytest.raises(C.CellConfigError, match="leg"):
+        C.apply_override(as_built, "origin_z", floor - 0.01)
+
+
+def test_rack_distance_override_moves_both_racks(as_built):
+    moved = C.apply_override(as_built, "rack_distance", 0.85)
+    assert moved.incoming.face_distance == pytest.approx(0.85)
+    assert moved.outgoing.face_distance == pytest.approx(0.85)
+
+
+def test_jig_gap_override_moves_both_racks(as_built):
+    moved = C.apply_override(as_built, "jig_gap", 0.020)
+    assert moved.incoming.jig_gap == pytest.approx(0.020)
+    assert moved.outgoing.jig_gap == pytest.approx(0.020)
+
+
+def test_table_overrides_reach_the_table(as_built):
+    moved = C.apply_override(as_built, "table_height", 0.75)
+    assert moved.table.height == pytest.approx(0.75)
+    moved = C.apply_override(as_built, "table_distance", 0.90)
+    assert moved.table.face_distance == pytest.approx(0.90)
+
+
+def test_standoff_overrides(as_built):
+    assert C.apply_override(as_built, "standoff_near", 0.25).standoff_near == 0.25
+    assert C.apply_override(as_built, "standoff_far", 0.40).standoff_far == 0.40
+
+
+def test_an_unknown_scan_parameter_lists_the_real_ones(as_built):
+    with pytest.raises(C.CellConfigError) as exc:
+        C.apply_override(as_built, "robot_height", 0.9)
+    assert "origin_z" in str(exc.value)
+
+
+def test_every_advertised_scan_parameter_actually_applies(as_built):
+    """No parameter may be listed in the help and then not work."""
+    for name in C.SCAN_PARAMS:
+        result = C.apply_override(as_built, name, _plausible_value(as_built, name))
+        assert isinstance(result, C.CellConfig)
+
+
+def _plausible_value(cfg, name):
+    return {
+        "origin_z": 0.80,
+        "rack_distance": 0.85,
+        "standoff_near": 0.25,
+        "standoff_far": 0.40,
+        "jig_gap": 0.018,
+        "table_height": 0.72,
+        "table_distance": 0.88,
+        "carry_tilt_deg": 8.0,
+    }[name]
