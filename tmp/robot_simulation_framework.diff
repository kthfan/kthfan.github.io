@@ -0,0 +1,116 @@
+"""tm5s.usd gripper vs the real gripper (cell_core.assets, D28/D29).
+
+Run: python -m pytest .agent-workspace/tools/test_fix_gripper_usd.py -q -p no:cacheprovider
+The asset checked is ``$GRIPPER_USD`` or the workspace copy.
+"""
+import os
+import sys
+
+import numpy as np
+import pytest
+
+pxr = pytest.importorskip("pxr")
+from pxr import Gf, Usd, UsdGeom, UsdPhysics  # noqa: E402
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, os.path.join(ROOT, "shared"))
+from cell_core import assets as A  # noqa: E402
+
+USD = os.environ.get("GRIPPER_USD", os.path.join(ROOT, ".agent-workspace", "assets", "isaacsim", "tm5s.usd"))
+GB = "/tm5s/link_6/gripper_body"
+#: egu50_v2.urdf jaw joint origins, mapped to the flange frame (x, z, -y).
+URDF_JAW = {"left": (-0.0261453, -0.029113, 0.0880107), "right": (0.02614, 0.02911, 0.0880107)}
+
+
+@pytest.fixture(scope="module")
+def stage():
+    return Usd.Stage.Open(USD)
+
+
+def _to_l6(stage, prim, pts):
+    cache = UsdGeom.XformCache()
+    M = cache.GetLocalToWorldTransform(prim) * cache.GetLocalToWorldTransform(
+        stage.GetPrimAtPath("/tm5s/link_6")).GetInverse()
+    return np.array([list(M.Transform(Gf.Vec3d(*map(float, v)))) for v in pts])
+
+
+def _bbox(stage, path):
+    prim = stage.GetPrimAtPath(path)
+    w = _to_l6(stage, prim, UsdGeom.Mesh(prim).GetPointsAttr().Get())
+    return w.min(axis=0), w.max(axis=0)
+
+
+def test_mount_has_no_offset(stage):
+    t = stage.GetPrimAtPath(GB).GetAttribute("xformOp:translate").Get()
+    assert np.allclose(t, 0.0, atol=1e-6)
+
+
+def test_plate_collider_is_the_real_plate(stage):
+    lo, hi = _bbox(stage, GB + "/collisions/Cube_01")
+    assert np.allclose(lo, (-A.PLATE_FX, A.PLATE_FY_BOT, A.PLATE_FZ_ROOT), atol=1e-4)
+    assert np.allclose(hi, (A.PLATE_FX, A.PLATE_FY_TOP, A.PLATE_FZ_TIP), atol=1e-4)
+
+
+def test_body_collider_is_the_real_body(stage):
+    lo, hi = _bbox(stage, GB + "/collisions/Cube")
+    assert np.allclose((lo[0], hi[0]), (-A.BODY_FX, A.BODY_FX), atol=1e-4)
+    assert np.allclose((lo[2], hi[2]), (0.0, A.BODY_FZ_FRONT), atol=1e-4)
+
+
+def test_visual_plate_within_1mm(stage):
+    prim = stage.GetPrimAtPath(GB + "/visuals/mesh_23")
+    w = _to_l6(stage, prim, UsdGeom.Mesh(prim).GetPointsAttr().Get())
+    plate = w[w[:, 2] > 0.105]
+    assert abs(plate[:, 1].min() - A.PLATE_FY_BOT) < 0.0005
+    assert abs(plate[:, 1].max() - A.PLATE_FY_TOP) < 0.0005
+    assert abs(plate[:, 2].max() - A.PLATE_FZ_TIP) < 0.001
+    body = w[w[:, 1] > A.PLATE_FY_TOP + 0.001]
+    assert abs(body[:, 2].max() - A.BODY_FZ_FRONT) < 0.003
+
+
+@pytest.mark.parametrize("side", ["left", "right"])
+def test_jaw_joint_on_the_urdf_mount(stage, side):
+    j = UsdPhysics.Joint(stage.GetPrimAtPath(f"/tm5s/{side}_gripper/{side}_gripper_joint"))
+    assert np.allclose(j.GetLocalPos0Attr().Get(), URDF_JAW[side], atol=0.001)
+
+
+@pytest.mark.parametrize("side", ["left", "right"])
+def test_jaw_body_sits_on_its_joint_axis(stage, side):
+    j = UsdPhysics.Joint(stage.GetPrimAtPath(f"/tm5s/{side}_gripper/{side}_gripper_joint"))
+    p0 = np.array(j.GetLocalPos0Attr().Get(), dtype=float)
+    axis = np.array(Gf.Rotation(Gf.Quatd(j.GetLocalRot0Attr().Get())).TransformDir(Gf.Vec3d(0, 1, 0)))
+    origin = _to_l6(stage, stage.GetPrimAtPath(f"/tm5s/{side}_gripper"), [(0, 0, 0)])[0]
+    r = origin - p0
+    assert np.linalg.norm(r - r.dot(axis) * axis) < 0.0005
+
+
+@pytest.mark.parametrize("side", ["left", "right"])
+def test_jaw_limits_are_the_real_stroke(stage, side):
+    j = UsdPhysics.PrismaticJoint(stage.GetPrimAtPath(f"/tm5s/{side}_gripper/{side}_gripper_joint"))
+    assert j.GetLowerLimitAttr().Get() == pytest.approx(A.JAW_Q_MIN, abs=1e-6)
+    assert j.GetUpperLimitAttr().Get() == pytest.approx(A.JAW_Q_MAX, abs=1e-6)
+
+
+@pytest.mark.parametrize("side", ["left", "right"])
+def test_jaw_faces_at_q0_are_the_assets_faces(stage, side):
+    xs = []
+    for cube in ("Cube", "Cube_01"):
+        lo, hi = _bbox(stage, f"/tm5s/{side}_gripper/collisions/{cube}")
+        xs += [abs(lo[0]), abs(hi[0])]
+    assert min(xs) == pytest.approx(A.JAW_X_IN, abs=3e-4)
+    assert max(xs) == pytest.approx(A.JAW_X_OUT, abs=3e-4)
+
+
+def test_plate_material_holds_the_tray(stage):
+    """M6 (D30): the plate/tray pair gets exactly PLATE_FRICTION (combine max)."""
+    plate = stage.GetPrimAtPath(GB + "/collisions/Cube_01")
+    bound = {str(t) for r in plate.GetRelationships() if r.GetName().startswith("material:binding")
+             for t in r.GetTargets()}
+    assert GB + "/Looks/TeflonMaterial" in bound
+    m = UsdPhysics.MaterialAPI(stage.GetPrimAtPath(GB + "/Looks/TeflonMaterial"))
+    assert m.GetStaticFrictionAttr().Get() == pytest.approx(A.PLATE_FRICTION[0], abs=1e-6)
+    assert m.GetDynamicFrictionAttr().Get() == pytest.approx(A.PLATE_FRICTION[1], abs=1e-6)
+    assert m.GetPrim().GetAttribute("physxMaterial:frictionCombineMode").Get() == "max"
+    # raw metadata: plain pxr has no PhysX schemas registered, so GetAppliedSchemas hides it
+    assert "PhysxMaterialAPI" in m.GetPrim().GetMetadata("apiSchemas").GetAddedOrExplicitItems()
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/trim_geometry.py" "b/C:\\Users\\chunghaofan\\Projects\\AI-Robotics-V2\\bak/.agent-workspace/tools/trim_geometry.py"
