+"""Dump every prim of the jig asset: type, local xform, shape attrs, world bbox (M3 scene)."""
+import sys
+from pxr import Usd, UsdGeom
+
+path = sys.argv[1]
+stage = Usd.Stage.Open(path)
+print("upAxis", UsdGeom.GetStageUpAxis(stage), "mpu", UsdGeom.GetStageMetersPerUnit(stage))
+print("defaultPrim", stage.GetDefaultPrim().GetPath() if stage.GetDefaultPrim() else None)
+cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_, UsdGeom.Tokens.render])
+for prim in stage.Traverse():
+    attrs = {}
+    for name in ("size", "radius", "height", "axis", "extent"):
+        a = prim.GetAttribute(name)
+        if a and a.HasValue():
+            attrs[name] = a.Get()
+    refs = prim.GetMetadata("references")
+    line = f"{prim.GetPath()} [{prim.GetTypeName()}] {attrs}"
+    if refs:
+        line += f" refs={refs}"
+    if prim.IsA(UsdGeom.Xformable):
+        ops = [(op.GetOpName(), op.Get()) for op in UsdGeom.Xformable(prim).GetOrderedXformOps()]
+        if ops:
+            line += f" ops={ops}"
+    if prim.IsA(UsdGeom.Imageable):
+        r = cache.ComputeWorldBound(prim).ComputeAlignedRange()
+        if not r.IsEmpty():
+            mn, mx = r.GetMin(), r.GetMax()
+            line += f"\n    bbox min=({mn[0]:.4f},{mn[1]:.4f},{mn[2]:.4f}) max=({mx[0]:.4f},{mx[1]:.4f},{mx[2]:.4f})"
+    print(line)
