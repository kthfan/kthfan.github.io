+"""The stage builders must find their assets without carrying them.
+
+The four ``.usd`` binaries come to about 45 MB. Copying them into this repo
+beside the scripts would mean two copies of every asset and a second place for
+them to drift, which is the same failure that let ``min_rack_width`` disagree
+with the generator for as long as it did (D22). So the scripts take an asset
+root instead, and these tests pin the rules that makes safe.
+
+Nothing here imports ``pxr``. ``asset_paths`` is plain ``os.path``, and the
+builders are inspected as source rather than imported, so the whole contract is
+checkable on a development machine and only the USD write needs the sim host.
+"""
+import ast
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+BUILD_ENV = Path(__file__).resolve().parents[1] / "build_env"
+sys.path.insert(0, str(BUILD_ENV))
+
+import asset_paths as AP  # noqa: E402
+
+#: The builders, and the asset each one resolves when given nothing.
+BUILDERS = {
+    "create_environment.py": "create_environment",
+    "create_robot_arm_base.py": "create_robot_arm_base",
+    "create_table_with_jig.py": "create_table_with_jig",
+    "create_rack_shelf_with_tray_jig.py": "create_rack_shelf_with_tray_jig",
+}
+
+
+def _function(filename, name):
+    """Parse a builder and return its ``ast.FunctionDef``.
+
+    Parsed rather than imported: these modules import ``pxr`` at module scope,
+    which does not exist off the sim host. The signature is still a fact about
+    the file, and a fact that can be checked anywhere is worth more than one
+    that can only be checked on the machine we are trying to avoid needing.
+    """
+    tree = ast.parse((BUILD_ENV / filename).read_text(encoding="utf-8"))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            return node
+    raise AssertionError(f"{name} not found in {filename}")
+
+
+def _defaults(fn):
+    """Map every keyword argument of *fn* to its default AST node."""
+    args = fn.args.args + fn.args.kwonlyargs
+    defaults = list(fn.args.defaults) + list(fn.args.kw_defaults)
+    return dict(zip([a.arg for a in args[len(args) - len(defaults):]], defaults))
+
+
+# ── resolution order ─────────────────────────────────────────────────────────
+def test_an_explicit_root_wins_over_everything(tmp_path, monkeypatch):
+    monkeypatch.setenv(AP.ASSET_ENV_VAR, str(tmp_path / "from-env"))
+    (tmp_path / AP.PROBE_ASSET).write_bytes(b"")
+    assert AP.find_asset_root(str(tmp_path)) == str(tmp_path)
+
+
+def test_the_environment_variable_wins_over_the_search_path(tmp_path, monkeypatch):
+    """The override that makes a non-standard deploy work without a code edit."""
+    monkeypatch.setenv(AP.ASSET_ENV_VAR, str(tmp_path))
+    (tmp_path / AP.PROBE_ASSET).write_bytes(b"")
+    assert AP.find_asset_root() == str(tmp_path)
+
+
+def test_the_assets_are_found_with_no_configuration_at_all(monkeypatch):
+    """The development-machine case: the resource drop is discovered by walking up."""
+    monkeypatch.delenv(AP.ASSET_ENV_VAR, raising=False)
+    root = AP.find_asset_root()
+    assert os.path.isfile(os.path.join(root, AP.PROBE_ASSET))
+
+
+def test_a_root_without_the_assets_is_not_silently_accepted(tmp_path, monkeypatch):
+    """An empty directory must not win just because it exists.
+
+    A deploy that creates the directory but fails to copy the binaries is the
+    realistic failure. Accepting it would build a stage from whichever root came
+    next, which is how a sim quietly stops being the cell it claims to be.
+    """
+    monkeypatch.delenv(AP.ASSET_ENV_VAR, raising=False)
+    empty = tmp_path / "empty"
+    empty.mkdir()
+    assert AP.find_asset_root(str(empty)) != str(empty)
+
+
+def test_failure_names_every_directory_it_tried(tmp_path, monkeypatch):
+    """A path that means nothing to the reader is not a usable error."""
+    monkeypatch.setenv(AP.ASSET_ENV_VAR, str(tmp_path / "nowhere"))
+    with pytest.raises(FileNotFoundError) as excinfo:
+        AP.find_asset_root(probe="no-such-asset.usd")
+    message = str(excinfo.value)
+    assert AP.ASSET_ENV_VAR in message
+    assert "nowhere" in message
+    assert message.count("\n") >= len(AP._RELATIVE_CANDIDATES)
+
+
+def test_every_asset_the_builders_ask_for_actually_resolves(monkeypatch):
+    monkeypatch.delenv(AP.ASSET_ENV_VAR, raising=False)
+    for name in (AP.ARM_USD, AP.JIG_USD, AP.TRAY_USD, AP.GROUND_USD):
+        assert os.path.isfile(AP.asset(name))
+
+
+def test_a_named_asset_missing_from_a_valid_root_is_reported(tmp_path):
+    """The root is right but a file is absent: name the file, not the root."""
+    (tmp_path / AP.PROBE_ASSET).write_bytes(b"")
+    with pytest.raises(FileNotFoundError, match="tm5s.usd"):
+        AP.asset(AP.ARM_USD, str(tmp_path))
+
+
+# ── the builders ─────────────────────────────────────────────────────────────
+@pytest.mark.parametrize("filename,name", sorted(BUILDERS.items()))
+def test_every_builder_accepts_an_asset_root(filename, name):
+    fn = _function(filename, name)
+    names = [a.arg for a in fn.args.args + fn.args.kwonlyargs]
+    assert "asset_root" in names, f"{name} cannot be told where its assets are"
+
+
+@pytest.mark.parametrize("filename,name", sorted(BUILDERS.items()))
+def test_no_builder_hardcodes_an_asset_path_in_its_signature(filename, name):
+    """Defaults must be ``None`` so the asset root is what decides.
+
+    A literal default is what allowed ``create_rack_shelf_with_tray_jig`` to
+    point at ``../asset`` (singular) while every sibling used ``../assets``.
+    That typo survived because the constant was only ever used as an argparse
+    default, so nothing exercised it.
+    """
+    for arg, default in _defaults(_function(filename, name)).items():
+        if arg.endswith("usd_path"):
+            assert isinstance(default, ast.Constant) and default.value is None, (
+                f"{name}({arg}=...) hardcodes a default")
+
+
+def test_no_build_env_module_still_builds_an_asset_path_by_hand():
+    """One place decides where assets live; ``asset_paths`` is that place."""
+    offenders = []
+    for path in sorted(BUILD_ENV.glob("*.py")):
+        if path.name == "asset_paths.py":
+            continue
+        for i, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+            if ".usd" in line and "os.path.join" in line:
+                offenders.append(f"{path.name}:{i}: {line.strip()}")
+    assert not offenders, "hand-built asset paths:\n" + "\n".join(offenders)
+
+
+def test_the_tray_is_not_resolved_from_the_asset_root():
+    """``tray_usd_path=None`` means "place no trays", not "find the tray".
+
+    ``create_rack_shelf_with_tray_jig`` gates tray placement on this argument
+    being set. Resolving it like the others would furnish every outgoing shelf
+    with trays and quietly occupy the destination slots.
+    """
+    source = (BUILD_ENV / "create_rack_shelf_with_tray_jig.py").read_text(encoding="utf-8")
+    assert "if tray_usd_path is None:" not in source
+    assert "if tray_mask is not None and tray_usd_path is not None:" in source
+
+
+# ── the generator is shared, not copied ──────────────────────────────────────
+def test_the_generator_here_is_the_generator_in_the_resource_drop():
+    """Two copies of an arithmetic module is exactly how D22 happened.
+
+    ``env_config_generator.py`` is duplicated into this repo so the sim host can
+    build without the resource drop, and ``cell_core`` reaches for whichever it
+    finds first. That is only safe while the two are byte-identical, so the
+    identity is pinned rather than assumed. Editing one and not the other should
+    fail here, loudly, instead of showing up as a shelf of the wrong width.
+    """
+    mine = BUILD_ENV / "env_config_generator.py"
+    original = (BUILD_ENV.parents[1] / "todo" / "resources" / "isaacsim"
+                / "build_env" / "env_config_generator.py")
+    if not original.is_file():
+        pytest.skip("resource drop not present")
+    assert mine.read_bytes() == original.read_bytes(), (
+        "env_config_generator.py has diverged between build_env and the "
+        "resource drop; make the change in both or keep only one")
+
+
+# ── the build script ─────────────────────────────────────────────────────────
+import build_cell as B  # noqa: E402  (after sys.path is set up above)
+
+PRESETS = ("as_built", "recommended")
+
+
+@pytest.mark.parametrize("preset", PRESETS)
+def test_planning_a_build_needs_no_isaac_sim(preset, monkeypatch):
+    """The arithmetic half must be checkable on a machine without ``pxr``.
+
+    If planning pulled in USD, every mistake in the config-to-stage plumbing
+    would only be findable on the sim host, which is the slowest place to find
+    anything. ``pxr`` is made unimportable rather than asserted unloaded, since
+    other tests may legitimately have loaded it already.
+    """
+    monkeypatch.setitem(sys.modules, "pxr", None)
+    cfg, env_kwargs, notes = B.plan(preset)
+    assert cfg.name
+    assert env_kwargs["right_rack_size"][0] > 0
+
+
+@pytest.mark.parametrize("preset", PRESETS)
+def test_the_plan_is_the_one_the_stage_tests_already_pin(preset):
+    """``plan`` must add nothing of its own to the generator's output.
+
+    The stage contract is pinned in ``shared/tests/test_generated_stage.py``
+    against ``shared``'s ``generator_kwargs``. That is only worth anything while
+    the build script produces the same dict, so the two are compared for real.
+
+    The comparison runs in a subprocess deliberately. Importing ``cell_core``
+    here would hand back the copy already in ``sys.modules`` -- the vendored one
+    that ``build_cell`` itself uses -- and the test would compare the plan to
+    itself. That is the D22 shape exactly, and it is easy to write by accident.
+    """
+    script = (
+        "import sys, pprint\n"
+        "sys.path.insert(0, %r)\n"
+        "import cell_core.config as C\n"
+        "from cell_core import env_adapter as E\n"
+        "cfg = C.load_preset(%r)\n"
+        "pprint.pprint(E.load_generator()(**E.generator_kwargs(cfg)))\n"
+        % (str(BUILD_ENV.parents[1] / "shared"), preset))
+    path = BUILD_ENV.parents[1] / ".agent-workspace" / "scratch" / "_plan_probe.py"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(script, encoding="utf-8")
+    try:
+        done = subprocess.run([sys.executable, str(path)],
+                              capture_output=True, text=True)
+    finally:
+        path.unlink()
+    assert done.returncode == 0, done.stderr
+    assert "cell_core" not in done.stdout  # it printed a dict, not a traceback
+
+    import pprint
+    _, env_kwargs, _ = B.plan(preset)
+    assert pprint.pformat(env_kwargs) == done.stdout.rstrip("\n")
+
+
+@pytest.mark.parametrize("preset", PRESETS)
+def test_every_argument_the_plan_produces_is_one_create_environment_accepts(preset):
+    """A key the builder ignores is a measurement that silently did nothing."""
+    fn = _function("create_environment.py", "create_environment")
+    accepted = {a.arg for a in fn.args.args + fn.args.kwonlyargs}
+    _, env_kwargs, _ = B.plan(preset)
+    assert set(env_kwargs) <= accepted, sorted(set(env_kwargs) - accepted)
+
