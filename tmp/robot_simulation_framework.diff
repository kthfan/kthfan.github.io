@@ -0,0 +1,651 @@
+"""For show (temporary, branch test/for_show): the cell's whole workflow, cuRobo between places, EAIK on straight lines.
+
+    . /opt/ros/humble/setup.bash
+    ROS_DOMAIN_ID=37 RMW_IMPLEMENTATION=rmw_fastrtps_cpp FASTRTPS_DEFAULT_PROFILES_FILE=motion/fastdds.xml \
+    python3 motion/show.py --preset strict --out _show/run
+
+1. scan: the camera looks down, slightly tilted, from far above the incoming
+   rack, the table and the outgoing rack (pretend: nothing is captured or detected);
+2. locate: far then near sighting in front of one incoming jig, the table's
+   and one outgoing jig (pretend: the jig poses used are the cell's ground
+   truth from ``ready``; ``--dry`` uses the nominal slots);
+3. move: the incoming tray to the table, then on to the outgoing slot:
+   approach, pre_insert, insert, lift, close, withdraw, tilt, retreat, carry
+   (tilt held), arrive, untilt, enter, open, lower, out, back; then home.
+
+Moves between places are cuRobo plans with its mesh collision check: free
+moves are ``plan_pose`` (``plan_cspace`` home), and the carry from jig to jig
+keeps the plate's tilt and roll by a tool pose bound with the carried tray as
+cuRobo's attached object. Straight moves (sighting in and out, pre_insert to
+retreat, arrive to back) and the tilts in place are EAIK's exact walk along
+the line, as M6 plans them (cuRobo could not plan a bounded straight move
+into a jig). The whole show is planned before anything moves; the
+incoming and outgoing slots are the first, in preference order, for which
+every plan succeeds.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import sys
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import planner as PL  # noqa: E402  (puts collision/ and vendor/ on the path)
+import paths as P  # noqa: E402
+import timing as TM  # noqa: E402
+import transfer as TR  # noqa: E402
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import scene as S  # noqa: E402
+from cell_core import sequence as SEQ  # noqa: E402
+
+FRAME = "link_6"
+#: Plate tilt while carrying, tip up (deg); the strict preset's is 0.
+TILT_DEG = 10.0
+#: Scan: the camera looks down at the middle of a workspace's label plane, from
+#: this far (m), leaning this much from straight down toward it (deg), from
+#: views this far either side of the middle (m). All reachable per EAIK.
+SCAN_DIST, SCAN_DIST_TABLE, SCAN_TILT_DEG = 0.6, 0.7, 30.0
+SCAN_LATERAL = (-0.15, 0.15, 0.0)
+SCAN_HORIZ = 0.6
+SCAN_HEIGHT, SCAN_HEIGHT_TABLE = 0.52, 0.61   # 維持原本的高度
+SCAN_TILT_DEG = 60.0
+#: Most viewpoints a workspace's scan takes.
+SCAN_VIEWS = 2
+#: Goal tolerances of every plan (m, rad).
+POS_TOL, ROT_TOL = 0.001, 0.01
+#: Carry: the plate's tilt and roll stay within this of the carry pose's (rad).
+HOLD = math.radians(3.0)
+#: Spheres cuRobo fits to the carried tray (the robot config reserves 18).
+ATT_SPHERES = 18
+#: A plan is refused when its path strays further than this (mm, deg).
+LINE_MAX_MM, LINE_MAX_DEG, TURN_MAX_MM, HOLD_MAX_DEG = 4.0, 2.0, 4.0, 4.0
+#: Slot candidates tried per role.
+MAX_TRIES = 6
+OPEN, FIT = A.JAW_Q_OPEN, A.JAW_Q_FIT
+
+DWELL_S = 6.0
+
+@dataclass(frozen=True, eq=False)
+class Step:
+    name: str
+    kind: str                  #: "free", "line", "turn", "carry", "jaw" or "home"
+    T: Optional[np.ndarray]    #: flange goal in the world (None for jaw, home)
+    jaw: float                 #: jaw command at the start
+    jaw_end: float
+    caps: Optional[TM.Caps]
+    occupied: frozenset        #: slots whose tray is in cuRobo's world
+    attached: bool = False     #: the tray is cuRobo's attached object
+    carried: bool = False      #: the tray moves with the plate (caps on its centre)
+    target: Optional[str] = None
+    lifting: bool = False
+    track: bool = False
+
+
+class ChainError(P.PathError):
+    def __init__(self, index: int, msg: str):
+        super().__init__(msg)
+        self.index = index
+
+
+def log(*a):
+    print("[show]", *a, flush=True)
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Pure: the show's steps
+# ─────────────────────────────────────────────────────────────────────────────
+def tilt_roll(R) -> tuple:
+    """``(tilt, roll)`` of the ZYZ angles ``Rz(yaw) Ry(tilt) Rz(roll)`` of *R*.
+
+    *tilt* is the flange Z axis from up; *roll* turns the flange about it.
+    Both are unchanged by a turn about up, so the base and world agree.
+    """
+    R = np.asarray(R, dtype=float)
+    return math.acos(max(-1.0, min(1.0, float(R[2, 2])))), math.atan2(R[2, 1], -R[2, 0])
+
+
+def _free(name, T, occupied):
+    return Step(name, "free", T, OPEN, OPEN, TM.EMPTY, frozenset(occupied))
+
+
+def scan_target(ws) -> np.ndarray:
+    """Middle of the label points of the workspace slots *ws*."""
+    pts = []
+    for s in ws:
+        a = np.asarray(s.approach_vec, dtype=float)
+        a = a / np.linalg.norm(a)
+        pts.append(a * s.label_plane_dist + F.lateral_axis(a) * s.lateral + F.UP * s.label_centre_z)
+    pts = np.array(pts)
+    return (pts.min(0) + pts.max(0)) / 2.0
+
+
+def scan_pose(target, approach, horiz: float, height: float,
+              tilt_deg: float = SCAN_TILT_DEG) -> np.ndarray:
+    """Flange pose putting the EIH camera *horiz* m (toward the robot) and
+    *height* m above *target*, its axis *tilt_deg* off straight down toward the
+    workspace; image down toward the robot."""
+    back = -np.asarray(approach, dtype=float)
+    back[2] = 0.0
+    back /= np.linalg.norm(back)
+    t = math.radians(tilt_deg)
+    z = -(math.cos(t) * np.asarray(F.UP, dtype=float) + math.sin(t) * back)  # optical axis
+    y = np.cross(z, np.cross(back, z))
+    y /= np.linalg.norm(y)
+    cam = np.eye(4)
+    cam[:3, :3] = np.column_stack([np.cross(y, z), y, z])
+    cam[:3, 3] = np.asarray(target, dtype=float) + horiz * back + height * np.asarray(F.UP, dtype=float)
+    return cam @ np.linalg.inv(SEQ.eih_camera_pose(np.eye(4)))
+
+
+def scan_views(slots, role) -> list:
+    """``[(name, flange T)]`` looking down over the *role* workspace from far, best first."""
+    ws = [s for s in slots if s.role == role]
+    a = np.asarray(ws[0].approach_vec, dtype=float)
+    a = a / np.linalg.norm(a)
+    centre = scan_target(ws)
+    dist = SCAN_DIST_TABLE if role == "inspection" else SCAN_DIST
+    height = SCAN_HEIGHT_TABLE if role == "inspection" else SCAN_HEIGHT
+    return [(f"scan_{role}_{lat:+.2f}",
+             scan_pose(centre + F.lateral_axis(a) * lat, a, SCAN_HORIZ, height))
+            for lat in SCAN_LATERAL]
+
+
+def preference(slots) -> list:
+    """*slots* middle layers and middle columns first."""
+    if not slots:
+        return []
+    lay = [s.layer for s in slots]
+    col = [s.column for s in slots]
+    ml, mc = (min(lay) + max(lay)) / 2.0, (min(col) + max(col)) / 2.0
+    return sorted(slots, key=lambda s: (abs(s.layer - ml), abs(s.column - mc), s.layer, s.column))
+
+
+def locate_steps(cfg, slot, occupied) -> list:
+    """Far sighting, straight in to the near one and back out."""
+    far = SEQ.sighting_pose(slot, cfg.standoff_far)
+    near = SEQ.sighting_pose(slot, cfg.standoff_near)
+    occ = frozenset(occupied)
+    return [_free(f"sight_far_{slot.key}", far, occ),
+            Step(f"sight_near_{slot.key}", "line", near, OPEN, OPEN, TM.EMPTY, occ),
+            Step(f"dwell_{slot.key}", "dwell", None, OPEN, OPEN, TM.EMPTY, occ),
+            Step(f"sight_back_{slot.key}", "line", far, OPEN, OPEN, TM.EMPTY, occ)]
+
+
+def transfer_steps(src, dst, occupied, tilt_deg: float = TILT_DEG) -> list:
+    """The tray in *src* to *dst*, from *src*'s approach to *dst*'s (plan.md).
+
+    While the plate is under a seated tray (insert, lift, lower, out) that tray
+    is not in cuRobo's world: its box would hold the plate in collision.
+    """
+    before = frozenset(occupied)
+    riding = before - {src.key}
+    after = riding | {dst.key}
+    carry_s, carry_d = SEQ.carry_pose(src, tilt_deg), SEQ.carry_pose(dst, tilt_deg)
+    s, d = src.key, dst.key
+    out = [_free(f"to_{s}", TR.approach_pose(src), before)]
+
+    def add(name, kind, T, jaw, caps, occ, attached=False, carried=False, target=None,
+            lifting=False, track=False, jaw_end=None):
+        out.append(Step(name, kind, T, jaw, jaw if jaw_end is None else jaw_end, caps, occ,
+                        attached, carried, target, lifting, track))
+
+    add("pre_insert", "line", SEQ.pre_insert_pose(src), OPEN, TM.EMPTY, before, target=s)
+    add("insert", "line", SEQ.insert_pose(src), OPEN, TM.IN_JIG, riding, target=s, track=True)
+    add("lift", "line", SEQ.lift_pose(src), OPEN, TM.IN_JIG, riding, carried=True, target=s,
+        lifting=True, track=True)
+    add("close", "jaw", None, OPEN, None, riding, carried=True, target=s, jaw_end=FIT)
+    add("withdraw", "line", SEQ.withdraw_pose(src), FIT, TM.IN_JIG, riding, True, True, s,
+        track=True)
+    if tilt_deg:
+        add("tilt", "turn", carry_s, FIT, TM.CARRY, riding, True, True, s)
+    add("retreat", "line", TR._back(src, carry_s), FIT, TM.CARRY, riding, True, True, s)
+    add("carry", "carry", TR._back(dst, carry_d), FIT, TM.CARRY, riding, True, True)
+    add("arrive", "line", carry_d, FIT, TM.CARRY, riding, True, True, d)
+    if tilt_deg:
+        add("untilt", "turn", SEQ.withdraw_pose(dst), FIT, TM.CARRY, riding, True, True, d)
+    add("enter", "line", SEQ.lift_pose(dst), FIT, TM.IN_JIG, riding, True, True, d, track=True)
+    add("open", "jaw", None, FIT, None, riding, True, True, d, jaw_end=OPEN)
+    add("lower", "line", SEQ.insert_pose(dst), OPEN, TM.IN_JIG, riding, carried=True, target=d,
+        lifting=True, track=True)
+    add("out", "line", SEQ.pre_insert_pose(dst), OPEN, TM.IN_JIG, riding, target=d, track=True)
+    add("back", "line", TR.approach_pose(dst), OPEN, TM.EMPTY, after, target=d)
+    return out
+
+
+def cap_scale(t, frames, caps) -> float:
+    """Least uniform slow-down taking *frames* at times *t* within *caps*."""
+    frames = np.asarray(frames, dtype=float)
+    k = {**TM.point_kinematics(t, frames[:, :3, 3]), **TM.angular_kinematics(t, frames[:, :3, :3])}
+    return max(1.0, k["v"] / caps.v, math.sqrt(k["a"] / caps.a), k["w"] / caps.w,
+               math.sqrt(k["alpha"] / caps.alpha), math.sqrt(k["a_down"] / caps.a_down))
+
+
+def retime(t, Q6, caps, frames_of, dt: float = P.DT, rounds: int = 40) -> tuple:
+    """*Q6* at *t* slowed to the joint caps, then uniformly until the frames
+    ``frames_of(Q)`` (flange or carried tray, world) are within *caps*, as
+    resampled at *dt*."""
+    t = np.asarray(t, dtype=float)
+    Q6 = np.asarray(Q6, dtype=float)
+    t = t * TM.joint_retime(t, Q6, TM.JOINT_V, TM.JOINT_A)
+    tr, Qr = TM.resample(t, Q6, dt)
+    if caps is None:
+        return tr, Qr
+    for _ in range(rounds):
+        if len(tr) < 3:
+            break
+        s = cap_scale(tr, frames_of(Qr), caps)
+        if s <= 1.0 + 1e-6:
+            break
+        t = t * s * 1.01
+        tr, Qr = TM.resample(t, Q6, dt)
+    return tr, Qr
+
+
+def straight(ik, base, step, q0, frames_of) -> tuple:
+    """``(t, Q6)``: EAIK's walk from where the flange is at *q0* straight to
+    ``step.T`` (a turn in place when only the rotation differs), within
+    ``step.caps`` on the frames ``frames_of(Q)``."""
+    q0 = np.asarray(q0, dtype=float)
+    T0 = P.fk_world(ik, q0, base)
+    us, Q = P.walk(ik, T0, step.T, q0, base)
+    t, Q6 = P.time_line(ik, us, Q, T0, step.T, step.caps, base)
+    Q6[0] = q0
+    return retime(t, Q6, step.caps, frames_of)
+
+
+def path_stats(kind, frames, T_start, T_goal) -> dict:
+    """How far a planned flange path keeps to its step's constraint."""
+    frames = np.asarray(frames, dtype=float)
+    pts = frames[:, :3, 3]
+    out = {}
+    if kind == "line":
+        p0, p1 = np.asarray(T_start)[:3, 3], np.asarray(T_goal)[:3, 3]
+        d = p1 - p0
+        L = float(np.linalg.norm(d))
+        r = pts - p0
+        if L > 1e-9:
+            u = d / L
+            along = np.clip(r @ u, 0.0, L)
+            r = r - along[:, None] * u
+        out["line_mm"] = float(np.linalg.norm(r, axis=1).max()) * 1e3
+        out["turn_deg"] = max(math.degrees(F.pose_error(T, T_goal)[1]) for T in frames)
+    elif kind == "turn":
+        out["drift_mm"] = float(np.linalg.norm(pts - np.asarray(T_start)[:3, 3], axis=1).max()) * 1e3
+    elif kind == "carry":
+        t0, r0 = tilt_roll(np.asarray(T_goal)[:3, :3])
+        tr = np.array([tilt_roll(T[:3, :3]) for T in frames])
+        dr = (tr[:, 1] - r0 + math.pi) % (2 * math.pi) - math.pi
+        out["tilt_deg"] = float(np.degrees(np.abs(tr[:, 0] - t0)).max())
+        out["roll_deg"] = float(np.degrees(np.abs(dr)).max())
+    return out
+
+
+def stats_ok(kind, st) -> bool:
+    if kind == "line":
+        return st["line_mm"] <= LINE_MAX_MM and st["turn_deg"] <= LINE_MAX_DEG
+    if kind == "turn":
+        return st["drift_mm"] <= TURN_MAX_MM
+    if kind == "carry":
+        return st["tilt_deg"] <= HOLD_MAX_DEG and st["roll_deg"] <= HOLD_MAX_DEG
+    return True
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Program host: cuRobo
+# ─────────────────────────────────────────────────────────────────────────────
+class ShowPlanner:
+    """One cuRobo motion planner, mesh collision checked, for every step."""
+
+    def __init__(self, cfg, slots, ik):
+        import torch
+        from curobo.config_io import load_yaml
+        from curobo.motion_planner import MotionPlanner, MotionPlannerCfg
+        from curobo.types import DeviceCfg, GoalToolPose, JointState, Pose, ToolPoseBound
+        from curobo._src.types.robot import RobotCfg
+        from curobo._src.robot.kinematics.kinematics import Kinematics
+        from curobo._src.geom.types import SceneCfg
+
+        self.torch, self.JointState, self.SceneCfg = torch, JointState, SceneCfg
+        self.Pose, self.GoalToolPose, self.Bound = Pose, GoalToolPose, ToolPoseBound
+        self.cfg, self.slots, self.ik = cfg, slots, ik
+        self.base = np.asarray(cfg.robot.base_pose, dtype=float)
+        self.base_inv = np.linalg.inv(self.base)
+        self.dev = DeviceCfg()
+        self.td = self.dev.as_torch_dict()
+        robot = load_yaml(PL.CC.ROBOT_YML)
+        k = robot["robot_cfg"]["kinematics"] if "robot_cfg" in robot else robot["kinematics"]
+        k["collision_sphere_buffer"] = {n: (0.0 if n in ("link_0", "link_1", "attached_object") else 0.005)
+                                        for n in k["collision_sphere_buffer"]}
+        ft = k["extra_links"]["attached_object"]["fixed_transform"]
+        att = F.make_pose(F.quat_to_matrix([ft[4], ft[5], ft[6], ft[3]]), ft[:3])
+        tray = S.carried_tray_box(np.eye(4))
+        self.tray_in_flange = tray.T
+        self.tray_in_att = np.linalg.inv(att) @ tray.T
+        self.tray_size = [float(x) for x in tray.size]
+        self._occ = frozenset(s.key for s in slots)
+        self.mp = MotionPlanner(MotionPlannerCfg.create(
+            robot=robot, scene_model=self._scene(self._occ),
+            collision_cache={"cuboid": PL.CC.MAX_CUBOIDS},
+            mesh_collision_check=True, mesh_only_success=True,
+            position_tolerance=POS_TOL, orientation_tolerance=ROT_TOL, use_cuda_graph=False))
+        grip = Kinematics(RobotCfg.create(PL.CC.gripper_cfg(load_yaml(PL.CC.GRIPPER_YML), True),
+                                          self.dev).kinematics, compute_link_transforms=True)
+        js = torch.full((1, len(grip.joint_names)), OPEN, **self.td)
+        state = JointState.from_position(js, joint_names=grip.joint_names)
+        kc = self.mp.kinematics.config.kinematics_config
+        kc.update_link_mesh(link_name="gripper", triangles=grip.compute_collision_triangles(state))
+        kc.update_link_spheres("gripper", grip.compute_kinematics(state).robot_spheres.squeeze(0).squeeze(0))
+        self.attached = False
+        self.mp.warmup(enable_graph=False)
+
+    def _scene(self, occupied):
+        boxes = [b for b in PL.world_boxes(self.cfg, occupied, self.slots) if b.name != "mount/plate"]
+        return S.to_curobo_scene(boxes, self.base)
+
+    def _js(self, q):
+        return self.JointState.from_position(
+            self.torch.as_tensor(np.asarray(q, dtype=np.float32)[None, :], **self.td),
+            joint_names=self.mp.joint_names)
+
+    def _goal(self, T):
+        Tb = self.base_inv @ np.asarray(T, dtype=float)
+        pose = self.Pose(position=self.torch.as_tensor(Tb[None, :3, 3], **self.td),
+                         quaternion=self.torch.as_tensor([S._quat_wxyz(Tb[:3, :3])], **self.td))
+        return self.GoalToolPose.from_poses({FRAME: pose}, ordered_tool_frames=self.mp.tool_frames)
+
+    def fk(self, Q6) -> np.ndarray:
+        return np.array([P.fk_world(self.ik, q, self.base) for q in np.asarray(Q6, dtype=float)])
+
+    def _world(self, occupied):
+        occupied = frozenset(occupied)
+        if occupied != self._occ:
+            self.mp.update_world(self.SceneCfg.create(self._scene(occupied)))
+            self._occ = occupied
+
+    def _attach(self, on: bool, q0):
+        if on == self.attached:
+            return
+        am = self.mp.attachment_manager
+        if on:
+            T = self.tray_in_att
+            sc = self.SceneCfg.create({"cuboid": {"tray_carried": {
+                "dims": self.tray_size,
+                "pose": [float(x) for x in T[:3, 3]] + S._quat_wxyz(T[:3, :3])}}})
+            am.attach(self._js(q0), sc.cuboid, link_name="attached_object", num_spheres=ATT_SPHERES)
+        else:
+            am.detach("attached_object")
+        self.attached = on
+
+    def bounds(self, step):
+        """cuRobo tool pose bounds holding *step*'s constraint (the carry's tilt)."""
+        if step.kind == "carry":
+            t0, r0 = tilt_roll((self.base_inv @ np.asarray(step.T))[:3, :3])
+            return [self.Bound(anchor="base", reference_axes="base", tilt=(t0 - HOLD, t0 + HOLD),
+                               roll=(r0 - HOLD, r0 + HOLD))]
+        return None
+
+    def _straight(self, step: Step, q0) -> tuple:
+        t_start = time.time()
+        T0 = P.fk_world(self.ik, q0, self.base)
+        frames_of = self._frames_of(step)
+        try:
+            t, Q6 = straight(self.ik, self.base, step, q0, frames_of)
+        except P.PathError as e:
+            raise P.PathError(f"{step.name}: EAIK: {e}") from e
+        info = {"plan_s": time.time() - t_start, "by": "eaik",
+                **path_stats(step.kind, self.fk(Q6), T0, step.T)}
+        return self._planned(step, t, Q6, info)
+
+    def _frames_of(self, step):
+        if step.carried:
+            return lambda Q: self.fk(Q) @ self.tray_in_flange  # noqa: E731
+        return self.fk
+
+    def _planned(self, step, t, Q6, info) -> tuple:
+        p = PL.Planned(step.name, None, t, P.with_jaws(Q6, step.jaw), Q6, (step.jaw, step.jaw),
+                       step.occupied)
+        if step.carried:
+            p.kin = PL.carried_kin(self.ik, self.base, t, Q6)
+        info["duration_s"] = float(t[-1])
+        return p, info
+
+    def plan(self, step: Step, q0) -> tuple:
+        """``(Planned, info)`` for *step* from joints *q0*; raises PathError."""
+        q0 = np.asarray(q0, dtype=float)
+        if step.kind == "jaw":
+            t, Q = P.time_jaw(q0, step.jaw, step.jaw_end)
+            return PL.Planned(step.name, None, t, Q, q0[None, :], (step.jaw, step.jaw_end),
+                              step.occupied), {"plan_s": 0.0}
+        if step.kind == "dwell":
+            Q6 = np.vstack([q0, q0])
+            return self._planned(step, np.array([0.0, DWELL_S]), Q6,
+                                 {"plan_s": 0.0, "by": "dwell"})
+        if step.kind in ("line", "turn"):
+            return self._straight(step, q0)
+        t_start = time.time()
+        self._world(step.occupied)
+        self._attach(step.attached, q0)
+        T0 = P.fk_world(self.ik, q0, self.base)
+        self.mp.update_tool_pose_bounds({FRAME: self.bounds(step)})
+        try:
+            if step.kind == "home":
+                res = self.mp.plan_cspace(self._js(PL.HOME), self._js(q0))
+            else:
+                res = self.mp.plan_pose(self._goal(step.T), self._js(q0))
+        except Exception as e:  # cuRobo raises on bounds the start or goal break
+            raise P.PathError(f"{step.name}: cuRobo: {e}") from e
+        if res is None or not bool(res.success.reshape(-1)[0]):
+            why = {}
+            for k in ("feasible", "position_error", "rotation_error"):
+                v = getattr(res, k, None)
+                if v is not None:
+                    why[k] = np.round(v.reshape(-1).float().cpu().numpy()[:4], 4).tolist()
+            raise P.PathError(f"{step.name}: cuRobo found no plan {why}")
+        ip = res.interpolated_trajectory
+        last = int(res.interpolated_last_tstep.reshape(-1)[0])
+        Q6 = ip.position.reshape(-1, 6)[: last + 1].cpu().numpy().astype(float)
+        Q6[0] = q0
+        if step.kind == "home":
+            Q6[-1] = PL.HOME
+        dt = float(ip.dt.reshape(-1)[0] if hasattr(ip.dt, "reshape") else ip.dt)
+        frames = self.fk(Q6)
+        info = {"plan_s": time.time() - t_start}
+        if step.T is not None:
+            dp, dr = F.pose_error(frames[-1], step.T)
+            info.update(end_mm=dp * 1e3, end_deg=math.degrees(dr))
+            if dp > 2 * POS_TOL or dr > 2 * ROT_TOL:
+                raise P.PathError(f"{step.name}: ends {dp * 1e3:.2f} mm {math.degrees(dr):.2f} deg off")
+            info.update(path_stats(step.kind, frames, T0, step.T))
+            if not stats_ok(step.kind, info):
+                raise P.PathError(f"{step.name}: strays {info}")
+        t, Q6 = retime(np.arange(len(Q6)) * dt, Q6, step.caps, self._frames_of(step))
+        info["by"] = "curobo"
+        return self._planned(step, t, Q6, info)
+
+    def chain(self, steps, q0) -> tuple:
+        """Every step planned from *q0* in turn: ``([(step, Planned, info)], q_end)``.
+
+        Raises :class:`ChainError` with the index of the step that failed.
+        """
+        out, q = [], np.asarray(q0, dtype=float)
+        for i, s in enumerate(steps):
+            try:
+                p, info = self.plan(s, q)
+            except P.PathError as e:
+                raise ChainError(i, str(e)) from e
+            out.append((s, p, info))
+            q = p.q_end
+        return out, q
+
+    def reset(self):
+        self._attach(False, PL.HOME)
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# The show
+# ─────────────────────────────────────────────────────────────────────────────
+def plan_scan(sp, slots, occupied, q) -> tuple:
+    """Up to SCAN_VIEWS viewpoints per workspace that cuRobo reaches, in turn."""
+    out = []
+    for role in ("incoming", "inspection", "outgoing"):
+        got = 0
+        for name, T in scan_views(slots, role):
+            if got == SCAN_VIEWS:
+                break
+            try:
+                (item,), q = sp.chain([_free(name, T, occupied)], q)
+            except P.PathError as e:
+                log("scan view skipped:", e)
+                continue
+            out.append(("scan", item))
+            got += 1
+        log("scan %s: %d views" % (role, got))
+        if not got:
+            raise P.PathError(f"no scan view of the {role} workspace plans")
+    return out, q
+
+
+def plan_show(sp, slots, occupied, q, tilt_deg) -> tuple:
+    """Locate src, table and dst, then the two transfers and home, for the
+    first incoming/outgoing pair that plans throughout."""
+    table = next(s for s in slots if s.role == "inspection")
+    inc = preference([s for s in slots if s.role == "incoming" and s.key in occupied])[:MAX_TRIES]
+    out = preference([s for s in slots if s.role == "outgoing" and s.key not in occupied])[:MAX_TRIES]
+    tried = []
+    for src in inc:
+        for dst in out:
+            occ1 = frozenset(occupied)
+            occ2 = (occ1 - {src.key}) | {table.key}
+            occ3 = (occ2 - {table.key}) | {dst.key}
+            loc = [("locate", s) for sl in (src, table, dst) for s in locate_steps(sp.cfg, sl, occ1)]
+            leg1 = [("transfer", s) for s in transfer_steps(src, table, occ1, tilt_deg)]
+            leg2 = [("transfer", s) for s in transfer_steps(table, dst, occ2, tilt_deg)]
+            phases = loc + leg1 + leg2 + [("home", Step("home", "home", None, OPEN, OPEN, TM.EMPTY, occ3))]
+            t0 = time.time()
+            try:
+                items, _ = sp.chain([s for _, s in phases], q)
+            except ChainError as e:
+                sp.reset()
+                tried.append({"src": src.key, "dst": dst.key, "why": str(e)})
+                log("%s -> %s -> %s: %s (%.1f s)" % (src.key, table.key, dst.key, e, time.time() - t0))
+                n_src = len(loc) // 3
+                if e.index < n_src or len(loc) <= e.index < len(loc) + len(leg1):
+                    break  # the source's own steps: next source
+                continue
+            log("%s -> %s -> %s planned (%.1f s)" % (src.key, table.key, dst.key, time.time() - t0))
+            return [(ph, it) for (ph, _), it in zip(phases, items)], (src, table, dst), tried
+    raise P.PathError(f"no incoming/outgoing pair plans throughout: {tried}")
+
+
+def summary(items) -> list:
+    return [{"phase": ph, "name": s.name, "kind": s.kind, "duration_s": float(p.t[-1]),
+             **{k: v for k, v in info.items() if k != "duration_s"}}
+            for ph, (s, p, info) in items]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--preset", default="strict")
+    ap.add_argument("--tilt", type=float, default=TILT_DEG, help="carry tilt, tip up (deg)")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--dry", action="store_true", help="plan only, nominal slots, no ROS")
+    args = ap.parse_args()
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+
+    cfg = C.load_preset(args.preset)
+    slots = G.enumerate_slots(cfg)
+    ik = PL.CC.load_ik(PL.CC.URDF)
+    cell = None
+    if args.dry:
+        q = PL.HOME.copy()
+        tray_at = {s.key: s.key for s in slots if s.role == "incoming"}
+        offset = np.eye(4)
+    else:
+        import run_cell as RC
+        cell = RC.Cell()
+        st = cell.ready()
+        q = np.asarray(st["q"][:6], dtype=float)
+        tray_at = {k: n for n, k in st["where"].items()}
+        offset = np.asarray(st["offset"], dtype=float)
+        slots = [S.located(s, np.asarray(st["jigs"][s.key], dtype=float)) for s in slots]
+        log("cell ready, %d trays" % len(tray_at))
+    occupied = frozenset(tray_at)
+
+    t0 = time.time()
+    sp = ShowPlanner(cfg, slots, ik)
+    log("planner ready %.1f s" % (time.time() - t0))
+    t0 = time.time()
+    scan, q1 = plan_scan(sp, slots, occupied, q)
+    rest, (src, table, dst), tried = plan_show(sp, slots, occupied, q1, args.tilt)
+    items = scan + rest
+    total = sum(float(p.t[-1]) for _, (_, p, _) in items)
+    log("show planned in %.1f s: %s -> %s -> %s, %d motions, %.1f s of motion"
+        % (time.time() - t0, src.key, table.key, dst.key, len(items), total))
+    plan = {"src": src.key, "table": table.key, "dst": dst.key, "tilt_deg": args.tilt,
+            "tried": tried, "steps": summary(items)}
+    (out / "plan.json").write_text(json.dumps(plan, indent=1))
+    for r in plan["steps"]:
+        log("  %-9s %-28s %-5s %-6s %5.2f s %s" % (
+            r["phase"], r["name"], r["kind"], r.get("by", ""), r["duration_s"],
+            {k: round(v, 2) for k, v in r.items()
+             if k not in ("phase", "name", "kind", "by", "duration_s")}))
+    if cell is None:
+        return
+
+    import judge as J
+    results, runs, phase, k = [], [], None, 0
+    legs = iter([(src, table), (table, dst)])
+    leg = None
+    try:
+        for ph, (s, p, info) in items:
+            if ph != phase or s.name.startswith("to_"):
+                phase = ph
+                if s.name.startswith("to_"):
+                    leg, runs = next(legs), []
+                    log("== MOVE %s -> %s" % (leg[0].key, leg[1].key))
+                elif ph == "locate":
+                    log("== LOCATE (ground-truth jig poses stand in for the AprilGrid read)")
+                else:
+                    log("== %s" % ph.upper())
+            if s.name.startswith("sight_near_"):
+                log("locating %s" % s.name[len("sight_near_"):])
+            tid = f"{k:03d}_{s.name}"
+            k += 1
+            rep = cell.run(tid, p)
+            log("%s done %.1f s" % (tid, p.t[-1]))
+            if leg is not None and ph == "transfer":
+                runs.append({"name": s.name, "kind": s.kind, "carried": s.carried,
+                             "lifting": s.lifting, "track": s.track, "kin": p.kin,
+                             "planned": [P.fk_world(ik, np.asarray(x["q_cmd"][:6]), sp.base)
+                                         for x in rep["samples"]],
+                             "report": rep})
+                if s.name == "back":
+                    v = J.assess(runs, tray_at[leg[0].key], J.seated_pose(S.tray_box(leg[1]).T, offset),
+                                 RC.ROBOT, RC.BASE)
+                    log("move %s -> %s: %s seat %.2f mm %.2f deg slip %.2f mm track %.2f mm contacts %d"
+                        % (leg[0].key, leg[1].key, "PASS" if v["ok"] else "FAIL", v["seat_mm"],
+                           v["seat_deg"], v["slip_mm"], v["track_mm"], len(v["contacts"])))
+                    results.append({"src": leg[0].key, "dst": leg[1].key, "verdict": v})
+                    tray_at = RC.moved(tray_at, leg[0].key, leg[1].key)
+                    leg = None
+    finally:
+        (out / "results.json").write_text(json.dumps(results, indent=1,
+                                                     default=lambda o: np.asarray(o).tolist()))
+        cell.close()
+    log("show done")
+
+
+if __name__ == "__main__":
+    main()
