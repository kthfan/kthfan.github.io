+    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
+    <parent link="base"/>
+    <child link="gripper_body"/>
+  </joint>
+  <joint name="left_gripper_joint" type="prismatic">
+    <origin xyz="-0.0261453 -0.0880107 -0.029113 " rpy="3.1415927 0. -1.5707964"/>
+    <parent link="gripper_body"/>
