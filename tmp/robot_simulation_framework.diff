+"""M4 task 7: the detector's board pose, taken to the world and judged.
+
+Synthetic transforms only; the real images are judged by the report. Every
+perturbation is built from the slot's own approach axis, so a component read
+off the wrong axis shows up on slots whose approaches differ (incoming,
+outgoing, table).
+"""
+import math
+
+import numpy as np
+import pytest
+
+import cell_core.config as C
+from cell_core import frames as F
+from cell_core import geometry as G
+from cell_core import locating as LOC
+from cell_core import sequence as S
+
+
+def _rot(axis, deg):
+    a = np.asarray(axis, float) / np.linalg.norm(axis)
+    K = np.array([[0, -a[2], a[1]], [a[2], 0, -a[0]], [-a[1], a[0], 0]])
+    t = math.radians(deg)
+    return np.eye(3) + math.sin(t) * K + (1 - math.cos(t)) * K @ K
+
+
+def _slots():
+    slots = G.enumerate_slots(C.load_preset("strict"))
+    picked = {}
+    for s in slots:
+        picked.setdefault(s.role, s)
+    assert len(picked) == 3
+    return list(picked.values())
+
+
+def _truth(slot):
+    """A board as the label carries it: z into the label, y down, x = y cross z."""
+    a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+    y = -F.UP
+    R = np.column_stack([np.cross(y, a), y, a])
+    return F.make_pose(R, a * slot.label_plane_dist + F.UP * slot.label_centre_z)
+
+
+# ── the detector's pose ──────────────────────────────────────────────────────
+def test_rodrigues_matches_opencv():
+    cv2 = pytest.importorskip("cv2")
+    rng = np.random.default_rng(7)
+    for rvec in [np.zeros(3), np.array([0, 0, math.pi / 2]), *rng.normal(0, 1.2, (20, 3)),
+                 np.array([1e-9, -2e-9, 3e-9])]:
+        want = cv2.Rodrigues(np.asarray(rvec, float).reshape(3, 1))[0]
+        assert LOC.rodrigues(rvec) == pytest.approx(want, abs=1e-12)
+
+
+def test_the_detector_pose_is_board_to_camera():
+    """``translation`` is the board origin in the camera frame (OpenCV solvePnP)."""
+    T = LOC.board_in_camera([0.01, -0.02, 0.3], [0, 0, math.pi / 2])
+    assert T[:3, 3] == pytest.approx([0.01, -0.02, 0.3])
+    assert T[:3, :3] @ [1, 0, 0] == pytest.approx([0, 1, 0], abs=1e-12)
+    assert T[3] == pytest.approx([0, 0, 0, 1])
+
+
+def test_the_board_in_the_world_is_the_camera_pose_then_the_board():
+    cam = F.make_pose(_rot([0, 0, 1], 90), [1, 2, 3])
+    board = F.make_pose(_rot([1, 0, 0], 30), [0.1, 0, 0.5])
+    W = LOC.board_in_world(cam, board)
+    assert W[:3, 3] == pytest.approx([1, 2.1, 3.5])
+    assert W[:3, :3] == pytest.approx(_rot([0, 0, 1], 90) @ _rot([1, 0, 0], 30))
+
+
+# ── the error, in the slot's own axes ────────────────────────────────────────
+@pytest.mark.parametrize("slot", _slots(), ids=lambda s: s.role)
+def test_the_error_is_split_along_the_slot_axes(slot):
+    a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+    lat = F.lateral_axis(a)
+    truth = _truth(slot)
+    R = _rot(lat, 0.5) @ _rot(F.UP, -0.7) @ _rot(a, 0.9) @ truth[:3, :3]
+    p = truth[:3, 3] + 0.002 * F.UP - 0.003 * lat + 0.004 * a
+    e = LOC.pose_errors(F.make_pose(R, p), truth, a)
+    assert e["vertical"] == pytest.approx(0.002, abs=1e-12)
+    assert e["lateral"] == pytest.approx(-0.003, abs=1e-12)
+    assert e["depth"] == pytest.approx(0.004, abs=1e-12)
+    # Composed small rotations: the rotation vector is the sum to second order.
+    assert e["pitch"] == pytest.approx(0.5, abs=0.01)
+    assert e["yaw"] == pytest.approx(-0.7, abs=0.01)
+    assert e["roll"] == pytest.approx(0.9, abs=0.01)
+
+
+@pytest.mark.parametrize("axis,key", [("lat", "pitch"), ("up", "yaw"), ("a", "roll")])
+def test_a_pure_rotation_is_read_on_its_own_axis_only(axis, key):
+    slot = _slots()[1]
+    a = slot.approach_vec / np.linalg.norm(slot.approach_vec)
+    vec = {"lat": F.lateral_axis(a), "up": F.UP, "a": a}[axis]
+    truth = _truth(slot)
+    e = LOC.pose_errors(F.make_pose(_rot(vec, 3.0) @ truth[:3, :3], truth[:3, 3]), truth, a)
+    for k in ("pitch", "yaw", "roll"):
+        assert e[k] == pytest.approx(3.0 if k == key else 0.0, abs=1e-9), k
+    for k in ("vertical", "lateral", "depth"):
+        assert e[k] == pytest.approx(0.0, abs=1e-12), k
+
+
+# ── the verdict ──────────────────────────────────────────────────────────────
+def test_the_limits_are_half_the_flat_corridor_budget():
+    flat = G.tolerance_budget(use_recess=False)
+    lim = LOC.limits()
+    assert {k: lim[k] for k in ("vertical", "lateral", "pitch", "yaw")} == {
+        "vertical": flat["vertical_half"] / 2, "lateral": flat["lateral_half"] / 2,
+        "pitch": flat["pitch_deg"] / 2, "yaw": flat["yaw_deg"] / 2}
+    assert lim["vertical"] != G.tolerance_budget(use_recess=True)["vertical_half"] / 2
+
+
+def test_the_depth_limit_is_half_the_tighter_insertion_margin(monkeypatch):
+    """D27: a depth error moves the plate tip along the approach, into the
+    pre-insert gap and the back margin alike. D28: and the gripper body into
+    the front margin."""
+    assert LOC.limits()["depth"] == pytest.approx(0.005)
+    monkeypatch.setattr(S, "BACK_MARGIN", 0.004)
+    assert LOC.limits()["depth"] == pytest.approx(0.002)
+    monkeypatch.setattr(S, "PRE_INSERT_GAP", 0.003)
+    assert LOC.limits()["depth"] == pytest.approx(0.0015)
+    monkeypatch.setattr(S, "FRONT_MARGIN", 0.002)
+    assert LOC.limits()["depth"] == pytest.approx(0.001)
+    assert set(LOC.limits()) == {"vertical", "lateral", "depth", "pitch", "yaw"}
+
+
+@pytest.mark.parametrize("read", ["far", "near"])
+def test_only_the_judged_axes_can_fail_and_the_sign_does_not_matter(read):
+    lim = LOC.limits()
+    ok = {k: -v for k, v in lim.items()}
+    ok.update(roll=90.0)
+    assert LOC.failures(ok, lim, read) == []
+    for k in LOC.JUDGED[read]:
+        bad = dict(ok, **{k: -lim[k] * 1.001})
+        assert LOC.failures(bad, lim, read) == [k]
+
+
+@pytest.mark.parametrize("read", ["far", "near"])
+def test_both_reads_are_judged_on_everything_but_roll(read):
+    """User decision 2026-10-03 (D27, supersedes D25's JUDGED): with the D26
+    renders the far read resolves pitch and depth too."""
+    assert LOC.JUDGED[read] == ("vertical", "lateral", "depth", "pitch", "yaw")
+    lim = LOC.limits()
+    zero = {k: 0.0 for k in ("vertical", "lateral", "depth", "pitch", "yaw", "roll")}
+    assert LOC.failures(dict(zero, pitch=5 * lim["pitch"]), lim, read) == ["pitch"]
+    assert LOC.failures(dict(zero, depth=2 * lim["depth"]), lim, read) == ["depth"]
+    assert LOC.failures(dict(zero, roll=90.0), lim, read) == []
+
+
+# ── which board is the slot's ────────────────────────────────────────────────
+def _board(board_id, rmse=0.05):
+    from types import SimpleNamespace as NS
+    return NS(board_id=board_id, coverage=1.0,
+              pose=NS(translation=(0, 0, 0.3), rvec=(0, 0, 0), reprojection_rmse=rmse))
+
+
+def test_the_grid_is_the_tags_and_their_gaps():
+    from cell_core import assets as A
+    assert A.GRID_W == pytest.approx(A.TAGS_X * A.TAG_SIZE + (A.TAGS_X - 1) * A.TAG_SEPARATION)
+    assert A.GRID_H == pytest.approx(A.TAGS_Y * A.TAG_SIZE + (A.TAGS_Y - 1) * A.TAG_SEPARATION)
+
+
+def test_the_expected_board_is_chosen_among_its_neighbours():
+    b = [_board(3), _board(5), _board(4)]
+    assert LOC.choose_board(b, 5) == (b[1], "ok")
+
+
+@pytest.mark.parametrize("boards,status", [
+    ([], "missing"),
+    ([_board(4), _board(6)], "wrong_id"),
+    ([_board(5), _board(5)], "duplicate"),
+    ([_board(4), _board(5, rmse=LOC.MAX_RMSE_PX * 1.01)], "high_rmse"),
+])
+def test_a_read_without_one_good_expected_board_is_named_not_skipped(boards, status):
+    board, got = LOC.choose_board(boards, 5)
+    assert got == status
+    assert (board is None) == (status in ("missing", "wrong_id", "duplicate"))
+
+
+def test_a_board_without_a_pose_is_not_a_located_board():
+    from types import SimpleNamespace as NS
+    assert LOC.choose_board([NS(board_id=5, coverage=0.25, pose=None)], 5) == (None, "no_pose")
+
+
+def test_the_rmse_limit_is_inclusive():
+    b = _board(5, rmse=LOC.MAX_RMSE_PX)
+    assert LOC.choose_board([b], 5) == (b, "ok")
+
+
+def test_the_rmse_cut_is_two_pixels():
+    """User decision 2026-09-30 (D25): the strict renders fit at 0.80-1.34 px
+    (texture filtering) with sub-0.05 mm positions; 2 px still flags a misfit."""
+    assert LOC.MAX_RMSE_PX == 2.0
