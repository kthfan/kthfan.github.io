@@ -0,0 +1,374 @@
+"""M3: the cell collision checker, pure parts.
+
+cuRobo runs only on the program host; these pin everything around it: which
+obstacles are judged at which margin, how a margin ladder becomes a clearance
+band, the carried-tray clearance, branch continuity and the slot verdict. EAIK
+is local too, so the branch enumeration is checked against forward kinematics.
+"""
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "program" / "collision"))
+
+import check_cell as CC  # noqa: E402  (puts the vendored cell_core on the path)
+from cell_core import assets as A  # noqa: E402
+from cell_core import config as C  # noqa: E402
+from cell_core import frames as F  # noqa: E402
+from cell_core import geometry as G  # noqa: E402
+from cell_core import scene as S  # noqa: E402
+from cell_core import sequence as SEQ  # noqa: E402
+
+URDF = ROOT / "todo" / "resources" / "robot_config" / "tm5s_v4.urdf"
+
+
+@pytest.fixture(scope="module")
+def cfg():
+    return C.load_preset("strict")
+
+
+@pytest.fixture(scope="module")
+def slot(cfg):
+    return next(s for s in G.enumerate_slots(cfg) if s.key == "outgoing/L3/C0")
+
+
+def _box(name, centre, size=(1, 1, 1)):
+    return S.Box(name, F.make_pose(np.eye(3), centre), np.asarray(size, dtype=float))
+
+
+# ── obstacle groups and their margins ────────────────────────────────────────
+def test_groups_partition_the_cell(cfg, slot):
+    boxes = S.cell_boxes(cfg)
+    groups = CC.groups(boxes, slot.key)
+    names = [b.name for g in groups.values() for b in g]
+    assert sorted(names) == sorted(b.name for b in boxes)
+    assert len(names) == len(set(names))
+    assert len(groups["target/jig"]) == len(S.jig_boxes(slot))
+    assert {b.name for b in groups["target/jig"]} == {b.name for b in S.jig_boxes(slot)}
+    assert [b.name for b in groups["target/tray"]] == [f"tray/{slot.key}"]
+    assert f"tray/{slot.key}" not in {b.name for b in groups["trays"]}
+    assert not any(b.name.startswith(f"jig/{slot.key}/") for b in groups["jigs"])
+    for rack in cfg.racks:
+        assert all("/shelf" in b.name for b in groups[f"rack/{rack.name}/shelves"])
+        assert len(groups[f"rack/{rack.name}/legs"]) == 4
+    assert {"table", "mount", "floor"} <= set(groups)
+
+
+def test_an_emptied_slot_has_no_target_tray_group(cfg, slot):
+    groups = CC.groups(S.cell_boxes(cfg, empty=(slot.key,)), slot.key)
+    assert "target/tray" not in groups
+    assert all(groups.values())
+
+
+def test_a_neighbour_with_a_shared_prefix_is_not_the_target(cfg):
+    """``outgoing/L1/C1`` must not claim ``outgoing/L1/C10``-style names."""
+    boxes = [_box("jig/outgoing/L1/C1/base", (0, 0, 0)), _box("jig/outgoing/L1/C10/base", (5, 0, 0)),
+             _box("tray/outgoing/L1/C1", (0, 0, 1)), _box("tray/outgoing/L1/C10", (5, 0, 1))]
+    groups = CC.groups(boxes, "outgoing/L1/C1")
+    assert [b.name for b in groups["target/jig"]] == ["jig/outgoing/L1/C1/base"]
+    assert [b.name for b in groups["target/tray"]] == ["tray/outgoing/L1/C1"]
+    assert [b.name for b in groups["jigs"]] == ["jig/outgoing/L1/C10/base"]
+    assert [b.name for b in groups["trays"]] == ["tray/outgoing/L1/C10"]
+
+
+def test_only_the_target_may_be_touched():
+    assert CC.required_margin("target/jig") == 0.0
+    assert CC.required_margin("target/tray") == 0.0
+    for g in ("jigs", "trays", "rack/incoming/shelves", "table", "mount", "floor"):
+        assert CC.required_margin(g) == CC.MARGIN == 0.005
+
+
+def test_the_ladder_resolves_both_margins():
+    assert CC.LADDER[0] == 0.0
+    assert CC.MARGIN in CC.LADDER
+    assert list(CC.LADDER) == sorted(CC.LADDER)
+
+
+# ── the gripper mesh each group is judged with ───────────────────────────────
+GRIPPER_YML = ROOT / "todo" / "resources" / "robot_config" / "egu50_v2.yml"
+
+
+def test_only_the_target_tray_is_judged_without_the_jaws():
+    """User 2026-10-06 (D28): the jaws clamp the tray sides, contact is allowed."""
+    assert CC.mesh_for("target/tray") == "no_jaws"
+    for g in ("target/jig", "trays", "jigs", "rack/outgoing/shelves", "table", "mount", "floor"):
+        assert CC.mesh_for(g) == "full", g
+
+
+def test_the_jaw_probe_overlaps_the_open_jaw():
+    (cx, _, _), (sx, _, _), _ = CC.PROBES["jaw"]
+    inner, outer = A.JAW_X_IN + CC.JAW, A.JAW_X_OUT + CC.JAW
+    assert cx - sx / 2 < outer and cx + sx / 2 > inner
+
+
+def test_the_no_jaw_gripper_keeps_only_the_body():
+    import copy
+
+    import yaml
+    raw = yaml.safe_load(GRIPPER_YML.read_text())
+    before = copy.deepcopy(raw)
+    k = CC.gripper_cfg(raw, jaws=False)["kinematics"]
+    assert k["collision_link_names"] == k["mesh_link_names"] == ["gripper_body"]
+    assert set(k["collision_spheres"]) == {"gripper_body"}
+    assert k["collision_spheres"]["gripper_body"] == raw["kinematics"]["collision_spheres"]["gripper_body"]
+    assert set(k["self_collision_buffer"]) == {"gripper_body"}
+    assert set(k["self_collision_ignore"]) == {"gripper_body", "base"}
+    assert raw == before
+    assert CC.gripper_cfg(raw, jaws=True) == raw
+
+
+def test_a_dropped_jaw_link_has_its_joint_locked_open():
+    """cuRobo keeps only collision links and tool frames in the tree; a cspace
+    joint left without its link must be locked (host run 2026-10-06)."""
+    import yaml
+    raw = yaml.safe_load(GRIPPER_YML.read_text())
+    k = CC.gripper_cfg(raw, jaws=False)["kinematics"]
+    assert k["tool_frames"] == ["right_gripper"]
+    assert k["lock_joints"] == {"left_gripper_joint": CC.JAW}
+    assert CC.gripper_cfg(raw, jaws=True)["kinematics"]["lock_joints"] is None
+
+
+# ── clearance bands ──────────────────────────────────────────────────────────
+@pytest.mark.parametrize("hits, band", [
+    ({0.0: False, 0.002: False, 0.005: True, 0.01: True}, (0.002, 0.005)),
+    ({0.0: False, 0.002: False, 0.005: False}, (0.005, None)),
+    ({0.0: True, 0.002: True}, (None, 0.0)),
+    # A wider margin cannot clear what a narrower one hit; the first hit decides.
+    ({0.0: False, 0.002: True, 0.005: False}, (0.0, 0.002)),
+])
+def test_clearance_band(hits, band):
+    assert CC.clearance_band(hits) == band
+
+
+def _rec(bands, self_cost=0.0, carried=None):
+    return {"groups": {g: {"free_at": lo, "hit_at": hi} for g, (lo, hi) in bands.items()},
+            "self": self_cost, "carried": carried}
+
+
+def test_a_pose_passes_when_every_group_keeps_its_margin():
+    assert CC.pose_ok(_rec({"target/jig": (0.0, 0.002), "jigs": (0.005, 0.01), "floor": (0.05, None)}))
+
+
+def test_a_pose_fails_on_contact_with_its_own_jig():
+    assert not CC.pose_ok(_rec({"target/jig": (None, 0.0), "floor": (0.05, None)}))
+
+
+def test_a_pose_fails_inside_the_margin_of_anything_else():
+    assert not CC.pose_ok(_rec({"target/jig": (0.05, None), "rack/outgoing/shelves": (0.002, 0.005)}))
+
+
+def test_a_pose_fails_on_self_collision():
+    assert not CC.pose_ok(_rec({"floor": (0.05, None)}, self_cost=1e-4))
+
+
+def test_a_pose_fails_when_the_carried_tray_is_too_close():
+    near = {"target": 0.02, "rest": 0.004, "nearest": "tray/x"}
+    assert not CC.pose_ok(_rec({"floor": (0.05, None)}, carried=near))
+    far = {"target": 0.0, "rest": 0.005, "nearest": "tray/x"}
+    assert CC.pose_ok(_rec({"floor": (0.05, None)}, carried=far))
+    sunk = {"target": -0.001, "rest": 0.05, "nearest": "tray/x"}
+    assert not CC.pose_ok(_rec({"floor": (0.05, None)}, carried=sunk))
+
+
+# ── the carried tray ─────────────────────────────────────────────────────────
+def test_carried_clearance_splits_target_and_rest():
+    carried = _box("tray/carried", (0, 0, 0))
+    boxes = [_box("jig/a/L0/C0/col_pp", (1.001, 0, 0)), _box("jig/a/L0/C1/base", (0, 1.004, 0)),
+             _box("floor", (0, 0, -1.5))]
+    got = CC.carried_clearance(carried, boxes, "a/L0/C0")
+    assert got["target"] == pytest.approx(0.001)
+    assert got["rest"] == pytest.approx(0.004)
+    assert got["nearest"] == "jig/a/L0/C1/base"
+
+
+def test_the_lifted_tray_clears_the_strict_cell(cfg, slot):
+    """A claim about the cell, not just the code: lift and withdraw are clear."""
+    for phase in ("lift", "withdraw"):
+        boxes, carried = S.phase_scene(cfg, slot, phase)
+        got = CC.carried_clearance(carried, boxes, slot.key)
+        assert got["target"] >= 0.0 and got["rest"] >= CC.MARGIN, (phase, got)
+
+
+# ── branches ─────────────────────────────────────────────────────────────────
+def _b(q, ok=True, score=0.01):
+    return {"q": list(q), "ok": ok, "score": score}
+
+
+def test_best_chain_follows_one_branch():
+    a, b = (0.0, -0.5, 1.0, 0.0, 0.5, 0.0), (0.0, -0.4, 1.1, 0.0, 0.5, 0.0)
+    branches = {"pre_insert": [_b(a)], "insert": [_b(b)], "lift": [_b(b)]}
+    assert CC.best_chain(branches) == (0, 0, 0)
+
+
+def test_best_chain_refuses_an_elbow_flip():
+    up, down = (0.0, -0.5, 0.2, 0.0, 0.5, 0.0), (0.0, -0.5, -0.2, 0.0, 0.5, 0.0)
+    assert CC.best_chain({"pre_insert": [_b(up)], "insert": [_b(down)], "lift": [_b(down)]}) is None
+
+
+def test_best_chain_refuses_a_large_joint_jump():
+    a = (0.0, -0.5, 1.0, 0.0, 0.5, 0.0)
+    b = (0.0, -0.5, 1.0, CC.MAX_JOINT_STEP + 0.01, 0.5, 0.0)
+    assert CC.best_chain({"pre_insert": [_b(a)], "insert": [_b(b)], "lift": [_b(b)]}) is None
+    c = (0.0, -0.5, 1.0, CC.MAX_JOINT_STEP - 0.01, 0.5, 0.0)
+    assert CC.best_chain({"pre_insert": [_b(a)], "insert": [_b(c)], "lift": [_b(c)]}) == (0, 0, 0)
+
+
+def test_best_chain_skips_failing_branches_and_prefers_clearance():
+    a = (0.0, -0.5, 1.0, 0.0, 0.5, 0.0)
+    flip = (3.0, -0.5, 1.0, 3.0, -0.5, 3.0)
+    branches = {
+        "pre_insert": [_b(a, score=0.002), _b(flip, score=0.05)],
+        "insert": [_b(a, ok=False), _b(a, score=0.01), _b(flip, score=0.05)],
+        "lift": [_b(flip, score=0.05), _b(a, score=0.02)],
+    }
+    assert CC.best_chain(branches) == (1, 2, 0)
+    branches["insert"][2]["ok"] = False
+    assert CC.best_chain(branches) == (0, 1, 1)
+
+
+# Joint 1 of the TM5S spans ±5.565 rad, joints 4 and 6 ±3.665: one pose can be
+# written a turn apart. Host run 2026-10-06: incoming/L0/C3 failed on that alone.
+LO = np.array([-5.565, -3.1416, -2.705, -3.665, -2.618, -3.665])
+HI = -LO
+#: pre_insert 6 and insert 2 of incoming/L0/C3 (strict, D28).
+TURNED = (-5.2, 0.24, 2.13, 0.77, -0.49, -3.14)
+NEAR = (0.68, 0.66, 1.46, 1.03, -0.89, -3.14)
+
+
+def test_a_joint_written_a_turn_apart_is_the_same_joint():
+    branches = {"pre_insert": [_b(TURNED)], "insert": [_b(NEAR)], "lift": [_b(NEAR)]}
+    assert CC.best_chain(branches) is None
+    assert CC.best_chain(branches, LO, HI) == (0, 0, 0)
+
+
+def test_the_chain_reports_the_turn_it_takes():
+    qs = CC.chain_joints([TURNED, NEAR, NEAR], LO, HI)
+    assert qs[0][0] == pytest.approx(-5.2 + 2 * np.pi)
+    assert list(qs[0][1:]) == list(TURNED[1:])
+    assert list(qs[1]) == list(NEAR) == list(qs[2])
+
+
+def test_a_turn_the_limits_forbid_is_not_taken():
+    lo, hi = LO.copy(), HI.copy()
+    lo[0], hi[0] = -5.565, 1.0            # 1.083 is out of range
+    assert CC.chain_joints([TURNED, NEAR, NEAR], lo, hi) is None
+
+
+def test_a_turn_does_not_excuse_an_elbow_flip():
+    flip = list(NEAR)
+    flip[2] = -flip[2]
+    assert CC.chain_joints([TURNED, flip, flip], LO, HI) is None
+
+
+def test_the_verdict_carries_the_chain_joints():
+    branches = {p: [_b(NEAR)] for p in SEQ.GRASP_PHASES}
+    branches["pre_insert"] = [_b(TURNED)]
+    v = CC.slot_verdict(branches, LO, HI)
+    assert v["ok"] and v["chain"] == [0, 0, 0]
+    assert v["chain_q"][0][0] == pytest.approx(-5.2 + 2 * np.pi)
+    assert CC.slot_verdict(branches)["chain_q"] is None
+
+
+def test_slot_verdict_needs_the_chain_and_every_other_phase():
+    a = (0.0, -0.5, 1.0, 0.0, 0.5, 0.0)
+    branches = {p: [_b(a)] for p in SEQ.GRASP_PHASES}
+    v = CC.slot_verdict(branches)
+    assert v["ok"] and v["chain"] == [0, 0, 0] and v["missing"] == []
+    branches["withdraw"] = [_b(a, ok=False)]
+    v = CC.slot_verdict(branches)
+    assert not v["ok"] and v["missing"] == ["withdraw"]
+    branches["withdraw"] = [_b(a)]
+    branches["insert"] = [_b(a, ok=False)]
+    v = CC.slot_verdict(branches)
+    assert not v["ok"] and v["chain"] is None and v["missing"] == ["insert"]
+
+
+def test_slot_verdict_fails_a_broken_chain_even_with_every_phase_covered():
+    up, down = (0.0, -0.5, 0.2, 0.0, 0.5, 0.0), (0.0, -0.5, -0.2, 0.0, 0.5, 0.0)
+    branches = {p: [_b(up)] for p in SEQ.GRASP_PHASES}
+    branches["insert"] = [_b(down)]
+    v = CC.slot_verdict(branches)
+    assert not v["ok"] and v["chain"] is None and v["missing"] == []
