+"""for_show probe: why the straight pre_insert / insert moves fail."""
+import sys
+import numpy as np
+sys.path.insert(0, "motion")
+import show as SH
+import planner as PL
+import paths as P
+import transfer as TR
+from cell_core import config as C, geometry as G, sequence as SEQ
+
+cfg = C.load_preset("strict")
+slots = G.enumerate_slots(cfg)
+ik = PL.CC.load_ik(PL.CC.URDF)
+src = next(s for s in slots if s.key == "incoming/L1/C1")
+occ = frozenset(s.key for s in slots if s.role == "incoming")
+sp = SH.ShowPlanner(cfg, slots, ik)
+B = sp.Bound
+
+
+def run(tag, goal, q0, bounds, occ_=occ):
+    sp._world(frozenset(occ_))
+    sp.mp.update_tool_pose_bounds({SH.FRAME: bounds})
+    try:
+        res = sp.mp.plan_pose(sp._goal(goal), sp._js(q0))
+    except Exception as e:
+        print(tag, "RAISE", str(e)[:300])
+        return None
+    ok = bool(res.success.reshape(-1)[0])
+    m = res.metrics
+    extra = {}
+    if m is not None:
+        for k in [k for k in dir(m) if not k.startswith("_")]:
+            v = getattr(m, k, None)
+            if hasattr(v, "reshape") and hasattr(v, "float"):
+                try:
+                    extra[k] = np.round(v.reshape(-1).float().cpu().numpy()[:3], 4).tolist()
+                except Exception:
+                    pass
+    print(tag, ok, extra)
+    if ok:
+        last = int(res.interpolated_last_tstep.reshape(-1)[0])
+        Q = res.interpolated_trajectory.position.reshape(-1, 6)[: last + 1].cpu().numpy().astype(float)
+        fr = sp.fk(Q)
+        print("   stats", SH.path_stats("line", fr, P.fk_world(ik, q0, sp.base), goal))
+        return Q[-1]
+    return None
+
+
+appr = TR.approach_pose(src)
+qa = run("free->approach", appr, PL.HOME, None)
+pre = SEQ.pre_insert_pose(src)
+step = SH.Step("pre_insert", "line", pre, SH.OPEN, SH.OPEN, None, occ)
+T0 = P.fk_world(ik, qa, sp.base)
+print("approach->pre dist", np.linalg.norm(pre[:3, 3] - T0[:3, 3]))
+run("pre none", pre, qa, None)
+bl = sp.bounds(step, T0)
+run("pre line+ori", pre, qa, bl)
+run("pre ori", pre, qa, [bl[0]])
+run("pre line", pre, qa, [bl[1]])
+u = sp.base[:3, :3].T @ ((pre[:3, 3] - T0[:3, 3]) / np.linalg.norm(pre[:3, 3] - T0[:3, 3]))
+print("u base", u, "goal z in base", (sp.base_inv @ pre)[:3, 2])
+run("pre line tol5", pre, qa, [B.line(direction=[float(x) for x in u], min_along=-0.12, max_along=0.002,
+                                         anchor="goal", reference_axes="base", tolerance=0.005)])
+run("pre line goalz", pre, qa, [B.line((0, 0, 1), min_along=-0.12, max_along=0.002, tolerance=0.002)])
+qp = run("pre goalz+ori", pre, qa, [B.line((0, 0, 1), min_along=-0.12, max_along=0.002, tolerance=0.002),
+                                    B.orientation_box(0.02, 0.02, 0.02, tolerance=0.005)])
+if qp is None:
+    qp = run("pre none again", pre, qa, None)
+ins = SEQ.insert_pose(src)
+run("insert none", ins, qp, None)
+run("insert none, no target tray", ins, qp, None, occ - {src.key})
+run("insert goalz", ins, qp, [B.line((0, 0, 1), min_along=-0.2, max_along=0.002, tolerance=0.002)],
+    occ - {src.key})
