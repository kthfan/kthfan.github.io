+#!/usr/bin/env python3
+"""Dump USD stage geometry to JSON for offline analysis.
+
+Runs with any python that has `pxr` importable (system python3 on the isaacsim
+host, or isaac-sim's python.sh). Read-only: opens stages and reports structure,
+transforms, and world-space bounding boxes. Never writes to the USD files.
+
+Usage:
+    python3 dump_usd_geometry.py <out.json> <stage.usd> [<stage.usd> ...]
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import traceback
+
+from pxr import Usd, UsdGeom, UsdPhysics, Gf
+
+
+def _xform_to_dict(m: Gf.Matrix4d) -> dict:
+    t = m.ExtractTranslation()
+    q = m.ExtractRotationQuat()
+    i = q.GetImaginary()
+    return {
+        "translation": [round(v, 9) for v in (t[0], t[1], t[2])],
+        "quat_xyzw": [round(v, 9) for v in (i[0], i[1], i[2], q.GetReal())],
+    }
+
+
+def _bbox_to_dict(bbox) -> dict | None:
+    rng = bbox.ComputeAlignedRange()
+    if rng.IsEmpty():
+        return None
+    mn, mx = rng.GetMin(), rng.GetMax()
+    return {
+        "min": [round(v, 9) for v in (mn[0], mn[1], mn[2])],
+        "max": [round(v, 9) for v in (mx[0], mx[1], mx[2])],
+        "size": [round(mx[i] - mn[i], 9) for i in range(3)],
+        "center": [round((mx[i] + mn[i]) / 2.0, 9) for i in range(3)],
+    }
+
+
+def _joint_info(prim) -> dict | None:
+    """Extract physics joint data (needed for flange / jaw kinematics)."""
+    if not prim.IsA(UsdPhysics.Joint):
+        return None
+    j = UsdPhysics.Joint(prim)
+    info = {}
+
+    def _rel(name, rel):
+        tgts = rel.GetTargets() if rel else []
+        if tgts:
+            info[name] = [str(t) for t in tgts]
+
+    _rel("body0", j.GetBody0Rel())
+    _rel("body1", j.GetBody1Rel())
+
+    for name, attr in (
+        ("local_pos0", j.GetLocalPos0Attr()),
+        ("local_pos1", j.GetLocalPos1Attr()),
+        ("local_rot0", j.GetLocalRot0Attr()),
+        ("local_rot1", j.GetLocalRot1Attr()),
+    ):
+        if attr and attr.HasAuthoredValue():
+            v = attr.Get()
+            if v is None:
+                continue
+            if hasattr(v, "GetImaginary"):
+                im = v.GetImaginary()
+                info[name] = [round(x, 9) for x in (im[0], im[1], im[2], v.GetReal())]
+            else:
+                info[name] = [round(float(x), 9) for x in v]
+
+    if prim.IsA(UsdPhysics.PrismaticJoint) or prim.IsA(UsdPhysics.RevoluteJoint):
+        cls = UsdPhysics.PrismaticJoint if prim.IsA(UsdPhysics.PrismaticJoint) else UsdPhysics.RevoluteJoint
+        tj = cls(prim)
+        axis = tj.GetAxisAttr().Get() if tj.GetAxisAttr() else None
+        lo = tj.GetLowerLimitAttr().Get() if tj.GetLowerLimitAttr() else None
+        hi = tj.GetUpperLimitAttr().Get() if tj.GetUpperLimitAttr() else None
+        info["joint_type"] = "prismatic" if prim.IsA(UsdPhysics.PrismaticJoint) else "revolute"
+        info["axis"] = str(axis) if axis is not None else None
+        info["lower"] = lo
+        info["upper"] = hi
+    else:
+        info["joint_type"] = prim.GetTypeName()
+
+    return info
+
+
+def dump_stage(path: str) -> dict:
+    stage = Usd.Stage.Open(path)
+    if stage is None:
+        return {"path": path, "error": "failed to open stage"}
+
+    out = {
+        "path": path,
+        "meters_per_unit": UsdGeom.GetStageMetersPerUnit(stage),
+        "up_axis": str(UsdGeom.GetStageUpAxis(stage)),
+        "default_prim": str(stage.GetDefaultPrim().GetPath()) if stage.GetDefaultPrim() else None,
+        "prims": [],
+    }
+
+    bbox_cache = UsdGeom.BBoxCache(
+        Usd.TimeCode.Default(),
+        [UsdGeom.Tokens.default_, UsdGeom.Tokens.render],
+        useExtentsHint=False,
+    )
+    xf_cache = UsdGeom.XformCache(Usd.TimeCode.Default())
+
+    for prim in stage.Traverse():
+        type_name = str(prim.GetTypeName())
+        entry = {
+            "path": str(prim.GetPath()),
+            "type": type_name,
+            "name": prim.GetName(),
+        }
+
+        if prim.IsA(UsdGeom.Xformable):
+            try:
+                entry["world_xform"] = _xform_to_dict(xf_cache.GetLocalToWorldTransform(prim))
+                entry["local_xform"] = _xform_to_dict(xf_cache.GetLocalTransformation(prim)[0])
+            except Exception as exc:  # noqa: BLE001
+                entry["xform_error"] = str(exc)
+
+        if prim.IsA(UsdGeom.Boundable):
+            try:
+                bb = _bbox_to_dict(bbox_cache.ComputeWorldBound(prim))
+                if bb:
+                    entry["world_bbox"] = bb
+            except Exception as exc:  # noqa: BLE001
+                entry["bbox_error"] = str(exc)
+
+        if prim.IsA(UsdGeom.Mesh):
+            mesh = UsdGeom.Mesh(prim)
+            pts = mesh.GetPointsAttr().Get()
+            entry["mesh_point_count"] = len(pts) if pts else 0
+
+        # Primitive shapes carry exact authored dimensions -- far better than bbox.
+        for api, fields in (
+            (UsdGeom.Cube, ("size",)),
+            (UsdGeom.Sphere, ("radius",)),
+            (UsdGeom.Cylinder, ("radius", "height", "axis")),
+            (UsdGeom.Capsule, ("radius", "height", "axis")),
+            (UsdGeom.Cone, ("radius", "height", "axis")),
+        ):
+            if prim.IsA(api):
+                shape = api(prim)
+                vals = {}
+                for f in fields:
+                    attr = getattr(shape, "Get" + f.capitalize() + "Attr", None)
+                    if attr:
+                        v = attr().Get()
+                        vals[f] = str(v) if isinstance(v, str) or f == "axis" else v
+                entry["shape"] = {"kind": api.__name__, **vals}
+
+        ji = _joint_info(prim)
+        if ji:
+            entry["joint"] = ji
+
+        if prim.HasAttribute("physics:mass"):
+            entry["mass"] = prim.GetAttribute("physics:mass").Get()
+
+        out["prims"].append(entry)
+
+    return out
+
+
+def main() -> int:
+    if len(sys.argv) < 3:
+        print(__doc__)
+        return 2
+    out_path, stage_paths = sys.argv[1], sys.argv[2:]
+    results = []
+    for p in stage_paths:
+        try:
+            results.append(dump_stage(p))
+        except Exception:  # noqa: BLE001
+            results.append({"path": p, "error": traceback.format_exc()})
+    with open(out_path, "w", encoding="utf-8") as fh:
+        json.dump(results, fh, indent=1)
+    for r in results:
+        n = len(r.get("prims", []))
+        print(f"{r['path']}: {n} prims" + (f" ERROR {r['error'][:200]}" if "error" in r else ""))
+    print(f"wrote {out_path}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
