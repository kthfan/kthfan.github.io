+# ── the floor ────────────────────────────────────────────────────────────────
+#: The bodies that stand on the floor rather than on another body.
+ON_THE_FLOOR = {"/Environment/RobotArmBase/Base", "/Environment/RightRack",
+                "/Environment/LeftRack", "/Environment/Table/TableTop"}
+
+
+@pytest.fixture(scope="module")
+def built_strict(tmp_path_factory):
+    """The strict stage, really built (under a second, pure USD)."""
+    pytest.importorskip("pxr")
+    from pxr import Usd
+    out = tmp_path_factory.mktemp("strict")
+    cfg, env_kwargs, _ = B.plan("strict")
+    B.build(cfg, env_kwargs, str(out / "cell.usd"), None, str(out / "labels"))
+    return Usd.Stage.Open(str(out / "cell.usd"))
