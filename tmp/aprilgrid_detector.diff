+        let line = fit_line(&pts, None).unwrap();
+        assert!(approx(line.dir.x.abs(), 0.0, 1e-9));
+        assert!(approx(line.point.x, 3.0, 1e-9));
+    }
+
+    #[test]
+    fn fit_line_rejects_degenerate_input() {
+        assert!(fit_line(&[Point2::new(1.0, 1.0)], None).is_none());
+        assert!(fit_line(&[Point2::new(1.0, 1.0); 4], None).is_none());
+    }
+
+    #[test]
+    fn lines_intersect_at_the_expected_point() {
+        let a = Line2 { point: Point2::new(0.0, 0.0), dir: Point2::new(1.0, 0.0) };
+        let b = Line2 { point: Point2::new(3.0, -2.0), dir: Point2::new(0.0, 1.0) };
+        let p = a.intersect(&b).unwrap();
