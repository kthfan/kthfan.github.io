+"""Parameter sweep for the detector, scored on a simulated dataset.
+
+Detection rate and speed both depend strongly on the early pipeline stages
+(threshold contrast floor, cluster size floor, quad acceptance). This runs a
+grid over those and prints a table so the defaults can be chosen from data
+rather than guesswork.
+
+Usage:
+    python3 tools/sweep.py --data data/sim_normal
+    python3 tools/sweep.py --data data/sim_hard --quick
+"""
+
+from __future__ import annotations
+
+import argparse
+import itertools
+import json
+import os
+
+import aprilgrid_detector as agd
+
+from evaluate import evaluate
+
+
+def load_scene(data_dir):
+    with open(os.path.join(data_dir, "ground_truth.json")) as f:
+        meta = json.load(f)
+    b, c = meta["board"], meta["camera"]
+    layout = agd.BoardLayout(
+        tags_x=b["tags_x"], tags_y=b["tags_y"],
+        tag_size=b["tag_size"], tag_separation=b["tag_separation"],
+    )
+    camera = agd.Camera(c["fx"], c["fy"], c["cx"], c["cy"], tuple(c["distortion"]))
+    return layout, camera
+
+
+GRID = {
+    "decimate": [1, 2],
+    "min_contrast": [5, 8, 12],
+    "min_cluster_size": [12, 24, 48],
+    "min_side_px": [8.0, 16.0],
+}
+
+QUICK = {
+    "decimate": [1, 2],
+    "min_contrast": [5, 12],
+    "min_cluster_size": [12, 24],
+    "min_side_px": [8.0, 16.0],
+}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", required=True)
+    ap.add_argument("--quick", action="store_true")
+    ap.add_argument("--json", help="write all results here")
+    args = ap.parse_args()
+
+    layout, camera = load_scene(args.data)
+    grid = QUICK if args.quick else GRID
+    keys = list(grid)
+
+    rows = []
+    header = f"{'dec':>4} {'contr':>6} {'clust':>6} {'side':>6} | {'rate%':>7} {'rmse':>7} {'p95':>7} {'fp':>4} {'ms':>7} {'fps':>6}"
+    print(header)
+    print("-" * len(header))
+
+    for combo in itertools.product(*(grid[k] for k in keys)):
+        cfg = dict(zip(keys, combo))
+        det = agd.Detector(
+            decimate=cfg["decimate"],
+            min_contrast=cfg["min_contrast"],
+            min_cluster_size=cfg["min_cluster_size"],
+            min_side_px=cfg["min_side_px"],
+        )
+        r = evaluate(args.data, det, layout, camera)
+        ce = r["corner_error_px"] or {}
+        row = {
+            **cfg,
+            "rate": r["detection"]["tag_rate"],
+            "rmse": ce.get("rmse"),
+            "p95": ce.get("p95"),
+            "false_positives": r["detection"]["false_positives"],
+            "mean_ms": r["speed"]["mean_ms"],
+            "fps": r["speed"]["fps"],
+        }
+        rows.append(row)
+        print(f"{cfg['decimate']:>4} {cfg['min_contrast']:>6} {cfg['min_cluster_size']:>6} "
+              f"{cfg['min_side_px']:>6.0f} | {row['rate'] * 100:>7.2f} "
+              f"{(row['rmse'] or float('nan')):>7.4f} {(row['p95'] or float('nan')):>7.4f} "
+              f"{row['false_positives']:>4} {row['mean_ms']:>7.1f} {row['fps']:>6.1f}")
+
+    print("\nbest by detection rate:")
+    for row in sorted(rows, key=lambda r: -r["rate"])[:5]:
+        print(f"  rate {row['rate'] * 100:6.2f}%  rmse {row['rmse']:.4f}  "
+              f"{row['mean_ms']:6.1f} ms  {row}")
+
+    print("\nbest by rate among configs reaching 30 fps:")
+    fast = [r for r in rows if r["fps"] >= 30.0]
+    for row in sorted(fast, key=lambda r: -r["rate"])[:5]:
+        print(f"  rate {row['rate'] * 100:6.2f}%  rmse {row['rmse']:.4f}  "
+              f"{row['mean_ms']:6.1f} ms  {row}")
+    if not fast:
+        print("  none")
+
+    if args.json:
+        with open(args.json, "w") as f:
+            json.dump(rows, f, indent=1)
+
+
+if __name__ == "__main__":
+    main()
