+//! Fitting a quadrilateral to a boundary cluster.
+//!
+//! Strategy: take the convex hull of the boundary points, pick the four hull
+//! vertices enclosing the largest area (a good approximation of the tag's
+//! corners even under strong perspective), then re-fit each side as a
+//! total-least-squares line through the boundary points belonging to it and
+//! intersect adjacent lines. Corner accuracy therefore comes from *all* the
+//! points along an edge rather than from a single extreme point, which is what
+//! makes the result sub-pixel and noise tolerant.
+
+use crate::geometry::{Line2, Point2, fit_line, signed_area};
+use crate::gray::GrayImage;
+use crate::segmentation::BoundaryPoint;
+
+/// A candidate tag outline, corners in counter-clockwise order.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Quad {
+    pub corners: [Point2; 4],
+}
+
+impl Quad {
+    /// Absolute area enclosed by the quad.
+    pub fn area(&self) -> f64 {
+        signed_area(&self.corners).abs()
+    }
+
+    /// Length of the shortest side.
+    pub fn min_side(&self) -> f64 {
+        (0..4).map(|i| self.corners[i].distance(self.corners[(i + 1) % 4])).fold(f64::MAX, f64::min)
+    }
+
+    /// Length of the longest side.
+    pub fn max_side(&self) -> f64 {
+        (0..4).map(|i| self.corners[i].distance(self.corners[(i + 1) % 4])).fold(0.0, f64::max)
+    }
+
+    /// True when every interior angle turns the same way.
+    pub fn is_convex(&self) -> bool {
+        let mut sign = 0.0;
+        for i in 0..4 {
+            let a = self.corners[i];
+            let b = self.corners[(i + 1) % 4];
+            let c = self.corners[(i + 2) % 4];
+            let cross = b.sub(a).cross(c.sub(b));
+            if cross.abs() < 1e-12 {
+                return false;
+            }
+            if sign == 0.0 {
+                sign = cross.signum();
+            } else if cross.signum() != sign {
+                return false;
+            }
+        }
+        true
+    }
+
+    /// Smallest interior angle, in degrees. Highly skewed quads are usually
+    /// clutter rather than a tag seen at a steep angle.
+    pub fn min_interior_angle_deg(&self) -> f64 {
+        let mut min = 180.0f64;
+        for i in 0..4 {
+            let prev = self.corners[(i + 3) % 4];
+            let cur = self.corners[i];
+            let next = self.corners[(i + 1) % 4];
+            let a = prev.sub(cur);
+            let b = next.sub(cur);
+            let denom = a.norm() * b.norm();
+            if denom < 1e-12 {
+                return 0.0;
+            }
+            let ang = (a.dot(b) / denom).clamp(-1.0, 1.0).acos().to_degrees();
+            min = min.min(ang);
+        }
+        min
+    }
+
+    /// Reorders the corners so the winding is counter-clockwise.
+    fn make_ccw(&mut self) {
+        if signed_area(&self.corners) < 0.0 {
+            self.corners.reverse();
+        }
+    }
+}
+
+/// Acceptance thresholds for a candidate quad.
+#[derive(Clone, Copy, Debug)]
+pub struct QuadParams {
+    /// Shortest permitted side, in pixels.
+    pub min_side_px: f64,
+    /// Smallest permitted interior angle, in degrees.
+    pub min_angle_deg: f64,
+    /// Minimum ratio between the quad area and its hull area. A tag outline is
+    /// nearly all of its own hull; a blob that merely happens to be convex is
+    /// not.
+    pub min_hull_fill: f64,
+    /// Maximum ratio between the longest and shortest side.
+    pub max_side_ratio: f64,
+}
+
+impl Default for QuadParams {
+    fn default() -> Self {
+        Self {
+            // A 36h11 tag needs ~2 px per cell (8 cells) to decode at all.
+            min_side_px: 16.0,
+            min_angle_deg: 25.0,
+            min_hull_fill: 0.82,
+            max_side_ratio: 8.0,
+        }
+    }
+}
+
+/// Andrew's monotone chain convex hull. Returns hull points counter-clockwise.
+pub fn convex_hull(pts: &[Point2]) -> Vec<Point2> {
+    if pts.len() < 3 {
+        return pts.to_vec();
+    }
+    let mut p: Vec<Point2> = pts.to_vec();
+    p.sort_by(|a, b| a.x.partial_cmp(&b.x).unwrap().then(a.y.partial_cmp(&b.y).unwrap()));
+    p.dedup_by(|a, b| (a.x - b.x).abs() < 1e-12 && (a.y - b.y).abs() < 1e-12);
+    if p.len() < 3 {
+        return p;
+    }
+
+    let build = |src: &[Point2]| -> Vec<Point2> {
+        let mut chain: Vec<Point2> = Vec::with_capacity(src.len());
+        for &q in src {
+            while chain.len() >= 2 {
+                let a = chain[chain.len() - 2];
+                let b = chain[chain.len() - 1];
+                if b.sub(a).cross(q.sub(b)) <= 0.0 {
+                    chain.pop();
+                } else {
+                    break;
+                }
+            }
+            chain.push(q);
+        }
+        chain
+    };
+
+    let mut lower = build(&p);
+    let rev: Vec<Point2> = p.iter().rev().copied().collect();
+    let mut upper = build(&rev);
+    lower.pop();
+    upper.pop();
+    lower.append(&mut upper);
+    lower
+}
+
+/// Picks the four hull vertices spanning the largest area.
+///
+/// Every vertex pair is tried as a diagonal; for each, the farthest vertex on
+/// either side completes the quad. The hull of a tag outline is small (tens of
+/// vertices) so the quadratic scan is not a bottleneck.
+fn max_area_quad(hull: &[Point2]) -> Option<[usize; 4]> {
+    let n = hull.len();
+    if n < 4 {
+        return None;
+    }
+    let mut best = (0.0f64, [0usize; 4]);
+    for i in 0..n {
+        for k in (i + 2)..n {
+            // The diagonal i..k splits the hull into two chains.
+            let mut best_left = (0.0f64, usize::MAX);
+            for j in (i + 1)..k {
+                let area = triangle_area(hull[i], hull[j], hull[k]);
+                if area > best_left.0 {
+                    best_left = (area, j);
+                }
+            }
+            let mut best_right = (0.0f64, usize::MAX);
+            for j in (k + 1)..(n + i) {
+                let area = triangle_area(hull[i], hull[j % n], hull[k]);
+                if area > best_right.0 {
+                    best_right = (area, j % n);
+                }
+            }
+            if best_left.1 == usize::MAX || best_right.1 == usize::MAX {
+                continue;
+            }
+            let total = best_left.0 + best_right.0;
+            if total > best.0 {
+                best = (total, [i, best_left.1, k, best_right.1]);
+            }
+        }
+    }
+    if best.0 <= 0.0 { None } else { Some(best.1) }
+}
+
+fn triangle_area(a: Point2, b: Point2, c: Point2) -> f64 {
+    (b.sub(a).cross(c.sub(a)) * 0.5).abs()
+}
+
+/// Fits a quad to a boundary cluster, or returns `None` if the cluster does not
+/// look like a tag outline.
+pub fn fit_quad(cluster: &[BoundaryPoint], params: &QuadParams) -> Option<Quad> {
+    if cluster.len() < 8 {
+        return None;
+    }
+    let pts: Vec<Point2> = cluster
+        .iter()
+        .map(|p| {
+            let (x, y) = p.to_pixel();
+            Point2::new(x, y)
+        })
+        .collect();
+
+    let hull = convex_hull(&pts);
+    let hull_area = signed_area(&hull).abs();
+    if hull_area <= 0.0 {
+        return None;
+    }
+    let idx = max_area_quad(&hull)?;
+    let coarse = [hull[idx[0]], hull[idx[1]], hull[idx[2]], hull[idx[3]]];
+
+    let coarse_quad = Quad { corners: coarse };
+    // Reject early on the cheap checks so the line fitting below only runs on
+    // plausible candidates.
+    if coarse_quad.area() / hull_area < params.min_hull_fill {
+        return None;
+    }
+
+    let refined = refine_corners(&pts, &coarse).unwrap_or(coarse);
+    let mut quad = Quad { corners: refined };
+    quad.make_ccw();
+
+    if !quad.is_convex()
+        || quad.min_side() < params.min_side_px
+        || quad.min_interior_angle_deg() < params.min_angle_deg
+        || quad.max_side() / quad.min_side().max(1e-9) > params.max_side_ratio
+    {
+        return None;
+    }
+    Some(quad)
+}
+
+/// Re-derives the corners by fitting a line to each side and intersecting.
+fn refine_corners(pts: &[Point2], coarse: &[Point2; 4]) -> Option<[Point2; 4]> {
+    // Assign every boundary point to the side it lies closest to, but ignore
+    // points near a corner: those straddle two sides and would bend both fits.
+    let mut sides: [Vec<Point2>; 4] = [Vec::new(), Vec::new(), Vec::new(), Vec::new()];
+    for &p in pts {
+        let mut best = (f64::MAX, 0usize, 0.0f64);
+        for s in 0..4 {
+            let a = coarse[s];
+            let b = coarse[(s + 1) % 4];
+            let ab = b.sub(a);
+            let len2 = ab.dot(ab);
+            if len2 < 1e-12 {
+                continue;
+            }
+            let t = (p.sub(a).dot(ab) / len2).clamp(0.0, 1.0);
+            let proj = a.add(ab.scale(t));
+            let d = p.distance(proj);
+            if d < best.0 {
+                best = (d, s, t);
+            }
+        }
+        // Trim the outer 15% at each end of the side.
+        if best.2 > 0.15 && best.2 < 0.85 {
+            sides[best.1].push(p);
+        }
+    }
+
+    let mut lines: [Option<Line2>; 4] = [None; 4];
+    for s in 0..4 {
+        if sides[s].len() < 3 {
+            return None;
+        }
+        lines[s] = fit_line(&sides[s], None);
+    }
+
+    let mut out = [Point2::default(); 4];
+    for c in 0..4 {
+        // Corner c is where side (c-1) meets side c.
+        let prev = lines[(c + 3) % 4]?;
+        let cur = lines[c]?;
+        let p = prev.intersect(&cur)?;
+        // A refined corner that runs away from its coarse estimate means the
+        // side assignment was wrong; fall back rather than emit nonsense.
+        if p.distance(coarse[c]) > 0.25 * coarse[c].distance(coarse[(c + 1) % 4]).max(4.0) {
+            return None;
+        }
+        out[c] = p;
+    }
+    Some(out)
+}
+
+/// Snaps each side of `quad` onto the true intensity edge and re-intersects,
+/// giving corners accurate to a fraction of a pixel.
+///
+/// The quad from [`fit_quad`] is only as good as the binarised image it came
+/// from — half a pixel at best, and biased whenever the threshold sits off the
+/// true edge. Here we go back to the original greyscale: along each side we
+/// walk the edge normal, locate the edge to sub-pixel precision, and re-fit the
+/// line through those points weighted by edge contrast.
+pub fn refine_edges(img: &GrayImage, quad: &Quad, params: &RefineParams) -> Option<Quad> {
+    // Never search so far along the normal that we reach the tag's payload:
+    // the black border ring is only one cell wide, and a 36h11 tag is 8 cells
+    // across. Overshooting would snap the outline onto a data cell.
+    let cell = quad.min_side() / 8.0;
+    let radius = params.search_radius.min(cell * 0.5).max(params.step * 2.0);
+
+    let mut lines: [Option<Line2>; 4] = [None; 4];
+    for s in 0..4 {
+        let a = quad.corners[s];
+        let b = quad.corners[(s + 1) % 4];
+        let side_len = a.distance(b);
+        if side_len < 4.0 {
+            return None;
+        }
+        let dir = b.sub(a).scale(1.0 / side_len);
+        let normal = Point2::new(-dir.y, dir.x);
+
+        let n = params.samples_per_side.max(4);
+        let mut pts = Vec::with_capacity(n);
+        let mut weights = Vec::with_capacity(n);
+        for i in 0..n {
+            // Skip the ends: near a corner the two edges blur into each other.
+            let t = params.end_trim + (1.0 - 2.0 * params.end_trim) * (i as f64 / (n - 1) as f64);
+            let base = a.add(dir.scale(t * side_len));
+            if let Some((offset, strength)) = edge_offset(img, base, normal, radius, params) {
+                pts.push(base.add(normal.scale(offset)));
+                weights.push(strength);
+            }
+        }
+        if pts.len() < 4 {
+            return None;
+        }
+        lines[s] = fit_line(&pts, Some(&weights));
+    }
+
+    let mut corners = [Point2::default(); 4];
+    for c in 0..4 {
+        let prev = lines[(c + 3) % 4]?;
+        let cur = lines[c]?;
+        let p = prev.intersect(&cur)?;
+        // Refinement should nudge, not relocate. A large jump means the search
+        // locked onto a neighbouring feature.
+        if p.distance(quad.corners[c]) > params.max_shift_px {
+            return None;
+        }
+        corners[c] = p;
+    }
+    let mut refined = Quad { corners };
+    refined.make_ccw();
+    if !refined.is_convex() {
+        return None;
+    }
+    Some(refined)
+}
+
+/// Tuning for [`refine_edges`].
+#[derive(Clone, Copy, Debug)]
+pub struct RefineParams {
+    /// Points sampled along each side.
+    pub samples_per_side: usize,
+    /// Fraction of the side length ignored at each end.
+    pub end_trim: f64,
+    /// How far to search along the normal, in pixels. Automatically clamped so
+    /// the search cannot reach the tag's payload cells.
+    pub search_radius: f64,
+    /// Spacing of the samples along the normal, in pixels.
+    pub step: f64,
+    /// Minimum intensity swing across the normal for an edge to be believed.
+    pub min_contrast: f64,
+    /// Refinement further than this from the initial corner is treated as a
+    /// failure.
+    pub max_shift_px: f64,
+}
+
+impl Default for RefineParams {
+    fn default() -> Self {
+        Self {
+            samples_per_side: 24,
+            end_trim: 0.15,
+            search_radius: 2.5,
+            // Fine enough that linear interpolation between neighbouring
+            // samples tracks the edge ramp closely.
+            step: 0.25,
+            min_contrast: 20.0,
+            max_shift_px: 4.0,
+        }
+    }
+}
+
+/// Locates the intensity edge along `normal`, returning `(offset, contrast)`.
+///
+/// Uses the half-amplitude crossing rather than the gradient peak. For an edge
+/// blurred by pixel-area sampling the intensity profile is antisymmetric about
+/// the true edge position, so the point where it crosses the midpoint between
+/// its dark and bright plateaus is an unbiased estimate. A gradient peak, by
+/// contrast, sits on a plateau once the profile ramp is wider than the
+/// differencing window, and `argmax` then breaks the tie in a fixed direction —
+/// a systematic sub-pixel bias that no amount of line fitting removes.
+fn edge_offset(
+    img: &GrayImage,
+    base: Point2,
+    normal: Point2,
+    radius: f64,
+    params: &RefineParams,
+) -> Option<(f64, f64)> {
+    let steps = (radius / params.step).floor() as i32;
+    if steps < 2 {
+        return None;
+    }
+    let n = (2 * steps + 1) as usize;
+    let mut prof = Vec::with_capacity(n);
+    for k in -steps..=steps {
+        let p = base.add(normal.scale(k as f64 * params.step));
+        prof.push(img.sample_bilinear(p.x, p.y));
+    }
+
+    let lo = prof.iter().cloned().fold(f64::MAX, f64::min);
+    let hi = prof.iter().cloned().fold(f64::MIN, f64::max);
+    let contrast = hi - lo;
+    if contrast < params.min_contrast {
+        return None;
+    }
+    let mid = 0.5 * (lo + hi);
+
+    // Of all midpoint crossings, take the one nearest the starting estimate;
+    // others belong to different features.
+    let mut best: Option<(f64, f64)> = None;
+    for i in 0..n - 1 {
+        let (a, b) = (prof[i], prof[i + 1]);
+        if (a - mid) * (b - mid) > 0.0 {
+            continue;
+        }
+        let denom = b - a;
+        let frac = if denom.abs() < 1e-9 { 0.5 } else { (mid - a) / denom };
+        let d = (i as i32 - steps) as f64 * params.step + frac * params.step;
+        let dist = d.abs();
+        if best.is_none_or(|(_, bd)| dist < bd) {
+            best = Some((d, dist));
+        }
+    }
+    let (offset, _) = best?;
+    // A crossing pinned to the window edge means the real edge is outside it.
+    if offset.abs() >= radius - params.step {
+        return None;
+    }
+    Some((offset, contrast))
+}
