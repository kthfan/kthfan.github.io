+//! Pinhole camera model with radial-tangential distortion.
+//!
+//! Kept deliberately small: the detector only needs to convert between pixel
+//! coordinates and normalized image rays so the pose solver can work in a
+//! distortion-free space.
+
+use crate::geometry::{Point2, Point3};
+
+/// Lens distortion model.
+#[derive(Clone, Copy, Debug, PartialEq, Default)]
+pub enum Distortion {
+    /// An ideal lens.
+    #[default]
+    None,
+    /// Brown-Conrady radial-tangential, the OpenCV `(k1, k2, p1, p2, k3)`
+    /// ordering.
+    RadTan { k1: f64, k2: f64, p1: f64, p2: f64, k3: f64 },
+}
+
+/// Pinhole intrinsics plus distortion.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Camera {
+    pub fx: f64,
+    pub fy: f64,
+    pub cx: f64,
+    pub cy: f64,
+    pub distortion: Distortion,
+}
+
+impl Camera {
+    /// A distortion-free pinhole camera.
+    pub fn pinhole(fx: f64, fy: f64, cx: f64, cy: f64) -> Option<Self> {
+        if !(fx.is_finite() && fy.is_finite() && cx.is_finite() && cy.is_finite()) {
+            return None;
+        }
+        if fx.abs() < 1e-9 || fy.abs() < 1e-9 {
+            return None;
+        }
+        Some(Self { fx, fy, cx, cy, distortion: Distortion::None })
+    }
+
+    pub fn with_distortion(mut self, d: Distortion) -> Self {
+        self.distortion = d;
+        self
+    }
+
+    /// Applies distortion to a normalized image point.
+    pub fn distort(&self, x: f64, y: f64) -> (f64, f64) {
+        match self.distortion {
+            Distortion::None => (x, y),
+            Distortion::RadTan { k1, k2, p1, p2, k3 } => {
+                let r2 = x * x + y * y;
+                let radial = 1.0 + r2 * (k1 + r2 * (k2 + r2 * k3));
+                let dx = 2.0 * p1 * x * y + p2 * (r2 + 2.0 * x * x);
+                let dy = p1 * (r2 + 2.0 * y * y) + 2.0 * p2 * x * y;
+                (x * radial + dx, y * radial + dy)
+            }
+        }
+    }
+
+    /// Normalized image point -> pixel.
+    pub fn project_normalized(&self, x: f64, y: f64) -> Point2 {
+        let (dx, dy) = self.distort(x, y);
+        Point2::new(self.fx * dx + self.cx, self.fy * dy + self.cy)
+    }
+
+    /// Camera-frame 3D point -> pixel. `None` for points at or behind the
+    /// camera plane.
+    pub fn project_point(&self, p: Point3) -> Option<Point2> {
+        if p.z <= 1e-9 {
+            return None;
+        }
+        Some(self.project_normalized(p.x / p.z, p.y / p.z))
+    }
+
+    /// Pixel -> normalized, undistorted image point.
+    ///
+    /// The distortion model has no closed-form inverse, so this iterates. The
+    /// fixed point converges linearly, so the iteration count is set well past
+    /// the point where the residual stops mattering; the loop exits early once
+    /// it does.
+    pub fn unproject(&self, p: Point2) -> (f64, f64) {
+        let xd = (p.x - self.cx) / self.fx;
+        let yd = (p.y - self.cy) / self.fy;
+        if matches!(self.distortion, Distortion::None) {
+            return (xd, yd);
+        }
+        let (mut x, mut y) = (xd, yd);
+        for _ in 0..25 {
+            let (px, py) = self.distort(x, y);
+            let (ex, ey) = (xd - px, yd - py);
+            if ex.abs() < 1e-12 && ey.abs() < 1e-12 {
+                break;
+            }
+            x += ex;
+            y += ey;
+        }
+        (x, y)
+    }
+}
