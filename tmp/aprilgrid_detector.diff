++//! Tag family definition, rotation handling, and code lookup.
++
++use crate::tag_family_data as data;
++
++pub use data::{BORDER_CELLS, EDGE_CELLS};
++
++/// Result of matching a sampled code against the family.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct CodeMatch {
++    /// Index of the matching tag in the family.
++    pub id: u32,
++    /// Hamming distance between the observed and stored code.
++    pub hamming: u8,
++    /// Number of clockwise 90 degree rotations applied to the *observed* code
++    /// to bring it into the tag's canonical orientation.
++    pub rotation: u8,
++}
++
++/// The AprilTag 36h11 family.
++#[derive(Clone, Copy, Debug)]
++pub struct TagFamily {
++    codes: &'static [u64],
++    /// Data cells along one edge (6 for 36h11).
++    pub edge_cells: usize,
++    /// Black border cells drawn around the data area.
++    pub border_cells: usize,
++    /// Largest Hamming distance still accepted as a match.
++    pub max_hamming: u8,
++}
++
++impl Default for TagFamily {
++    fn default() -> Self {
++        Self::t36h11()
++    }
++}
++
++impl TagFamily {
++    /// The 36h11 family as drawn by `cv2.aruco.DICT_APRILTAG_36h11`.
++    ///
++    /// The family guarantees a minimum Hamming distance of 11, so up to 5 bit
++    /// errors are in principle correctable. The default cap is deliberately
++    /// much lower: every extra bit of correction multiplies the false-positive
++    /// rate across the hundreds of quads a cluttered frame produces, and a
++    /// wrong id is far more damaging to a calibration than a missed tag.
++    pub const fn t36h11() -> Self {
++        Self {
++            codes: &data::T36H11,
++            edge_cells: data::EDGE_CELLS,
++            border_cells: data::BORDER_CELLS,
++            max_hamming: 2,
++        }
++    }
++
++    /// Number of tags in the family.
++    pub const fn len(&self) -> usize {
++        self.codes.len()
++    }
++
++    pub const fn is_empty(&self) -> bool {
++        self.codes.is_empty()
++    }
++
++    /// Canonical code for `id`.
++    pub fn code(&self, id: u32) -> Option<u64> {
++        self.codes.get(id as usize).copied()
++    }
++
++    /// Total cells along one edge including the black border.
++    pub const fn side_cells(&self) -> usize {
++        self.edge_cells + 2 * self.border_cells
++    }
++
++    /// Mask covering the bits actually used by a code.
++    const fn mask(&self) -> u64 {
++        let bits = (self.edge_cells * self.edge_cells) as u32;
++        if bits >= 64 { u64::MAX } else { (1u64 << bits) - 1 }
++    }
++
++    /// Rotates a packed code 90 degrees clockwise.
++    ///
++    /// Cell `(r, c)` of the rotated grid is cell `(n - 1 - c, r)` of the
++    /// original, matching how a tag's appearance changes when the board is
++    /// turned clockwise in front of the camera.
++    pub fn rotate_cw(&self, code: u64) -> u64 {
++        let n = self.edge_cells;
++        let total = (n * n) as u32;
++        let mut out = 0u64;
++        for r in 0..n {
++            for c in 0..n {
++                let src = (n - 1 - c) * n + r;
++                if code >> (total - 1 - src as u32) & 1 == 1 {
++                    let dst = r * n + c;
++                    out |= 1 << (total - 1 - dst as u32);
++                }
++            }
++        }
++        out
++    }
