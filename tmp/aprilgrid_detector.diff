+"""What a test needs in order to run, and where it comes from.
+
+A :class:`Backend` bundles an arm, a camera and the geometry of the scene. The
+simulated and real backends differ in exactly two ways that the tests can see:
+
+* the simulator knows the true pose of everything, and exposes it through
+  :meth:`Backend.truth`; the real backend returns ``None`` and every test
+  simply omits the ground-truth column
+* the real backend is ``interactive`` -- motions are physical, so they are
+  gated on an operator keypress and cannot be run unattended
+
+Everything else -- detection, viewpoint planning, the pose chain -- is shared,
+so the three tests have one implementation each rather than two.
+"""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+
+import numpy as np
+
+from .camera import CameraModel
+from .config import Config
+from .robot import CameraSource, RobotArm
+
+__all__ = ["Backend", "Truth", "build"]
+
+
+class Truth(ABC):
+    """Ground truth. Only a simulator can answer these."""
+
+    @abstractmethod
+    def board_matrix(self, index: int = 0) -> np.ndarray:
+        """True ``T_base_board``."""
+
+    @abstractmethod
+    def tool_position(self, T_ee_tool) -> np.ndarray:
+        """True tool-tip position in the base frame."""
+
+    @abstractmethod
+    def moved(self) -> bool:
+        """True if any board has shifted since the backend was built."""
+
+
+class Backend(ABC):
+    """An arm, a camera, and the geometry they share."""
+
+    #: Physical motion, so every move needs an operator keypress.
+    interactive = False
+    name = "backend"
+
+    def __init__(self, cfg: Config):
+        self.cfg = cfg
+        #: Intrinsics as written down. Used directly by subclass ``__init__``,
+        #: which runs before :attr:`source` exists.
+        self._config_camera: CameraModel = cfg.camera()
+
+    @property
+    def camera_model(self) -> CameraModel:
+        """Intrinsics for the images the source is producing *now*.
+
+        The config stays authoritative unless the source insists otherwise,
+        which only a device with a variable lens does. Read it fresh rather
+        than caching it: the alternative is a detector quietly working from
+        the focal length of a lens position the camera has since left.
+        """
+        reported = self.source.intrinsics()
+        return self._config_camera if reported is None else reported
+
+    @property
+    @abstractmethod
+    def robot(self) -> RobotArm: ...
+
+    @property
+    @abstractmethod
+    def source(self) -> CameraSource: ...
+
+    def truth(self) -> Truth | None:
+        """Ground truth, when there is any. Real hardware has none."""
+        return None
+
+    def viewing_pose(self) -> np.ndarray:
+        """``T_base_cam`` the last image was actually taken from.
+
+        The simulator renders from the arm's *true* camera pose, so overlays
+        must be projected from there. A real rig has only the believed pose.
+        """
+        return self.robot.get_camera_matrix()
+
+    def close(self) -> None:
+        self.source.close()
+        self.robot.close()
+
+
+def build(cfg: Config, board_count: int = 1, rng=None) -> Backend:
+    """Construct the backend named by the config."""
+    if cfg.backend == "sim":
+        from ..sim.backend import SimBackend
+
+        return SimBackend(cfg, board_count=board_count, rng=rng)
+    if cfg.backend == "techman":
+        from ..drivers.techman import TechmanBackend
+
+        return TechmanBackend(cfg)
+    raise ValueError(f"unknown backend {cfg.backend!r}")
