+//! Board geometry: where each tag sits on the printed target.
+//!
+//! The layout mirrors `references/generate_aprilgrid.py`, which builds boards
+//! with `cv2.aruco.GridBoard`. Matching that convention exactly means object
+//! points from this module are directly comparable with OpenCV's, so a user can
+//! cross-check a pose against `cv2.aruco` without juggling frames.
+//!
+//! # Object frame
+//!
+//! Origin at the **top-left corner of the top-left tag**, `x` right, `y` down,
+//! `z` out of the board towards the camera's negative side (the board lies in
+//! `z = 0`). Units are metres.
+//!
+//! # Tag ids
+//!
+//! `generate_aprilgrid.py` assigns `ids = arange(tags_x * tags_y) + grid_id *
+//! tags_x * tags_y`, so a tag id determines both which board it belongs to and
+//! its slot on that board. Several boards may appear in one image; they are
+//! separated by board id.
+
+use std::collections::BTreeMap;
+
+use crate::decode::Detection;
+use crate::geometry::{Point2, Point3};
+
+/// Physical description of one AprilGrid board.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct BoardLayout {
+    /// Tags across (`markers_x`).
+    pub tags_x: usize,
+    /// Tags down (`markers_y`).
+    pub tags_y: usize,
+    /// Side length of a tag's black square, in metres (`marker_length`).
+    pub tag_size: f64,
+    /// Gap between neighbouring tags, in metres (`marker_separation`).
+    pub tag_separation: f64,
+}
+
+impl Default for BoardLayout {
+    /// The user's target: a 4x1 strip of 20 mm tags separated by 7.5 mm, which
+    /// are the defaults in `generate_aprilgrid.py`.
+    fn default() -> Self {
+        Self { tags_x: 4, tags_y: 1, tag_size: 0.020, tag_separation: 0.0075 }
+    }
+}
+
+impl BoardLayout {
+    /// Returns `None` for a layout that cannot describe a real board.
+    pub fn new(
+        tags_x: usize,
+        tags_y: usize,
+        tag_size: f64,
+        tag_separation: f64,
+    ) -> Option<Self> {
+        if tags_x == 0 || tags_y == 0 {
+            return None;
+        }
+        if !(tag_size.is_finite() && tag_size > 0.0) {
+            return None;
+        }
+        if !(tag_separation.is_finite() && tag_separation >= 0.0) {
+            return None;
+        }
+        Some(Self { tags_x, tags_y, tag_size, tag_separation })
+    }
+
+    /// Tags on one board.
+    pub fn tags_per_board(&self) -> usize {
+        self.tags_x * self.tags_y
+    }
+
+    /// Which board a tag id belongs to.
+    pub fn board_id(&self, tag_id: u32) -> u32 {
+        tag_id / self.tags_per_board() as u32
+    }
+
+    /// Position of a tag id within its board, row-major from the top-left.
+    pub fn slot(&self, tag_id: u32) -> usize {
+        tag_id as usize % self.tags_per_board()
+    }
+
+    /// Centre-to-centre distance between neighbouring tags.
+    pub fn pitch(&self) -> f64 {
+        self.tag_size + self.tag_separation
+    }
+
+    /// Overall printed size of the tag area (excluding the outer margin).
+    pub fn extent(&self) -> (f64, f64) {
+        let w = self.tags_x as f64 * self.tag_size
+            + (self.tags_x.saturating_sub(1)) as f64 * self.tag_separation;
+        let h = self.tags_y as f64 * self.tag_size
+            + (self.tags_y.saturating_sub(1)) as f64 * self.tag_separation;
+        (w, h)
+    }
+
+    /// The four object-space corners of the tag in `slot`, in the same order as
+    /// [`Detection::corners`]: top-left, top-right, bottom-right, bottom-left.
+    pub fn slot_corners(&self, slot: usize) -> Option<[Point3; 4]> {
+        if slot >= self.tags_per_board() {
+            return None;
+        }
+        let col = slot % self.tags_x;
+        let row = slot / self.tags_x;
+        let x0 = col as f64 * self.pitch();
+        let y0 = row as f64 * self.pitch();
+        let s = self.tag_size;
+        Some([
+            Point3::new(x0, y0, 0.0),
+            Point3::new(x0 + s, y0, 0.0),
+            Point3::new(x0 + s, y0 + s, 0.0),
+            Point3::new(x0, y0 + s, 0.0),
+        ])
+    }
+
+    /// Object-space corners for a tag id, or `None` if the id is not on a board
+    /// of this layout.
+    pub fn tag_corners(&self, tag_id: u32) -> Option<[Point3; 4]> {
+        self.slot_corners(self.slot(tag_id))
+    }
+}
+
+/// All detections belonging to one physical board, with matched 3D/2D points.
+#[derive(Clone, Debug, PartialEq)]
+pub struct BoardObservation {
+    pub board_id: u32,
+    /// Detections that make up this observation, sorted by tag id.
+    pub detections: Vec<Detection>,
+    /// Object points, four per detection, in detection order.
+    pub object_points: Vec<Point3>,
+    /// Matching image points.
+    pub image_points: Vec<Point2>,
+}
+
+impl BoardObservation {
+    /// Number of tags contributing to this observation.
+    pub fn tag_count(&self) -> usize {
+        self.detections.len()
+    }
+
+    /// Fraction of the board's tags that were seen.
+    pub fn coverage(&self, layout: &BoardLayout) -> f64 {
+        self.tag_count() as f64 / layout.tags_per_board() as f64
+    }
+}
+
+/// Groups detections into per-board observations.
+///
+/// Boards are returned sorted by id, and within a board the tags are sorted by
+/// id, so the output is deterministic regardless of detection order.
+pub fn group_by_board(dets: &[Detection], layout: &BoardLayout) -> Vec<BoardObservation> {
+    let mut by_board: BTreeMap<u32, Vec<Detection>> = BTreeMap::new();
+    for d in dets {
+        by_board.entry(layout.board_id(d.id)).or_default().push(*d);
+    }
+
+    by_board
+        .into_iter()
+        .map(|(board_id, mut detections)| {
+            detections.sort_by_key(|d| d.id);
+            let mut object_points = Vec::with_capacity(detections.len() * 4);
+            let mut image_points = Vec::with_capacity(detections.len() * 4);
+            for d in &detections {
+                // slot() is always in range, so this cannot fail.
+                let corners = layout.tag_corners(d.id).expect("slot derived from layout");
+                object_points.extend_from_slice(&corners);
+                image_points.extend_from_slice(&d.corners);
+            }
+            BoardObservation { board_id, detections, object_points, image_points }
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn det(id: u32) -> Detection {
+        Detection {
+            id,
+            hamming: 0,
+            corners: [Point2::default(); 4],
+            decision_margin: 50.0,
+        }
+    }
+
+    #[test]
+    fn default_layout_matches_the_reference_generator() {
+        let l = BoardLayout::default();
+        assert_eq!((l.tags_x, l.tags_y), (4, 1));
+        assert!((l.tag_size - 0.020).abs() < 1e-12);
+        assert!((l.tag_separation - 0.0075).abs() < 1e-12);
+    }
+
+    #[test]
+    fn degenerate_layouts_are_rejected() {
+        assert!(BoardLayout::new(0, 1, 0.02, 0.0).is_none());
+        assert!(BoardLayout::new(4, 0, 0.02, 0.0).is_none());
+        assert!(BoardLayout::new(4, 1, 0.0, 0.0).is_none());
+        assert!(BoardLayout::new(4, 1, -0.02, 0.0).is_none());
+        assert!(BoardLayout::new(4, 1, 0.02, -0.001).is_none());
+        assert!(BoardLayout::new(4, 1, f64::NAN, 0.0).is_none());
+        // Zero separation is a legitimate board.
+        assert!(BoardLayout::new(4, 1, 0.02, 0.0).is_some());
+    }
+
+    #[test]
+    fn tag_ids_map_to_boards_the_way_the_generator_assigns_them() {
+        let l = BoardLayout::default();
+        // generate_aprilgrid.py: ids = arange(4) + grid_id * 4
+        for grid_id in [0u32, 1, 6, 50] {
+            for slot in 0..4u32 {
+                let id = grid_id * 4 + slot;
+                assert_eq!(l.board_id(id), grid_id, "id {id}");
+                assert_eq!(l.slot(id), slot as usize, "id {id}");
+            }
+        }
+    }
+
+    #[test]
+    fn slot_corners_are_a_square_of_the_right_size_in_printed_order() {
+        let l = BoardLayout::default();
+        let c = l.slot_corners(0).unwrap();
+        assert_eq!(c[0], Point3::new(0.0, 0.0, 0.0));
+        assert_eq!(c[1], Point3::new(0.02, 0.0, 0.0));
+        assert_eq!(c[2], Point3::new(0.02, 0.02, 0.0));
+        assert_eq!(c[3], Point3::new(0.0, 0.02, 0.0));
+        // Flat board.
+        assert!(c.iter().all(|p| p.z == 0.0));
+    }
+
+    #[test]
+    fn neighbouring_tags_are_one_pitch_apart() {
+        let l = BoardLayout::default();
+        let a = l.slot_corners(0).unwrap();
+        let b = l.slot_corners(1).unwrap();
+        let expected = l.tag_size + l.tag_separation;
+        assert!((b[0].x - a[0].x - expected).abs() < 1e-12);
+        assert!((b[0].y - a[0].y).abs() < 1e-12, "a 4x1 strip must not step in y");
+    }
+
+    #[test]
+    fn slots_advance_row_major() {
+        let l = BoardLayout::new(3, 2, 0.02, 0.005).unwrap();
+        // Slot 3 is the start of the second row.
+        let s3 = l.slot_corners(3).unwrap();
+        assert!((s3[0].x - 0.0).abs() < 1e-12);
+        assert!((s3[0].y - 0.025).abs() < 1e-12);
+        assert!(l.slot_corners(6).is_none(), "out-of-range slot must be rejected");
+    }
+
+    #[test]
+    fn extent_covers_tags_and_the_gaps_between_them() {
+        let l = BoardLayout::default();
+        let (w, h) = l.extent();
+        // 4 tags + 3 gaps.
+        assert!((w - (4.0 * 0.02 + 3.0 * 0.0075)).abs() < 1e-12);
+        assert!((h - 0.02).abs() < 1e-12, "a single row is one tag tall");
+    }
+
+    #[test]
+    fn detections_are_split_by_board_id() {
+        let l = BoardLayout::default();
+        // Board 0 (ids 0..3) and board 6 (ids 24..27).
+        let dets = vec![det(25), det(1), det(24), det(3), det(0)];
+        let obs = group_by_board(&dets, &l);
+        assert_eq!(obs.len(), 2);
+        assert_eq!(obs[0].board_id, 0);
+        assert_eq!(obs[1].board_id, 6);
+        assert_eq!(obs[0].detections.iter().map(|d| d.id).collect::<Vec<_>>(), vec![0, 1, 3]);
+        assert_eq!(obs[1].detections.iter().map(|d| d.id).collect::<Vec<_>>(), vec![24, 25]);
+    }
+
+    #[test]
+    fn grouping_is_independent_of_detection_order() {
+        let l = BoardLayout::default();
+        let a = group_by_board(&[det(3), det(0), det(24)], &l);
+        let b = group_by_board(&[det(24), det(3), det(0)], &l);
+        assert_eq!(a, b);
+    }
+
+    #[test]
+    fn point_correspondences_are_four_per_tag_and_aligned() {
+        let l = BoardLayout::default();
+        let obs = group_by_board(&[det(0), det(2)], &l);
+        assert_eq!(obs.len(), 1);
+        let o = &obs[0];
+        assert_eq!(o.object_points.len(), 8);
+        assert_eq!(o.image_points.len(), 8);
+        // The second tag's object points must be those of slot 2.
+        let slot2 = l.slot_corners(2).unwrap();
+        assert_eq!(&o.object_points[4..8], &slot2[..]);
+    }
+
+    #[test]
+    fn coverage_reports_how_much_of_the_board_was_seen() {
+        let l = BoardLayout::default();
+        let obs = group_by_board(&[det(0), det(1)], &l);
+        assert!((obs[0].coverage(&l) - 0.5).abs() < 1e-12);
+        let full = group_by_board(&[det(0), det(1), det(2), det(3)], &l);
+        assert!((full[0].coverage(&l) - 1.0).abs() < 1e-12);
+    }
+
+    #[test]
+    fn tags_of_one_board_are_never_mixed_into_another() {
+        let l = BoardLayout::default();
+        // id 4 is the first tag of board 1, not the fifth tag of board 0.
+        let obs = group_by_board(&[det(3), det(4)], &l);
+        assert_eq!(obs.len(), 2);
+        assert_eq!(obs[0].board_id, 0);
+        assert_eq!(obs[1].board_id, 1);
+        assert_eq!(l.slot(4), 0);
+    }
+}
