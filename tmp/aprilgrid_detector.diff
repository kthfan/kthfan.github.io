+"""Regenerate the Techman gRPC stubs from the vendor ``.proto`` files.
+
+The generated modules are committed, so a normal run needs only ``grpcio``.
+Re-run this only when the vendor updates a ``.proto``::
+
+    python tools/robotlab/drivers/tm_proto/generate.py
+
+``protoc`` emits top-level imports (``import EIHCamera_pb2``) which only work
+if the output directory happens to be on ``sys.path``. They are rewritten to
+relative imports so the stubs behave like a normal package.
+"""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+PROTO_DIR = HERE.parents[3] / "references" / "techman" / "protobuf"
+FILES = ["robot.proto", "EIHCamera.proto", "EIHCameraAPI.proto"]
+
+
+def main() -> int:
+    if not PROTO_DIR.is_dir():
+        print(f"no proto directory at {PROTO_DIR}", file=sys.stderr)
+        return 1
+
+    cmd = [sys.executable, "-m", "grpc_tools.protoc", f"-I{PROTO_DIR}",
+           f"--python_out={HERE}", f"--grpc_python_out={HERE}",
+           *[str(PROTO_DIR / f) for f in FILES]]
+    print(" ".join(cmd))
+    result = subprocess.run(cmd)
+    if result.returncode != 0:
+        return result.returncode
+
+    stems = {Path(f).stem for f in FILES}
+    pattern = re.compile(
+        r"^import ((?:%s)_pb2) as (\w+)$" % "|".join(map(re.escape, sorted(stems))),
+        re.MULTILINE)
+    for path in sorted(HERE.glob("*_pb2*.py")):
+        text = path.read_text(encoding="utf-8")
+        fixed = pattern.sub(r"from . import \1 as \2", text)
+        if fixed != text:
+            path.write_text(fixed, encoding="utf-8")
+            print(f"rewrote imports in {path.name}")
+    print("done")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
