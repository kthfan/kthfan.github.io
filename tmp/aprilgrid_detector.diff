+"""Synthetic AprilGrid dataset generator.
+
+Renders a printed AprilGrid seen by a calibrated camera from known 6-DoF
+poses, applies a configurable stack of real-world degradations, and writes both
+the images and exact ground truth (pose + every tag corner in pixels).
+
+The board, the camera model and the rendering/degradation stack are *not*
+defined here -- they live in the ``robotlab`` package (``core.board``,
+``core.camera``, ``sim.render``) and are shared with the robot-arm bench, so
+both produce pixels from the same code. This file is only the pose sampler and
+the driver that writes a dataset out.
+
+The ground truth is computed analytically from the pose and intrinsics rather
+than read back from the rendering, so it stays exact no matter how badly the
+image is degraded. That is what makes it usable as an accuracy reference.
+
+Coordinate conventions match the Rust crate:
+  * object frame: origin at the top-left corner of the top-left tag,
+    x right, y down, z = 0, in metres
+  * image frame: pixel centres at integer coordinates
+  * corner order: top-left, top-right, bottom-right, bottom-left, as printed
+
+Usage:
+    python3 tools/simulate.py --out data/sim --count 200
+    python3 tools/simulate.py --out data/sim_easy --count 50 --preset easy
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import sys
+from dataclasses import dataclass, asdict
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+# Running this as a script puts tools/ on sys.path already; importing it from
+# somewhere else does not, so make the package reachable either way.
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from robotlab.core.board import Board            # noqa: E402
+from robotlab.core.camera import CameraModel     # noqa: E402
+from robotlab.sim import render                  # noqa: E402
+from robotlab.sim.render import Degradations     # noqa: E402
+
+__all__ = ["Board", "CameraModel", "Degradations", "PoseRanges", "generate"]
+
+# A plausible consumer lens. The dataset is only interesting if the detector
+# has to cope with real distortion.
+DEFAULT_DISTORTION = (-0.18, 0.04, 0.0004, -0.0003, -0.002)
+
+
+@dataclass
+class PoseRanges:
+    """Ranges the board pose is sampled from."""
+
+    distance: tuple[float, float] = (0.18, 0.85)     # metres along the optical axis
+    tilt_deg: tuple[float, float] = (0.0, 62.0)      # angle away from fronto-parallel
+    roll_deg: tuple[float, float] = (-180.0, 180.0)  # in-plane rotation
+    # Lateral offset as a fraction of the frame, per axis.
+    offset: tuple[float, float] = (-0.32, 0.32)
+
+
+# ---------------------------------------------------------------------------
+# Rendering
+# ---------------------------------------------------------------------------
+
+
+def _rodrigues(rvec: np.ndarray) -> np.ndarray:
+    return cv2.Rodrigues(rvec)[0]
+
+
+def sample_pose(rng: np.random.Generator, ranges: PoseRanges, cam: CameraModel,
+                board: Board) -> tuple[np.ndarray, np.ndarray]:
+    """Sample a random board pose as (rvec, tvec), object frame to camera."""
+    tilt = math.radians(rng.uniform(*ranges.tilt_deg))
+    azimuth = rng.uniform(0.0, 2.0 * math.pi)
+    roll = math.radians(rng.uniform(*ranges.roll_deg))
+
+    # Tilt about an axis lying in the image plane, then roll about the optic
+    # axis. This covers the whole viewing hemisphere uniformly in direction.
+    tilt_axis = np.array([math.cos(azimuth), math.sin(azimuth), 0.0]) * tilt
+    r = _rodrigues(np.array([0.0, 0.0, roll])) @ _rodrigues(tilt_axis)
+
+    z = rng.uniform(*ranges.distance)
+    bw, bh = board.extent
+    # Place the board centre, then convert to the origin-corner translation.
+    cx_off = rng.uniform(*ranges.offset) * z * cam.width / cam.fx
+    cy_off = rng.uniform(*ranges.offset) * z * cam.height / cam.fy
+    centre = np.array([cx_off, cy_off, z])
+    t = centre - r @ np.array([bw / 2.0, bh / 2.0, 0.0])
+    return cv2.Rodrigues(r)[0].ravel(), t
+
+
+def render_frame(board: Board, sheet: np.ndarray, ppm: float, cam: CameraModel,
+                 rvec, tvec, rng: np.random.Generator, deg: Degradations,
+                 background: int = 210):
+    """Render one degraded frame plus its exact ground truth."""
+    h_sheet = render.sheet_homography(board, ppm, rvec, tvec, cam)
+    canvas = np.full((cam.height, cam.width), background, np.uint8)
+    warped = cv2.warpPerspective(
+        sheet, h_sheet, (cam.width, cam.height),
+        flags=cv2.INTER_AREA, borderMode=cv2.BORDER_TRANSPARENT, dst=canvas,
+    )
+    # Bend the ideal render through the lens model.
+    maps = render.distortion_maps(cam)
+    warped = cv2.remap(warped, maps[0], maps[1], cv2.INTER_LINEAR,
+                       borderMode=cv2.BORDER_REPLICATE)
+
+    n = board.tag_count
+    img_pts = render.project(board.all_corners(), rvec, tvec, cam)
+
+    occ = render.add_occlusion(warped, rng, deg, img_pts)
+    degraded, applied = render.degrade(warped, rng, deg)
+
+    tags = []
+    for i in range(n):
+        c = img_pts[4 * i:4 * i + 4]
+        entry = {
+            "id": board.start_id + i,
+            "corners": [[float(x), float(y)] for x, y in c],
+            "object_corners": board.tag_corners(i).tolist(),
+            "visible": render.visible(c, cam),
+        }
+        if occ:
+            ox, oy = occ["center"]
+            # A tag counts as occluded when the blob touches its quad at all,
+            # not merely when it covers the centre. An occluder clipping one
+            # corner erases part of the outline, which makes the tag genuinely
+            # undetectable; scoring it as a miss blames the detector for
+            # missing something that is not there. (Measured: a centre-only
+            # test mislabelled 16 of 46 blob-frame tags as detectable, and
+            # every large, sharp, "unexplained" miss turned out to be one.)
+            entry["occluded"] = render.disc_touches_quad(c, ox, oy, occ["radius"])
+        else:
+            entry["occluded"] = False
+        tags.append(entry)
+
+    r = _rodrigues(np.asarray(rvec, np.float64).reshape(3, 1))
+    truth = {
+        "rvec": [float(v) for v in np.asarray(rvec).ravel()],
+        "tvec": [float(v) for v in np.asarray(tvec).ravel()],
+        "rotation": r.tolist(),
+        "distance": float(np.linalg.norm(tvec)),
+        "tags": tags,
+        "degradations": applied,
+        "occlusion": occ or None,
+    }
+    return degraded, truth
+
+
+# ---------------------------------------------------------------------------
+# Dataset driver
+# ---------------------------------------------------------------------------
+
+
+PRESETS = {
+    "easy": Degradations.easy,
+    "normal": Degradations,
+    "hard": Degradations.hard,
+}
+
+
+def generate(out_dir: str, count: int, seed: int, preset: str,
+             board: Board, cam: CameraModel, ranges: PoseRanges,
+             min_visible_tags: int = 1) -> dict:
+    os.makedirs(os.path.join(out_dir, "images"), exist_ok=True)
+    rng = np.random.default_rng(seed)
+    deg = PRESETS[preset]()
+    sheet, ppm = board.render()
+
+    n = board.tag_count
+    obj = board.all_corners()
+    frames = []
+    attempts = 0
+    while len(frames) < count:
+        attempts += 1
+        if attempts > count * 50:
+            raise RuntimeError(
+                "could not sample enough on-screen poses; loosen PoseRanges"
+            )
+        rvec, tvec = sample_pose(rng, ranges, cam, board)
+        # Reject poses that put the board off-screen or edge-on before paying
+        # for a render.
+        pts = render.project(obj, rvec, tvec, cam)
+        if not np.isfinite(pts).all():
+            continue
+        visible = sum(
+            render.visible(pts[4 * i:4 * i + 4], cam) for i in range(n)
+        )
+        if visible < min_visible_tags:
+            continue
+
+        img, truth = render_frame(board, sheet, ppm, cam, rvec, tvec, rng, deg)
+        name = f"{len(frames):05d}.png"
+        cv2.imwrite(os.path.join(out_dir, "images", name), img)
+        truth["image"] = f"images/{name}"
+        frames.append(truth)
+
+    meta = {
+        "preset": preset,
+        "seed": seed,
+        "board": asdict(board),
+        "camera": {
+            "width": cam.width,
+            "height": cam.height,
+            "fx": cam.fx,
+            "fy": cam.fy,
+            "cx": cam.cx,
+            "cy": cam.cy,
+            "distortion": list(cam.dist),
+        },
+        "pose_ranges": asdict(ranges),
+        "frames": frames,
+    }
+    with open(os.path.join(out_dir, "ground_truth.json"), "w") as f:
+        json.dump(meta, f, indent=1)
+    return meta
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--out", required=True, help="output directory")
+    ap.add_argument("--count", type=int, default=100, help="number of frames")
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--preset", choices=sorted(PRESETS), default="normal")
+    ap.add_argument("--width", type=int, default=1920)
+    ap.add_argument("--height", type=int, default=1080)
+    ap.add_argument("--tags-x", type=int, default=4)
+    ap.add_argument("--tags-y", type=int, default=1)
+    ap.add_argument("--tag-size", type=float, default=0.020)
+    ap.add_argument("--tag-separation", type=float, default=0.0075)
+    ap.add_argument("--start-id", type=int, default=0)
+    ap.add_argument("--no-distortion", action="store_true")
+    ap.add_argument("--min-visible-tags", type=int, default=1,
+                    help="reject poses showing fewer fully on-screen tags")
+    args = ap.parse_args()
+
+    board = Board(
+        tags_x=args.tags_x,
+        tags_y=args.tags_y,
+        tag_size=args.tag_size,
+        tag_separation=args.tag_separation,
+        start_id=args.start_id,
+    )
+    cam = CameraModel(
+        width=args.width, height=args.height, fx=1400.0, fy=1400.0,
+        dist=(0.0,) * 5 if args.no_distortion else DEFAULT_DISTORTION,
+    )
+
+    meta = generate(args.out, args.count, args.seed, args.preset, board, cam,
+                    PoseRanges(), args.min_visible_tags)
+    n_tags = sum(len(f["tags"]) for f in meta["frames"])
+    print(f"wrote {len(meta['frames'])} frames ({n_tags} tags) to {args.out}")
+
+
+if __name__ == "__main__":
+    main()
