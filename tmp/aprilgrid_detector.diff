@@ -0,0 +1,66 @@
+"""Entry point for the robot-arm test bench.
+
+    python tools/robotlab/run.py probe            --backend techman --arm
+    python tools/robotlab/run.py reproducibility  --samples 30
+    python tools/robotlab/run.py consistency      --backend techman
+    python tools/robotlab/run.py touch            --rounds 5 --show
+    python tools/robotlab/run.py transforms
+
+``--backend`` picks ``configs/<name>.yaml``; the tests themselves are the same
+code either way. On a real arm ``--auto`` is refused: every motion is
+physical and needs a human to approve it.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from robotlab.tests import (consistency, probe, reproducibility,  # noqa: E402
+                            test_transforms, touch)
+from robotlab.tests._common import add_ensemble_args  # noqa: E402
+
+TESTS = {
+    "probe": probe,
+    "reproducibility": reproducibility,
+    "consistency": consistency,
+    "touch": touch,
+}
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = p.add_subparsers(dest="test", required=True)
+
+    for name, module in TESTS.items():
+        q = sub.add_parser(name, description=module.__doc__,
+                           formatter_class=argparse.RawDescriptionHelpFormatter)
+        q.add_argument("--backend", default="sim",
+                       help="which configs/<name>.yaml to run against")
+        q.add_argument("--config", help="YAML file overriding the backend config")
+        q.add_argument("--seed", type=int)
+        q.add_argument("--show", action="store_true",
+                       help="display frames in a window")
+        q.add_argument("--save-images", action="store_true",
+                       help="write a PNG for every viewpoint, not just failures")
+        if name != "probe":
+            add_ensemble_args(q)
+        module.add_args(q)
+        if name != "probe":
+            q.add_argument("--auto", action="store_true",
+                           help="run unattended (refused on a real robot)")
+        q.set_defaults(_run=module.run)
+
+    sub.add_parser("transforms", description=test_transforms.__doc__).set_defaults(
+        _run=lambda _args: test_transforms.main())
+
+    args = p.parse_args()
+    return args._run(args)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
