+"""Attribute missed detections to a cause.
+
+The size breakdown says the misses are concentrated on small tags, but
+"small" and "blurred" are confounded in the dataset: distant boards are both
+smaller on screen and, because the simulator samples blur independently, may
+also be smeared. This cross-tabulates the detection rate against the
+degradation actually recorded for each frame so the two can be told apart.
+
+The point is to decide *where* to spend effort. If misses track motion blur,
+no amount of quad-fitting tolerance will help and the answer is a different
+front end. If they track size at low blur, the pipeline is giving up early.
+
+    python3 tools/diagnose.py --data data/sim_normal [--decimate N]
+"""
+
+import argparse
+import json
+import math
+import os
+
+import cv2
+import numpy as np
+
+import aprilgrid_detector as agd
+
+from evaluate import apparent_size
+
+
+def _bucket(value, edges):
+    """Index of the bucket `value` falls into, saturating at the last one."""
+    for i in range(len(edges) - 1):
+        if value < edges[i + 1]:
+            return i
+    return len(edges) - 2
+
+
+def _table(title, edges, unit, counts, found):
+    print(f"\n{title}")
+    for i in range(len(edges) - 1):
+        n = counts[i]
+        if n == 0:
+            continue
+        lo, hi = edges[i], edges[i + 1]
+        span = f"{lo:g}-{hi:g}" if hi < 1e8 else f">{lo:g}"
+        print(f"  {span:>12} {unit}  n={n:<5} {100.0 * found[i] / n:6.2f}%")
+
+
+def diagnose(data_dir, detector, decimate):
+    with open(os.path.join(data_dir, "ground_truth.json")) as f:
+        meta = json.load(f)
+
+    size_edges = [0, 20, 25, 30, 40, 60, 1e9]
+    blur_edges = [0.0, 0.3, 0.6, 1.0, 1.4, 1e9]
+    motion_edges = [0.0, 1.0, 2.0, 4.0, 7.0, 1e9]
+
+    n_size = [0] * (len(size_edges) - 1)
+    f_size = [0] * (len(size_edges) - 1)
+    n_blur = [0] * (len(blur_edges) - 1)
+    f_blur = [0] * (len(blur_edges) - 1)
+    n_motion = [0] * (len(motion_edges) - 1)
+    f_motion = [0] * (len(motion_edges) - 1)
+
+    # The decisive cell: tags that are BIG and SHARP. Anything missed here is
+    # squarely our fault and cannot be blamed on the image.
+    big_sharp_n = big_sharp_found = 0
+    # ...and the converse, to size the irreducible part of the problem.
+    small_or_smeared_n = small_or_smeared_found = 0
+    misses = []
+
+    for frame in meta["frames"]:
+        img = cv2.imread(os.path.join(data_dir, frame["image"]), cv2.IMREAD_GRAYSCALE)
+        found_ids = {d.id for d in detector.detect(img)}
+
+        deg = frame.get("degradations", {}) or {}
+        blur = float(deg.get("blur_sigma", 0.0))
+        motion = float(deg.get("motion_px", 0.0))
+
+        for tag in frame["tags"]:
+            if not tag["visible"] or tag["occluded"]:
+                continue
+            size = apparent_size(tag["corners"])
+            hit = tag["id"] in found_ids
+
+            for edges, n, fnd, v in (
+                (size_edges, n_size, f_size, size),
+                (blur_edges, n_blur, f_blur, blur),
+                (motion_edges, n_motion, f_motion, motion),
+            ):
+                b = _bucket(v, edges)
+                n[b] += 1
+                fnd[b] += hit
+
+            sharp = blur <= 0.6 and motion <= 2.0
+            if size >= 40 and sharp:
+                big_sharp_n += 1
+                big_sharp_found += hit
+                if not hit:
+                    rvec = np.asarray(frame["rvec"], float)
+                    # Angle between the board normal and the optical axis.
+                    r, _ = cv2.Rodrigues(rvec)
+                    tilt = math.degrees(math.acos(min(1.0, abs(r[2, 2]))))
+                    misses.append({
+                        "image": frame["image"],
+                        "id": tag["id"],
+                        "size": size,
+                        "blur": blur,
+                        "motion": motion,
+                        "tilt": tilt,
+                        "distance": frame["distance"],
+                    })
+            else:
+                small_or_smeared_n += 1
+                small_or_smeared_found += hit
+
+    print(f"dataset {data_dir}  decimate={decimate}")
+    _table("rate by apparent size", size_edges, "px", n_size, f_size)
+    _table("rate by gaussian blur sigma", blur_edges, "  ", n_blur, f_blur)
+    _table("rate by motion blur", motion_edges, "px", n_motion, f_motion)
+
+    print("\nthe decisive split:")
+    for label, n, fnd in (
+        (">=40 px and sharp", big_sharp_n, big_sharp_found),
+        ("small or smeared", small_or_smeared_n, small_or_smeared_found),
+    ):
+        rate = 100.0 * fnd / n if n else float("nan")
+        print(f"  {label:<20} n={n:<5} {rate:6.2f}%")
+
+    if misses:
+        # These are the indefensible failures: big, sharp, unoccluded tags.
+        # Listing them individually is the only way to tell a systematic
+        # pipeline bug from a handful of unlucky frames.
+        print("\nmissed despite being big and sharp:")
+        for m in misses:
+            print(
+                f"  {m['image']}  id={m['id']:<3} size={m['size']:6.1f} px"
+                f"  blur={m['blur']:.2f}  motion={m['motion']:.1f}"
+                f"  tilt={m['tilt']:5.1f} deg  dist={m['distance']:.3f} m"
+            )
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", default="data/sim_normal")
+    ap.add_argument("--decimate", type=int, default=1)
+    args = ap.parse_args()
+
+    detector = agd.Detector(decimate=args.decimate)
+    diagnose(args.data, detector, args.decimate)
+
+
+if __name__ == "__main__":
+    main()
