++/// Tuning for [`refine_edges`].
++#[derive(Clone, Copy, Debug)]
++pub struct RefineParams {
++    /// Points sampled along each side.
++    pub samples_per_side: usize,
++    /// Fraction of the side length ignored at each end.
++    pub end_trim: f64,
++    /// How far to search along the normal, in pixels. Automatically clamped so
++    /// the search cannot reach the tag's payload cells.
++    pub search_radius: f64,
++    /// Spacing of the samples along the normal, in pixels.
++    pub step: f64,
++    /// Minimum intensity swing across the normal for an edge to be believed.
++    pub min_contrast: f64,
++    /// Refinement further than this from the initial corner is treated as a
++    /// failure.
++    pub max_shift_px: f64,
++}
++
++impl Default for RefineParams {
++    fn default() -> Self {
++        Self {
++            samples_per_side: 24,
++            end_trim: 0.15,
++            search_radius: 2.5,
++            // Fine enough that linear interpolation between neighbouring
++            // samples tracks the edge ramp closely.
++            step: 0.25,
++            min_contrast: 20.0,
++            max_shift_px: 4.0,
++        }
++    }
++}
++
++/// Locates the intensity edge along `normal`, returning `(offset, contrast)`.
++///
++/// Uses the half-amplitude crossing rather than the gradient peak. For an edge
++/// blurred by pixel-area sampling the intensity profile is antisymmetric about
++/// the true edge position, so the point where it crosses the midpoint between
++/// its dark and bright plateaus is an unbiased estimate. A gradient peak, by
++/// contrast, sits on a plateau once the profile ramp is wider than the
++/// differencing window, and `argmax` then breaks the tie in a fixed direction —
++/// a systematic sub-pixel bias that no amount of line fitting removes.
++fn edge_offset(
++    img: &GrayImage,
++    base: Point2,
++    normal: Point2,
++    radius: f64,
++    params: &RefineParams,
++) -> Option<(f64, f64)> {
++    let steps = (radius / params.step).floor() as i32;
++    if steps < 2 {
++        return None;
++    }
++    let n = (2 * steps + 1) as usize;
++    let mut prof = Vec::with_capacity(n);
++    for k in -steps..=steps {
++        let p = base.add(normal.scale(k as f64 * params.step));
++        prof.push(img.sample_bilinear(p.x, p.y));
++    }
++
++    let lo = prof.iter().cloned().fold(f64::MAX, f64::min);
++    let hi = prof.iter().cloned().fold(f64::MIN, f64::max);
++    let contrast = hi - lo;
++    if contrast < params.min_contrast {
++        return None;
++    }
++    let mid = 0.5 * (lo + hi);
++
++    // Of all midpoint crossings, take the one nearest the starting estimate;
++    // others belong to different features.
++    let mut best: Option<(f64, f64)> = None;
++    for i in 0..n - 1 {
++        let (a, b) = (prof[i], prof[i + 1]);
++        if (a - mid) * (b - mid) > 0.0 {
++            continue;
++        }
++        let denom = b - a;
++        let frac = if denom.abs() < 1e-9 { 0.5 } else { (mid - a) / denom };
++        let d = (i as i32 - steps) as f64 * params.step + frac * params.step;
++        let dist = d.abs();
++        if best.is_none_or(|(_, bd)| dist < bd) {
++            best = Some((d, dist));
++        }
++    }
++    let (offset, _) = best?;
++    // A crossing pinned to the window edge means the real edge is outside it.
++    if offset.abs() >= radius - params.step {
++        return None;
++    }
++    Some((offset, contrast))
++}
