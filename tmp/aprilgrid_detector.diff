index 0000000..02f8014
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/tests/consistency.py"
@@ -0,0 +1,160 @@
+"""Consistency test: two grids, one known relative transform.
+
+Two AprilGrids are mounted rigidly to each other, so ``T_grid1_grid2`` is fixed
+and known from the mounting -- a number you measure once with callipers, not a
+simulation privilege. Both appear in the same image, both are detected
+independently, and the transform between them is recomputed from the two
+detections::
+
+    T_grid1_grid2 = inv(T_cam_grid1) @ T_cam_grid2
+
+Comparing that with the known value asks a different question from the
+reproducibility test: not "does the answer wander?" but "is the answer right?".
+It is also the one test here that involves no robot at all -- both poses come
+from the same frame, so the arm's pose and the hand-eye calibration cancel out
+exactly. A large error here is the detector or the camera model, nothing else.
+
+    python tools/robotlab/run.py consistency --samples 30
+    python tools/robotlab/run.py consistency --backend techman
+"""
+
+from __future__ import annotations
+
+import math
+
+from ._common import GO, QUIT, Session, common_args, fmt_pose, np, open_session, tf
+from robotlab.core.metrics import rotation_stats, translation_stats
+
+
+def run(args) -> int:
+    session = open_session(args, board_count=2)
+    n = args.samples if args.samples is not None else int(
+        session.cfg.tests["consistency_samples"])
+    try:
+        return _measure(session, args, n)
+    finally:
+        session.close()
+
+
+def _measure(session: Session, args, n: int) -> int:
+    cfg, bench = session.cfg, session.bench
+
+    # The mounting, measured off the rig. Both backends get it the same way.
+    T_true = cfg.pose("scene", "T_grid_grid2")
+
+    estimates = session.start_view(board_count=2, what="both AprilGrids")
+    bench.save("00_start_view", bench.capture())
+
+    id1, id2 = cfg.board_ids(2)
+    T_base_grid_rough = estimates[id1]
+    centre = bench.centre_frame(T_base_grid_rough, board_count=2)
+    accept = bench.visibility_from_estimate(T_base_grid_rough, board_count=2)
+
+    print(f"known    T_grid1_grid2 = {fmt_pose(T_true)}")
+    print(f"first look             = "
+          f"{fmt_pose(tf.invert(estimates[id1]) @ estimates[id2])}")
+
+    rel, records, misses, skipped = [], [], 0, 0
+    print(f"\n{'#':>3}  {'r(m)':>5} {'theta':>6} {'phi':>6}  {'cov0':>5} {'cov1':>5}  "
+          f"{'dt(mm)':>7} {'dR(deg)':>8}  {'|d|err(mm)':>10}")
+    for i in range(n):
+        vp = session.sampler.sample(centre, accept)
+        answer = session.goto(vp.T_base_cam, f"viewpoint {i + 1}/{n}")
+        if answer is QUIT:
+            print("  stopped by operator")
+            break
+        if answer is not GO:
+            skipped += 1
+            continue
+
+        frame, boards = bench.observe_all()
+        if id1 not in boards or id2 not in boards:
+            misses += 1
+            print(f"{i:>3}  {vp.radius_m:5.3f} {vp.theta_deg:6.1f} {vp.phi_deg:6.1f}  "
+                  f"only board(s) {sorted(boards)} detected")
+            bench.save(f"miss_{i:03d}", frame)
+            continue
+
+        T_est = (tf.invert(bench.board_transform(boards[id1]))
+                 @ bench.board_transform(boards[id2]))
+        d_t, d_r = tf.pose_error(T_est, T_true)
+        # Separated out because a pure distance error means a scale problem
+        # (focal length, tag size), while the full translation error also
+        # picks up a rotated baseline.
+        d_len = abs(np.linalg.norm(T_est[:3, 3]) - np.linalg.norm(T_true[:3, 3]))
+
+        rel.append(T_est)
+        records.append({**vp.params(),
+                        "coverage": [boards[id1].coverage, boards[id2].coverage],
+                        "T_grid1_grid2": tf.matrix_to_pose(T_est),
+                        "translation_error_mm": d_t * 1e3,
+                        "rotation_error_deg": math.degrees(d_r),
+                        "distance_error_mm": d_len * 1e3})
+        print(f"{i:>3}  {vp.radius_m:5.3f} {vp.theta_deg:6.1f} {vp.phi_deg:6.1f}  "
+              f"{boards[id1].coverage:5.2f} {boards[id2].coverage:5.2f}  "
+              f"{d_t * 1e3:7.3f} {math.degrees(d_r):8.3f}  {d_len * 1e3:10.3f}")
+        if args.save_images:
+            bench.save(f"view_{i:03d}", frame)
+        bench.display("consistency", frame)
+
+    truth = session.truth
+    if truth is not None:
+        assert not truth.moved(), "an AprilGrid moved during the test"
+
+    if not rel:
+        print("\nboth grids were never detected in the same frame")
+        return 1
+
+    errs = np.array([[r["translation_error_mm"], r["rotation_error_deg"]]
+                     for r in records])
+    est = np.stack(rel)
+    spread_t = translation_stats(est[:, :3, 3])
+    spread_r = rotation_stats(est[:, :3, :3])
+    mean_est = tf.rt_to_matrix(spread_r["mean_rotation"], spread_t["mean_m"])
+
+    print("\n" + "=" * 74)
+    print(f"consistency of T_grid1_grid2 over {len(rel)} viewpoints "
+          f"({misses} missed, {skipped} skipped)")
+    print("=" * 74)
+    print(f"  known               {fmt_pose(T_true)}")
+    print(f"  mean estimate       {fmt_pose(mean_est)}")
+    print(f"  translation error   {errs[:, 0].mean():.3f} mm mean, "
+          f"{errs[:, 0].max():.3f} mm max")
+    print(f"  rotation error      {errs[:, 1].mean():.3f} deg mean, "
+          f"{errs[:, 1].max():.3f} deg max")
+    print(f"  spread of estimate  {spread_t['rms_mm']:.3f} mm rms, "
+          f"{spread_r['rms_deg']:.3f} deg rms")
+
+    bench.write_json("consistency", {
+        "backend": session.backend.name, "seed": session.seed,
+        "samples": n, "misses": misses, "skipped": skipped,
+        "known_T_grid1_grid2": tf.matrix_to_pose(T_true),
+        "mean_T_grid1_grid2": tf.matrix_to_pose(mean_est),
+        "translation_error_mm": {"mean": float(errs[:, 0].mean()),
+                                 "max": float(errs[:, 0].max())},
+        "rotation_error_deg": {"mean": float(errs[:, 1].mean()),
+                               "max": float(errs[:, 1].max())},
+        "spread_mm_rms": spread_t["rms_mm"], "spread_deg_rms": spread_r["rms_deg"],
+        "views": records,
+    })
+    if bench.out_dir:
+        print(f"  wrote {bench.out_dir}")
+    return 0
+
+
+def add_args(p):
+    p.add_argument("--samples", type=int, help="number of viewpoints")
+    p.add_argument("--out", default="data/robotlab/consistency",
+                   help="directory for images and the JSON summary")
+    return p
+
+
+def main() -> int:
+    p = add_args(common_args(__doc__.splitlines()[0]))
+    p.add_argument("--auto", action="store_true",
+                   help="run unattended (simulation only)")
+    return run(p.parse_args())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
