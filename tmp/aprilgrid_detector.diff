++
++    #[test]
++    fn the_estimated_rotation_is_a_proper_rotation() {
++        let truth = pose_from(0.5, -0.4, 0.9, [0.02, 0.01, 0.33]);
++        let (obj, img) = synth(&truth, &cam());
