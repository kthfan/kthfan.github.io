++    let mut decimate = 1usize;
++    let argv: Vec<String> = std::env::args().skip(1).collect();
++    let mut i = 0;
++    while i < argv.len() {
++        if argv[i] == "--decimate" {
++            i += 1;
++            decimate = argv[i].parse().expect("--decimate needs a number");
++        } else {
++            paths.push(argv[i].clone());
++        }
++        i += 1;
++    }
++    if paths.is_empty() {
++        eprintln!("usage: profile <image>... [--decimate N]");
++        std::process::exit(2);
++    }
++
++    let params = DetectorParams { decimate, ..DetectorParams::default() };
++    let detector = Detector::t36h11();
++    let family = detector.family();
++    let mut s = Stages::default();
++
++    for path in &paths {
++        let img = image::open(path).expect("failed to open image").to_luma8();
++        let (w, h) = (img.width() as usize, img.height() as usize);
++        let img = GrayImage::from_vec(w, h, img.into_raw()).expect("bad image");
++
++        let t_all = Instant::now();
++
++        let t = Instant::now();
++        let decimated;
++        let search: &GrayImage = if decimate > 1 {
++            decimated = img.decimate(decimate);
++            &decimated
++        } else {
++            &img
++        };
++        s.decimate += ms(t);
++
++        let t = Instant::now();
++        let bin = adaptive_threshold(search, params.min_contrast);
++        s.threshold += ms(t);
++
++        let t = Instant::now();
++        let clusters = boundary_clusters(&bin, params.min_cluster_size);
++        s.cluster += ms(t);
++        s.clusters += clusters.len();
++
++        let search_quad = QuadParams {
++            min_side_px: params.quad.min_side_px / decimate as f64,
++            ..params.quad
++        };
++
++        // Run the per-cluster stages serially so the timings are comparable;
++        // the shipped detector fans these out across rayon.
++        let mut quads = Vec::new();
++        let t = Instant::now();
