++/// Accumulated wall time per stage, in milliseconds.
++#[derive(Default)]
++struct Stages {
++    decimate: f64,
++    threshold: f64,
++    cluster: f64,
++    quad: f64,
++    refine: f64,
++    decode: f64,
++    total: f64,
++    frames: usize,
++    clusters: usize,
++    quads: usize,
++    detections: usize,
++}
