+//! Stage-by-stage timing of the detection pipeline.
+//!
+//! Guessing at the bottleneck has been unproductive: two plausible
+//! optimisations landed with very different payoffs (a 25% win from the
+//! boundary-cluster area filter, nothing measurable from rewriting the
+//! threshold inner loop). This walks the same stages `Detector::detect` runs
+//! and reports where the time actually goes.
+//!
+//! ```text
+//! cargo run --release --example profile -- <image>... [--decimate N]
+//! ```
+
+use std::time::Instant;
+
+use aprilgrid::decode::decode_quad;
+use aprilgrid::detector::{Detector, DetectorParams};
+use aprilgrid::gray::GrayImage;
+use aprilgrid::quad::{QuadParams, fit_quad, refine_edges};
+use aprilgrid::segmentation::boundary_clusters;
+use aprilgrid::threshold::adaptive_threshold;
+
+/// Accumulated wall time per stage, in milliseconds.
+#[derive(Default)]
+struct Stages {
+    decimate: f64,
+    threshold: f64,
+    cluster: f64,
+    quad: f64,
+    refine: f64,
+    decode: f64,
+    total: f64,
+    frames: usize,
+    clusters: usize,
+    quads: usize,
+    detections: usize,
+}
+
+fn main() {
+    let mut paths: Vec<String> = Vec::new();
+    let mut decimate = 1usize;
+    let argv: Vec<String> = std::env::args().skip(1).collect();
+    let mut i = 0;
+    while i < argv.len() {
+        if argv[i] == "--decimate" {
+            i += 1;
+            decimate = argv[i].parse().expect("--decimate needs a number");
+        } else {
+            paths.push(argv[i].clone());
+        }
+        i += 1;
+    }
+    if paths.is_empty() {
+        eprintln!("usage: profile <image>... [--decimate N]");
+        std::process::exit(2);
+    }
+
+    let params = DetectorParams { decimate, ..DetectorParams::default() };
+    let detector = Detector::t36h11();
+    let family = detector.family();
+    let mut s = Stages::default();
+
+    for path in &paths {
+        let img = image::open(path).expect("failed to open image").to_luma8();
+        let (w, h) = (img.width() as usize, img.height() as usize);
+        let img = GrayImage::from_vec(w, h, img.into_raw()).expect("bad image");
+
+        let t_all = Instant::now();
+
+        let t = Instant::now();
+        let decimated;
+        let search: &GrayImage = if decimate > 1 {
+            decimated = img.decimate(decimate);
+            &decimated
+        } else {
+            &img
+        };
+        s.decimate += ms(t);
+
+        let t = Instant::now();
+        let bin = adaptive_threshold(search, params.min_contrast);
+        s.threshold += ms(t);
+
+        let t = Instant::now();
+        let clusters = boundary_clusters(&bin, params.min_cluster_size);
+        s.cluster += ms(t);
+        s.clusters += clusters.len();
+
+        let search_quad = QuadParams {
+            min_side_px: params.quad.min_side_px / decimate as f64,
+            ..params.quad
+        };
+
+        // Run the per-cluster stages serially so the timings are comparable;
+        // the shipped detector fans these out across rayon.
+        let mut quads = Vec::new();
+        let t = Instant::now();
+        for cluster in &clusters {
+            if let Some(q) = fit_quad(cluster, &search_quad) {
+                let full = upscale(&q, decimate);
+                if full.min_side() >= params.quad.min_side_px {
+                    quads.push(full);
+                }
+            }
+        }
+        s.quad += ms(t);
+        s.quads += quads.len();
+
+        let t = Instant::now();
+        let refined: Vec<_> = quads
+            .iter()
+            .map(|q| refine_edges(&img, q, &params.refine).unwrap_or(*q))
+            .collect();
+        s.refine += ms(t);
+
+        let t = Instant::now();
+        for q in &refined {
+            if decode_quad(&img, q, family, &params.decode).is_some() {
+                s.detections += 1;
+            }
+        }
+        s.decode += ms(t);
+
+        s.total += ms(t_all);
+        s.frames += 1;
+    }
+
+    let n = s.frames as f64;
+    println!("frames {}  decimate {}", s.frames, decimate);
+    println!(
+        "clusters/frame {:.0}   quads/frame {:.1}   detections/frame {:.1}",
+        s.clusters as f64 / n,
+        s.quads as f64 / n,
+        s.detections as f64 / n,
+    );
+    println!();
+    let row = |name: &str, v: f64| {
+        println!("{name:<12} {:8.2} ms  {:5.1}%", v / n, 100.0 * v / s.total);
+    };
+    row("decimate", s.decimate);
+    row("threshold", s.threshold);
+    row("cluster", s.cluster);
+    row("fit_quad", s.quad);
+    row("refine", s.refine);
+    row("decode", s.decode);
+    println!("{:<12} {:8.2} ms  (serial)", "total", s.total / n);
+}
+
+fn ms(t: Instant) -> f64 {
+    t.elapsed().as_secs_f64() * 1000.0
+}
+
+fn upscale(q: &aprilgrid::quad::Quad, factor: usize) -> aprilgrid::quad::Quad {
+    if factor <= 1 {
+        return *q;
+    }
+    let f = factor as f64;
+    // Matches `detector::upscale_quad`: a decimated pixel centre maps back to
+    // the centre of the block of full-resolution pixels it covered.
+    let mut corners = q.corners;
+    for c in corners.iter_mut() {
+        c.x = c.x * f + (f - 1.0) * 0.5;
+        c.y = c.y * f + (f - 1.0) * 0.5;
+    }
+    aprilgrid::quad::Quad { corners }
+}
