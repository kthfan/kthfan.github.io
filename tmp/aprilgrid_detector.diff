+//! Tag family definition, rotation handling, and code lookup.
+
+use crate::tag_family_data as data;
+
+pub use data::{BORDER_CELLS, EDGE_CELLS};
+
+/// Result of matching a sampled code against the family.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CodeMatch {
+    /// Index of the matching tag in the family.
+    pub id: u32,
+    /// Hamming distance between the observed and stored code.
+    pub hamming: u8,
+    /// Number of clockwise 90 degree rotations applied to the *observed* code
+    /// to bring it into the tag's canonical orientation.
+    pub rotation: u8,
+}
+
+/// The AprilTag 36h11 family.
+#[derive(Clone, Copy, Debug)]
+pub struct TagFamily {
+    codes: &'static [u64],
+    /// Data cells along one edge (6 for 36h11).
+    pub edge_cells: usize,
+    /// Black border cells drawn around the data area.
+    pub border_cells: usize,
+    /// Largest Hamming distance still accepted as a match.
+    pub max_hamming: u8,
+}
+
+impl Default for TagFamily {
+    fn default() -> Self {
+        Self::t36h11()
+    }
+}
+
+impl TagFamily {
+    /// The 36h11 family as drawn by `cv2.aruco.DICT_APRILTAG_36h11`.
+    ///
+    /// The family guarantees a minimum Hamming distance of 11, so up to 5 bit
+    /// errors are in principle correctable. The default cap is deliberately
+    /// much lower: every extra bit of correction multiplies the false-positive
+    /// rate across the hundreds of quads a cluttered frame produces, and a
+    /// wrong id is far more damaging to a calibration than a missed tag.
+    pub const fn t36h11() -> Self {
+        Self {
+            codes: &data::T36H11,
+            edge_cells: data::EDGE_CELLS,
+            border_cells: data::BORDER_CELLS,
+            max_hamming: 2,
+        }
+    }
+
+    /// Number of tags in the family.
+    pub const fn len(&self) -> usize {
+        self.codes.len()
+    }
+
+    pub const fn is_empty(&self) -> bool {
+        self.codes.is_empty()
+    }
+
+    /// Canonical code for `id`.
+    pub fn code(&self, id: u32) -> Option<u64> {
+        self.codes.get(id as usize).copied()
+    }
+
+    /// Total cells along one edge including the black border.
+    pub const fn side_cells(&self) -> usize {
+        self.edge_cells + 2 * self.border_cells
+    }
+
+    /// Mask covering the bits actually used by a code.
+    const fn mask(&self) -> u64 {
+        let bits = (self.edge_cells * self.edge_cells) as u32;
+        if bits >= 64 { u64::MAX } else { (1u64 << bits) - 1 }
+    }
+
+    /// Rotates a packed code 90 degrees clockwise.
+    ///
+    /// Cell `(r, c)` of the rotated grid is cell `(n - 1 - c, r)` of the
+    /// original, matching how a tag's appearance changes when the board is
+    /// turned clockwise in front of the camera.
+    pub fn rotate_cw(&self, code: u64) -> u64 {
+        let n = self.edge_cells;
+        let total = (n * n) as u32;
+        let mut out = 0u64;
+        for r in 0..n {
+            for c in 0..n {
+                let src = (n - 1 - c) * n + r;
+                if code >> (total - 1 - src as u32) & 1 == 1 {
+                    let dst = r * n + c;
+                    out |= 1 << (total - 1 - dst as u32);
+                }
+            }
+        }
+        out
+    }
+
+    /// Finds the best matching tag for an observed code.
+    ///
+    /// The observed code is rotated clockwise up to three times; the rotation
+    /// that yields the smallest Hamming distance wins. Returns `None` when no
+    /// rotation lands within [`TagFamily::max_hamming`].
+    pub fn match_code(&self, observed: u64) -> Option<CodeMatch> {
+        let mask = self.mask();
+        let mut best: Option<CodeMatch> = None;
+        let mut rotated = observed & mask;
+        for rotation in 0..4u8 {
+            for (id, &code) in self.codes.iter().enumerate() {
+                let hamming = (code ^ rotated).count_ones() as u8;
+                if hamming <= self.max_hamming
+                    && best.is_none_or(|b| hamming < b.hamming)
+                {
+                    best = Some(CodeMatch { id: id as u32, hamming, rotation });
+                    if hamming == 0 {
+                        return best;
+                    }
+                }
+            }
+            rotated = self.rotate_cw(rotated);
+        }
+        best
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn family_has_the_expected_shape() {
+        let f = TagFamily::t36h11();
+        assert_eq!(f.len(), 587);
+        assert_eq!(f.edge_cells, 6);
+        assert_eq!(f.border_cells, 1);
+        assert_eq!(f.side_cells(), 8);
+    }
+
+    #[test]
+    fn rotate_cw_matches_the_rasterised_markers() {
+        // ROTATION_FIXTURES comes straight from rotating the images that
+        // cv2.aruco actually draws, so this pins our bit convention to the
+        // physical board rather than to itself.
+        let f = TagFamily::t36h11();
+        for fx in data::ROTATION_FIXTURES {
+            let (id, r0, r1, r2, r3) = (fx[0], fx[1], fx[2], fx[3], fx[4]);
+            assert_eq!(f.code(id as u32), Some(r0), "tag {id} canonical code");
+            assert_eq!(f.rotate_cw(r0), r1, "tag {id} rot90");
+            assert_eq!(f.rotate_cw(r1), r2, "tag {id} rot180");
+            assert_eq!(f.rotate_cw(r2), r3, "tag {id} rot270");
+            assert_eq!(f.rotate_cw(r3), r0, "tag {id} full turn");
+        }
+    }
+
+    #[test]
+    fn four_rotations_are_the_identity_for_every_tag() {
+        let f = TagFamily::t36h11();
+        for id in 0..f.len() as u32 {
+            let c = f.code(id).unwrap();
+            assert_eq!(f.rotate_cw(f.rotate_cw(f.rotate_cw(f.rotate_cw(c)))), c);
+        }
+    }
+
+    #[test]
+    fn exact_codes_decode_to_their_own_id_with_zero_rotation() {
+        let f = TagFamily::t36h11();
+        for id in 0..f.len() as u32 {
+            let m = f.match_code(f.code(id).unwrap()).unwrap();
+            assert_eq!(m.id, id);
+            assert_eq!(m.hamming, 0);
+            assert_eq!(m.rotation, 0);
+        }
+    }
+
+    #[test]
+    fn rotated_codes_report_the_rotation_that_restores_them() {
+        let f = TagFamily::t36h11();
+        for fx in data::ROTATION_FIXTURES {
+            let id = fx[0] as u32;
+            for rot in 0..4usize {
+                // fx[1 + rot] is the code seen when the tag is turned; feeding
+                // it back must recover the id and say how far it was turned.
+                let m = f.match_code(fx[1 + rot]).unwrap();
+                assert_eq!(m.id, id);
+                assert_eq!(m.hamming, 0);
+                assert_eq!(m.rotation as usize, (4 - rot) % 4, "tag {id} rot {rot}");
+            }
+        }
+    }
+
+    #[test]
+    fn a_single_bit_error_is_still_decoded() {
+        let f = TagFamily::t36h11();
+        for id in [0u32, 5, 123, 586] {
+            let code = f.code(id).unwrap();
+            for bit in 0..36 {
+                let m = f.match_code(code ^ (1 << bit)).unwrap();
+                assert_eq!(m.id, id, "tag {id} bit {bit}");
+                assert_eq!(m.hamming, 1);
+            }
+        }
+    }
+
+    #[test]
+    fn errors_beyond_the_cap_are_rejected_rather_than_guessed() {
+        let f = TagFamily::t36h11();
+        let code = f.code(17).unwrap();
+        // Flip 5 bits: still closer to tag 17 than to anything else (min
+        // distance is 11), but past the configured trust threshold.
+        let corrupted = code ^ 0b11111;
+        assert!(f.match_code(corrupted).is_none());
+    }
+
+    #[test]
+    fn all_zero_and_all_one_codes_are_not_tags() {
+        let f = TagFamily::t36h11();
+        // A blank white or blank black quad is the single most common false
+        // positive; neither may resolve to a tag.
+        assert!(f.match_code(0).is_none());
+        assert!(f.match_code(f.mask()).is_none());
+    }
+
+    #[test]
+    fn ids_stay_within_the_family() {
+        let f = TagFamily::t36h11();
+        assert!(f.code(586).is_some());
+        assert!(f.code(587).is_none());
+    }
+}
