+//! Robust, real-time AprilGrid detection.
+//!
+//! # Pixel coordinate convention
+//!
+//! Pixel centres lie at **integer** coordinates, so pixel `i` covers the
+//! interval `[i - 0.5, i + 0.5]` and the boundary between pixels `i` and
+//! `i + 1` is at `i + 0.5`. Every corner this crate reports follows this
+//! convention, matching OpenCV and upstream AprilTag. A tag whose black
+//! square occupies pixel columns `40..=79` therefore has its left edge
+//! reported at `39.5`, not `40.0`.
+
+pub mod board;
+pub mod camera;
+pub mod decode;
+pub mod detector;
+pub mod geometry;
+pub mod gray;
+pub mod pose;
+pub mod quad;
+pub mod segmentation;
+pub mod tag_family;
+#[path = "tag_family_data.rs"]
+pub mod tag_family_data;
+pub mod threshold;
+pub mod unionfind;
+
+pub use board::{BoardLayout, BoardObservation, group_by_board};
+pub use camera::{Camera, Distortion};
+pub use decode::{DecodeParams, Detection};
+pub use detector::{Detector, DetectorParams};
+pub use geometry::{Point2, Point3};
+pub use gray::GrayImage;
+pub use pose::{Pose, PoseEstimate, PoseParams, estimate_board_pose, estimate_pose};
+pub use quad::Quad;
+pub use tag_family::TagFamily;
