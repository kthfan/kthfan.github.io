++    #[test]
++    fn corner_noise_shows_up_in_the_reported_error() {
++        let truth = pose_from(0.2, 0.1, 0.0, [0.0, 0.0, 0.3]);
++        let (obj, mut img) = synth(&truth, &cam());
++        // Displace one corner by 3 px.
++        img[5] = Point2::new(img[5].x + 3.0, img[5].y);
++        let est = estimate_pose(&obj, &img, &cam(), &PoseParams::default()).unwrap();
++        assert!(est.reprojection_rmse > 0.1, "outlier vanished from the metric");
++        assert!(
++            est.reprojection_max > est.reprojection_rmse,
++            "max must expose the single bad corner"
