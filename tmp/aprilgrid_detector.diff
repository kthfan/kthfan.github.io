++//! `agdet` — command-line AprilGrid detector.
++//!
++//! Arguments are parsed by hand rather than with `clap` because the build
++//! environment is offline and `clap` is not vendored.
++
++use std::path::Path;
++use std::process::ExitCode;
++
++use aprilgrid::board::{BoardLayout, group_by_board};
++use aprilgrid::camera::{Camera, Distortion};
++use aprilgrid::detector::{Detector, DetectorParams};
++use aprilgrid::gray::GrayImage;
++use aprilgrid::pose::{PoseParams, estimate_pose};
++use aprilgrid::tag_family::TagFamily;
++
++const USAGE: &str = "\
++agdet - detect AprilGrid tags in an image
++
++USAGE:
++    agdet [OPTIONS] <IMAGE>...
++
++OPTIONS:
++    --decimate <N>          search at 1/N resolution (default 1)
++    --min-contrast <N>      local contrast floor, 0-255 (default 12)
++    --min-cluster <N>       smallest boundary cluster (default 24)
++    --min-side <PX>         smallest quad side in pixels (default 16)
++    --no-refine             skip sub-pixel edge refinement
++    --single-thread         disable parallelism
++    --tags-x <N>            board columns (default 4)
++    --tags-y <N>            board rows (default 1)
++    --tag-size <M>          tag side in metres (default 0.020)
++    --tag-sep <M>           gap between tags in metres (default 0.0075)
++    --intrinsics <fx,fy,cx,cy>
++                            enable pose estimation
++    --distortion <k1,k2,p1,p2,k3>
++                            OpenCV radial-tangential coefficients
++    --json                  emit JSON instead of text
++    -h, --help              show this help
++
++EXAMPLES:
++    agdet frame.png
++    agdet --intrinsics 1400,1400,959.5,539.5 --json frames/*.png
++";
++
++struct Args {
++    images: Vec<String>,
++    params: DetectorParams,
++    layout: BoardLayout,
++    camera: Option<Camera>,
++    json: bool,
++}
++
++/// Parse a fixed-length comma-separated list of floats.
++fn parse_floats<const N: usize>(s: &str, flag: &str) -> Result<[f64; N], String> {
++    let parts: Vec<&str> = s.split(',').collect();
++    if parts.len() != N {
++        return Err(format!("{flag} needs {N} comma-separated numbers, got {}", parts.len()));
++    }
++    let mut out = [0.0; N];
++    for (i, p) in parts.iter().enumerate() {
++        out[i] = p
++            .trim()
++            .parse()
++            .map_err(|_| format!("{flag}: '{}' is not a number", p.trim()))?;
++    }
++    Ok(out)
++}
++
++fn parse_args(argv: &[String]) -> Result<Option<Args>, String> {
++    let mut images = Vec::new();
++    let mut params = DetectorParams::default();
++    let (mut tags_x, mut tags_y) = (4usize, 1usize);
++    let (mut tag_size, mut tag_sep) = (0.020f64, 0.0075f64);
++    let mut intrinsics: Option<[f64; 4]> = None;
++    let mut distortion: Option<[f64; 5]> = None;
++    let mut json = false;
++
++    let mut i = 0;
++    while i < argv.len() {
++        let arg = argv[i].clone();
++        // Options taking a value fetch it through this helper so a missing
++        // value is reported consistently instead of panicking on an index.
++        let value = |i: &mut usize| -> Result<String, String> {
++            *i += 1;
++            argv.get(*i).cloned().ok_or_else(|| format!("{arg} needs a value"))
++        };
++        match argv[i].as_str() {
++            "-h" | "--help" => return Ok(None),
++            "--json" => json = true,
++            "--no-refine" => params.refine_edges = false,
++            "--single-thread" => params.parallel = false,
++            "--decimate" => {
++                let v: usize = value(&mut i)?.parse().map_err(|_| "--decimate: not an integer")?;
++                if v == 0 {
++                    return Err("--decimate must be at least 1".into());
++                }
++                params.decimate = v;
++            }
++            "--min-contrast" => {
++                params.min_contrast =
++                    value(&mut i)?.parse().map_err(|_| "--min-contrast: expected 0-255")?;
++            }
++            "--min-cluster" => {
++                params.min_cluster_size =
++                    value(&mut i)?.parse().map_err(|_| "--min-cluster: not an integer")?;
++            }
++            "--min-side" => {
++                params.quad.min_side_px =
++                    value(&mut i)?.parse().map_err(|_| "--min-side: not a number")?;
++            }
++            "--tags-x" => tags_x = value(&mut i)?.parse().map_err(|_| "--tags-x: not an integer")?,
++            "--tags-y" => tags_y = value(&mut i)?.parse().map_err(|_| "--tags-y: not an integer")?,
++            "--tag-size" => {
++                tag_size = value(&mut i)?.parse().map_err(|_| "--tag-size: not a number")?
++            }
++            "--tag-sep" => {
++                tag_sep = value(&mut i)?.parse().map_err(|_| "--tag-sep: not a number")?
++            }
++            "--intrinsics" => intrinsics = Some(parse_floats(&value(&mut i)?, "--intrinsics")?),
++            "--distortion" => distortion = Some(parse_floats(&value(&mut i)?, "--distortion")?),
++            other if other.starts_with('-') => {
++                return Err(format!("unknown option '{other}'"));
++            }
++            other => images.push(other.to_string()),
++        }
++        i += 1;
++    }
++
++    if images.is_empty() {
++        return Err("no input images given".into());
++    }
++    let layout = BoardLayout::new(tags_x, tags_y, tag_size, tag_sep)
++        .ok_or("invalid board layout: check --tags-x/--tags-y/--tag-size/--tag-sep")?;
++
++    let camera = match intrinsics {
++        None => {
++            if distortion.is_some() {
++                return Err("--distortion also needs --intrinsics".into());
++            }
++            None
++        }
++        Some([fx, fy, cx, cy]) => {
++            let mut c = Camera::pinhole(fx, fy, cx, cy)
++                .ok_or("--intrinsics: focal lengths must be finite and non-zero")?;
++            if let Some([k1, k2, p1, p2, k3]) = distortion {
++                c.distortion = Distortion::RadTan { k1, k2, p1, p2, k3 };
++            }
++            Some(c)
++        }
++    };
++
++    Ok(Some(Args { images, params, layout, camera, json }))
++}
++
++fn load_gray(path: &str) -> Result<GrayImage, String> {
++    let img = image::open(Path::new(path)).map_err(|e| format!("{path}: {e}"))?;
++    let luma = img.to_luma8();
++    let (w, h) = (luma.width() as usize, luma.height() as usize);
++    GrayImage::from_vec(w, h, luma.into_raw()).ok_or_else(|| format!("{path}: bad image data"))
++}
++
++fn escape(s: &str) -> String {
++    s.replace('\\', "\\\\").replace('"', "\\\"")
++}
++
++fn run(args: Args) -> Result<(), String> {
++    let detector = Detector::new(TagFamily::t36h11(), args.params);
++    let pose_params = PoseParams::default();
++    let mut first = true;
++
++    if args.json {
++        println!("[");
++    }
++    for path in &args.images {
++        let img = load_gray(path)?;
++        let detections = detector.detect(&img);
++        let boards = group_by_board(&detections, &args.layout);
++
++        if args.json {
++            if !first {
++                println!(",");
++            }
++            first = false;
++            println!("  {{");
++            println!("    \"image\": \"{}\",", escape(path));
++            println!("    \"width\": {}, \"height\": {},", img.width(), img.height());
++            println!("    \"detections\": [");
++            for (i, d) in detections.iter().enumerate() {
++                let c: Vec<String> = d
++                    .corners
++                    .iter()
++                    .map(|p| format!("[{:.4}, {:.4}]", p.x, p.y))
++                    .collect();
++                println!(
++                    "      {{\"id\": {}, \"hamming\": {}, \"decision_margin\": {:.2}, \"corners\": [{}]}}{}",
++                    d.id,
++                    d.hamming,
++                    d.decision_margin,
++                    c.join(", "),
++                    if i + 1 < detections.len() { "," } else { "" }
++                );
++            }
++            println!("    ],");
++            println!("    \"boards\": [");
++            for (i, b) in boards.iter().enumerate() {
++                let pose = args.camera.as_ref().and_then(|cam| {
++                    estimate_pose(&b.object_points, &b.image_points, cam, &pose_params)
++                });
++                print!(
++                    "      {{\"board_id\": {}, \"tags\": {}, \"coverage\": {:.4}",
++                    b.board_id,
++                    b.tag_count(),
++                    b.coverage(&args.layout)
++                );
++                if let Some(e) = pose {
++                    let t = e.pose.translation;
