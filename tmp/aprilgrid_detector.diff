index 0000000..9f2789b
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/tests/reproducibility.py"
@@ -0,0 +1,184 @@
+"""Reproducibility test: does the grid stay put as the camera moves?
+
+One AprilGrid, bolted down. The arm looks at it from many random viewpoints on
+a sphere around it and, from each one, works out where the grid is in the robot
+base frame::
+
+    T_base_grid = T_base_ee @ T_ee_cam @ T_cam_grid
+
+The grid never moves, so every estimate should land on the same answer. The
+spread of those estimates -- not their distance from any ground truth -- is the
+measurement. It needs no calibration rig, works identically on a simulator and
+on real hardware, and is exactly the number that decides whether a
+vision-guided motion will be repeatable.
+
+Viewpoints are drawn as a radius, then theta and phi on the sphere, then a
+lateral shift in the camera's own x and y so the grid is not centred in the
+image. The sphere is centred on the grid pose recovered from the *first* look,
+never on ground truth -- which is what lets the same code run on a real arm.
+
+    python tools/robotlab/run.py reproducibility --samples 30
+    python tools/robotlab/run.py reproducibility --backend techman
+"""
+
+from __future__ import annotations
+
+import math
+
+from ._common import GO, QUIT, Session, common_args, fmt_pose, np, open_session, tf
+from robotlab.core.metrics import rotation_stats, translation_stats, pose_axis_stats
+
+
+def run(args) -> int:
+    session = open_session(args, board_count=1)
+    cfg, bench = session.cfg, session.bench
+    n = args.samples if args.samples is not None else int(
+        cfg.tests["reproducibility_samples"])
+
+    try:
+        return _measure(session, args, n)
+    finally:
+        session.close()
+
+
+def _measure(session: Session, args, n: int) -> int:
+    cfg, bench = session.cfg, session.bench
+
+    # Precondition: the arm can clearly see the grid to begin with, so it
+    # knows roughly where the grid is and can plan viewpoints around it.
+    T_base_grid_rough = session.start_view()
+    bench.save("00_start_view", bench.capture())
+    print(f"start view  T_base_grid ~ {fmt_pose(T_base_grid_rough)}")
+
+    centre = bench.centre_frame(T_base_grid_rough)
+    accept = bench.visibility_from_estimate(T_base_grid_rough)
+
+    estimates, records, misses, skipped = [], [], 0, 0
+    ensemble = bench.ensemble
+    move = session.mover() if session.interactive else None
+    print(f"\n{'#':>3}  {'r(m)':>5} {'theta':>6} {'phi':>6} {'roll':>6}  "
+          f"{'cov':>5} {'rmse px':>7} {'n':>3}   T_base_grid")
+    for i in range(n):
+        vp = session.sampler.sample(centre, accept)
+        answer = session.goto(vp.T_base_cam, f"viewpoint {i + 1}/{n}")
+        if answer is QUIT:
+            print("  stopped by operator")
+            break
+        if answer is not GO:
+            skipped += 1
+            continue
+
+        if ensemble is None:
+            frame, board, T_base_grid = bench.observe()
+            used = 0 if board is None else 1
+        else:
+            frame, board, T_base_grid, used = bench.observe_ensemble(
+                vp.T_base_cam, centre, move=move)
+        if board is None:
+            misses += 1
+            print(f"{i:>3}  {vp.radius_m:5.3f} {vp.theta_deg:6.1f} {vp.phi_deg:6.1f} "
+                  f"{vp.roll_deg:6.1f}    ---         {used:>3}   grid not detected")
+            if frame is not None:
+                bench.save(f"miss_{i:03d}", frame)
+            continue
+
+        estimates.append(T_base_grid)
+        records.append({**vp.params(), "coverage": board.coverage,
+                        "reprojection_rmse": board.pose.reprojection_rmse,
+                        "ensemble_used": used,
+                        "T_base_grid": tf.matrix_to_pose(T_base_grid)})
+        print(f"{i:>3}  {vp.radius_m:5.3f} {vp.theta_deg:6.1f} {vp.phi_deg:6.1f} "
+              f"{vp.roll_deg:6.1f}  {board.coverage:5.2f} "
+              f"{board.pose.reprojection_rmse:7.3f} {used:>3}   {fmt_pose(T_base_grid)}")
+        if args.save_images:
+            bench.save(f"view_{i:03d}", frame)
+        bench.display("reproducibility", frame)
+
+    truth = session.truth
+    if truth is not None:
+        assert not truth.moved(), "the AprilGrid moved during the test"
+
+    if len(estimates) < 2:
+        print("\nnot enough detections to measure a spread")
+        return 1
+
+    est = np.stack(estimates)
+    trans = translation_stats(est[:, :3, 3])
+    rot = rotation_stats(est[:, :3, :3])
+    mean_pose = tf.rt_to_matrix(rot["mean_rotation"], trans["mean_m"])
+
+    world_ax = pose_axis_stats([tf.matrix_to_pose(T) for T in est])
+    T_mean_inv = np.linalg.inv(mean_pose)
+    grid_ax = pose_axis_stats([tf.matrix_to_pose(T_mean_inv @ T) for T in est])
+
+    print("\n" + "=" * 74)
+    print(f"reproducibility of T_base_grid over {trans['n']} viewpoints "
+          f"({misses} missed, {skipped} skipped)")
+    print("=" * 74)
+    print(f"  position spread    {trans['rms_mm']:.3f} mm rms, "
+          f"{trans['max_mm']:.3f} mm max")
+    print(f"  rotation spread    {rot['rms_deg']:.3f} deg rms, "
+          f"{rot['max_deg']:.3f} deg max")
+
+    print("\n  per-axis             x        y        z         rx       ry       rz")
+    def _axis_row(name, st, kind):
+        xyz = st[f"{kind}_xyz_mm"]
+        rpy = st[f"{kind}_rpy_deg"]
+        print(f"  {name:<14} {xyz[0]:8.3f} {xyz[1]:8.3f} {xyz[2]:8.3f} mm "
+              f"{rpy[0]:8.4f} {rpy[1]:8.4f} {rpy[2]:8.4f} deg")
+
+    print("  world frame")
+    _axis_row("  mean", world_ax, "mean")
+    _axis_row("  std", world_ax, "std")
+    _axis_row("  max - min", world_ax, "range")
+    print("  grid frame   (relative to mean pose)")
+    _axis_row("  mean", grid_ax, "mean")
+    _axis_row("  std", grid_ax, "std")
+    _axis_row("  max - min", grid_ax, "range")
+
+    payload = {
+        "backend": session.backend.name, "seed": session.seed,
+        "samples": n, "misses": misses, "skipped": skipped,
+        "ensemble": None if ensemble is None else ensemble.describe(),
+        "position_std_mm": trans["std_xyz_mm"], "position_rms_mm": trans["rms_mm"],
+        "position_max_mm": trans["max_mm"], "rotation_rms_deg": rot["rms_deg"],
+        "rotation_max_deg": rot["max_deg"],
+        "mean_T_base_grid": tf.matrix_to_pose(mean_pose),
+        "world_frame": world_ax,
+        "grid_frame": grid_ax,
+        "views": records,
+    }
+
+    # Ground truth exists only in simulation. It is reported for context and
+    # takes no part in the measurement above.
+    if truth is not None:
+        true_grid = truth.board_matrix(0)
+        dt, dr = tf.pose_error(mean_pose, true_grid)
+        print(f"\n  [simulation only] mean estimate vs. true grid pose: "
+              f"{dt * 1e3:.3f} mm, {math.degrees(dr):.3f} deg")
+        payload["true_T_base_grid"] = tf.matrix_to_pose(true_grid)
+        payload["mean_error_mm"] = dt * 1e3
+        payload["mean_error_deg"] = math.degrees(dr)
+
+    bench.write_json("reproducibility", payload)
+    if bench.out_dir:
+        print(f"  wrote {bench.out_dir}")
+    return 0
+
+
+def add_args(p):
+    p.add_argument("--samples", type=int, help="number of viewpoints")
+    p.add_argument("--out", default="data/robotlab/reproducibility",
+                   help="directory for images and the JSON summary")
+    return p
+
+
+def main() -> int:
+    p = add_args(common_args(__doc__.splitlines()[0]))
+    p.add_argument("--auto", action="store_true",
+                   help="run unattended (simulation only)")
+    return run(p.parse_args())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
