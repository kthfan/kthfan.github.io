++#[cfg(test)]
++mod tests {
++    use super::*;
++    use crate::board::BoardLayout;
++    use crate::camera::Distortion;
++
++    fn cam() -> Camera {
++        Camera::pinhole(900.0, 900.0, 960.0, 540.0).unwrap()
++    }
++
++    fn lens_cam() -> Camera {
++        cam().with_distortion(Distortion::RadTan {
++            k1: -0.25,
++            k2: 0.08,
++            p1: 0.0006,
++            p2: -0.0009,
++            k3: -0.01,
++        })
++    }
++
++    fn pose_from(rx: f64, ry: f64, rz: f64, t: [f64; 3]) -> Pose {
++        Pose {
++            rotation: exp_so3(&Vector3::new(rx, ry, rz)),
++            translation: Vector3::new(t[0], t[1], t[2]),
++        }
++    }
++
++    /// Object points for a full default board, and their exact projections.
++    fn synth(pose: &Pose, camera: &Camera) -> (Vec<Point3>, Vec<Point2>) {
++        let layout = BoardLayout::default();
++        let mut obj = Vec::new();
++        for slot in 0..layout.tags_per_board() {
++            obj.extend_from_slice(&layout.slot_corners(slot).unwrap());
++        }
++        let img = obj
++            .iter()
++            .map(|p| camera.project_point(pose.transform(*p)).expect("in front of camera"))
++            .collect();
++        (obj, img)
++    }
++
++    fn assert_pose_close(got: &Pose, want: &Pose, ang_tol: f64, pos_tol: f64) {
++        let dr = want.rotation.transpose() * got.rotation;
++        let ang = log_so3(&dr).norm();
++        let dt = (got.translation - want.translation).norm();
++        assert!(ang < ang_tol, "rotation off by {ang} rad");
++        assert!(dt < pos_tol, "translation off by {dt} m");
++    }
++
++    #[test]
++    fn exp_and_log_are_inverses() {
++        for w in [
++            Vector3::new(0.0, 0.0, 0.0),
++            Vector3::new(0.3, -0.2, 0.15),
++            Vector3::new(1.5, 0.0, 0.0),
++            Vector3::new(0.0, 2.9, 0.0),
++        ] {
++            let r = exp_so3(&w);
++            assert!((r.determinant() - 1.0).abs() < 1e-12, "not a rotation");
++            assert!((log_so3(&r) - w).norm() < 1e-9, "round trip failed for {w:?}");
++        }
++    }
++
++    #[test]
++    fn log_handles_the_half_turn_singularity() {
++        // At exactly pi the antisymmetric part of R vanishes.
++        let w = Vector3::new(0.0, 0.0, std::f64::consts::PI);
++        let r = exp_so3(&w);
++        let back = log_so3(&r);
++        assert!((back.norm() - std::f64::consts::PI).abs() < 1e-6);
++        // Recovering +pi or -pi about z are both correct.
++        assert!(exp_so3(&back).relative_eq(&r, 1e-9, 1e-9));
++    }
++
++    #[test]
++    fn recovers_a_frontal_pose_exactly() {
++        let truth = pose_from(0.0, 0.0, 0.0, [-0.04, -0.01, 0.30]);
++        let (obj, img) = synth(&truth, &cam());
++        let est = estimate_pose(&obj, &img, &cam(), &PoseParams::default()).unwrap();
++        assert_pose_close(&est.pose, &truth, 1e-6, 1e-7);
++        assert!(est.reprojection_rmse < 1e-6, "rmse {}", est.reprojection_rmse);
++        assert_eq!(est.point_count, 16);
++    }
++
++    #[test]
++    fn recovers_a_strongly_tilted_pose() {
++        // ~40 degrees of tilt plus roll: the regime where a planar pose solver
++        // is most likely to pick the wrong branch.
++        let truth = pose_from(0.6, -0.45, 0.3, [-0.05, 0.02, 0.35]);
++        let (obj, img) = synth(&truth, &cam());
++        let est = estimate_pose(&obj, &img, &cam(), &PoseParams::default()).unwrap();
++        assert_pose_close(&est.pose, &truth, 1e-5, 1e-6);
++    }
++
++    #[test]
++    fn recovers_pose_through_lens_distortion() {
++        let truth = pose_from(0.35, 0.25, -0.2, [0.06, -0.03, 0.28]);
++        let c = lens_cam();
++        let (obj, img) = synth(&truth, &c);
++        let est = estimate_pose(&obj, &img, &c, &PoseParams::default()).unwrap();
++        assert_pose_close(&est.pose, &truth, 1e-4, 1e-5);
++        assert!(est.reprojection_rmse < 1e-3);
++    }
++
++    #[test]
++    fn a_single_tag_is_enough_for_a_pose() {
++        let truth = pose_from(0.2, -0.15, 0.1, [0.0, 0.0, 0.25]);
++        let (obj, img) = synth(&truth, &cam());
++        let est =
++            estimate_pose(&obj[..4], &img[..4], &cam(), &PoseParams::default()).unwrap();
++        // Four coplanar points are the minimum; accuracy is lower but the
++        // answer must still be the right one.
++        assert_pose_close(&est.pose, &truth, 1e-4, 1e-5);
++    }
++
++    #[test]
++    fn the_board_always_ends_up_in_front_of_the_camera() {
++        for rz in [0.0, 1.0, 2.0, 3.0] {
++            let truth = pose_from(0.1, 0.1, rz, [0.0, 0.0, 0.4]);
++            let (obj, img) = synth(&truth, &cam());
++            let est = estimate_pose(&obj, &img, &cam(), &PoseParams::default()).unwrap();
++            assert!(est.pose.translation[2] > 0.0, "board placed behind the camera");
++            assert_pose_close(&est.pose, &truth, 1e-5, 1e-6);
