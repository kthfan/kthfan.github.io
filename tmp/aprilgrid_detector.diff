+//! Small geometry helpers: points, line fitting, and homographies.
+
+use nalgebra::{Matrix3, SMatrix, SVector};
+
+/// A 2D point in pixel coordinates.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Point2 {
+    pub x: f64,
+    pub y: f64,
+}
+
+impl Point2 {
+    pub const fn new(x: f64, y: f64) -> Self {
+        Self { x, y }
+    }
+
+    #[inline]
+    pub fn sub(self, o: Self) -> Self {
+        Self::new(self.x - o.x, self.y - o.y)
+    }
+
+    #[inline]
+    pub fn add(self, o: Self) -> Self {
+        Self::new(self.x + o.x, self.y + o.y)
+    }
+
+    #[inline]
+    pub fn scale(self, s: f64) -> Self {
+        Self::new(self.x * s, self.y * s)
+    }
+
+    #[inline]
+    pub fn dot(self, o: Self) -> f64 {
+        self.x * o.x + self.y * o.y
+    }
+
+    /// z-component of the 3D cross product; positive when `o` is CCW from self.
+    #[inline]
+    pub fn cross(self, o: Self) -> f64 {
+        self.x * o.y - self.y * o.x
+    }
+
+    #[inline]
+    pub fn norm(self) -> f64 {
+        self.dot(self).sqrt()
+    }
+
+    #[inline]
+    pub fn distance(self, o: Self) -> f64 {
+        self.sub(o).norm()
+    }
+}
+
+/// A 3D point in board (object) coordinates, in metres.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Point3 {
+    pub x: f64,
+    pub y: f64,
+    pub z: f64,
+}
+
+impl Point3 {
+    pub const fn new(x: f64, y: f64, z: f64) -> Self {
+        Self { x, y, z }
+    }
+}
+
+/// Signed area of a polygon; positive for counter-clockwise winding in a
+/// right-handed coordinate system.
+pub fn signed_area(pts: &[Point2]) -> f64 {
+    let n = pts.len();
+    let mut acc = 0.0;
+    for i in 0..n {
+        let a = pts[i];
+        let b = pts[(i + 1) % n];
+        acc += a.cross(b);
+    }
+    acc / 2.0
+}
+
+/// A line expressed as a point on the line plus a direction vector.
+#[derive(Clone, Copy, Debug)]
+pub struct Line2 {
+    pub point: Point2,
+    pub dir: Point2,
+}
+
+impl Line2 {
+    /// Intersection of two lines, or `None` when they are (near) parallel.
+    pub fn intersect(&self, other: &Line2) -> Option<Point2> {
+        let denom = self.dir.cross(other.dir);
+        if denom.abs() < 1e-12 {
+            return None;
+        }
+        let delta = other.point.sub(self.point);
+        let t = delta.cross(other.dir) / denom;
+        Some(self.point.add(self.dir.scale(t)))
+    }
+}
+
+/// Total-least-squares line fit through weighted points.
+///
+/// Returns `None` when the points are degenerate (all coincident).
+pub fn fit_line(pts: &[Point2], weights: Option<&[f64]>) -> Option<Line2> {
+    if pts.len() < 2 {
+        return None;
+    }
+    let mut wsum = 0.0;
+    let (mut mx, mut my) = (0.0, 0.0);
+    for (i, p) in pts.iter().enumerate() {
+        let w = weights.map_or(1.0, |w| w[i]);
+        wsum += w;
+        mx += w * p.x;
+        my += w * p.y;
+    }
+    if wsum <= 0.0 {
+        return None;
+    }
+    mx /= wsum;
+    my /= wsum;
+
+    let (mut sxx, mut syy, mut sxy) = (0.0, 0.0, 0.0);
+    for (i, p) in pts.iter().enumerate() {
+        let w = weights.map_or(1.0, |w| w[i]);
+        let dx = p.x - mx;
+        let dy = p.y - my;
+        sxx += w * dx * dx;
+        syy += w * dy * dy;
+        sxy += w * dx * dy;
+    }
+    if sxx + syy < 1e-12 {
+        return None;
+    }
+
+    // Principal eigenvector of the 2x2 scatter matrix, in closed form.
+    let theta = 0.5 * (2.0 * sxy).atan2(sxx - syy);
+    Some(Line2 { point: Point2::new(mx, my), dir: Point2::new(theta.cos(), theta.sin()) })
+}
+
+/// A plane-to-plane homography.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Homography {
+    pub m: Matrix3<f64>,
+}
+
+impl Homography {
+    pub const fn from_matrix(m: Matrix3<f64>) -> Self {
+        Self { m }
+    }
+
+    /// Maps a point through the homography. Returns `None` behind the plane at
+    /// infinity (w == 0).
+    pub fn project(&self, p: Point2) -> Option<Point2> {
+        let m = &self.m;
+        let w = m[(2, 0)] * p.x + m[(2, 1)] * p.y + m[(2, 2)];
+        if w.abs() < 1e-12 {
+            return None;
+        }
+        Some(Point2::new(
+            (m[(0, 0)] * p.x + m[(0, 1)] * p.y + m[(0, 2)]) / w,
+            (m[(1, 0)] * p.x + m[(1, 1)] * p.y + m[(1, 2)]) / w,
+        ))
+    }
+
+    pub fn inverse(&self) -> Option<Homography> {
+        self.m.try_inverse().map(Homography::from_matrix)
+    }
+}
+
+/// Direct Linear Transform homography from four source to four destination
+/// points, solved with normalized coordinates for numerical stability.
+///
+/// Returns `None` if the correspondence is degenerate.
+pub fn homography_from_quad(src: &[Point2; 4], dst: &[Point2; 4]) -> Option<Homography> {
+    let (ns, ts) = normalize(src)?;
+    let (nd, td) = normalize(dst)?;
+
+    let mut a: SMatrix<f64, 8, 8> = SMatrix::zeros();
+    let mut b: SVector<f64, 8> = SVector::zeros();
+    for i in 0..4 {
+        let (x, y) = (ns[i].x, ns[i].y);
+        let (u, v) = (nd[i].x, nd[i].y);
+        a[(2 * i, 0)] = x;
+        a[(2 * i, 1)] = y;
+        a[(2 * i, 2)] = 1.0;
+        a[(2 * i, 6)] = -u * x;
+        a[(2 * i, 7)] = -u * y;
+        b[2 * i] = u;
+
+        a[(2 * i + 1, 3)] = x;
+        a[(2 * i + 1, 4)] = y;
+        a[(2 * i + 1, 5)] = 1.0;
+        a[(2 * i + 1, 6)] = -v * x;
+        a[(2 * i + 1, 7)] = -v * y;
+        b[2 * i + 1] = v;
+    }
+
+    let h = a.lu().solve(&b)?;
+    if !h.iter().all(|v| v.is_finite()) {
+        return None;
+    }
+    let hn = Matrix3::new(h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], 1.0);
+
+    // Undo the normalization: H = Td^-1 * Hn * Ts
+    let td_inv = td.try_inverse()?;
+    Some(Homography::from_matrix(td_inv * hn * ts))
+}
+
+/// Builds a similarity transform that centers the points on the origin and
+/// scales their mean distance to sqrt(2) (Hartley normalization).
+fn normalize(pts: &[Point2; 4]) -> Option<([Point2; 4], Matrix3<f64>)> {
+    let cx = pts.iter().map(|p| p.x).sum::<f64>() / 4.0;
+    let cy = pts.iter().map(|p| p.y).sum::<f64>() / 4.0;
+    let mean_dist =
+        pts.iter().map(|p| ((p.x - cx).powi(2) + (p.y - cy).powi(2)).sqrt()).sum::<f64>() / 4.0;
+    if mean_dist < 1e-12 {
+        return None;
+    }
+    let s = std::f64::consts::SQRT_2 / mean_dist;
+    let t = Matrix3::new(s, 0.0, -s * cx, 0.0, s, -s * cy, 0.0, 0.0, 1.0);
+    let out = std::array::from_fn(|i| Point2::new((pts[i].x - cx) * s, (pts[i].y - cy) * s));
+    Some((out, t))
+}
+
+/// Same as [`normalize`] for a slice of any length.
+fn normalize_slice(pts: &[Point2]) -> Option<(Vec<Point2>, Matrix3<f64>)> {
+    let n = pts.len() as f64;
+    if pts.len() < 4 {
+        return None;
+    }
+    let cx = pts.iter().map(|p| p.x).sum::<f64>() / n;
+    let cy = pts.iter().map(|p| p.y).sum::<f64>() / n;
+    let mean_dist =
+        pts.iter().map(|p| ((p.x - cx).powi(2) + (p.y - cy).powi(2)).sqrt()).sum::<f64>() / n;
+    if mean_dist < 1e-12 {
+        return None;
+    }
+    let s = std::f64::consts::SQRT_2 / mean_dist;
+    let t = Matrix3::new(s, 0.0, -s * cx, 0.0, s, -s * cy, 0.0, 0.0, 1.0);
+    let out = pts.iter().map(|p| Point2::new((p.x - cx) * s, (p.y - cy) * s)).collect();
+    Some((out, t))
+}
+
+/// Least-squares DLT homography from any number of correspondences (>= 4).
+///
+/// Unlike [`homography_from_quad`] this does not assume `h22 != 0`; the
+/// solution is the right singular vector of the constraint matrix belonging to
+/// the smallest singular value, which stays well behaved when the exact
+/// solution has `h22 == 0` and lets extra correspondences average out noise.
+pub fn homography_from_points(src: &[Point2], dst: &[Point2]) -> Option<Homography> {
+    if src.len() != dst.len() || src.len() < 4 {
+        return None;
+    }
+    let (ns, ts) = normalize_slice(src)?;
+    let (nd, td) = normalize_slice(dst)?;
+
+    // At least 9 rows: with exactly 4 correspondences the constraint matrix is
+    // 8x9, and a thin SVD of a wide matrix returns only 8 right singular
+    // vectors - the null vector we are after would be missing entirely. Extra
+    // all-zero rows leave the null space untouched and force a square V^T.
+    let rows = (2 * ns.len()).max(9);
+    let mut a = nalgebra::DMatrix::<f64>::zeros(rows, 9);
+    for i in 0..ns.len() {
+        let (x, y) = (ns[i].x, ns[i].y);
+        let (u, v) = (nd[i].x, nd[i].y);
+        a[(2 * i, 0)] = -x;
+        a[(2 * i, 1)] = -y;
+        a[(2 * i, 2)] = -1.0;
+        a[(2 * i, 6)] = u * x;
+        a[(2 * i, 7)] = u * y;
+        a[(2 * i, 8)] = u;
+
+        a[(2 * i + 1, 3)] = -x;
+        a[(2 * i + 1, 4)] = -y;
+        a[(2 * i + 1, 5)] = -1.0;
+        a[(2 * i + 1, 6)] = v * x;
+        a[(2 * i + 1, 7)] = v * y;
+        a[(2 * i + 1, 8)] = v;
+    }
+
+    let svd = a.svd(false, true);
+    let vt = svd.v_t.as_ref()?;
+    // Smallest singular value is last; nalgebra does not guarantee ordering, so
+    // find it explicitly.
+    let mut best = 0usize;
+    for i in 1..svd.singular_values.len() {
+        if svd.singular_values[i] < svd.singular_values[best] {
+            best = i;
+        }
+    }
+    let h = vt.row(best);
+    if !h.iter().all(|v| v.is_finite()) {
+        return None;
+    }
+    let hn = Matrix3::new(h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]);
+    let td_inv = td.try_inverse()?;
+    let m = td_inv * hn * ts;
+    // Fix the arbitrary scale so callers get a repeatable matrix.
+    let norm = m.norm();
+    if norm < 1e-12 {
+        return None;
+    }
+    Some(Homography::from_matrix(m / norm))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn approx(a: f64, b: f64, tol: f64) -> bool {
+        (a - b).abs() < tol
+    }
+
+    #[test]
