@@ -0,0 +1,105 @@
+"""Spread statistics for poses.
+
+Kept apart from the bench because they are pure functions over pose data and
+are worth reading on their own -- particularly :func:`mean_rotation`, which is
+the one place where averaging rotations correctly matters.
+"""
+
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+from . import transforms as tf
+
+__all__ = ["translation_stats", "rotation_stats", "mean_rotation", "fmt_pose"]
+
+
+def translation_stats(points: np.ndarray) -> dict:
+    """Spread of a set of 3-D positions, in millimetres."""
+    p = np.asarray(points, np.float64).reshape(-1, 3)
+    mean = p.mean(axis=0)
+    radial = np.linalg.norm(p - mean, axis=1)
+    return {
+        "n": int(len(p)),
+        "mean_m": mean,
+        "std_xyz_mm": p.std(axis=0, ddof=1) * 1e3 if len(p) > 1 else np.zeros(3),
+        "rms_mm": float(np.sqrt(np.mean(radial ** 2)) * 1e3),
+        "max_mm": float(radial.max()) * 1e3,
+    }
+
+
+def mean_rotation(rotations: np.ndarray) -> np.ndarray:
+    """Chordal mean: the orthonormal matrix closest to the arithmetic mean.
+
+    Averaging Euler triples instead would be wrong -- they wrap, and near
+    gimbal lock they are not even unique.
+    """
+    r = np.asarray(rotations, np.float64).reshape(-1, 3, 3).mean(axis=0)
+    u, _, vt = np.linalg.svd(r)
+    m = u @ vt
+    if np.linalg.det(m) < 0:                     # keep it a rotation, not a flip
+        u[:, -1] *= -1.0
+        m = u @ vt
+    return m
+
+
+def rotation_stats(rotations: np.ndarray) -> dict:
+    """Spread of a set of rotations about their mean, in degrees."""
+    r = np.asarray(rotations, np.float64).reshape(-1, 3, 3)
+    mean = mean_rotation(r)
+    ang = np.array([math.degrees(tf.rotation_angle(mean.T @ ri)) for ri in r])
+    return {
+        "n": int(len(r)),
+        "mean_rotation": mean,
+        "rms_deg": float(np.sqrt(np.mean(ang ** 2))),
+        "max_deg": float(ang.max()),
+        "per_sample_deg": ang,
+    }
+
+
+def fmt_pose(pose) -> str:
+    p = np.asarray(pose, np.float64).ravel()
+    if p.size == 16:
+        p = tf.matrix_to_pose(p.reshape(4, 4))
+    return ("[{:+.2f} {:+.2f} {:+.2f} mm  {:+7.2f} {:+7.2f} {:+7.2f} deg]"
+            .format(*(1000 * p[:3]), *np.degrees(p[3:])))
+
+def _center_angles(radians: np.ndarray) -> np.ndarray:
+    """Shift each column so its circular mean is 0, wrapped into ``[-pi, pi]``."""
+    a = np.asarray(radians, np.float64)
+    mean = np.arctan2(np.sin(a).mean(axis=0), np.cos(a).mean(axis=0))
+    return (a - mean + np.pi) % (2.0 * np.pi) - np.pi
+
+
+def pose_axis_stats(poses: np.ndarray) -> dict:
+    """Per-axis std and max−min of 6-DoF poses ``[x, y, z, rx, ry, rz]``.
+
+    Translations are reported in millimetres, rotations in degrees.
+    Rotation columns are centred on their circular mean so a cluster
+    near ±π is not reported as a 2π spread.
+    """
+    p = np.asarray(poses, np.float64).reshape(-1, 6).copy()
+
+    mean_xyz = p[:, :3].mean(axis=0)
+    mean_rpy = tf.matrix_to_euler(mean_rotation(np.stack([tf.euler_to_matrix(*pose[3:6]) for pose in p])))
+
+    xyz = p[:, :3]
+    rpy = _center_angles(p[:, 3:])
+    if len(p) > 1:
+        std_xyz = xyz.std(axis=0, ddof=1)
+        std_rpy = rpy.std(axis=0, ddof=1)
+        range_xyz = xyz.max(axis=0) - xyz.min(axis=0)
+        range_rpy = rpy.max(axis=0) - rpy.min(axis=0)
+    else:
+        std_xyz = range_xyz = np.zeros(3)
+        std_rpy = range_rpy = np.zeros(3)
+    return {
+        "mean_xyz_mm": mean_xyz * 1e3,
+        "mean_rpy_deg": np.degrees(mean_rpy),
+        "std_xyz_mm": std_xyz * 1e3,
+        "std_rpy_deg": np.degrees(std_rpy),
+        "range_xyz_mm": range_xyz * 1e3,
+        "range_rpy_deg": np.degrees(range_rpy),
+    }
