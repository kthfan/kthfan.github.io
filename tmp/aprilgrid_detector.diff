@@ -0,0 +1,136 @@
+"""Unit tests for the cast-shadow model used by ``tools/shadow_test.py``.
+
+These check the *renderer*, not the detector: if the shadow lands on the wrong
+side, at the wrong place, or at the wrong depth, every number the shadow test
+reports is about a different scene than the one it claims.
+
+    python tools/test_shadow_model.py
+"""
+
+import math
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import cv2
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from robotlab.core.board import Board              # noqa: E402
+from robotlab.sim.render import Shadow, cast_shadow  # noqa: E402
+from shadow_test import classify_tag, pose_error     # noqa: E402
+
+
+def test_hard_edge_splits_the_plane_on_the_normal_side():
+    s = Shadow(angle_deg=0.0, offset=0.010, strength=0.8)
+    # Normal points along +x: x > 10 mm is in shadow.
+    assert s.cover(np.array([0.009]), np.array([0.0]))[0] == 0.0
+    assert s.cover(np.array([0.011]), np.array([0.0]))[0] == 1.0
+    # y is irrelevant for a vertical edge.
+    assert s.cover(np.array([0.011]), np.array([-5.0]))[0] == 1.0
+
+
+def test_soft_edge_is_half_covered_on_the_geometric_edge_and_monotone():
+    s = Shadow(angle_deg=90.0, offset=0.0, strength=1.0, penumbra=0.004)
+    y = np.linspace(-0.004, 0.004, 81)
+    c = s.cover(np.zeros_like(y), y)
+    assert c[0] == 0.0 and c[-1] == 1.0
+    assert math.isclose(c[40], 0.5, abs_tol=1e-9)
+    assert np.all(np.diff(c) >= 0.0)
+    # The ramp spans exactly the penumbra: fully lit/dark just beyond +-p/2.
+    assert s.cover(np.array([0.0]), np.array([-0.0021]))[0] == 0.0
+    assert s.cover(np.array([0.0]), np.array([0.0021]))[0] == 1.0
+
+
+def test_bar_narrower_than_its_penumbra_has_no_umbra():
+    # A thin occluder far from the board casts only penumbra: the light source
+    # is never fully hidden, so the centre must stay short of full cover.
+    thin = Shadow(angle_deg=0.0, offset=0.0, strength=1.0, penumbra=0.004, width=0.002)
+    assert 0.0 < thin.cover(np.array([0.0]), np.array([0.0]))[0] < 1.0
+    wide = Shadow(angle_deg=0.0, offset=0.0, strength=1.0, penumbra=0.001, width=0.004)
+    assert wide.cover(np.array([0.0]), np.array([0.0]))[0] == 1.0
+    assert wide.cover(np.array([0.003]), np.array([0.0]))[0] == 0.0
+    assert wide.cover(np.array([-0.003]), np.array([0.0]))[0] == 0.0
+
+
+def test_cast_shadow_darkens_by_strength_on_the_right_side_of_the_sheet():
+    board = Board()
+    sheet, ppm = board.render()
+    # Edge at x = -2 mm (inside the left margin), shadow toward -x. The left
+    # margin left of the edge goes dark; everything else is untouched.
+    s = Shadow(angle_deg=180.0, offset=0.002, strength=0.6)
+    out = cast_shadow(sheet, board, ppm, s)
+
+    assert out.dtype == np.uint8 and out.shape == sheet.shape
+    # Sheet pixel u has its centre at object x = -margin + (u + 0.5) / ppm.
+    u_dark = int(0.5 * (board.margin - 0.002) * ppm)    # x ~ -3.5 mm
+    u_lit = int((board.margin - 0.001) * ppm)           # x ~ -1 mm
+    row = sheet.shape[0] // 2
+    assert sheet[row, u_dark] == 255
+    assert out[row, u_dark] == round(255 * 0.4)
+    assert out[row, u_lit] == 255
+    # Multiplicative: black ink stays black, so contrast shrinks, not shifts.
+    assert np.array_equal(out[sheet == 0], sheet[sheet == 0])
+    # Input is not mutated.
+    assert sheet[row, u_dark] == 255
+
+
+def test_tags_are_classified_by_how_much_of_them_the_shadow_touches():
+    board = Board()
+    t1_mid = board.tag_corners(1)[:, 0].mean()
+    # Vertical edge through the middle of tag 1, shadow toward +x.
+    s = Shadow(angle_deg=0.0, offset=float(t1_mid), strength=0.7)
+    assert classify_tag(board, 0, s) == "lit"
+    assert classify_tag(board, 1, s) == "partial"
+    assert classify_tag(board, 2, s) == "shadowed"
+    assert classify_tag(board, 3, s) == "shadowed"
+
+
+def test_an_edge_through_the_quiet_zone_counts_as_partial():
+    # The detector needs the white ring around the black border as much as
+    # the tag itself, so a shadow edge splitting that ring is a partial shadow
+    # even though no tag pixel is lit.
+    board = Board()
+    cell = board.tag_size / 8
+    left_of_tag2 = float(board.tag_corners(2)[0, 0])
+    s = Shadow(angle_deg=0.0, offset=left_of_tag2 - 0.5 * cell, strength=0.7)
+    assert classify_tag(board, 2, s) == "partial"
+    # Two cells out it no longer touches the ring.
+    s = Shadow(angle_deg=0.0, offset=left_of_tag2 - 2.0 * cell, strength=0.7)
+    assert classify_tag(board, 2, s) == "shadowed"
+
+
+def test_pose_error_is_translation_in_mm_and_geodesic_rotation_in_degrees():
+    rvec, tvec = np.array([0.1, -0.2, 0.3]), np.array([0.01, 0.02, 0.30])
+    same = SimpleNamespace(rvec=tuple(rvec), translation=tuple(tvec))
+    assert pose_error(same, rvec, tvec) == (0.0, 0.0)
+
+    # Rotate the truth by 1 deg about its own z and shift it 3 mm along x.
+    r = cv2.Rodrigues(rvec)[0] @ cv2.Rodrigues(np.array([0.0, 0.0, math.radians(1.0)]))[0]
+    off = SimpleNamespace(rvec=tuple(cv2.Rodrigues(r)[0].ravel()),
+                          translation=tuple(tvec + [0.003, 0.0, 0.0]))
+    mm, deg = pose_error(off, rvec, tvec)
+    assert math.isclose(mm, 3.0, rel_tol=1e-9)
+    assert math.isclose(deg, 1.0, rel_tol=1e-6)
+
+
+def test_a_zero_strength_shadow_leaves_the_sheet_bit_identical():
+    board = Board()
+    sheet, ppm = board.render()
+    out = cast_shadow(sheet, board, ppm, Shadow(angle_deg=30.0, offset=0.03, strength=0.0))
+    assert np.array_equal(out, sheet)
