+        let x0 = MARGIN + (fam.border_cells + c) * CELL;
+        let y0 = MARGIN + (fam.border_cells + r) * CELL;
+        let flipped = 255 - img.get(x0 + CELL / 2, y0 + CELL / 2);
+        for y in 0..CELL {
+            for x in 0..CELL {
