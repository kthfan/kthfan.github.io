+    #[test]
+    fn homography_maps_the_unit_square_onto_the_target_quad() {
+        let src = [
+            Point2::new(0.0, 0.0),
+            Point2::new(1.0, 0.0),
+            Point2::new(1.0, 1.0),
+            Point2::new(0.0, 1.0),
