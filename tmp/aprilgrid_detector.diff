+"""The simulated backend: a scene, a teleporting arm, and full ground truth."""
+
+from __future__ import annotations
+
+import numpy as np
+
+from ..core import transforms as tf
+from ..core.backend import Backend, Truth
+from ..core.config import Config
+from .robot import SimCamera, SimRobot
+from .scene import BoardPlacement, Scene
+
+__all__ = ["SimBackend", "SimTruth"]
+
+
+class SimTruth(Truth):
+    """Where things really are. Only meaningful inside the simulator."""
+
+    def __init__(self, backend: "SimBackend"):
+        self.b = backend
+        self._initial = [p.T_base_board.copy() for p in backend.scene.placements]
+
+    def board_matrix(self, index: int = 0) -> np.ndarray:
+        return self.b.scene.placements[index].T_base_board.copy()
+
+    def tool_position(self, T_ee_tool) -> np.ndarray:
+        return self.b.sim_robot.true_tool_matrix(T_ee_tool)[:3, 3]
+
+    def moved(self) -> bool:
+        return any(not np.allclose(p.T_base_board, t0, atol=1e-12)
+                   for p, t0 in zip(self.b.scene.placements, self._initial))
+
+    def move_board(self, index: int, T_base_board) -> None:
+        """Physically shift a board -- used to make the touch test honest."""
+        self.b.scene.placements[index].T_base_board = tf.as_matrix(T_base_board)
+        self.b.scene._cache.clear()
+
+
+class SimBackend(Backend):
+    name = "sim"
+    interactive = False
+
+    def __init__(self, cfg: Config, board_count: int = 1, rng=None):
+        super().__init__(cfg)
+        self.rng = rng if rng is not None else np.random.default_rng(
+            int(cfg.tests["seed"]))
+
+        tags = cfg.tags_per_board()
+        start = cfg.start_id()
+        T_base_grid = cfg.pose("scene", "T_base_grid")
+        T_grid_grid2 = cfg.pose("scene", "T_grid_grid2")
+        placements = []
+        for i in range(board_count):
+            T = T_base_grid if i == 0 else T_base_grid @ T_grid_grid2
+            placements.append(BoardPlacement(cfg.board(start_id=start + i * tags), T))
+
+        self.scene = Scene(self._config_camera, placements, cfg.degradations(),
+                           self.rng, int(cfg.scene.get("background", 210)))
+
+        r = cfg.robot
+        self.sim_robot = SimRobot(
+            hand_eye=cfg.hand_eye(),
+            initial_pose=np.asarray(r["home_pose"], np.float64),
+            sigma_pos_m=float(r.get("sigma_pos_m", 0.0)),
+            sigma_rot_rad=float(r.get("sigma_rot_rad", 0.0)),
+            sigma_report_pos_m=float(r.get("sigma_report_pos_m", 0.0)),
+            sigma_report_rot_rad=float(r.get("sigma_report_rot_rad", 0.0)),
+            true_hand_eye=cfg.hand_eye_true(),
+            rng=self.rng,
+        )
+        self.sim_camera = SimCamera(self.scene, self.sim_robot)
+        self._truth = SimTruth(self)
+
+    @property
+    def robot(self) -> SimRobot:
+        return self.sim_robot
+
+    @property
+    def source(self) -> SimCamera:
+        return self.sim_camera
+
+    def truth(self) -> SimTruth:
+        return self._truth
+
+    def viewing_pose(self) -> np.ndarray:
+        # The renderer used the true pose, so overlays must too, otherwise a
+        # deliberately wrong hand-eye would move the drawn marker along with
+        # the error and hide it.
+        return self.sim_robot.true_camera_matrix()
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/sim/render.py" "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/sim/render.py"
