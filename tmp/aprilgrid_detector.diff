@@ -0,0 +1,260 @@
+"""Touch test: use the grid to put a tool tip on an object.
+
+A tool sticks out of the end effector at a known ``T_ee_tool``. A small target
+object sits next to the AprilGrid at a known ``T_grid_target``. Neither is ever
+seen by the camera -- the only measurement is the grid pose, and everything
+else is a chain of known transforms::
+
+    T_base_target = T_base_ee @ T_ee_cam @ T_cam_grid @ T_grid_target
+    T_base_ee_cmd = T_base_target @ inv(T_ee_tool)
+
+which is what vision-guided manipulation actually does. The distance between
+the tool tip and the target after the move is the number that matters, and it
+is the only place where all the errors -- detection, hand-eye, and the arm's
+own repeatability -- add up instead of cancelling.
+
+The run is a paused loop::
+
+    move to next pose -> touch -> measure -> move to next pose -> ...
+
+How the miss is measured is the one thing that differs between backends. In
+simulation it is read off ground truth. On a real arm there is no such thing,
+so the operator looks at the tool, measures, and types the numbers in. That
+makes the real test slower and coarser, and honest.
+
+The tool is drawn as a blue point and the target as a red point, projected
+through the same camera model the detector uses -- on hardware that overlay is
+worth watching, because a gross calibration error is visible in it before
+anything moves.
+
+    python tools/robotlab/run.py touch --rounds 5 --show
+    python tools/robotlab/run.py touch --auto            # simulation only
+    python tools/robotlab/run.py touch --backend techman
+"""
+
+from __future__ import annotations
+
+from ._common import GO, QUIT, SKIP, Session, common_args, fmt_pose, np, open_session, tf
+from robotlab.core.robot import Marker
+
+
+def run(args) -> int:
+    session = open_session(args, board_count=1)
+    rounds = args.rounds if args.rounds is not None else int(
+        session.cfg.tests["touch_rounds"])
+    try:
+        return _measure(session, args, rounds)
+    finally:
+        session.close()
+
+
+def _measure(session: Session, args, rounds: int) -> int:
+    cfg, bench, console = session.cfg, session.bench, session.console
+    truth = session.truth
+
+    T_ee_tool = cfg.pose("scene", "T_ee_tool")
+    T_grid_target = cfg.pose("scene", "T_grid_target")
+    tool_colour = tuple(int(c) for c in cfg.scene["tool_marker_bgr"])
+    target_colour = tuple(int(c) for c in cfg.scene["target_marker_bgr"])
+    tool_radius = float(cfg.scene["tool_marker_radius_m"])
+    target_radius = float(cfg.scene["target_marker_radius_m"])
+
+    def markers(T_base_target=None):
+        """Rebuilt every frame: the tool marker follows the arm."""
+        tip = (truth.tool_position(T_ee_tool) if truth is not None
+               else bench.robot.get_tool_matrix(T_ee_tool)[:3, 3])
+        out = [Marker(tip, tool_colour, tool_radius, "tool")]
+        if T_base_target is not None:
+            out.insert(0, Marker(T_base_target[:3, 3], target_colour,
+                                 target_radius, "target"))
+        return out
+
+    print(__doc__.splitlines()[0])
+    print(f"  tool     T_ee_tool     = {fmt_pose(T_ee_tool)}")
+    print(f"  target   T_grid_target = {fmt_pose(T_grid_target)}")
+    print("  answers: [Enter] continue   s skip this viewpoint   q quit\n")
+
+    T_base_grid_rough = session.start_view()
+    bench.save("00_start_view", bench.capture(markers()))
+    print(f"start view  T_base_grid ~ {fmt_pose(T_base_grid_rough)}")
+
+    centre = bench.centre_frame(T_base_grid_rough)
+    accept = bench.visibility_from_estimate(T_base_grid_rough)
+    target_true = (truth.board_matrix(0) @ T_grid_target)[:3, 3] if truth else None
+
+    results = []
+    for i in range(rounds):
+        print(f"\n--- round {i + 1}/{rounds} " + "-" * 44)
+
+        # 1. MOVE TO DETECT POSE
+        vp = session.sampler.sample(centre, accept)
+        answer = session.goto(vp.T_base_cam, "move to the next viewpoint")
+        if answer is QUIT:
+            break
+        if answer is not GO:
+            continue
+
+        # 2. DETECT
+        frame, board, T_base_grid = bench.observe(markers=markers())
+        bench.save(f"round_{i:02d}_view", frame)
+        bench.display("touch test", frame, wait=200)
+
+        if board is None:
+            print("  grid not detected from this viewpoint; skipping")
+            continue
+        print(f"  viewpoint  r={vp.radius_m:.3f} m  theta={vp.theta_deg:.1f} deg  "
+              f"phi={vp.phi_deg:.1f} deg  coverage={board.coverage:.2f}")
+        print(f"  grid       {fmt_pose(T_base_grid)}")
+
+        T_base_target = T_base_grid @ T_grid_target
+        print(f"  target     {fmt_pose(T_base_target)}")
+        est_err = None
+        if target_true is not None:
+            est_err = float(np.linalg.norm(T_base_target[:3, 3] - target_true))
+            print(f"  [simulation only] estimate is {est_err * 1e3:.3f} mm from "
+                  f"the true target")
+
+        # Show where the arm believes the target is before it commits.
+        preview = bench.capture(markers(T_base_target))
+        bench.display("touch test", preview, wait=200)
+        bench.save(f"round_{i:02d}_aim", preview)
+
+        answer = console.ask("touch?")
+        if answer is QUIT:
+            break
+        if answer is SKIP:
+            continue
+
+        # Calculate standoff pose if applicable
+        T_standoff = (
+            T_base_target @ tf.pose_to_matrix([0, 0, -args.standoff, 0, 0, 0])
+            if args.standoff > 0.0 else None
+        )
+
+        try:
+            # 3. TOUCH WITH STAND OFF
+            if T_standoff is not None:
+                bench.robot.move_tool_to(T_standoff, T_ee_tool)
+                if session.interactive and console.ask("close the last few mm?") is not GO:
+                    continue
+
+            # 4. TOUCH
+            bench.robot.move_tool_to(T_base_target, T_ee_tool)
+        except Exception as exc:              # noqa: BLE001 - reported, not fatal
+            print(f"  move refused: {exc}")
+            continue
+
+        touch_frame = bench.capture(markers(T_base_target))
+        bench.save(f"round_{i:02d}_touch", touch_frame)
+        bench.display("touch test", touch_frame, wait=200)
+
+        # The approach direction, from the target frame the arm aimed at, so
+        # "too deep" and "missed sideways" stay separable on both backends.
+        approach = T_base_target[:3, 2] / np.linalg.norm(T_base_target[:3, 2])
+        measured = _measure_miss(session, approach, target_true, T_ee_tool)
+
+        # 5. MOVE BACK WITH STAND OFF
+        if T_standoff is not None:
+            try:
+                bench.robot.move_tool_to(T_standoff, T_ee_tool)
+            except Exception as exc:          # noqa: BLE001 - reported, not fatal
+                print(f"  retract to standoff refused: {exc}")
+
+        if measured is None:
+            print("  no measurement recorded for this round")
+            continue
+        along, lateral = measured
+        total = float(np.hypot(along, lateral))
+
+        print(f"  TOUCH      miss {total * 1e3:.3f} mm  "
+              f"(lateral {lateral * 1e3:.3f} mm, along approach {along * 1e3:+.3f} mm)")
+        results.append({
+            **vp.params(), "coverage": board.coverage,
+            "T_base_grid": tf.matrix_to_pose(T_base_grid),
+            "T_base_target": tf.matrix_to_pose(T_base_target),
+            "estimate_error_mm": None if est_err is None else est_err * 1e3,
+            "touch_error_mm": total * 1e3,
+            "lateral_mm": lateral * 1e3, "along_mm": along * 1e3,
+        })
+
+        if session.interactive:
+            if console.ask("continue to next round?") is QUIT:
+                break
+
+    if truth is not None:
+        assert not truth.moved(), "the AprilGrid moved during the test"
+
+    print("\n" + "=" * 74)
+    if not results:
+        print("no touches completed")
+        return 1
+    err = np.array([r["touch_error_mm"] for r in results])
+    lat = np.array([r["lateral_mm"] for r in results])
+    print(f"touch test: {len(results)} touches  [{session.backend.name}]")
+    print("=" * 74)
+    est = [r["estimate_error_mm"] for r in results if r["estimate_error_mm"] is not None]
+    if est:
+        est = np.array(est)
+        print(f"  target estimate error  {est.mean():.3f} mm mean, "
+              f"{est.max():.3f} mm max  [simulation only]")
+    print(f"  touch error            {err.mean():.3f} mm mean, {err.max():.3f} mm max")
+    print(f"  lateral component      {lat.mean():.3f} mm mean, {lat.max():.3f} mm max")
+
+    bench.write_json("touch", {
+        "backend": session.backend.name, "seed": session.seed,
+        "rounds": rounds, "touches": len(results),
+        "measurement": "ground truth" if truth is not None else "operator",
+        "T_ee_tool": cfg.scene["T_ee_tool"],
+        "T_grid_target": cfg.scene["T_grid_target"],
+        "touch_error_mm": {"mean": float(err.mean()), "max": float(err.max())},
+        "lateral_mm": {"mean": float(lat.mean()), "max": float(lat.max())},
+        "rounds_detail": results,
+    })
+    if bench.out_dir:
+        print(f"  wrote {bench.out_dir}")
+    return 0
+
+
+def _measure_miss(session: Session, approach, target_true, T_ee_tool):
+    """Return ``(along, lateral)`` in metres, or ``None`` if not measured.
+
+    In simulation this is arithmetic on ground truth. On hardware there is no
+    ground truth to do arithmetic on, so the operator measures the gap and
+    types it in -- coarser, but it is the same quantity.
+    """
+    truth = session.truth
+    if truth is not None:
+        error = truth.tool_position(T_ee_tool) - target_true
+        along = float(np.dot(error, approach))
+        return along, float(np.linalg.norm(error - along * approach))
+
+    print("  measure the tool tip against the target:")
+    lateral = session.console.ask_float(
+        "lateral miss, perpendicular to the approach [mm, blank to skip round]")
+    if lateral is None:
+        return None
+    along = session.console.ask_float(
+        "miss along the approach [mm, + = too deep, blank = 0]", 0.0)
+    if along is None:
+        return None
+    return along * 1e-3, abs(lateral) * 1e-3
+
+
+def add_args(p):
+    p.add_argument("--rounds", type=int, help="number of move/touch cycles")
+    p.add_argument("--out", default="data/robotlab/touch",
+                   help="directory for images and the JSON summary")
+    p.add_argument("--standoff", type=float, default=0.25,
+                   help="metres to approach from along the tool -z; 0 disables")
+    return p
+
+
+def main() -> int:
+    p = add_args(common_args(__doc__.splitlines()[0]))
+    p.add_argument("--auto", action="store_true",
+                   help="run without pausing (simulation only)")
+    return run(p.parse_args())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/shadow_test.py" "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/shadow_test.py"
new file mode 100644
index 0000000..181b444
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/shadow_test.py"
@@ -0,0 +1,372 @@
+"""Shadow test: how a partial cast shadow affects detection.
+
+A shadow edge crossing a tag is not like the illumination ramp the simulator
+already applies. The ramp is smooth over the whole frame; a shadow puts a
+sharp (or penumbral) step of light *inside* the tag, so one part of the
+outline sits on bright paper and the rest in the dark. That can break the
+adaptive threshold, split the boundary cluster, bias the sub-pixel edge
+location, and flip payload bits whose cells straddle the edge.
+
+This renders the board from a few fixed viewpoints and casts controlled
+shadows on the printed sheet (so they are foreshortened and lens-distorted
+with the tags), sweeping:
+
+  * shape     -- ``edge``: a half-plane, e.g. the shadow of an arm or fixture;
+                 ``bar``: a narrow band, e.g. a cable or rod
+  * penumbra  -- hard, 1 cell, 4 cells (a tag is 8 cells wide)
+  * strength  -- fraction of the light blocked in the umbra
+
+Each config is placed at many positions and angles, each passing through some
+tag. Every tag is then scored in one of three groups:
+
+  * partial   -- the shadow edge crosses the tag (the case under test)
+  * shadowed  -- the tag sits entirely inside the umbra
+  * lit       -- untouched (should match the no-shadow baseline)
+
+The sensor noise draw is reseeded per viewpoint, so every config sees the
+identical image apart from the shadow: differences are caused by the shadow
+alone. Like the robot-arm tests, this reports measurements rather than
+asserting thresholds. The one thing it asserts is its precondition: with no
+shadow, every tag must be found, or the numbers would be measuring the pose
+rather than the shadow.
+
+    python tools/shadow_test.py
+    python tools/shadow_test.py --distance 0.6 --decimate 2
+    python tools/shadow_test.py --examples data/shadow_examples
+"""
+
+from __future__ import annotations
+
+import argparse
+import math
+import os
+import sys
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from robotlab.core.board import Board                       # noqa: E402
+from robotlab.core.camera import CameraModel                # noqa: E402
+from robotlab.sim import render                             # noqa: E402
+from robotlab.sim.render import Degradations, Shadow        # noqa: E402
+
+# 36h11 is 6x6 data cells inside a one-cell black border.
+CELLS_PER_TAG = 8
+
+STRENGTHS = (0.3, 0.5, 0.7, 0.85, 0.95)
+PENUMBRA_CELLS = (0.0, 1.0, 4.0)
+BAR_WIDTH_CELLS = 1.5
+ANGLES_DEG = tuple(range(0, 360, 45))
+# Where the edge crosses the target tag, as a fraction of the tag size from
+# its centre along the edge normal.
+OFFSETS = (-0.25, 0.0, 0.25)
+# (tilt, tilt azimuth, roll), degrees. Fronto-parallel plus two oblique views.
+VIEWS = ((0.0, 0.0, 0.0), (35.0, 20.0, 15.0), (50.0, 110.0, 160.0))
+
+LENS = (-0.18, 0.04, 0.0004, -0.0003, -0.002)
+
+
+def classify_tag(board: Board, index: int, shadow: Shadow, samples: int = 21) -> str:
+    """'lit', 'partial' or 'shadowed', by how much of the tag the shadow covers.
+
+    The tag is taken with a one-cell ring of quiet zone around it: the
+    detector finds the outline as a black/white boundary, so an edge running
+    through that white ring splits the tag's contrast just as surely as one
+    running through the tag.
+    """
+    c = board.tag_corners(index)
+    ring = board.tag_size / CELLS_PER_TAG
+    xs = np.linspace(c[0, 0] - ring, c[1, 0] + ring, samples)
+    ys = np.linspace(c[0, 1] - ring, c[3, 1] + ring, samples)
+    cover = shadow.cover(xs[None, :], ys[:, None])
+    if shadow.strength <= 0.0 or cover.max() < 0.02:
+        return "lit"
+    if cover.min() > 0.98:
+        return "shadowed"
+    return "partial"
+
+
+def view_pose(board: Board, tilt: float, azimuth: float, roll: float,
+              distance: float) -> tuple[np.ndarray, np.ndarray]:
+    """Board pose with its centre on the optical axis, as (rvec, tvec)."""
+    a = math.radians(azimuth)
+    axis = np.array([math.cos(a), math.sin(a), 0.0]) * math.radians(tilt)
+    r = cv2.Rodrigues(np.array([0.0, 0.0, math.radians(roll)]))[0] @ cv2.Rodrigues(axis)[0]
+    bw, bh = board.extent
+    t = np.array([0.0, 0.0, distance]) - r @ np.array([bw / 2.0, bh / 2.0, 0.0])
+    return cv2.Rodrigues(r)[0].ravel(), t
+
+
+def placements(board: Board):
+    """Edge placements, each passing through some tag, cycling the target tag."""
+    k = 0
+    for angle in ANGLES_DEG:
+        a = math.radians(angle)
+        n = np.array([math.cos(a), math.sin(a)])
+        for frac in OFFSETS:
+            centre = board.tag_corners(k % board.tag_count)[:, :2].mean(axis=0)
+            yield angle, float(n @ centre + frac * board.tag_size)
+            k += 1
+
+
+@dataclass
+class Group:
+    n: int = 0
+    found: int = 0
+    sq_err: float = 0.0
+    corners: int = 0
+
+    def add(self, hit: bool, errs=()):
+        self.n += 1
+        self.found += hit
+        for e in errs:
+            self.sq_err += e * e
+            self.corners += 1
+
+    def rate(self) -> str:
+        return f"{100.0 * self.found / self.n:6.1f}%" if self.n else "     - "
+
+    def rmse(self) -> str:
+        return f"{math.sqrt(self.sq_err / self.corners):5.2f}" if self.corners else "   - "
+
+
+def pose_error(pose, rvec, tvec) -> tuple[float, float]:
+    """(translation error in mm, geodesic rotation error in degrees)."""
+    dt = np.asarray(pose.translation, float) - np.asarray(tvec, float)
+    r_est = cv2.Rodrigues(np.asarray(pose.rvec, float))[0]
+    r_true = cv2.Rodrigues(np.asarray(rvec, float))[0]
+    # |log(R_est^T R_true)|, not acos((tr - 1) / 2): acos is ill-conditioned
+    # near 1 and reads ~1e-6 deg for identical rotations.
+    rel = cv2.Rodrigues(r_est.T @ r_true)[0]
+    return float(np.linalg.norm(dt) * 1000.0), math.degrees(float(np.linalg.norm(rel)))
+
+
+@dataclass
+class PoseStats:
+    """Pose error under the shadow, and of a same-tags control without it.
+
+    A shadow hurts the pose two ways: it loses tags (fewer, less spread-out
+    points) and it biases the corners of tags it still finds. The control
+    re-fits the pose from the *unshadowed* corners of exactly the tags found
+    in the shadowed frame, so it carries the first effect only. The gap
+    between the two is the corner bias.
+    """
+
+    frames: int = 0
+    lost: int = 0
+    tags: int = 0
+    t: list = field(default_factory=list)
+    r: list = field(default_factory=list)
+    ct: list = field(default_factory=list)
+    cr: list = field(default_factory=list)
+
+    @staticmethod
+    def _fmt(v, w=5):
+        return f"{np.mean(v):{w}.2f} {np.max(v):{w}.2f}" if v else f"{'-':>{w}} {'-':>{w}}"
+
+    def row(self) -> str:
+        posed = len(self.t)
+        tags = f"{self.tags / posed:4.2f}" if posed else "   -"
+        return (f"{posed:>3}/{self.frames:<3} {tags} | {self._fmt(self.t)} | {self._fmt(self.r)} | "
+                f"{self._fmt(self.ct)} | {self._fmt(self.cr)}")
+
+
+def table_coords(board, ppm, h, cam):
+    """Board-plane (x, y) of every pinhole pixel, and whether it is in front.
+
+    The board lies on a table, and the shadow falls on the table too. Leaving
+    the surroundings lit puts bright background against a dark board end -- a
+    scene no real shadow produces, which (measured) cost fully shadowed end
+    tags their detection with the edge 16 cells away. So the background is
+    shaded on the board plane as well. Depends only on the view, so build once.
+    """
+    ys, xs = np.mgrid[0:cam.height, 0:cam.width]
+    p = np.linalg.inv(h) @ np.stack([xs.ravel(), ys.ravel(), np.ones(xs.size)])
+    # Pixels whose ray meets the plane behind the camera (beyond the horizon)
+    # have the opposite homogeneous sign to the board's own.
+    sw, sh = board.sheet_size(ppm)
+    front = p[2] * (h[2] @ np.array([sw / 2.0, sh / 2.0, 1.0])) > 0.0
+    with np.errstate(divide="ignore", invalid="ignore"):
+        ox = -board.margin + (p[0] / p[2] + 0.5) / ppm
+        oy = -board.margin + (p[1] / p[2] + 0.5) / ppm
+    return ox, oy, front & np.isfinite(ox) & np.isfinite(oy)
+
+
+def render_view(sheet, ppm, board, cam, rvec, tvec, deg, seed, shadow=None, table=None):
+    h = render.sheet_homography(board, ppm, rvec, tvec, cam)
+    canvas = np.full((cam.height, cam.width), 210, np.uint8)
+    if shadow is not None and shadow.strength > 0.0:
+        ox, oy, front = table if table is not None else table_coords(board, ppm, h, cam)
+        with np.errstate(invalid="ignore"):
+            gain = 1.0 - shadow.strength * shadow.cover(ox, oy)
+        gain = np.where(front, gain, 1.0).reshape(canvas.shape)
+        canvas = np.rint(canvas * gain).astype(np.uint8)
+    img = cv2.warpPerspective(sheet, h, (cam.width, cam.height), flags=cv2.INTER_AREA,
+                              borderMode=cv2.BORDER_TRANSPARENT, dst=canvas)
+    mx, my = render.distortion_maps(cam)
+    img = cv2.remap(img, mx, my, cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)
+    out, _ = render.degrade(img, np.random.default_rng(seed), deg)
+    return out
+
+
+def score(detector, img, board, truth_pts, classes, groups, fp, ctx=None, stats=None):
+    """Score one frame. With ``ctx``/``stats``, also score the board pose.
+
+    ``ctx`` is (layout, camera, rvec, tvec, unshadowed corners by id).
+    """
+    if ctx is None:
+        boards = []
+        dets = detector.detect(img)
+    else:
+        layout, camera, rvec, tvec, clean = ctx
+        boards = detector.detect_boards(img, layout, camera)
+        dets = [d for b in boards for d in b.detections]
+    found = {d.id: d for d in dets}
+    ids = {board.start_id + i for i in range(board.tag_count)}
+    fp[0] += sum(1 for i in found if i not in ids)
+    for i in range(board.tag_count):
+        d = found.get(board.start_id + i)
+        truth = truth_pts[4 * i:4 * i + 4]
+        errs = () if d is None else [
+            math.hypot(px - tx, py - ty) for (px, py), (tx, ty) in zip(d.corners, truth)
+        ]
+        groups[classes[i]].add(d is not None, errs)
+
+    if stats is None:
+        return
+    import aprilgrid_detector as agd
+
+    stats.frames += 1
+    pose = next((b.pose for b in boards if b.board_id == 0), None)
+    if pose is None:
+        stats.lost += 1
+        return
+    mm, deg = pose_error(pose, rvec, tvec)
+    stats.t.append(mm)
+    stats.r.append(deg)
+    kept = [i for i in range(board.tag_count) if board.start_id + i in found]
+    stats.tags += len(kept)
+    obj = [tuple(p) for i in kept for p in board.tag_corners(i)]
+    img_pts = [tuple(p) for i in kept for p in clean[board.start_id + i]]
+    cmm, cdeg = pose_error(agd.estimate_pose(obj, img_pts, camera), rvec, tvec)
+    stats.ct.append(cmm)
+    stats.cr.append(cdeg)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--distance", type=float, default=0.30,
+                    help="board distance in metres (0.30 -> ~67 px tags)")
+    ap.add_argument("--decimate", type=int, default=1)
+    ap.add_argument("--noise", type=float, default=2.0, help="sensor noise sigma, grey levels")
+    ap.add_argument("--blur", type=float, default=0.6, help="defocus sigma, pixels")
+    ap.add_argument("--seed", type=int, default=7)
+    ap.add_argument("--examples", help="write one image per config to this directory")
+    args = ap.parse_args()
+
+    import aprilgrid_detector as agd
+
+    board = Board()
+    sheet, ppm = board.render()
+    cam = CameraModel(width=1280, height=720, fx=1000.0, fy=1000.0, dist=LENS)
+    # Fixed, mild sensor model: the shadow is the only thing that varies.
+    deg = Degradations(
+        blur_sigma=(args.blur, args.blur), motion_px=(0.0, 0.0),
+        noise_sigma=(args.noise, args.noise), exposure=(1.0, 1.0),
+        vignette=(0.0, 0.0), illumination_ramp=(0.0, 0.0),
+        contrast_loss=(0.0, 0.0), occlusion_prob=0.0, jpeg_quality=None,
+    )
+    detector = agd.Detector(decimate=args.decimate)
+    cell = board.tag_size / CELLS_PER_TAG
+    views = [view_pose(board, *v, args.distance) for v in VIEWS]
+    truths = [render.project(board.all_corners(), rv, tv, cam) for rv, tv in views]
+    tables = [table_coords(board, ppm, render.sheet_homography(board, ppm, rv, tv, cam), cam)
+              for rv, tv in views]
+    places = list(placements(board))
+    if args.examples:
+        os.makedirs(args.examples, exist_ok=True)
+
+    tag_px = board.tag_size * cam.fx / args.distance
+    print(f"board {board.tags_x}x{board.tags_y}, ~{tag_px:.0f} px tags "
+          f"({tag_px / CELLS_PER_TAG:.1f} px/cell), decimate={args.decimate}, "
+          f"noise={args.noise}, blur={args.blur}")
+    print(f"{len(views)} views x {len(places)} placements per config")
+
+    # Precondition: the unshadowed scene must be fully detectable.
+    layout = agd.BoardLayout(tags_x=board.tags_x, tags_y=board.tags_y,
+                             tag_size=board.tag_size, tag_separation=board.tag_separation)
+    camera = cam.to_agd_camera()
+    base = {"lit": Group(), "partial": Group(), "shadowed": Group()}
+    base_pose = PoseStats()
+    clean = []
+    fp = [0]
+    for v, ((rv, tv), truth) in enumerate(zip(views, truths)):
+        img = render_view(sheet, ppm, board, cam, rv, tv, deg, args.seed + v)
+        clean.append({d.id: d.corners for d in detector.detect(img)})
+        score(detector, img, board, truth, ["lit"] * board.tag_count, base, fp,
+              (layout, camera, rv, tv, clean[v]), base_pose)
+    b = base["lit"]
+    print(f"\nbaseline, no shadow: {b.found}/{b.n} tags, corner rmse {b.rmse().strip()} px, "
+          f"{fp[0]} false positive(s)")
+    print(f"  pose error, mean / max: {np.mean(base_pose.t):.2f} / {np.max(base_pose.t):.2f} mm, "
+          f"{np.mean(base_pose.r):.3f} / {np.max(base_pose.r):.3f} deg")
+    if b.found != b.n or len(base_pose.t) != len(views):
+        print("PRECONDITION FAILED: tags are missed without any shadow; "
+              "the shadow numbers would be meaningless. Move the board closer.")
+        return 2
+
+    print(f"\n{'shape':<5} {'penumbra':>8} {'strength':>8} | "
+          f"{'partial':>7} {'rate':>7} {'rmse':>5} | "
+          f"{'umbra':>5} {'rate':>7} {'rmse':>5} | {'lit':>7} | FP")
+    t0 = time.perf_counter()
+    frames = 0
+    pose_rows = []
+    for shape, width in (("edge", None), ("bar", BAR_WIDTH_CELLS * cell)):
+        for pen in PENUMBRA_CELLS:
+            for strength in STRENGTHS:
+                groups = {"lit": Group(), "partial": Group(), "shadowed": Group()}
+                stats = PoseStats()
+                fp = [0]
+                for p, (angle, offset) in enumerate(places):
+                    s = Shadow(angle_deg=angle, offset=offset, strength=strength,
+                               penumbra=pen * cell, width=width)
+                    shaded = render.cast_shadow(sheet, board, ppm, s)
+                    classes = [classify_tag(board, i, s) for i in range(board.tag_count)]
+                    for v, ((rv, tv), truth) in enumerate(zip(views, truths)):
+                        img = render_view(shaded, ppm, board, cam, rv, tv, deg, args.seed + v,
+                                          shadow=s, table=tables[v])
+                        score(detector, img, board, truth, classes, groups, fp,
+                              (layout, camera, rv, tv, clean[v]), stats)
+                        frames += 1
+                        if args.examples and p == 1 and v == 1:
+                            name = f"{shape}_pen{pen:g}_str{strength:g}.png"
+                            cv2.imwrite(os.path.join(args.examples, name), img)
+                pa, sh, li = groups["partial"], groups["shadowed"], groups["lit"]
+                pen_s = "hard" if pen == 0 else f"{pen:g} cell"
+                print(f"{shape:<5} {pen_s:>8} {strength:>8.2f} | "
+                      f"{pa.n:>7} {pa.rate()} {pa.rmse()} | "
+                      f"{sh.n:>5} {sh.rate()} {sh.rmse()} | {li.rate()} | {fp[0]}")
+                pose_rows.append(f"{shape:<5} {pen_s:>8} {strength:>8.2f} | {stats.row()}")
+    dt = time.perf_counter() - t0
+    print(f"\n{frames} frames in {dt:.1f} s; rmse in px, over found tags only")
+
+    print("\npose error, mean and max over frames with a pose. 'control' re-fits the"
+          "\npose from the UNSHADOWED corners of the same tags, so it isolates the"
+          "\neffect of losing tags; shadow minus control is the corner bias.")
+    print(f"\n{'':<5} {'':>8} {'':>8} | {'posed':>7} {'tags':>4} | {'shadow mm':^11} | "
+          f"{'shadow deg':^11} | {'control mm':^11} | {'control deg':^11}")
+    print(f"{'shape':<5} {'penumbra':>8} {'strength':>8} | {'':>7} {'':>4} | "
+          + " | ".join([f"{'mean':>5} {'max':>5}"] * 4))
+    for row in pose_rows:
+        print(row)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
