+"""Minimal simulation of what an eye-in-hand camera sees.
+
+The scene is a handful of rigid things bolted to the robot's world: one or two
+printed AprilGrids. Nothing is animated and nothing is pre-rendered --
+:meth:`Scene.render` runs the pipeline once, on demand, for whatever camera
+pose it is handed, and caches the result so capturing twice without moving
+costs nothing.
+
+Rendering goes through :mod:`robotlab.sim.render`, which is already validated
+against the detector's ground truth: rasterise the printed sheet, warp it with
+the exact homography, bend the result through the radial-tangential lens
+model, then apply the sensor degradation stack.
+
+Operator overlays are *not* drawn here. They are projected by the bench, from
+the same camera model the real backend uses, so the touch test looks identical
+on hardware and the detector never sees them either way.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+import cv2
+import numpy as np
+
+from ..core import transforms as tf
+from ..core.board import Board
+from ..core.camera import CameraModel
+from . import render
+from .render import Degradations
+
+__all__ = ["BoardPlacement", "Scene"]
+
+
+@dataclass
+class BoardPlacement:
+    """A printed AprilGrid bolted somewhere in the base frame.
+
+    ``T_base_board`` follows the crate's object frame: origin at the top-left
+    corner of the top-left tag, x right, y down, z into the sheet. The printed
+    face therefore looks along **-z**, so a camera must sit on the board's -z
+    side to see anything.
+    """
+
+    board: Board
+    T_base_board: np.ndarray
+    _sheet: np.ndarray | None = field(default=None, repr=False)
+    _ppm: float = field(default=0.0, repr=False)
+
+    def sheet(self):
+        if self._sheet is None:
+            self._sheet, self._ppm = self.board.render()
+        return self._sheet, self._ppm
+
+    @property
+    def board_id(self) -> int:
+        return self.board.start_id // self.board.tag_count
+
+    def centre_base(self) -> np.ndarray:
+        w, h = self.board.extent
+        return tf.transform_points(self.T_base_board, [[w / 2.0, h / 2.0, 0.0]])[0]
+
+    def view_normal_base(self) -> np.ndarray:
+        """Unit vector pointing out of the *printed* face, in the base frame."""
+        return -self.T_base_board[:3, 2]
+
+    def corners_base(self) -> np.ndarray:
+        return tf.transform_points(self.T_base_board, self.board.all_corners())
+
+
+class Scene:
+    """Static geometry plus the renderer that turns a camera pose into an image."""
+
+    def __init__(self, camera: CameraModel, placements: list[BoardPlacement],
+                 degradations: Degradations | None = None,
+                 rng: np.random.Generator | None = None,
+                 background: int = 210):
+        self.camera = camera
+        self.placements = list(placements)
+        self.deg = degradations
+        self.rng = rng if rng is not None else np.random.default_rng(0)
+        self.background = int(background)
+        self._cache: dict[bytes, np.ndarray] = {}
+        self.render_count = 0
+
+    # -- geometry -----------------------------------------------------------
+
+    def centre_base(self) -> np.ndarray:
+        """Centroid of every board -- the point viewpoints are sampled around."""
+        return np.mean([p.centre_base() for p in self.placements], axis=0)
+
+    def view_normal_base(self) -> np.ndarray:
+        n = np.mean([p.view_normal_base() for p in self.placements], axis=0)
+        return n / np.linalg.norm(n)
+
+    def all_corners_base(self) -> np.ndarray:
+        return np.concatenate([p.corners_base() for p in self.placements], axis=0)
+
+    def visible_fraction(self, T_base_cam, points_base=None) -> float:
+        """Fraction of ``points_base`` that land inside the image, in front."""
+        if points_base is None:
+            points_base = self.all_corners_base()
+        return self.camera.visible_fraction(T_base_cam, points_base)
+
+    # -- rendering ----------------------------------------------------------
+
+    def render(self, T_base_cam, degrade: bool = True,
+               use_cache: bool = True) -> np.ndarray:
+        """Render the view from ``T_base_cam``. Only runs when asked to.
+
+        Identical camera poses return the cached image, sensor noise included,
+        so a still arm produces a still picture. Move, and the cache misses.
+        """
+        T = tf.as_matrix(T_base_cam)
+        key = np.round(T, 12).tobytes() + bytes([degrade])
+        img = self._cache.get(key) if use_cache else None
+        if img is None:
+            img = self._render_uncached(T, degrade)
+            if use_cache:
+                self._cache[key] = img
+        return img
+
+    def _render_uncached(self, T_base_cam: np.ndarray, degrade: bool) -> np.ndarray:
+        self.render_count += 1
+        cam = self.camera
+        canvas = np.full((cam.height, cam.width), self.background, np.uint8)
+        T_cam_base = tf.invert(T_base_cam)
+
+        # Painter's algorithm: furthest board first, so a nearer one covers it.
+        order = []
+        for p in self.placements:
+            centre_cam = tf.transform_points(T_cam_base, [p.centre_base()])[0]
+            order.append((centre_cam[2], p))
+        for depth, p in sorted(order, key=lambda x: -x[0]):
+            if depth <= 1e-3:
+                continue                      # board centre behind the camera
+            self._warp_board(canvas, p, T_cam_base @ p.T_base_board)
+
+        maps = render.distortion_maps(cam)
+        img = cv2.remap(canvas, maps[0], maps[1], cv2.INTER_LINEAR,
+                        borderMode=cv2.BORDER_REPLICATE)
+
+        if degrade and self.deg is not None:
+            img, _ = render.degrade(img, self.rng, self.deg)
+
+        return np.ascontiguousarray(img)
+
+    def _warp_board(self, canvas: np.ndarray, p: BoardPlacement, T_cam_board: np.ndarray):
+        sheet, ppm = p.sheet()
+        # A sheet corner behind the camera makes the homography meaningless
+        # (points wrap around through infinity), so skip the board entirely
+        # rather than smearing garbage across the frame.
+        w, h = p.board.extent
+        m = p.board.margin
+        obj = np.array([[-m, -m, 0.0], [w + m, -m, 0.0],
+                        [w + m, h + m, 0.0], [-m, h + m, 0.0]])
+        if np.any(tf.transform_points(T_cam_board, obj)[:, 2] <= 1e-3):
+            return
+        # Only the printed face carries tags. Seen from behind, a real board is
+        # blank paper -- without this check the warp happily draws a mirrored,
+        # still-plausible tag pattern and the simulation is silently wrong.
+        centre_cam = tf.transform_points(T_cam_board, [[w / 2.0, h / 2.0, 0.0]])[0]
+        if np.dot(-T_cam_board[:3, 2], centre_cam) >= 0.0:
+            sheet = np.full_like(sheet, 245)
+        rvec, tvec = tf.matrix_to_rvec_tvec(T_cam_board)
+        hom = render.sheet_homography(p.board, ppm, rvec, tvec, self.camera)
+        cv2.warpPerspective(sheet, hom, (self.camera.width, self.camera.height),
+                            flags=cv2.INTER_AREA,
+                            borderMode=cv2.BORDER_TRANSPARENT, dst=canvas)
