@@ -0,0 +1,164 @@
+"""Shared scaffolding for the three tests.
+
+Each test does the same three things before it can measure anything: build the
+backend named by the config, confirm the arm can actually see the grid, and --
+on hardware -- put a human in front of every motion. That is all this module
+is.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from robotlab.core import backend as backend_mod          # noqa: E402
+from robotlab.core import config as config_mod            # noqa: E402
+from robotlab.core import transforms as tf                # noqa: E402
+from robotlab.core.bench import Bench                     # noqa: E402
+from robotlab.core.console import GO, QUIT, SKIP, Console  # noqa: E402
+from robotlab.core.metrics import fmt_pose                # noqa: E402
+from robotlab.core.sampling import ViewpointSampler, frontal_view  # noqa: E402
+
+__all__ = ["Session", "open_session", "common_args", "add_ensemble_args",
+           "GO", "SKIP", "QUIT", "fmt_pose", "tf", "np"]
+
+
+@dataclass
+class Session:
+    cfg: object
+    backend: object
+    bench: Bench
+    console: Console
+    sampler: ViewpointSampler
+    rng: np.random.Generator
+    seed: int
+
+    @property
+    def truth(self):
+        """Ground truth, or ``None`` on hardware."""
+        return self.backend.truth()
+
+    @property
+    def interactive(self) -> bool:
+        return self.backend.interactive
+
+    def goto(self, T_base_cam, label: str = "move the camera"):
+        """Move, asking first when the arm is real.
+
+        Returns :data:`GO` if the arm is now there, :data:`SKIP` if the
+        operator declined or the pose was unreachable, :data:`QUIT` to stop.
+        """
+        if self.interactive:
+            answer = self.console.ask(f"{label} -- clear of obstructions?")
+            if answer is not GO:
+                return answer
+        return GO if self.bench.try_move_camera_to(T_base_cam) else SKIP
+
+    def mover(self, label: str = "ensemble nudge"):
+        """A move-and-report callable for :meth:`Bench.observe_ensemble`.
+
+        Each pose in an ensemble is a real motion on real hardware, so it goes
+        through the same prompt as any other. That makes an ensemble N times
+        as many keypresses -- which is the honest cost, and a reason to keep
+        the pattern small on an arm.
+        """
+        def move(T_base_cam) -> bool:
+            answer = self.goto(T_base_cam, label)
+            if answer is QUIT:
+                raise SystemExit("stopped by operator during an ensemble")
+            return answer is GO
+        return move
+
+    def _seed_grid(self, board_ids):
+        """Roughly where the grid is, measured from the home pose if possible.
+
+        The home pose is jogged and checked by whoever set the arm up, so what
+        the camera sees from there beats the hand-typed ``scene.T_base_grid``
+        every time. The config value is a fallback for the case where the grid
+        is not in frame from home -- it is only ever used to aim the first
+        look, never reported as a measurement.
+
+        Returns ``(T_base_grid, description_of_where_it_came_from)``.
+        """
+        _, boards = self.bench.observe_all()
+        missing = [i for i in board_ids if i not in boards]
+        if not missing:
+            first = self.bench.board_transform(boards[board_ids[0]])
+            return self.bench.grid_in_base(first), "detected from the home pose"
+        return (self.cfg.pose("scene", "T_base_grid"),
+                f"config scene.T_base_grid -- board(s) {missing} not visible "
+                f"from the home pose")
+
+    def start_view(self, board_count: int = 1, what: str = "the AprilGrid"):
+        """Send the arm home, look, and refuse to continue if it cannot see.
+
+        Everything downstream plans viewpoints around this first estimate, so
+        a test that starts blind would produce numbers about nothing.
+
+        Returns one estimate when ``board_count`` is 1, otherwise a dict keyed
+        by detector board id.
+        """
+        cfg = self.cfg
+        board_ids = cfg.board_ids(board_count)
+        home = np.asarray(cfg.robot["home_pose"], np.float64)
+        if self.interactive:
+            print(f"  home pose {fmt_pose(home)}")
+            if self.console.ask("move the arm to the home pose?") is not GO:
+                raise SystemExit("cancelled at the home pose")
+        self.bench.robot.move_pose(home)
+        seed_grid, source = self._seed_grid(board_ids)
+        print(f"  grid seed {fmt_pose(tf.matrix_to_pose(seed_grid))}  ({source})")
+        start_distance = float(np.mean(cfg.sampling["radius_m"]))
+        view = frontal_view(self.bench.centre_frame(seed_grid, board_count),
+                            start_distance)
+        if self.interactive and self.console.ask("move to the start view?") is not GO:
+            raise SystemExit("cancelled at the start view")
+        return self.bench.require_clear_view(view, board_ids, what)
+
+    def close(self) -> None:
+        self.bench.close()
+
+
+def open_session(args, board_count: int = 1) -> Session:
+    cfg = config_mod.load(args.backend, args.config)
+    override = getattr(args, "ensemble", None)
+    if override is not None:
+        cfg.data.setdefault("ensemble", {})["enabled"] = bool(override)
+    seed = args.seed if args.seed is not None else int(cfg.tests["seed"])
+    rng = np.random.default_rng(seed)
+    be = backend_mod.build(cfg, board_count=board_count, rng=rng)
+    console = Console(auto=getattr(args, "auto", False),
+                      interactive_backend=be.interactive)
+    bench = Bench(be, out_dir=args.out, show=args.show)
+    print(f"backend: {be.name}  config: {cfg.source.name}  seed: {seed}")
+    if bench.ensemble is not None:
+        print(f"ensemble: {bench.ensemble.describe()}")
+    return Session(cfg, be, bench, console, ViewpointSampler(cfg.sampling, rng),
+                   rng, seed)
+
+
+def common_args(description: str) -> argparse.ArgumentParser:
+    p = argparse.ArgumentParser(description=description)
+    p.add_argument("--backend", default="sim",
+                   help="which configs/<name>.yaml to run against (sim, techman)")
+    p.add_argument("--config", help="YAML file overriding the backend config")
+    p.add_argument("--seed", type=int)
+    p.add_argument("--show", action="store_true", help="display frames in a window")
+    p.add_argument("--save-images", action="store_true",
+                   help="write a PNG for every viewpoint, not just failures")
+    add_ensemble_args(p)
+    return p
+
+
+def add_ensemble_args(p) -> None:
+    """``--ensemble`` / ``--no-ensemble``, overriding ``ensemble.enabled``."""
+    p.add_argument("--ensemble", dest="ensemble", action="store_true", default=None,
+                   help="average several nearby looks per viewpoint")
+    p.add_argument("--no-ensemble", dest="ensemble", action="store_false",
+                   help="one look per viewpoint, whatever the config says")
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/tests/consistency.py" "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/tests/consistency.py"
