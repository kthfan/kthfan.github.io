+#!/usr/bin/env bash
+# Runs cargo on the remote build host.
+#
+# `sync.ps1` streams a tar archive, which preserves the *local* Windows mtime of
+# every file. When a remote build takes longer than the gap between two local
+# edits, cargo's fingerprint sees sources that are older than the artifacts it
+# already produced and silently skips the rebuild -- so the previous test binary
+# runs again and you debug a stale failure. Touching every source first makes
+# the freshness check honest.
+#
+# Usage: scripts/remote-cargo.sh test -p aprilgrid
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+export PATH="$HOME/.local/bin:$PATH"
+
+find . -path ./target -prune -o -path ./vendor -prune -o \
+    \( -name '*.rs' -o -name '*.toml' -o -name '*.py' \) -print0 | xargs -0 touch
+
+exec cargo "$@"
