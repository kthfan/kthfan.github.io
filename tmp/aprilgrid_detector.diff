@@ -0,0 +1,68 @@
+"""The operator's side of an interactive run.
+
+On the simulator a "move" is a matrix multiply and can be run unattended. On
+hardware it is a real arm swinging through real space, so every motion is
+gated on a keypress and ``--auto`` is refused outright.
+"""
+
+from __future__ import annotations
+
+__all__ = ["Console", "QUIT", "SKIP", "GO"]
+
+
+class _Answer:
+    def __init__(self, name):
+        self.name = name
+
+    def __repr__(self):
+        return f"<{self.name}>"
+
+
+QUIT = _Answer("quit")
+SKIP = _Answer("skip")
+GO = _Answer("go")
+
+
+class Console:
+    """Prompts the operator, or waves everything through in auto mode."""
+
+    def __init__(self, auto: bool, interactive_backend: bool):
+        if auto and interactive_backend:
+            raise SystemExit(
+                "refusing --auto on a real robot: every physical motion needs a "
+                "keypress. Drop --auto, or run with --backend sim."
+            )
+        self.auto = auto
+
+    def ask(self, prompt: str):
+        """Return :data:`GO`, :data:`SKIP` or :data:`QUIT`."""
+        if self.auto:
+            print(f"  > {prompt}  [auto]")
+            return GO
+        try:
+            answer = input(f"  > {prompt} [Enter/s/q] ").strip().lower()
+        except EOFError:
+            return QUIT
+        if answer in ("q", "quit", "exit"):
+            return QUIT
+        if answer in ("s", "skip"):
+            return SKIP
+        return GO
+
+    def ask_float(self, prompt: str, default: float | None = None) -> float | None:
+        """Read a number from the operator; blank keeps ``default``."""
+        if self.auto:
+            return default
+        while True:
+            try:
+                raw = input(f"  > {prompt} ").strip()
+            except EOFError:
+                return default
+            if not raw:
+                return default
+            if raw.lower() in ("q", "quit"):
+                return None
+            try:
+                return float(raw)
+            except ValueError:
+                print("    not a number; try again (blank to skip)")
