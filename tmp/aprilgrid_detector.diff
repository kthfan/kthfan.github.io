+        let dst = [
+            Point2::new(10.0, 12.0),
+            Point2::new(90.0, 20.0),
+            Point2::new(80.0, 95.0),
+            Point2::new(15.0, 88.0),
+        ];
+        let h = homography_from_quad(&src, &dst).unwrap();
+        let inv = h.inverse().unwrap();
