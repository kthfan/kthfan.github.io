@@ -0,0 +1,190 @@
+"""Settings, one file per backend.
+
+``configs/sim.yaml`` and ``configs/techman.yaml`` share a schema; each names
+its own ``backend`` so ``run.py`` knows what to build. ``--config other.yaml``
+merges on top and only needs the keys it changes.
+
+Geometry the two backends must agree on -- board size, the object frames, the
+sampling ranges -- means the same thing in both files. What differs is the
+camera, the hand-eye transform, and the driver block.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+from . import transforms as tf
+from .board import Board
+from .camera import CameraModel
+
+CONFIG_DIR = Path(__file__).resolve().parent.parent / "configs"
+
+__all__ = ["Config", "load", "CONFIG_DIR"]
+
+
+def _strip_comments(node):
+    """Drop underscore-prefixed keys.
+
+    YAML has real ``#`` comments, so prose lives there. Underscored keys are
+    still dropped because the configs use them to park alternative values that
+    you swap in by renaming, e.g. ``_T_ee_tool``.
+    """
+    if isinstance(node, dict):
+        return {k: _strip_comments(v) for k, v in node.items() if not k.startswith("_")}
+    if isinstance(node, list):
+        return [_strip_comments(v) for v in node]
+    return node
+
+
+def _merge(base: dict, override: dict) -> dict:
+    out = dict(base)
+    for k, v in override.items():
+        if isinstance(v, dict) and isinstance(out.get(k), dict):
+            out[k] = _merge(out[k], v)
+        else:
+            out[k] = v
+    return out
+
+
+def _read(path: Path) -> dict:
+    # utf-8-sig, not utf-8: Windows editors and PowerShell's Set-Content write
+    # a BOM, and the YAML parser reports it as an unexpected character.
+    data = yaml.safe_load(Path(path).read_text(encoding="utf-8-sig"))
+    if not isinstance(data, dict):
+        raise ValueError(f"{path}: expected a mapping at the top level, "
+                         f"got {type(data).__name__}")
+    return _strip_comments(data)
+
+
+class Config:
+    """Parsed settings plus the objects built from them."""
+
+    def __init__(self, data: dict, source: Path | None = None):
+        self.data = data
+        self.source = source
+        self.backend = data.get("backend", "sim")
+        self.camera_cfg = data["camera"]
+        self.board_cfg = data["board"]
+        self.scene = data["scene"]
+        self.sampling = data["sampling"]
+        self.detector = data["detector"]
+        self.tests = data["tests"]
+        self.driver = data.get("driver", {})
+        self.robot = data.get("robot", {})
+
+    # -- camera and board ----------------------------------------------------
+
+    def camera(self) -> CameraModel:
+        return CameraModel.from_config(self.camera_cfg)
+
+    def board(self, start_id: int | None = None) -> Board:
+        b = self.board_cfg
+        return Board(
+            tags_x=int(b["tags_x"]), tags_y=int(b["tags_y"]),
+            tag_size=float(b["tag_size"]), tag_separation=float(b["tag_separation"]),
+            margin=float(b["margin"]),
+            start_id=self.start_id() if start_id is None else start_id,
+            render_px_per_tag=int(b.get("render_px_per_tag", 120)),
+        )
+
+    def tags_per_board(self) -> int:
+        return int(self.board_cfg["tags_x"]) * int(self.board_cfg["tags_y"])
+
+    def start_id(self) -> int:
+        """Tag id of the first tag on the printed board.
+
+        Boards are not required to start at zero -- a sheet printed from a
+        larger family, or the second board of a pair, carries whatever ids it
+        was generated with. The detector derives ``board_id = tag_id // N``,
+        so the run has to know this to ask for the right board.
+        """
+        start = int(self.board_cfg.get("start_id", 0))
+        tags = self.tags_per_board()
+        if start < 0 or start % tags:
+            raise ValueError(
+                f"board.start_id must be a non-negative multiple of "
+                f"tags_x*tags_y ({tags}); got {start}. The detector groups tags "
+                f"by tag_id // {tags}, so any other value splits the board "
+                f"across two board ids and it will never be detected whole."
+            )
+        return start
+
+    def board_id(self, index: int = 0) -> int:
+        """Detector board id of the ``index``-th board in the scene."""
+        return self.start_id() // self.tags_per_board() + index
+
+    def board_ids(self, count: int = 1) -> tuple[int, ...]:
+        return tuple(self.board_id(i) for i in range(count))
+
+    def degradations(self):
+        """Simulator only; real backends have no such block.
+
+        Imported lazily: the degradation stack belongs to the renderer, and a
+        hardware run should not have to import it at all.
+        """
+        from ..sim.render import Degradations
+
+        return Degradations.from_config(self.data.get("degradations"))
+
+    # -- poses ---------------------------------------------------------------
+
+    def hand_eye(self) -> np.ndarray:
+        """``T_ee_cam`` as a 6-vector pose."""
+        return np.asarray(self.data["hand_eye"]["T_ee_cam"], np.float64)
+
+    def hand_eye_true(self):
+        """Simulation only: where the camera really is, or None if exact."""
+        v = self.data["hand_eye"].get("T_ee_cam_true")
+        return None if v is None else np.asarray(v, np.float64)
+
+    def pose(self, section: str, key: str) -> np.ndarray:
+        return tf.pose_to_matrix(self.data[section][key])
+
+    def grid_centre(self):
+        """``T_grid_centre``, or None to derive it from the printed geometry.
+
+        Where viewpoints are aimed and how roll is zeroed, expressed in the
+        first board's frame. Absent, the bench uses the centroid of the tag
+        corners with the board's own axes, which is right for a plain
+        rectangular sheet. Set it when that guess is wrong: boards of unequal
+        size, a sheet you want to orbit off-centre, or a rig where the
+        board's x axis is not the roll reference you want.
+        """
+        v = self.scene.get("T_grid_centre")
+        return None if v is None else tf.pose_to_matrix(v)
+
+    def ensemble(self):
+        """The ensemble block when switched on, else None for a single look."""
+        block = self.data.get("ensemble")
+        if not block or not block.get("enabled", False):
+            return None
+        return block
+
+    # -- detector ------------------------------------------------------------
+
+    def detector_kwargs(self) -> dict:
+        return dict(self.detector)
+
+    def board_layout(self):
+        import aprilgrid_detector as agd
+
+        b = self.board_cfg
+        return agd.BoardLayout(
+            tags_x=int(b["tags_x"]), tags_y=int(b["tags_y"]),
+            tag_size=float(b["tag_size"]), tag_separation=float(b["tag_separation"]),
+        )
+
+
+def load(backend: str = "sim", path: str | Path | None = None) -> Config:
+    """Load ``configs/<backend>.yaml``, merged with an optional override."""
+    base = CONFIG_DIR / f"{backend}.yaml"
+    if not base.exists():
+        available = ", ".join(sorted(p.stem for p in CONFIG_DIR.glob("*.yaml")))
+        raise FileNotFoundError(f"no config for backend {backend!r}; have: {available}")
+    data = _read(base)
+    if path is not None:
+        data = _merge(data, _read(Path(path)))
+    return Config(data, base)
