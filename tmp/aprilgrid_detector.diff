+"""Evaluate the detector against a simulated dataset.
+
+Reads a dataset produced by `tools/simulate.py` and reports:
+  * detection rate (per tag and per frame), counted only over tags the
+    ground truth says were actually visible and unoccluded
+  * corner accuracy: RMSE and the error distribution, in pixels
+  * pose accuracy: translation, distance and rotation error
+  * false positives: decoded ids that are not on the board
+  * throughput, in frames per second
+
+Usage:
+    python3 tools/evaluate.py --data data/sim
+    python3 tools/evaluate.py --data data/sim --decimate 2 --json report.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import time
+
+import cv2
+import numpy as np
+
+import aprilgrid_detector as agd
+
+
+def _percentile(values, q):
+    return float(np.percentile(values, q)) if len(values) else float("nan")
+
+
+def rotation_error_deg(r_est: np.ndarray, r_true: np.ndarray) -> float:
+    """Geodesic angle between two rotations, in degrees."""
+    m = r_est.T @ r_true
+    # Clamp guards against the trace drifting outside [-1, 3] numerically.
+    c = (np.trace(m) - 1.0) / 2.0
+    return math.degrees(math.acos(max(-1.0, min(1.0, c))))
+
+
+def apparent_size(corners) -> float:
+    """Shortest side of the tag as it appears on screen, in pixels.
+
+    This is the quantity the detector's `min_side_px` acts on, so bucketing
+    results by it shows directly whether misses are a size limit.
+    """
+    c = np.asarray(corners, float)
+    return float(min(np.linalg.norm(c[i] - c[(i + 1) % 4]) for i in range(4)))
+
+
+def _size_breakdown(records) -> list[dict]:
+    """Detection rate per apparent-size bucket."""
+    edges = [0, 15, 20, 25, 30, 40, 60, 1e9]
+    out = []
+    for lo, hi in zip(edges, edges[1:]):
+        sel = [found for size, found in records if lo <= size < hi]
+        if not sel:
+            continue
+        out.append({
+            "min_px": lo,
+            "max_px": None if hi > 1e8 else hi,
+            "count": len(sel),
+            "rate": sum(sel) / len(sel),
+        })
+    return out
+
+
+def evaluate(data_dir: str, detector: agd.Detector, layout: agd.BoardLayout,
+             camera: agd.Camera, corner_gate_px: float = 5.0) -> dict:
+    with open(os.path.join(data_dir, "ground_truth.json")) as f:
+        meta = json.load(f)
+
+    expected_ids = {t["id"] for f in meta["frames"] for t in f["tags"]}
+
+    corner_errors: list[float] = []
+    per_tag_worst: list[float] = []
+    trans_errors: list[float] = []
+    dist_errors: list[float] = []
+    rot_errors: list[float] = []
+    rmse_reported: list[float] = []
+    margins: list[float] = []
+    times: list[float] = []
+
+    n_expected = 0        # visible, unoccluded tags
+    n_found = 0
+    n_false = 0
+    n_hamming = 0
+    n_mislocated = 0      # decoded with the right id but a bad corner
+    frames_complete = 0
+    frames_with_pose = 0
+    frames_total = 0
+    size_records: list[tuple[float, bool]] = []
+
+    for frame in meta["frames"]:
+        img = cv2.imread(os.path.join(data_dir, frame["image"]), cv2.IMREAD_GRAYSCALE)
+        if img is None:
+            raise FileNotFoundError(frame["image"])
+        frames_total += 1
+
+        t0 = time.perf_counter()
+        boards = detector.detect_boards(img, layout, camera)
+        times.append(time.perf_counter() - t0)
+
+        found = {d.id: d for b in boards for d in b.detections}
+        truth = {t["id"]: t for t in frame["tags"]}
+
+        detectable = [t for t in frame["tags"] if t["visible"] and not t["occluded"]]
+        n_expected += len(detectable)
+
+        for tag in detectable:
+            d = found.get(tag["id"])
+            size = apparent_size(tag["corners"])
+            if d is None:
+                size_records.append((size, False))
+                continue
+            errs = [
+                math.hypot(px - tx, py - ty)
+                for (px, py), (tx, ty) in zip(d.corners, tag["corners"])
+            ]
+            worst = max(errs)
+            if worst > corner_gate_px:
+                # Right id, wrong place: count as a localisation failure rather
+                # than silently inflating the corner statistics.
+                n_mislocated += 1
+                size_records.append((size, False))
+                continue
+            n_found += 1
+            size_records.append((size, True))
+            corner_errors.extend(errs)
+            per_tag_worst.append(worst)
+            margins.append(d.decision_margin)
+            n_hamming += d.hamming
+
+        for tag_id in found:
+            if tag_id not in expected_ids or tag_id not in truth:
+                n_false += 1
+
+        if detectable and len(found) >= len(detectable):
+            frames_complete += 1
+
+        # Pose is only meaningful when at least one board was decoded.
+        posed = [b for b in boards if b.pose is not None]
+        if posed:
+            b = max(posed, key=lambda x: len(x.detections))
+            frames_with_pose += 1
+            t_true = np.array(frame["tvec"], float)
+            t_est = np.array(b.pose.translation, float)
+            trans_errors.append(float(np.linalg.norm(t_est - t_true)))
+            dist_errors.append(abs(float(np.linalg.norm(t_est)) - frame["distance"]))
+            rot_errors.append(
+                rotation_error_deg(np.array(b.pose.rotation, float),
+                                   np.array(frame["rotation"], float))
+            )
+            rmse_reported.append(b.pose.reprojection_rmse)
+
+    def stats(v, unit=""):
+        if not len(v):
+            return None
+        a = np.asarray(v, float)
+        return {
+            "mean": float(a.mean()),
+            "median": float(np.median(a)),
+            "p95": _percentile(a, 95),
+            "max": float(a.max()),
+            "unit": unit,
+        }
+
+    corners = np.asarray(corner_errors, float)
+    return {
+        "dataset": {
+            "dir": data_dir,
+            "preset": meta.get("preset"),
+            "frames": frames_total,
+            "detectable_tags": n_expected,
+        },
+        "detection": {
+            "tag_rate": n_found / n_expected if n_expected else float("nan"),
+            "frame_complete_rate": frames_complete / frames_total if frames_total else 0.0,
+            "found": n_found,
+            "missed": n_expected - n_found - n_mislocated,
+            "mislocated": n_mislocated,
+            "false_positives": n_false,
+            "corrected_bit_errors": n_hamming,
+            "by_apparent_size": _size_breakdown(size_records),
+        },
+        "corner_error_px": {
+            "rmse": float(np.sqrt((corners ** 2).mean())) if corners.size else None,
+            **(stats(corners, "px") or {}),
+        } if corners.size else None,
+        "worst_corner_per_tag_px": stats(per_tag_worst, "px"),
+        "pose": {
+            "frames_with_pose": frames_with_pose,
+            "translation_error_m": stats(trans_errors, "m"),
+            "distance_error_m": stats(dist_errors, "m"),
+            "rotation_error_deg": stats(rot_errors, "deg"),
+            "reported_reprojection_rmse_px": stats(rmse_reported, "px"),
+        },
+        "decision_margin": stats(margins),
+        "speed": {
+            "mean_ms": float(np.mean(times) * 1e3),
+            "median_ms": float(np.median(times) * 1e3),
+            "p95_ms": _percentile(np.asarray(times) * 1e3, 95),
+            "fps": float(1.0 / np.mean(times)) if times else 0.0,
+        },
+    }
+
+
+def _fmt(s, scale=1.0, digits=3):
+    if s is None:
+        return "n/a"
+    return (f"mean {s['mean'] * scale:.{digits}f}  med {s['median'] * scale:.{digits}f}  "
+            f"p95 {s['p95'] * scale:.{digits}f}  max {s['max'] * scale:.{digits}f}")
+
+
+def report(r: dict) -> str:
+    d = r["detection"]
+    lines = [
+        f"dataset            {r['dataset']['dir']}  preset={r['dataset']['preset']}  "
+        f"frames={r['dataset']['frames']}  detectable tags={r['dataset']['detectable_tags']}",
+        "",
+        f"tag detection rate {d['tag_rate'] * 100:.2f}%   "
+        f"(found {d['found']}, missed {d['missed']}, mislocated {d['mislocated']})",
+        f"complete frames    {d['frame_complete_rate'] * 100:.2f}%",
+        f"false positives    {d['false_positives']}",
+        f"corrected bits     {d['corrected_bit_errors']}",
+        "",
+        "rate by apparent tag size (shortest on-screen side):",
+    ]
+    for b in d["by_apparent_size"]:
+        label = f"{b['min_px']:.0f}-{b['max_px']:.0f} px" if b["max_px"] else f">{b['min_px']:.0f} px"
+        lines.append(f"  {label:>12}  n={b['count']:<5} {b['rate'] * 100:6.2f}%")
+    lines.append("")
+    if r["corner_error_px"]:
+        c = r["corner_error_px"]
+        lines.append(f"corner error       rmse {c['rmse']:.4f} px   "
+                     f"med {c['median']:.4f}  p95 {c['p95']:.4f}  max {c['max']:.4f}")
+    lines.append(f"worst per tag      {_fmt(r['worst_corner_per_tag_px'], digits=4)}")
+    lines.append(f"decision margin    {_fmt(r['decision_margin'], digits=1)}")
+    p = r["pose"]
+    lines += [
+        "",
+        f"poses fitted       {p['frames_with_pose']}",
+        f"translation err    {_fmt(p['translation_error_m'], 1e3, 3)}  (mm)",
+        f"distance err       {_fmt(p['distance_error_m'], 1e3, 3)}  (mm)",
+        f"rotation err       {_fmt(p['rotation_error_deg'], 1.0, 3)}  (deg)",
+        f"reported rmse      {_fmt(p['reported_reprojection_rmse_px'], 1.0, 3)}  (px)",
+        "",
+        f"speed              mean {r['speed']['mean_ms']:.2f} ms  "
+        f"med {r['speed']['median_ms']:.2f}  p95 {r['speed']['p95_ms']:.2f}  "
+        f"=> {r['speed']['fps']:.1f} fps",
+    ]
+    return "\n".join(lines)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--data", required=True, help="dataset directory")
+    ap.add_argument("--decimate", type=int, default=1)
+    ap.add_argument("--no-refine", action="store_true", help="disable edge refinement")
+    ap.add_argument("--single-thread", action="store_true")
+    ap.add_argument("--corner-gate", type=float, default=5.0,
+                    help="corner error above which a detection counts as mislocated")
+    ap.add_argument("--json", help="also write the raw report here")
+    args = ap.parse_args()
+
+    with open(os.path.join(args.data, "ground_truth.json")) as f:
+        meta = json.load(f)
+    b, c = meta["board"], meta["camera"]
+
+    layout = agd.BoardLayout(
+        tags_x=b["tags_x"], tags_y=b["tags_y"],
+        tag_size=b["tag_size"], tag_separation=b["tag_separation"],
+    )
+    camera = agd.Camera(c["fx"], c["fy"], c["cx"], c["cy"], tuple(c["distortion"]))
+    detector = agd.Detector(
+        decimate=args.decimate,
+        refine_edges=not args.no_refine,
+        parallel=not args.single_thread,
+    )
+
+    r = evaluate(args.data, detector, layout, camera, args.corner_gate)
+    r["config"] = {
+        "decimate": args.decimate,
+        "refine_edges": not args.no_refine,
+        "parallel": not args.single_thread,
+    }
+    print(report(r))
+    if args.json:
+        with open(args.json, "w") as f:
+            json.dump(r, f, indent=1)
+
+
+if __name__ == "__main__":
+    main()
