@@ -0,0 +1,330 @@
+"""The machinery every test shares.
+
+The one piece of maths all three tests repeat::
+
+    T_base_grid = T_base_ee @ T_ee_cam @ T_cam_grid
+
+``T_base_ee`` comes from the robot's own report and ``T_cam_grid`` from the
+detector. Nothing here consults ground truth; that lives behind
+``backend.truth()`` and is only ever used to print a "[simulation only]"
+column that takes no part in any measurement.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+from . import transforms as tf
+from .backend import Backend
+from .metrics import mean_rotation
+from .robot import Frame, Marker, UnreachablePose
+from .sampling import EnsemblePattern
+
+__all__ = ["Bench"]
+
+
+class Bench:
+    """Detection, viewpoint planning and output, on top of a backend."""
+
+    def __init__(self, backend: Backend, out_dir: str | Path | None = None,
+                 show: bool = False):
+        import aprilgrid_detector as agd
+
+        self.backend = backend
+        self.cfg = backend.cfg
+        self.robot = backend.robot
+        self.source = backend.source
+
+        self.detector = agd.Detector(**self.cfg.detector_kwargs())
+        self.layout = self.cfg.board_layout()
+        self._agd_camera = None
+        self._agd_camera_for = None
+
+        block = self.cfg.ensemble()
+        self.ensemble = EnsemblePattern(block) if block else None
+
+        self.out_dir = Path(out_dir) if out_dir else None
+        if self.out_dir:
+            self.out_dir.mkdir(parents=True, exist_ok=True)
+        self.show = show
+        self.captures = 0
+
+    # -- optics --------------------------------------------------------------
+
+    @property
+    def camera_model(self):
+        """Intrinsics as they are right now, not as they were at startup.
+
+        A camera with a motorised lens changes focal length when it refocuses,
+        so this is asked of the backend on every use. Nothing here may cache
+        it: the whole point is that the answer moves.
+        """
+        return self.backend.camera_model
+
+    @property
+    def agd_camera(self):
+        """:attr:`camera_model` in the detector's own form.
+
+        Rebuilt only when the model behind it is replaced, since this is read
+        once per detection and the conversion is not free.
+        """
+        model = self.backend.camera_model
+        if model is not self._agd_camera_for:
+            self._agd_camera = model.to_agd_camera()
+            self._agd_camera_for = model
+        return self._agd_camera
+
+    # -- motion --------------------------------------------------------------
+
+    def move_camera_to(self, T_base_cam) -> None:
+        self.robot.move_camera_to(T_base_cam)
+
+    # -- perception ----------------------------------------------------------
+
+    def capture(self, markers: list[Marker] | None = None) -> Frame:
+        gray = self.source.capture()
+        if gray is None:
+            raise RuntimeError("camera returned no image")
+        gray = np.ascontiguousarray(gray)
+        if gray.ndim != 2 or gray.dtype != np.uint8:
+            raise ValueError(f"expected a 2-D uint8 image, got {gray.shape} {gray.dtype}")
+        self.captures += 1
+
+        color = self.source.capture_color()
+        if markers:
+            color = self._overlay(color if color is not None else gray, markers)
+        return Frame(gray, color)
+
+    def detect(self, frame: Frame) -> list:
+        return list(self.detector.detect_boards(frame.gray, self.layout, self.agd_camera))
+
+    def board_transform(self, board) -> np.ndarray:
+        """``T_cam_board`` from a detection (the detector reports object->camera)."""
+        return tf.rvec_tvec_to_matrix(board.pose.rvec, board.pose.translation)
+
+    def grid_in_base(self, T_cam_board: np.ndarray) -> np.ndarray:
+        """Chain a detection through the arm's reported pose and hand-eye."""
+        return self.robot.get_camera_matrix() @ T_cam_board
+
+    def observe_all(self, markers=None):
+        """Capture and detect, keeping only boards with a usable pose."""
+        frame = self.capture(markers)
+        min_cov = float(self.cfg.tests["min_board_coverage"])
+        boards = {b.board_id: b for b in self.detect(frame)
+                  if b.pose is not None and b.coverage >= min_cov}
+        return frame, boards
+
+    def observe(self, board_id: int | None = None, markers=None):
+        """Capture, detect, and return ``(frame, board, T_base_grid)``.
+
+        ``board_id`` defaults to the first board named by the config.
+        ``board`` and the transform are ``None`` when the grid was not found or
+        too little of it was visible.
+        """
+        if board_id is None:
+            board_id = self.cfg.board_id()
+        frame, boards = self.observe_all(markers)
+        board = boards.get(board_id)
+        if board is None:
+            return frame, None, None
+        return frame, board, self.grid_in_base(self.board_transform(board))
+
+    def observe_ensemble(self, T_base_cam, T_base_centre, board_id=None,
+                         markers=None, move=None):
+        """Look from several nearby poses and average what they say.
+
+        The arm is already at ``T_base_cam``; this walks the pattern in
+        ``config.ensemble`` around it and returns the mean ``T_base_grid``.
+        Rotations are averaged chordally rather than component-wise, because
+        Euler triples do not average.
+
+        What this can and cannot do is worth being clear about. Averaging
+        removes error that changes sign between the poses; it does nothing to
+        error that is the same at all of them. Since the offsets are small,
+        anything systematic -- hand-eye calibration, a bowed sheet, a
+        mis-measured tag -- survives the mean untouched. Only the offsets that
+        change the incidence angle (``orbit_x_deg``, ``orbit_y_deg``,
+        ``d_radius_m``) attack the geometric weakness of a single view; the
+        rest just resample sensor noise.
+
+        ``move`` moves the arm and reports whether it arrived, so a caller on
+        real hardware can keep a human in front of every motion. Returns
+        ``(frame, board, T_base_grid, used)`` like :meth:`observe` with the
+        number of contributing poses appended; ``frame`` and ``board`` are
+        from the nominal pose, for reporting only.
+        """
+        if self.ensemble is None:
+            frame, board, T = self.observe(board_id, markers)
+            return frame, board, T, (0 if board is None else 1)
+
+        move = move or self.try_move_camera_to
+        estimates, first_frame, first_board, last_frame = [], None, None, None
+        for ep in self.ensemble.poses(T_base_cam, T_base_centre):
+            if not move(ep.T_base_cam):
+                continue
+            frame, board, T = self.observe(board_id, markers)
+            last_frame = frame
+            if board is None:
+                continue
+            estimates.append(T)
+            if first_board is None:
+                first_frame, first_board = frame, board
+
+        if len(estimates) < self.ensemble.min_detections:
+            return last_frame, None, None, len(estimates)
+
+        est = np.stack(estimates)
+        mean = tf.rt_to_matrix(mean_rotation(est[:, :3, :3]),
+                               est[:, :3, 3].mean(axis=0))
+        return first_frame, first_board, mean, len(estimates)
+
+    # -- viewpoint planning --------------------------------------------------
+
+    def board_corners_local(self, board_count: int = 1) -> np.ndarray:
+        """Tag corners of the scene's boards, in the *first* board's frame.
+
+        Printed geometry, known from the config -- not a measurement. This is
+        what lets a viewpoint be judged before the arm goes there.
+        """
+        tags = self.cfg.tags_per_board()
+        start = self.cfg.start_id()
+        T_grid_grid2 = tf.pose_to_matrix(self.cfg.scene["T_grid_grid2"])
+        pts = []
+        for i in range(board_count):
+            board = self.cfg.board(start_id=start + i * tags)
+            obj = np.concatenate([board.tag_corners(j) for j in range(tags)], axis=0)
+            pts.append(obj if i == 0 else tf.transform_points(T_grid_grid2, obj))
+        return np.concatenate(pts, axis=0)
+
+    def visibility_from_estimate(self, T_base_grid_est, board_count: int = 1):
+        """Predicate for the sampler: how much of the grid a pose would see.
+
+        Uses the *estimated* grid pose and the known printed geometry, so
+        viewpoint planning never peeks at ground truth -- which is what makes
+        the same code work on hardware.
+        """
+        pts = tf.transform_points(tf.as_matrix(T_base_grid_est),
+                                  self.board_corners_local(board_count))
+        return lambda T_base_cam: self.camera_model.visible_fraction(T_base_cam, pts)
+
+    def centre_frame(self, T_base_grid, board_count: int = 1) -> np.ndarray:
+        """Frame at the centre of the boards, aligned with the first board.
+
+        Viewpoints are sampled around this: origin at the centroid of the
+        printed area, -z facing the camera, x fixing the zero of roll.
+
+        ``scene.T_grid_centre`` overrides both, for when the centroid is not
+        what you want to orbit or the board's x axis is not the roll you want.
+        It is given in the first board's frame and covers every board, so
+        ``board_count`` no longer enters into it.
+        """
+        centre = self.cfg.grid_centre()
+        if centre is None:
+            centre = np.eye(4)
+            centre[:3, 3] = self.board_corners_local(board_count).mean(axis=0)
+        return tf.as_matrix(T_base_grid) @ centre
+
+    def try_move_camera_to(self, T_base_cam) -> bool:
+        """Move, reporting rather than raising if the pose is out of reach."""
+        try:
+            self.move_camera_to(T_base_cam)
+            return True
+        except UnreachablePose as exc:
+            print(f"  unreachable viewpoint ({exc}); resampling")
+            return False
+
+    # -- preconditions -------------------------------------------------------
+
+    def require_clear_view(self, T_base_cam, board_ids=None,
+                           what: str = "the AprilGrid"):
+        """Assert the arm can see ``what`` from here, and return the estimates.
+
+        Every test starts by checking this: without a usable first look the
+        arm has no idea where the grid is and the run is meaningless.
+        """
+        if board_ids is None:
+            board_ids = (self.cfg.board_id(),)
+        self.move_camera_to(T_base_cam)
+        frame, boards = self.observe_all()
+        missing = [i for i in board_ids if i not in boards]
+        if missing:
+            self.save("precondition_failed", frame)
+            raise AssertionError(
+                f"precondition failed: {what} is not clearly visible from the "
+                f"start pose (board(s) {missing} not detected with at least "
+                f"{float(self.cfg.tests['min_board_coverage']):.0%} coverage). "
+                f"Point robot.home_pose at the grid so the start pose can be "
+                f"measured; failing that, correct scene.T_base_grid, which is "
+                f"what the arm aimed at instead."
+            )
+        camera = self.robot.get_camera_matrix()
+        estimates = {i: camera @ self.board_transform(boards[i]) for i in board_ids}
+        return estimates[board_ids[0]] if len(board_ids) == 1 else estimates
+
+    # -- output --------------------------------------------------------------
+
+    def _overlay(self, base: np.ndarray, markers: list[Marker]) -> np.ndarray:
+        """Draw base-frame points on the operator's view.
+
+        Projected from the pose the image was taken from, using the same
+        camera model the detector uses. On hardware this is genuinely useful:
+        it shows where the system *believes* the tool and target are, so a
+        gross calibration error is visible before anything moves.
+        """
+        out = base if base.ndim == 3 else cv2.cvtColor(base, cv2.COLOR_GRAY2BGR)
+        out = out.copy()
+        uv, cam = self.camera_model.project(
+            self.backend.viewing_pose(),
+            np.array([m.position_base for m in markers], np.float64))
+        for m, (u, v), c in zip(markers, uv, cam):
+            if c[2] <= 1e-3 or not np.isfinite(u) or not np.isfinite(v):
+                continue
+            r = max(2, int(round(self.camera_model.fx * m.radius_m / c[2])))
+            centre = (int(round(u)), int(round(v)))
+            cv2.circle(out, centre, r, m.color_bgr, -1, cv2.LINE_AA)
+            cv2.circle(out, centre, r, (255, 255, 255), 1, cv2.LINE_AA)
+            if m.label:
+                cv2.putText(out, m.label, (centre[0] + r + 4, centre[1] - r - 4),
+                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, m.color_bgr, 2, cv2.LINE_AA)
+        return out
+
+    def save(self, name: str, frame: Frame) -> Path | None:
+        if not self.out_dir:
+            return None
+        path = self.out_dir / f"{name}.png"
+        cv2.imwrite(str(path), frame.display)
+        return path
+
+    def display(self, title: str, frame: Frame, wait: int = 1) -> None:
+        if not self.show:
+            return
+        img = frame.display
+        h, w = img.shape[:2]
+        scale = min(1.0, 1200.0 / w)
+        cv2.imshow(title, cv2.resize(img, (int(w * scale), int(h * scale))))
+        cv2.waitKey(wait)
+
+    def write_json(self, name: str, payload: dict) -> Path | None:
+        if not self.out_dir:
+            return None
+        path = self.out_dir / f"{name}.json"
+        path.write_text(json.dumps(payload, indent=2, default=_jsonable),
+                        encoding="utf-8")
+        return path
+
+    def close(self) -> None:
+        self.backend.close()
+        if self.show:
+            cv2.destroyAllWindows()
+
+
+def _jsonable(o):
+    if isinstance(o, np.ndarray):
+        return o.tolist()
+    if isinstance(o, (np.floating, np.integer)):
+        return o.item()
+    raise TypeError(type(o))
