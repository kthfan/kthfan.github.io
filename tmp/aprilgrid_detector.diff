+            Point2::new(2.0, 10.0),
+        ];
+        let pts = outline(corners, 16);
+        assert!(fit_quad(&pts, &QuadParams::default()).is_none());
+        let permissive = QuadParams { min_side_px: 4.0, ..QuadParams::default() };
+        assert!(fit_quad(&pts, &permissive).is_some());
+    }
+
+    #[test]
+    fn extremely_elongated_quads_are_rejected() {
+        let corners = [
+            Point2::new(10.0, 10.0),
+            Point2::new(300.0, 10.0),
+            Point2::new(300.0, 26.0),
+            Point2::new(10.0, 26.0),
+        ];
+        // side ratio 290/16 > 8
+        assert!(fit_quad(&outline(corners, 100), &QuadParams::default()).is_none());
+    }
+
+    #[test]
+    fn tiny_clusters_are_rejected_without_panicking() {
+        assert!(fit_quad(&[], &QuadParams::default()).is_none());
+        assert!(fit_quad(&[bp(1.0, 1.0), bp(2.0, 2.0)], &QuadParams::default()).is_none());
+    }
+
+    /// Anti-aliased dark square on a light background, corners at exact
+    /// sub-pixel positions: each pixel's value is its coverage by the square.
+    /// Pixel `i` covers `[i - 0.5, i + 0.5]`, matching the crate convention.
+    fn render_square(size: usize, x0: f64, y0: f64, x1: f64, y1: f64) -> GrayImage {
+        let mut img = GrayImage::filled(size, size, 0);
+        const SUB: usize = 16;
+        for py in 0..size {
+            for px in 0..size {
+                let mut inside = 0usize;
+                for sy in 0..SUB {
+                    for sx in 0..SUB {
+                        let x = px as f64 - 0.5 + (sx as f64 + 0.5) / SUB as f64;
+                        let y = py as f64 - 0.5 + (sy as f64 + 0.5) / SUB as f64;
+                        if x >= x0 && x <= x1 && y >= y0 && y <= y1 {
+                            inside += 1;
+                        }
+                    }
+                }
+                let cov = inside as f64 / (SUB * SUB) as f64;
+                img.set(px, py, (255.0 * (1.0 - cov)).round() as u8);
+            }
+        }
+        img
+    }
+
+    #[test]
+    fn refine_edges_recovers_sub_pixel_corners() {
+        let (x0, y0, x1, y1) = (20.35, 25.7, 79.8, 70.2);
+        let img = render_square(100, x0, y0, x1, y1);
+        let truth = [
+            Point2::new(x0, y0),
+            Point2::new(x1, y0),
+            Point2::new(x1, y1),
+            Point2::new(x0, y1),
+        ];
+        // Start from a deliberately coarse, integer-rounded quad.
+        let coarse = Quad {
+            corners: [
+                Point2::new(20.0, 26.0),
+                Point2::new(80.0, 26.0),
+                Point2::new(80.0, 70.0),
+                Point2::new(20.0, 70.0),
+            ],
+        };
+        let refined = refine_edges(&img, &coarse, &RefineParams::default()).unwrap();
+
+        let err = |q: &Quad| -> f64 {
+            truth
+                .iter()
+                .map(|t| q.corners.iter().map(|c| c.distance(*t)).fold(f64::MAX, f64::min))
+                .fold(0.0, f64::max)
+        };
+        let before = err(&coarse);
+        let after = err(&refined);
+        assert!(after < 0.2, "refined corner error {after} px is too large");
+        assert!(after < before, "refinement made it worse: {before} -> {after}");
+    }
+
+    #[test]
+    fn refine_edges_gives_up_when_there_is_no_edge_to_snap_to() {
+        let img = GrayImage::filled(100, 100, 128);
+        let quad = Quad {
+            corners: [
+                Point2::new(20.0, 20.0),
+                Point2::new(80.0, 20.0),
+                Point2::new(80.0, 80.0),
+                Point2::new(20.0, 80.0),
+            ],
+        };
+        assert!(refine_edges(&img, &quad, &RefineParams::default()).is_none());
+    }
+
+    #[test]
+    fn refine_edges_does_not_run_away_to_a_nearby_edge() {
+        // Two parallel edges close together; refinement must not jump the gap.
+        let img = render_square(100, 30.0, 30.0, 70.0, 70.0);
+        let quad = Quad {
+            corners: [
+                Point2::new(10.0, 10.0),
+                Point2::new(90.0, 10.0),
+                Point2::new(90.0, 90.0),
+                Point2::new(10.0, 90.0),
+            ],
+        };
+        // The real edge is 20 px away, far beyond max_shift_px.
+        assert!(refine_edges(&img, &quad, &RefineParams::default()).is_none());
+    }
+
+    #[test]
+    fn refine_edges_is_unbiased_across_sub_pixel_phases() {
+        // Sweeping the edge through a whole pixel exposes systematic bias that
+        // a single-position test hides: an estimator that always leans one way
+        // still looks accurate at some phases. The mean *signed* error is the
+        // quantity that matters, because a constant offset survives the line
+        // fit and lands directly in the pose.
+        let mut signed = Vec::new();
+        for i in 0..10 {
+            let phase = i as f64 / 10.0;
+            let (x0, y0) = (20.0 + phase, 20.0 + phase);
+            let (x1, y1) = (x0 + 40.0, y0 + 40.0);
+            let img = render_square(100, x0, y0, x1, y1);
+            let coarse = Quad {
+                corners: [
+                    Point2::new(x0.round(), y0.round()),
+                    Point2::new(x1.round(), y0.round()),
+                    Point2::new(x1.round(), y1.round()),
+                    Point2::new(x0.round(), y1.round()),
+                ],
+            };
+            let refined = refine_edges(&img, &coarse, &RefineParams::default())
+                .unwrap_or_else(|| panic!("phase {phase} failed to refine"));
+            // Signed error of the left edge and the top edge.
+            signed.push(refined.corners[0].x - x0);
+            signed.push(refined.corners[0].y - y0);
+        }
+        let mean = signed.iter().sum::<f64>() / signed.len() as f64;
+        let worst = signed.iter().fold(0.0f64, |a, b| a.max(b.abs()));
+        assert!(mean.abs() < 0.05, "systematic bias of {mean} px across phases");
+        assert!(worst < 0.2, "worst phase error {worst} px");
+    }
+}
