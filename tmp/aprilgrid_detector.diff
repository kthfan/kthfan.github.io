++//! Tiled adaptive thresholding.
++//!
++//! The image is split into 4x4 pixel tiles; each tile records its local
++//! extrema. Extrema are then dilated over a 3x3 tile neighbourhood so a tile
++//! that happens to contain only black (or only white) still inherits a sane
++//! threshold from its surroundings. Tiles whose local contrast stays below
++//! `min_contrast` are marked [`SKIP`] and ignored by the rest of the pipeline,
++//! which is what keeps flat background regions from generating spurious edges.
++
++use crate::gray::GrayImage;
++
++/// Pixel classified as part of a dark region.
++pub const BLACK: u8 = 0;
++/// Pixel classified as part of a light region.
++pub const WHITE: u8 = 255;
++/// Pixel in a region with too little local contrast to classify.
++pub const SKIP: u8 = 127;
++
++const TILE: usize = 4;
++
++/// Produces a three-valued image containing only [`BLACK`], [`WHITE`], and
++/// [`SKIP`].
++pub fn adaptive_threshold(img: &GrayImage, min_contrast: u8) -> GrayImage {
++    let (w, h) = (img.width(), img.height());
++    let tw = w / TILE;
++    let th = h / TILE;
++    let mut out = GrayImage::filled(w, h, SKIP);
++    if tw == 0 || th == 0 {
++        return out;
++    }
++
++    // Per-tile extrema.
++    let mut tmin = vec![255u8; tw * th];
++    let mut tmax = vec![0u8; tw * th];
++    for ty in 0..th {
++        for y in ty * TILE..ty * TILE + TILE {
++            let row = img.row(y);
++            for tx in 0..tw {
++                let (mut lo, mut hi) = (tmin[ty * tw + tx], tmax[ty * tw + tx]);
++                for &v in &row[tx * TILE..tx * TILE + TILE] {
++                    lo = lo.min(v);
++                    hi = hi.max(v);
++                }
++                tmin[ty * tw + tx] = lo;
++                tmax[ty * tw + tx] = hi;
++            }
++        }
++    }
++
++    // Dilate extrema over the 3x3 tile neighbourhood.
++    let mut nmin = vec![255u8; tw * th];
++    let mut nmax = vec![0u8; tw * th];
++    for ty in 0..th {
++        let y0 = ty.saturating_sub(1);
++        let y1 = (ty + 1).min(th - 1);
++        for tx in 0..tw {
++            let x0 = tx.saturating_sub(1);
++            let x1 = (tx + 1).min(tw - 1);
++            let (mut lo, mut hi) = (255u8, 0u8);
++            for yy in y0..=y1 {
++                for xx in x0..=x1 {
++                    lo = lo.min(tmin[yy * tw + xx]);
++                    hi = hi.max(tmax[yy * tw + xx]);
++                }
++            }
++            nmin[ty * tw + tx] = lo;
++            nmax[ty * tw + tx] = hi;
++        }
++    }
++
++    // Classify row by row rather than tile by tile. Both orders touch every
++    // pixel once, but walking whole rows keeps the source and destination
++    // scans linear in memory and lets the inner loop work on slices, which
++    // drops the per-pixel bounds check that `get`/`set` would otherwise cost
++    // two million times per 1080p frame.
++    for y in 0..h {
++        // The bottom partial tile is folded into the last full tile row so no
++        // pixel is left unclassified.
++        let ty = (y / TILE).min(th - 1);
++        let (src, dst) = (img.row(y), out.row_mut(y));
++        for tx in 0..tw {
++            let lo = nmin[ty * tw + tx];
++            let hi = nmax[ty * tw + tx];
++            if hi.saturating_sub(lo) < min_contrast {
++                continue; // stays SKIP
++            }
++            let thresh = ((lo as u16 + hi as u16) / 2) as u8;
++            let xend = if tx + 1 == tw { w } else { tx * TILE + TILE };
++            for x in tx * TILE..xend {
++                dst[x] = if src[x] > thresh { WHITE } else { BLACK };
++            }
++        }
++    }
++    out
++}
++
