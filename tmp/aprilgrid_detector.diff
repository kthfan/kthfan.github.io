@@ -0,0 +1,190 @@
+"""Rigid-body maths for the eye-in-hand robot tests.
+
+A *pose* is the 6-vector ``[x, y, z, rx, ry, rz]``: translation in metres,
+rotation in radians. A *transform* is the equivalent 4x4 homogeneous matrix.
+``T_a_b`` names the transform that maps a point expressed in frame ``b`` into
+frame ``a``, so ``p_a = T_a_b @ p_b`` and ``T_a_c = T_a_b @ T_b_c``.
+
+Rotation convention -- the one place it is defined
+--------------------------------------------------
+``[rx, ry, rz]`` is a **fixed-axis XYZ** triple, equivalently an **intrinsic
+ZYX** (yaw-pitch-roll) triple::
+
+    R = Rz(rz) @ Ry(ry) @ Rx(rx)
+
+This matches Fanuc W-P-R, KUKA A-B-C and ``scipy``'s ``from_euler("ZYX",
+[rz, ry, rx])`` / ``from_euler("xyz", [rx, ry, rz])``.
+
+Only :func:`euler_to_matrix` and :func:`matrix_to_euler` encode the choice.
+Every other function in this package -- and every test -- goes through them,
+so switching to another convention (intrinsic XYZ, or the axis-angle rotation
+vector Universal Robots controllers use) means rewriting exactly those two
+functions and nothing else.
+"""
+
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+__all__ = [
+    "EULER_CONVENTION",
+    "euler_to_matrix",
+    "matrix_to_euler",
+    "pose_to_matrix",
+    "matrix_to_pose",
+    "as_matrix",
+    "rt_to_matrix",
+    "rvec_tvec_to_matrix",
+    "matrix_to_rvec_tvec",
+    "invert",
+    "compose",
+    "transform_points",
+    "rotation_angle",
+    "pose_error",
+    "wrap_angle",
+]
+
+EULER_CONVENTION = "fixed-axis XYZ (intrinsic ZYX): R = Rz(rz) @ Ry(ry) @ Rx(rx)"
+
+# Below this |cos(ry)| the ZYX decomposition is gimbal-locked: rx and rz become
+# degenerate and only their sum (or difference) is observable.
+_GIMBAL_EPS = 1e-8
+
+
+def euler_to_matrix(rx: float, ry: float, rz: float) -> np.ndarray:
+    """Euler triple (radians) -> 3x3 rotation matrix. See module docstring."""
+    sa, ca = math.sin(rx), math.cos(rx)
+    sb, cb = math.sin(ry), math.cos(ry)
+    sc, cc = math.sin(rz), math.cos(rz)
+    return np.array(
+        [
+            [cc * cb, cc * sb * sa - sc * ca, cc * sb * ca + sc * sa],
+            [sc * cb, sc * sb * sa + cc * ca, sc * sb * ca - cc * sa],
+            [-sb, cb * sa, cb * ca],
+        ],
+        np.float64,
+    )
+
+
+def matrix_to_euler(r: np.ndarray) -> np.ndarray:
+    """3x3 rotation matrix -> Euler triple (radians). Inverse of the above.
+
+    ``ry`` is returned in ``[-pi/2, pi/2]``; ``rx`` and ``rz`` in ``(-pi, pi]``.
+    At gimbal lock (``|ry| = pi/2``) the split between ``rx`` and ``rz`` is
+    arbitrary, so ``rx`` is pinned to zero.
+    """
+    r = np.asarray(r, np.float64)
+    cb = math.hypot(r[0, 0], r[1, 0])
+    if cb < _GIMBAL_EPS:
+        ry = math.copysign(math.pi / 2.0, -r[2, 0])
+        return np.array([0.0, ry, math.atan2(-r[0, 1], r[1, 1])], np.float64)
+    return np.array(
+        [
+            math.atan2(r[2, 1], r[2, 2]),
+            math.atan2(-r[2, 0], cb),
+            math.atan2(r[1, 0], r[0, 0]),
+        ],
+        np.float64,
+    )
+
+
+def pose_to_matrix(pose) -> np.ndarray:
+    """``[x, y, z, rx, ry, rz]`` -> 4x4 transform."""
+    p = np.asarray(pose, np.float64).ravel()
+    if p.size != 6:
+        raise ValueError(f"pose must have 6 elements, got {p.size}")
+    t = np.eye(4)
+    t[:3, :3] = euler_to_matrix(p[3], p[4], p[5])
+    t[:3, 3] = p[:3]
+    return t
+
+
+def matrix_to_pose(t: np.ndarray) -> np.ndarray:
+    """4x4 transform -> ``[x, y, z, rx, ry, rz]``."""
+    t = np.asarray(t, np.float64)
+    if t.shape != (4, 4):
+        raise ValueError(f"transform must be 4x4, got {t.shape}")
+    return np.concatenate([t[:3, 3], matrix_to_euler(t[:3, :3])])
+
+
+def as_matrix(x) -> np.ndarray:
+    """Accept either a 6-vector pose or a 4x4 transform, return a 4x4."""
+    a = np.asarray(x, np.float64)
+    if a.shape == (4, 4):
+        return a.copy()
+    return pose_to_matrix(a)
+
+
+def rt_to_matrix(r: np.ndarray, t) -> np.ndarray:
+    out = np.eye(4)
+    out[:3, :3] = np.asarray(r, np.float64).reshape(3, 3)
+    out[:3, 3] = np.asarray(t, np.float64).ravel()
+    return out
+
+
+def rvec_tvec_to_matrix(rvec, tvec) -> np.ndarray:
+    """OpenCV / detector output (axis-angle + translation) -> 4x4 transform."""
+    import cv2
+
+    r, _ = cv2.Rodrigues(np.asarray(rvec, np.float64).reshape(3, 1))
+    return rt_to_matrix(r, tvec)
+
+
+def matrix_to_rvec_tvec(t: np.ndarray):
+    """4x4 transform -> (rvec, tvec) as OpenCV wants them."""
+    import cv2
+
+    t = np.asarray(t, np.float64)
+    rvec, _ = cv2.Rodrigues(t[:3, :3])
+    return rvec.ravel(), t[:3, 3].copy()
+
+
+def invert(t: np.ndarray) -> np.ndarray:
+    """Inverse of a rigid transform, without a general matrix inverse."""
+    t = np.asarray(t, np.float64)
+    r = t[:3, :3]
+    out = np.eye(4)
+    out[:3, :3] = r.T
+    out[:3, 3] = -r.T @ t[:3, 3]
+    return out
+
+
+def compose(*transforms: np.ndarray) -> np.ndarray:
+    out = np.eye(4)
+    for t in transforms:
+        out = out @ np.asarray(t, np.float64)
+    return out
+
+
+def transform_points(t: np.ndarray, points) -> np.ndarray:
+    """Apply a 4x4 transform to an (N, 3) array of points."""
+    p = np.asarray(points, np.float64).reshape(-1, 3)
+    return p @ np.asarray(t, np.float64)[:3, :3].T + np.asarray(t, np.float64)[:3, 3]
+
+
+def rotation_angle(r: np.ndarray) -> float:
+    """Magnitude of a rotation, in radians, from its 3x3 matrix."""
+    r = np.asarray(r, np.float64)[:3, :3]
+    # Clip guards against trace slightly outside [-1, 3] from round-off.
+    return float(math.acos(max(-1.0, min(1.0, (np.trace(r) - 1.0) / 2.0))))
+
+
+def pose_error(a, b) -> tuple[float, float]:
+    """Translation (m) and rotation (rad) difference between two transforms.
+
+    Accepts poses or matrices. The rotation term is the angle of the relative
+    rotation, which is convention-free -- unlike differencing Euler triples,
+    which wraps badly near +-pi and is meaningless near gimbal lock.
+    """
+    ta, tb = as_matrix(a), as_matrix(b)
+    return (
+        float(np.linalg.norm(ta[:3, 3] - tb[:3, 3])),
+        rotation_angle(ta[:3, :3].T @ tb[:3, :3]),
+    )
+
+
+def wrap_angle(a: float) -> float:
+    """Wrap an angle into (-pi, pi]."""
+    return float(-((-a + math.pi) % (2.0 * math.pi) - math.pi))
