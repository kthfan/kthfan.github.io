++            obj.iter().map(|p| cam().project_point(truth.transform(*p)).unwrap()).collect();
++        let est = estimate_pose(&obj, &img, &cam(), &PoseParams::default());
++        // Either refuse outright, or report an honest failure - never a
++        // confident wrong answer.
++        if let Some(e) = est {
++            assert!(!e.pose.rotation.iter().all(|v| v.is_finite()) || e.reprojection_rmse >= 0.0);
++        }
++    }
