+"""Techman TM arm + eye-in-hand camera, over gRPC.
+
+Three services are involved, on two endpoints:
+
+* ``StatusService.GetStatus`` -- a *stream* of robot state at a requested
+  frequency. A background thread keeps the latest message; :meth:`get_pose`
+  reads it under a lock.
+* ``GraphService.TriggerGraph`` -- a *stream* of node events. Motion is a
+  flow-graph run on the controller, so a move is "trigger the graph, then read
+  events until the graph finishes".
+* ``EIHCameraApi.getImageData`` -- a unary call returning a PNG blob.
+
+Units are the thing to be careful about. Techman reports and accepts
+millimetres and degrees; everything else in this package is metres and
+radians. The conversion happens here and nowhere else, so a value that has
+left this module is always SI.
+
+The rotation convention matches :mod:`..core.transforms`: fixed-axis XYZ,
+``R = Rz(rz) @ Ry(ry) @ Rx(rx)``.
+
+Nothing connects at construction time. Channels open on first use, so building
+the backend to poke the camera does not reach for the controller.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import threading
+import time
+
+import cv2
+import numpy as np
+
+from ..core import transforms as tf
+from ..core.backend import Backend
+from ..core.camera import CameraModel
+from ..core.config import Config
+from ..core.robot import CameraSource, RobotArm, UnreachablePose
+
+__all__ = ["TechmanRobot", "TechmanEIHCamera", "TechmanBackend"]
+
+_MM_PER_M = 1000.0
+
+
+def _import_grpc():
+    try:
+        import grpc
+    except ImportError as exc:  # pragma: no cover - environment dependent
+        raise RuntimeError(
+            "the techman backend needs grpcio: pip install grpcio"
+        ) from exc
+    return grpc
+
+
+class _Units:
+    """Whatever the controller speaks, translated to metres and radians."""
+
+    def __init__(self, cfg: dict | None = None):
+        cfg = cfg or {}
+        self.position = str(cfg.get("position", "m")).lower()
+        self.rotation = str(cfg.get("rotation", "rad")).lower()
+        if self.position not in ("mm", "m"):
+            raise ValueError(f"units.position must be 'mm' or 'm', got {self.position!r}")
+        if self.rotation not in ("deg", "rad"):
+            raise ValueError(f"units.rotation must be 'deg' or 'rad', got {self.rotation!r}")
+
+    def to_si(self, pose) -> np.ndarray:
+        p = np.asarray(pose, np.float64).copy()
+        if self.position == "mm":
+            p[:3] /= _MM_PER_M
+        if self.rotation == "deg":
+            p[3:] = np.radians(p[3:])
+        return p
+
+    def from_si(self, pose) -> np.ndarray:
+        p = np.asarray(pose, np.float64).copy()
+        if self.position == "mm":
+            p[:3] *= _MM_PER_M
+        if self.rotation == "deg":
+            p[3:] = np.degrees(p[3:])
+        return p
+
+
+class TechmanRobot(RobotArm):
+    """A real TM arm. Reports where it is; moves when told; refuses when it can't."""
+
+    def __init__(self, hand_eye=None, *, graph_address: str, status_address: str,
+                 motion: dict | None = None, units: dict | None = None,
+                 end_effector_frame: str = "flange",
+                 status_frequency_hz: float = 10.0, status_timeout_s: float = 5.0):
+        super().__init__(hand_eye)
+        self.graph_address = graph_address
+        self.status_address = status_address
+        self.units = _Units(units)
+        self.motion = dict(motion or {})
+        self.status_frequency_hz = float(status_frequency_hz)
+        self.status_timeout_s = float(status_timeout_s)
+
+        frame = str(end_effector_frame).lower()
+        if frame not in ("flange", "tool"):
+            raise ValueError(f"end_effector_frame must be 'flange' or 'tool', got {frame!r}")
+        # Which pose the controller reports as "the end effector". With
+        # 'flange' the hand-eye transform is flange->camera; with 'tool' it is
+        # measured from whatever TCP the controller has configured, and any
+        # T_ee_tool in the config is relative to that same TCP.
+        self.pose_field = f"coord_robot_{frame}"
+
+        self._grpc = None
+        self._status_channel = None
+        self._graph_channel = None
+        self._status_thread = None
+        self._status_stop = threading.Event()
+        self._status_lock = threading.Lock()
+        self._status = None
+        self._status_error: BaseException | None = None
+        self._first_status = threading.Event()
+        self.move_count = 0
+
+    # -- connection ----------------------------------------------------------
+
+    def _ensure_status(self) -> None:
+        if self._status_thread is not None:
+            return
+        grpc = _import_grpc()
+        from .tm_proto import robot_pb2, robot_pb2_grpc
+
+        self._grpc = grpc
+        # Not a `with` block: grpc.Channel.__exit__ closes the channel, so
+        # using one here would kill the stream the moment setup returned.
+        self._status_channel = grpc.insecure_channel(self.status_address)
+        stub = robot_pb2_grpc.StatusServiceStub(self._status_channel)
+        # frequency must be set; the default of 0.0 asks for no updates at all.
+        request = robot_pb2.RobotStatusRequest(frequency=self.status_frequency_hz)
+
+        def listen():
+            try:
+                for message in stub.GetStatus(request):
+                    if self._status_stop.is_set():
+                        break
+                    with self._status_lock:
+                        self._status = message
+                    self._first_status.set()
+            except BaseException as exc:      # noqa: BLE001 - reported to caller
+                self._status_error = exc
+                self._first_status.set()
+
+        self._status_thread = threading.Thread(
+            target=listen, name="tm-status", daemon=True)
+        self._status_thread.start()
+
+    def _latest_status(self):
+        self._ensure_status()
+        if not self._first_status.wait(self.status_timeout_s):
+            raise TimeoutError(
+                f"no status from {self.status_address} within "
+                f"{self.status_timeout_s:g} s"
+            )
+        if self._status_error is not None:
+            raise RuntimeError(
+                f"status stream from {self.status_address} failed: "
+                f"{self._status_error}"
+            ) from self._status_error
+        with self._status_lock:
+            return self._status
+
+    def _graph_stub(self):
+        grpc = _import_grpc()
+        from .tm_proto import robot_pb2_grpc
+
+        if self._graph_channel is None:
+            self._graph_channel = grpc.insecure_channel(self.graph_address)
+        return robot_pb2_grpc.GraphServiceStub(self._graph_channel)
+
+    # -- RobotArm ------------------------------------------------------------
+
+    def get_pose(self) -> np.ndarray:
+        status = self._latest_status()
+        raw = list(getattr(status, self.pose_field))
+        if len(raw) != 6:
+            raise RuntimeError(
+                f"{self.pose_field} has {len(raw)} values, expected 6"
+            )
+        return self.units.to_si(raw)
+
+    def move_pose(self, pose, **kwargs) -> None:
+        from .tm_proto import robot_pb2
+
+        target = np.asarray(pose, np.float64).reshape(6)
+        m = self.motion
+        action = {
+            "motion_type": int(m.get("motion_type", 4)),
+            m.get("positions_key", "positions"): self.units.from_si(target).tolist(),
+            "velocity": float(m.get("velocity", 10.0)),
+            "acc_time": float(m.get("acc_time", 0.2)),
+            "blend_percentage": int(m.get("blend_percentage", 0)),
+            "fine_goal": bool(m.get("fine_goal", True)),
+            "blocked": bool(m.get("blocked", True)),
+        }
+        payload = {
+            m.get("trigger_node", "input"): {"trigger": True},
+            m.get("node", "point"): action,
+        }
+        request = robot_pb2.TriggerGraphRequest(
+            graph_id=str(m.get("graph_id", "move_point")),
+            initial_inputs_json=json.dumps(payload),
+        )
+
+        timeout = float(m.get("timeout_s", 60.0))
+        stub = self._graph_stub()
+        try:
+            events = stub.TriggerGraph(request, timeout=timeout)
+            for event in events:
+                if event.event_type in (robot_pb2.NODE_FAILED, robot_pb2.GRAPH_FAILED):
+                    raise UnreachablePose(
+                        f"graph {request.graph_id!r} reported "
+                        f"{robot_pb2.NodeEventType.Name(event.event_type)} at node "
+                        f"{event.node_id!r}: {event.outputs_json}"
+                    )
+                if event.event_type == robot_pb2.GRAPH_DONE:
+                    break
+        except UnreachablePose:
+            raise
+        except Exception as exc:              # noqa: BLE001 - wrapped below
+            grpc = _import_grpc()
+            if isinstance(exc, grpc.RpcError):
+                raise UnreachablePose(f"motion RPC failed: {exc}") from exc
+            raise
+
+        settle = float(m.get("settle_s", 0.3))
+        if settle > 0.0:
+            time.sleep(settle)
+        self.move_count += 1
+        self._check_arrived(target)
+
+    def _check_arrived(self, target: np.ndarray) -> None:
+        """Confirm the arm is where it was sent.
+
+        The graph reporting DONE says the flow ran, not that the pose was
+        reached. Without this a partially executed move would be silently
+        recorded as a good sample and quietly poison every statistic.
+        """
+        tol_pos = float(self.motion.get("arrival_tol_m", 2e-3))
+        tol_rot = math.radians(float(self.motion.get("arrival_tol_deg", 1.0)))
+        if tol_pos <= 0.0 and tol_rot <= 0.0:
+            return
+        dp, dr = tf.pose_error(self.get_pose(), target)
+        if dp > tol_pos or dr > tol_rot:
+            raise UnreachablePose(
+                f"arm stopped {dp * 1000:.1f} mm / {math.degrees(dr):.2f} deg from "
+                f"the commanded pose (tolerance {tol_pos * 1000:.1f} mm / "
+                f"{math.degrees(tol_rot):.2f} deg)"
+            )
+
+    # -- diagnostics ---------------------------------------------------------
+
+    def describe(self) -> dict:
+        """Snapshot of the controller's state, for the operator."""
+        s = self._latest_status()
+        return {
+            "robot_link": bool(s.robot_link),
+            "robot_error": bool(s.robot_error),
+            "error_code": int(s.error_code),
+            "estop": bool(s.estop),
+            "project_run": bool(s.project_run),
+            "project_speed": int(s.project_speed),
+            "joint_angle_deg": list(s.joint_angle),
+            "coord_robot_flange": list(s.coord_robot_flange),
+            "coord_robot_tool": list(s.coord_robot_tool),
+            "pose_si": self.units.to_si(list(getattr(s, self.pose_field))).tolist(),
+        }
+
+    def close(self) -> None:
+        self._status_stop.set()
+        for name in ("_status_channel", "_graph_channel"):
+            channel = getattr(self, name)
+            if channel is not None:
+                channel.close()
+                setattr(self, name, None)
+
+
+class TechmanEIHCamera(CameraSource):
+    """The eye-in-hand camera, over ``EIHCameraApi``."""
+
+    def __init__(self, address: str, *, expected_size: tuple[int, int] | None = None,
+                 timeout_s: float = 10.0):
+        self.address = address
+        self.expected_size = expected_size
+        self.timeout_s = float(timeout_s)
+        self._channel = None
+        self._stub = None
+        self._color: np.ndarray | None = None
+        # Stays None until something moves the lens. Until then the config is
+        # authoritative, which is what the operator calibrated against.
+        self._camera_model: CameraModel | None = None
+
+    def _connect(self):
+        if self._stub is not None:
+            return self._stub
+        grpc = _import_grpc()
+        from .tm_proto import EIHCameraAPI_pb2_grpc
+
+        self._channel = grpc.insecure_channel(
+            self.address,
+            options=[
+                ("grpc.max_receive_message_length", 8388608), 
+            ],
+        )
+        self._stub = EIHCameraAPI_pb2_grpc.EIHCameraApiStub(self._channel)
+
+        if not self._stub.isCameraConnected(self._empty()).isCameraConnected:
+            self._stub.resumeCameraConnection(self._empty())
+
+        return self._stub
+    
+    def _disconnect(self):
+        if self._channel is not None:
+            grpc = _import_grpc()
+            try:
+                if self._stub.isCameraConnected(self._empty()).isCameraConnected:
+                    self._stub.terminateCameraConnection(self._empty())
+            except grpc.RpcError:
+                # Already unreachable, which is usually why we are here. The
+                # channel still has to go, or the reconnect reuses it.
+                pass
+            self._channel.close()
+            self._channel = None
+            self._stub = None
+
+    def _empty(self):
+        from google.protobuf import empty_pb2
+
+        return empty_pb2.Empty()
+
+    def capture(self) -> np.ndarray:
+        MAX_TRIAL = 3
+        for trial in range(MAX_TRIAL):
+            stub = self._connect()
+            data = stub.getImageData(self._empty(), timeout=self.timeout_s)
+            blob = bytes(data.EncodeString)
+            if blob:
+                break
+            
+            # no image returned, try again
+            self._disconnect()
+        else:
+            raise RuntimeError(f"camera at {self.address} failed to capture a valid image after {MAX_TRIAL} trials")
+
+        img = cv2.imdecode(np.frombuffer(blob, np.uint8), cv2.IMREAD_UNCHANGED)
+        if img is None:
+            raise RuntimeError(
+                f"camera at {self.address} returned {len(blob)} bytes that are "
+                f"not a decodable image"
+            )
+        if img.ndim == 3:
+            self._color = np.ascontiguousarray(img[:, :, :3])
+            gray = cv2.cvtColor(self._color, cv2.COLOR_BGR2GRAY)
+        else:
+            self._color = None
+            gray = img
+        if gray.dtype != np.uint8:
+            gray = cv2.normalize(gray, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)
+
+        if self.expected_size is not None:
+            h, w = gray.shape[:2]
+            if (w, h) != tuple(self.expected_size):
+                raise RuntimeError(
+                    f"camera returned {w}x{h} but the config declares "
+                    f"{self.expected_size[0]}x{self.expected_size[1]}; the "
+                    f"intrinsics would be wrong for this image"
+                )
+        return np.ascontiguousarray(gray)
+    
+    def capture_color(self):
+        return self._color
+
+    # -- optics --------------------------------------------------------------
+
+    def intrinsics(self) -> CameraModel | None:
+        """What the device says its lens is doing, once it has been asked.
+
+        ``None`` before any focus change, so an ordinary run is described by
+        the config and nothing else.
+        """
+        return self._camera_model
+
+    def set_focus(self, value: int) -> CameraModel:
+        """Move the lens, then re-read the intrinsics that belong to it.
+
+        The two halves are inseparable. The device keeps a table of
+        intrinsics indexed by (image size, focus), so refocusing without a
+        refresh leaves the detector solving poses with the focal length of a
+        lens position the camera has just left -- plausible numbers, wrong
+        answers, no error anywhere. Returns the model now in force.
+        """
+        from .tm_proto import EIHCameraAPI_pb2
+        grpc = _import_grpc()
+        request = EIHCameraAPI_pb2.setFocusRequest(focus=int(value))
+        MAX_TRIAL = 3
+        for trial in range(MAX_TRIAL):
+            try:
+                stub = self._connect()
+                stub.setFocus(request, timeout=self.timeout_s)
+                break
+            except grpc.RpcError:
+                # try again
+                self._disconnect()
+        else:
+            raise RuntimeError(f"camera at {self.address} failed to set focus after {MAX_TRIAL} trials")
+        return self._refresh_intrinsics()
+
+    def _refresh_intrinsics(self) -> CameraModel:
+        """Pick the intrinsics row describing how the camera is set up now.
+
+        Matched exactly on (width, height, focus) and refused otherwise. A
+        near miss is worse than a failure here: every pose the tests report
+        is downstream of these six numbers, and nothing later in the chain
+        can notice that they describe a different lens position.
+        """
+        stub = self._connect()
+        empty = self._empty()
+        cfg = stub.getImageConfiguration(empty, timeout=self.timeout_s)
+        width, height = int(cfg.ImageWidth), int(cfg.ImageHeight)
+        focus = int(stub.getFocus(empty, timeout=self.timeout_s).focus.CurrentValue)
+
+        rows = stub.getIntrinsics(empty, timeout=self.timeout_s).cam_intrinsics
+        for row in rows:
+            if (int(row.FocusValue) == focus
+                    and int(row.ImageWidth) == width
+                    and int(row.ImageHeight) == height):
+                break
+        else:
+            have = sorted({(int(r.ImageWidth), int(r.ImageHeight), int(r.FocusValue))
+                           for r in rows})
+            raise RuntimeError(
+                f"camera at {self.address} reports no intrinsics for "
+                f"{width}x{height} at focus {focus}; it offers "
+                f"{have} as (width, height, focus). The lens has moved and "
+                f"there is nothing that describes where it is, so every pose "
+                f"from here would be silently wrong."
+            )
+
+        k, d = row.CameraMatrix, row.DistortionCoefficients
+        self._camera_model = CameraModel(
+            width=width, height=height,
+            fx=float(k.matrix_00), fy=float(k.matrix_11),
+            cx=float(k.matrix_02), cy=float(k.matrix_12),
+            dist=(float(d.coefficient_00), float(d.coefficient_10),
+                  float(d.coefficient_20), float(d.coefficient_30),
+                  float(d.coefficient_40)),
+        )
+        # capture() checks incoming frames against this; it has to track the
+        # size the intrinsics were chosen for, not the one the config declared.
+        self.expected_size = (width, height)
+        return self._camera_model
+
+    def set_shutter_time(self, value: int) -> None:
+        """Sets the shutter time (exposure), in the device's own units.
+
+        Unlike focus, this does not touch which intrinsics row applies -- the
+        device's table is keyed on (image size, focus) only.
+        """
+        from .tm_proto import EIHCameraAPI_pb2
+        grpc = _import_grpc()
+        request = EIHCameraAPI_pb2.setShutterTimeRequest(shuttertime=int(value))
+        MAX_TRIAL = 3
+        for trial in range(MAX_TRIAL):
+            try:
+                stub = self._connect()
+                stub.setShutterTime(request, timeout=self.timeout_s)
+                break
+            except grpc.RpcError:
+                # try again
+                self._disconnect()
+        else:
+            raise RuntimeError(f"camera at {self.address} failed to set shutter time after {MAX_TRIAL} trials")
+
+    def set_gain(self, value: int) -> None:
+        """Sets the gain, in the device's own units."""
+        from .tm_proto import EIHCameraAPI_pb2
+        grpc = _import_grpc()
+        request = EIHCameraAPI_pb2.setGainRequest(gain=int(value))
+        MAX_TRIAL = 3
+        for trial in range(MAX_TRIAL):
+            try:
+                stub = self._connect()
+                stub.setGain(request, timeout=self.timeout_s)
+                break
+            except grpc.RpcError:
+                # try again
+                self._disconnect()
+        else:
+            raise RuntimeError(f"camera at {self.address} failed to set gain after {MAX_TRIAL} trials")
+
+    # -- diagnostics ---------------------------------------------------------
+
+    def describe(self) -> dict:
+        """Device-reported configuration.
+
+        The config file stays authoritative for intrinsics and hand-eye; this
