++fn upscale(q: &aprilgrid::quad::Quad, factor: usize) -> aprilgrid::quad::Quad {
++    if factor <= 1 {
++        return *q;
++    }
++    let f = factor as f64;
++    // Matches `detector::upscale_quad`: a decimated pixel centre maps back to
++    // the centre of the block of full-resolution pixels it covered.
++    let mut corners = q.corners;
++    for c in corners.iter_mut() {
++        c.x = c.x * f + (f - 1.0) * 0.5;
++        c.y = c.y * f + (f - 1.0) * 0.5;
++    }
++    aprilgrid::quad::Quad { corners }
++}
