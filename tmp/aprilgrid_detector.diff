+"""Simulated arm and camera.
+
+``SimRobot`` teleports, with realistic repeatability error: ``move_pose``
+lands near the commanded pose but not exactly on it, perturbed in the
+end-effector's own frame, which is what a real arm's repeatability spec
+describes. The renderer uses the *achieved* pose while :meth:`get_pose`
+reports the encoder reading, so a test that assumes "commanded == actual"
+shows the discrepancy instead of hiding it.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+from ..core import transforms as tf
+from ..core.robot import CameraSource, RobotArm
+from .scene import Scene
+
+__all__ = ["SimRobot", "SimCamera"]
+
+
+class SimRobot(RobotArm):
+    """An arm that teleports, with realistic repeatability error."""
+
+    def __init__(self, hand_eye=None, initial_pose=None,
+                 sigma_pos_m: float = 0.0, sigma_rot_rad: float = 0.0,
+                 sigma_report_pos_m: float = 0.0, sigma_report_rot_rad: float = 0.0,
+                 true_hand_eye=None, rng: np.random.Generator | None = None):
+        super().__init__(hand_eye)
+        self.rng = rng if rng is not None else np.random.default_rng(0)
+        self.sigma_pos = float(sigma_pos_m)
+        self.sigma_rot = float(sigma_rot_rad)
+        self.sigma_report_pos = float(sigma_report_pos_m)
+        self.sigma_report_rot = float(sigma_report_rot_rad)
+        # Where the camera really is, when that differs from the calibration
+        # the arm was given. None means the calibration is exact.
+        self._true_hand_eye = None if true_hand_eye is None else tf.as_matrix(true_hand_eye)
+        self.move_count = 0
+        self._achieved = tf.as_matrix(initial_pose if initial_pose is not None
+                                      else np.zeros(6))
+        self._reported = self._read_encoders()
+
+    # -- RobotArm ------------------------------------------------------------
+
+    def get_pose(self) -> np.ndarray:
+        return self._reported.copy()
+
+    def move_pose(self, pose, **kwargs) -> None:
+        commanded = tf.as_matrix(pose)
+        self._achieved = commanded @ self._perturbation(self.sigma_pos, self.sigma_rot)
+        self._reported = self._read_encoders()
+        self.move_count += 1
+
+    # -- ground truth (not part of the RobotArm contract) --------------------
+
+    def true_pose_matrix(self) -> np.ndarray:
+        return self._achieved.copy()
+
+    def true_camera_matrix(self) -> np.ndarray:
+        if self._true_hand_eye is not None:
+            return self._achieved @ self._true_hand_eye
+        return self._achieved @ self.hand_eye_matrix
+
+    def true_tool_matrix(self, T_ee_tool) -> np.ndarray:
+        return self._achieved @ tf.as_matrix(T_ee_tool)
+
+    # -- internals -----------------------------------------------------------
+
+    def _perturbation(self, sigma_pos: float, sigma_rot: float) -> np.ndarray:
+        if sigma_pos <= 0.0 and sigma_rot <= 0.0:
+            return np.eye(4)
+        d = np.zeros(6)
+        if sigma_pos > 0.0:
+            d[:3] = self.rng.normal(0.0, sigma_pos, 3)
+        if sigma_rot > 0.0:
+            d[3:] = self.rng.normal(0.0, sigma_rot, 3)
+        return tf.pose_to_matrix(d)
+
+    def _read_encoders(self) -> np.ndarray:
+        """Latched once per move: a real encoder does not jitter while parked."""
+        return tf.matrix_to_pose(
+            self._achieved @ self._perturbation(self.sigma_report_pos,
+                                                self.sigma_report_rot))
+
+
+class SimCamera(CameraSource):
+    """Renders through :class:`Scene` from the arm's *true* camera pose."""
+
+    def __init__(self, scene: Scene, robot: SimRobot):
+        self.scene = scene
+        self.robot = robot
+
+    def capture(self) -> np.ndarray:
+        return self.scene.render(self.robot.true_camera_matrix())
