++//! Planar pose estimation: where the board is relative to the camera.
++//!
++//! All the correspondences lie on a plane, so the pose can be recovered from a
++//! homography in closed form and then polished by minimizing reprojection
++//! error. The closed-form step gives an initial guess good enough that the
++//! nonlinear refinement always lands in the right basin, which is what keeps
++//! this deterministic and fast enough to run every frame.
++
++use nalgebra::{DMatrix, DVector, Matrix3, Vector3};
++
++use crate::board::{BoardLayout, BoardObservation};
++use crate::camera::Camera;
++use crate::geometry::{Point2, Point3, homography_from_points};
++
++/// Rigid transform taking board (object) coordinates into the camera frame.
++#[derive(Clone, Copy, Debug, PartialEq)]
++pub struct Pose {
++    pub rotation: Matrix3<f64>,
++    pub translation: Vector3<f64>,
++}
++
++impl Pose {
++    /// Maps an object point into the camera frame.
++    pub fn transform(&self, p: Point3) -> Point3 {
++        let v = self.rotation * Vector3::new(p.x, p.y, p.z) + self.translation;
++        Point3::new(v[0], v[1], v[2])
++    }
++
++    /// Rotation as a Rodrigues vector (axis * angle).
++    pub fn rotation_vector(&self) -> Vector3<f64> {
++        log_so3(&self.rotation)
++    }
++
++    /// Distance from the camera to the board origin, in metres.
++    pub fn distance(&self) -> f64 {
++        self.translation.norm()
++    }
++}
++
++/// A pose plus the evidence for how much to trust it.
++#[derive(Clone, Copy, Debug, PartialEq)]
++pub struct PoseEstimate {
++    pub pose: Pose,
++    /// Root-mean-square reprojection error over all corners, in pixels.
++    pub reprojection_rmse: f64,
++    /// Largest single-corner reprojection error, in pixels. A low RMSE with a
++    /// high maximum means one tag is misplaced.
++    pub reprojection_max: f64,
++    /// Corner correspondences used.
++    pub point_count: usize,
++}
++
++/// Refinement limits.
++#[derive(Clone, Copy, Debug)]
++pub struct PoseParams {
++    pub max_iterations: usize,
++    /// Stop once the parameter update falls below this.
++    pub convergence_eps: f64,
++}
++
++impl Default for PoseParams {
++    fn default() -> Self {
++        Self { max_iterations: 30, convergence_eps: 1e-10 }
++    }
++}
++
++/// Estimates the pose of a planar point set.
++///
++/// `object` points must be coplanar with `z == 0`; `image` points are in
++/// pixels. Requires at least four correspondences.
++pub fn estimate_pose(
++    object: &[Point3],
++    image: &[Point2],
++    camera: &Camera,
++    params: &PoseParams,
++) -> Option<PoseEstimate> {
++    if object.len() != image.len() || object.len() < 4 {
++        return None;
++    }
++
++    // Work in normalized, undistortion-corrected coordinates so the pose
++    // problem reduces to an ideal pinhole.
++    let plane: Vec<Point2> = object.iter().map(|p| Point2::new(p.x, p.y)).collect();
++    let rays: Vec<Point2> = image
++        .iter()
++        .map(|p| {
++            let (x, y) = camera.unproject(*p);
++            Point2::new(x, y)
++        })
++        .collect();
++
++    let h = homography_from_points(&plane, &rays)?;
++    let mut pose = pose_from_homography(&h.m)?;
++    refine(&mut pose, object, image, camera, params);
++
++    let (rmse, max) = reprojection_stats(&pose, object, image, camera)?;
++    Some(PoseEstimate {
++        pose,
++        reprojection_rmse: rmse,
++        reprojection_max: max,
++        point_count: object.len(),
++    })
++}
++
++/// Convenience wrapper for a grouped board observation.
++pub fn estimate_board_pose(
++    obs: &BoardObservation,
++    camera: &Camera,
++    params: &PoseParams,
++) -> Option<PoseEstimate> {
++    estimate_pose(&obs.object_points, &obs.image_points, camera, params)
++}
++
++/// Estimates a pose for every board seen in the image.
++pub fn estimate_all(
++    observations: &[BoardObservation],
++    _layout: &BoardLayout,
++    camera: &Camera,
++    params: &PoseParams,
++) -> Vec<(u32, PoseEstimate)> {
++    observations
++        .iter()
++        .filter_map(|o| estimate_board_pose(o, camera, params).map(|e| (o.board_id, e)))
++        .collect()
++}
++
++/// Closed-form pose from a plane-to-normalized-image homography.
++///
++/// With the intrinsics already removed, `H ~ [r1 | r2 | t]`. The scale comes
++/// from the fact that `r1` and `r2` are unit vectors; the sign is fixed by
++/// requiring the board to be in front of the camera.
++fn pose_from_homography(h: &Matrix3<f64>) -> Option<Pose> {
++    let h1 = Vector3::new(h[(0, 0)], h[(1, 0)], h[(2, 0)]);
++    let h2 = Vector3::new(h[(0, 1)], h[(1, 1)], h[(2, 1)]);
++    let h3 = Vector3::new(h[(0, 2)], h[(1, 2)], h[(2, 2)]);
++
++    let n1 = h1.norm();
++    let n2 = h2.norm();
++    if n1 < 1e-12 || n2 < 1e-12 {
++        return None;
++    }
++    // Averaging the two scales is more stable than trusting either alone.
++    let lambda = 2.0 / (n1 + n2);
++
++    let mut r1 = h1 * lambda;
++    let mut r2 = h2 * lambda;
++    let mut t = h3 * lambda;
++    if t[2] < 0.0 {
++        // The board must be in front of the camera; the homography's sign is
++        // arbitrary, so flip the whole thing.
++        r1 = -r1;
++        r2 = -r2;
++        t = -t;
++    }
++    let r3 = r1.cross(&r2);
++
++    let approx = Matrix3::from_columns(&[r1, r2, r3]);
++    let rotation = nearest_rotation(&approx)?;
++    Some(Pose { rotation, translation: t })
++}
++
++/// Closest true rotation matrix, via the polar decomposition `R = U V^T`.
++fn nearest_rotation(m: &Matrix3<f64>) -> Option<Matrix3<f64>> {
++    let svd = m.svd(true, true);
++    let u = svd.u?;
++    let vt = svd.v_t?;
++    let mut r = u * vt;
++    if r.determinant() < 0.0 {
++        // Guard against a reflection sneaking in.
++        let mut u2 = u;
++        u2.column_mut(2).neg_mut();
++        r = u2 * vt;
++    }
++    Some(r)
++}
++
++/// Gauss-Newton refinement of the 6-DoF pose against reprojection error.
++fn refine(
++    pose: &mut Pose,
++    object: &[Point3],
++    image: &[Point2],
++    camera: &Camera,
++    params: &PoseParams,
++) {
++    let n = object.len();
++    let mut lambda = 1e-3;
++    let mut current = residual_norm(pose, object, image, camera);
++
++    for _ in 0..params.max_iterations {
++        let mut j = DMatrix::<f64>::zeros(2 * n, 6);
++        let mut r = DVector::<f64>::zeros(2 * n);
++        let mut ok = true;
++
++        for (i, (op, ip)) in object.iter().zip(image).enumerate() {
++            let pc = pose.transform(*op);
++            if pc.z <= 1e-9 {
++                ok = false;
++                break;
++            }
++            let proj = camera.project_normalized(pc.x / pc.z, pc.y / pc.z);
++            r[2 * i] = proj.x - ip.x;
++            r[2 * i + 1] = proj.y - ip.y;
++
++            // Numeric Jacobian. The analytic form would be faster, but this
++            // runs once per board per frame on at most a few dozen points, and
++            // a hand-derived distortion derivative is a classic source of
++            // silent, hard-to-find sign errors.
++            for k in 0..6 {
++                const EPS: f64 = 1e-7;
++                let bumped = perturb(pose, k, EPS);
++                let pc2 = bumped.transform(*op);
++                if pc2.z <= 1e-9 {
++                    ok = false;
++                    break;
++                }
++                let p2 = camera.project_normalized(pc2.x / pc2.z, pc2.y / pc2.z);
++                j[(2 * i, k)] = (p2.x - proj.x) / EPS;
++                j[(2 * i + 1, k)] = (p2.y - proj.y) / EPS;
++            }
++            if !ok {
++                break;
++            }
++        }
++        if !ok {
++            return;
++        }
++
++        // Levenberg-Marquardt damping keeps the step sane when the board is
++        // nearly edge-on and the normal equations go ill-conditioned.
++        let jt = j.transpose();
++        let mut jtj = &jt * &j;
++        let jtr = &jt * &r;
++        for d in 0..6 {
++            jtj[(d, d)] *= 1.0 + lambda;
++        }
++        let Some(delta) = jtj.lu().solve(&-jtr) else {
++            return;
++        };
++        if !delta.iter().all(|v| v.is_finite()) {
++            return;
++        }
++
++        let mut candidate = *pose;
++        for k in 0..6 {
++            candidate = perturb(&candidate, k, delta[k]);
++        }
++        let next = residual_norm(&candidate, object, image, camera);
++        if next < current {
++            *pose = candidate;
++            let improvement = current - next;
++            current = next;
++            lambda = (lambda * 0.5).max(1e-12);
++            if improvement < params.convergence_eps {
++                return;
++            }
++        } else {
++            lambda *= 4.0;
++            if lambda > 1e8 {
++                return;
++            }
++        }
++    }
++}
++
++/// Applies a small increment to one of the six pose parameters.
++///
++/// `k` in `0..3` rotates (right-multiplied so the increment lives in the body
++/// frame), `k` in `3..6` translates.
++fn perturb(pose: &Pose, k: usize, eps: f64) -> Pose {
++    if k < 3 {
++        let mut w = Vector3::zeros();
++        w[k] = eps;
++        Pose { rotation: pose.rotation * exp_so3(&w), translation: pose.translation }
++    } else {
++        let mut d = Vector3::zeros();
++        d[k - 3] = eps;
++        Pose { rotation: pose.rotation, translation: pose.translation + d }
++    }
++}
++
++fn residual_norm(pose: &Pose, object: &[Point3], image: &[Point2], camera: &Camera) -> f64 {
++    let mut acc = 0.0;
++    for (op, ip) in object.iter().zip(image) {
++        let pc = pose.transform(*op);
++        if pc.z <= 1e-9 {
++            return f64::MAX;
++        }
++        let proj = camera.project_normalized(pc.x / pc.z, pc.y / pc.z);
++        acc += (proj.x - ip.x).powi(2) + (proj.y - ip.y).powi(2);
++    }
++    acc
++}
++
++fn reprojection_stats(
++    pose: &Pose,
++    object: &[Point3],
++    image: &[Point2],
++    camera: &Camera,
++) -> Option<(f64, f64)> {
++    let mut sum_sq = 0.0;
++    let mut max: f64 = 0.0;
++    for (op, ip) in object.iter().zip(image) {
++        let pc = pose.transform(*op);
++        if pc.z <= 1e-9 {
++            return None;
++        }
++        let proj = camera.project_normalized(pc.x / pc.z, pc.y / pc.z);
++        let d = proj.distance(*ip);
++        sum_sq += d * d;
++        max = max.max(d);
++    }
++    Some(((sum_sq / object.len() as f64).sqrt(), max))
++}
++
++/// Rodrigues: rotation vector -> matrix.
++pub fn exp_so3(w: &Vector3<f64>) -> Matrix3<f64> {
++    let theta = w.norm();
++    if theta < 1e-12 {
++        return Matrix3::identity();
++    }
++    let k = w / theta;
++    let kx = Matrix3::new(0.0, -k[2], k[1], k[2], 0.0, -k[0], -k[1], k[0], 0.0);
++    Matrix3::identity() + kx * theta.sin() + kx * kx * (1.0 - theta.cos())
++}
++
++/// Rodrigues: rotation matrix -> vector.
++pub fn log_so3(r: &Matrix3<f64>) -> Vector3<f64> {
++    let trace = r[(0, 0)] + r[(1, 1)] + r[(2, 2)];
++    let cos = ((trace - 1.0) * 0.5).clamp(-1.0, 1.0);
++    let theta = cos.acos();
++    if theta < 1e-12 {
++        return Vector3::zeros();
++    }
++    if (std::f64::consts::PI - theta).abs() < 1e-6 {
++        // Near 180 degrees the antisymmetric part vanishes; recover the axis
++        // from the diagonal of R + I instead.
++        let d = Vector3::new(
++            ((r[(0, 0)] + 1.0) * 0.5).max(0.0).sqrt(),
++            ((r[(1, 1)] + 1.0) * 0.5).max(0.0).sqrt(),
++            ((r[(2, 2)] + 1.0) * 0.5).max(0.0).sqrt(),
++        );
++        let mut axis = d;
++        // Fix the signs from the off-diagonal terms.
++        if r[(2, 1)] - r[(1, 2)] < 0.0 {
++            axis[0] = -axis[0];
++        }
++        if r[(0, 2)] - r[(2, 0)] < 0.0 {
++            axis[1] = -axis[1];
++        }
++        if r[(1, 0)] - r[(0, 1)] < 0.0 {
++            axis[2] = -axis[2];
++        }
++        let n = axis.norm();
++        if n < 1e-12 {
++            return Vector3::zeros();
++        }
++        return axis / n * theta;
++    }
++    let s = 0.5 * theta / theta.sin();
++    Vector3::new(
++        (r[(2, 1)] - r[(1, 2)]) * s,
++        (r[(0, 2)] - r[(2, 0)]) * s,
++        (r[(1, 0)] - r[(0, 1)]) * s,
++    )
++}
