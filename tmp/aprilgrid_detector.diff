+    #[test]
+    fn parallel_lines_do_not_intersect() {
+        let a = Line2 { point: Point2::new(0.0, 0.0), dir: Point2::new(1.0, 0.0) };
+        let b = Line2 { point: Point2::new(0.0, 5.0), dir: Point2::new(1.0, 0.0) };
+        assert!(a.intersect(&b).is_none());
