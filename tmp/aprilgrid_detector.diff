@@ -0,0 +1,154 @@
+"""Probe: talk to the hardware without moving it.
+
+Run this first, before any test. It touches only the camera -- the arm is
+never commanded and, on the Techman backend, the controller is not even
+connected to unless ``--arm`` is given.
+
+What it answers:
+
+* is the camera reachable, and does it return a decodable image
+* does that image match the size the config declares (if not, the intrinsics
+  are wrong and every number the tests produce would be meaningless)
+* what intrinsics and hand-eye values does the device itself report -- for
+  filling in ``configs/techman.yaml``, which stays authoritative
+* can the detector find the grid in that image at all
+
+    python tools/robotlab/run.py probe --backend techman --show
+"""
+
+from __future__ import annotations
+
+import json
+
+from ._common import common_args, fmt_pose, np, open_session, tf
+
+
+def run(args) -> int:
+    session = open_session(args, board_count=1)
+    cfg, bench = session.cfg, session.bench
+    source = session.backend.source
+    ok = True
+
+    try:
+        cam = cfg.camera()
+        print(f"\nconfig camera  {cam.width}x{cam.height}  fx={cam.fx:.1f} "
+              f"fy={cam.fy:.1f}  cx={cam.cx:.1f} cy={cam.cy:.1f}")
+        print(f"config dist    {list(cam.dist)}")
+
+        describe = getattr(source, "describe", None)
+        if describe is not None:
+            info = describe()
+            print("\ndevice reports:")
+            print(json.dumps(info, indent=2))
+            if not _suggest_camera_block(info):
+                ok = False
+
+        print("\ncapturing...")
+        frame = bench.capture()
+        print(f"  image {frame.gray.shape[1]}x{frame.gray.shape[0]} "
+              f"{frame.gray.dtype}  mean {frame.gray.mean():.1f}  "
+              f"range {frame.gray.min()}-{frame.gray.max()}")
+        path = bench.save("probe", frame)
+        if path:
+            print(f"  wrote {path}")
+        bench.display("probe", frame, wait=1000)
+
+        boards = bench.detect(frame)
+        if not boards:
+            print("\n  NO BOARD DETECTED")
+            print("  check focus, lighting, that the grid is in view, and that "
+                  "board.tags_x/tags_y/tag_size match the printed sheet")
+            ok = False
+        for b in boards:
+            print(f"\n  board {b.board_id}  coverage {b.coverage:.2f}  "
+                  f"{len(b.detections)} tags")
+            if b.pose is None:
+                print("    no pose (too few tags)")
+                ok = False
+                continue
+            T = tf.rvec_tvec_to_matrix(b.pose.rvec, b.pose.translation)
+            print(f"    T_cam_grid   {fmt_pose(T)}")
+            print(f"    distance     {b.pose.distance:.4f} m")
+            print(f"    reprojection {b.pose.reprojection_rmse:.3f} px rms, "
+                  f"{b.pose.reprojection_max:.3f} px max")
+            if b.pose.reprojection_rmse > 1.0:
+                print("    reprojection is high -- suspect the intrinsics or "
+                      "the tag size")
+
+        if args.arm:
+            print("\nconnecting to the controller (read-only)...")
+            describe_arm = getattr(bench.robot, "describe", None)
+            if describe_arm is None:
+                print("  this backend has no controller to describe")
+            else:
+                print(json.dumps(describe_arm(), indent=2))
+                pose = bench.robot.get_pose()
+                print(f"  T_base_ee    {fmt_pose(pose)}   (metres, radians)")
+                print(f"  T_base_cam   {fmt_pose(bench.robot.get_camera_matrix())}")
+    finally:
+        session.close()
+
+    print("\nprobe " + ("OK" if ok else "FAILED"))
+    return 0 if ok else 1
+
+
+def _suggest_camera_block(info: dict) -> bool:
+    """Print the intrinsics row that matches how the camera is set up now.
+
+    The device ships a table covering every focus and image-size combination.
+    Only one row describes the images it is currently producing, and picking
+    the wrong one is a silent error, so pick it here rather than leaving it to
+    whoever edits the config.
+    """
+    current = info.get("current", {})
+    image = info.get("image", {})
+    w, h = image.get("width"), image.get("height")
+    focus = current.get("focus")
+    rows = [r for r in info.get("intrinsics", [])
+            if r["width"] == w and r["height"] == h]
+    if not rows:
+        print(f"\n  the device reports no intrinsics for its current "
+              f"{w}x{h} image size")
+        return False
+    match = min(rows, key=lambda r: abs(r["focus"] - focus))
+    if abs(match["focus"] - focus) > 1e-6:
+        print(f"\n  no intrinsics for focus {focus}; nearest is "
+              f"{match['focus']}, which will be wrong")
+        return False
+
+    print(f"\n  current setup: {w}x{h}, focus {focus}, "
+          f"{image.get('pixel_format')} {image.get('type')}")
+    print("  the matching intrinsics, ready to paste into the config's "
+          "`camera` block:\n")
+    block = [("width", w), ("height", h),
+             ("fx", round(match["fx"], 4)), ("fy", round(match["fy"], 4)),
+             ("cx", round(match["cx"], 4)), ("cy", round(match["cy"], 4)),
+             ("dist", [round(d, 6) for d in match["dist"]])]
+    print("    camera:")
+    for key, value in block:
+        print(f"      {key}: {value}")
+    print("\n  and the device's own hand-eye, in metres and radians "
+          "(cross-check only -- your calibration stays authoritative):")
+    raw = info.get("hand_eye_raw")
+    if raw:
+        pose = np.concatenate([np.asarray(raw[:3]) / 1000.0,
+                               np.radians(raw[3:])])
+        print(f"    T_ee_cam  {[round(float(v), 6) for v in pose]}")
+        print(f"              {fmt_pose(tf.pose_to_matrix(pose))}")
+    return True
+
+
+def add_args(p):
+    p.add_argument("--out", default="data/robotlab/probe",
+                   help="directory for the captured image")
+    p.add_argument("--arm", action="store_true",
+                   help="also query the controller (read-only; never moves)")
+    return p
+
+
+def main() -> int:
+    return run(add_args(common_args(__doc__.splitlines()[0])).parse_args())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
