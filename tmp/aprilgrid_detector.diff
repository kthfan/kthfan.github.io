index 0000000..a30c989
--- /dev/null
+++ "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/configs/sim.yaml"
@@ -0,0 +1,136 @@
+# Settings for the eye-in-hand robot tests. Every pose is [x, y, z, rx, ry, rz]:
+# metres and radians, fixed-axis XYZ (see core/transforms.py).
+# T_a_b maps points from frame b into frame a.
+#
+# Frames: base (robot), ee (end effector/flange), cam (optical: x right, y down,
+# z forward), grid (AprilGrid: x right, y down, z into the printed sheet, so the
+# camera views the board from its -z side), tool (tip at the tool-frame origin),
+# target (the object to be touched).
+#
+# Pass a modified copy to any test with --config; only the keys you list are
+# overridden, the rest fall back to this file.
+
+backend: sim
+
+camera:
+  width: 1920
+  height: 1080
+  fx: 1400.0
+  fy: 1400.0
+  cx: null
+  cy: null
+  dist: [-0.18, 0.04, 0.0004, -0.0003, -0.002]
+
+board:
+  # start_id is the tag id in the top-left cell. The detector groups tags by
+  # tag_id // (tags_x*tags_y), so a sheet starting at 4 is board 1, not board 0;
+  # a second board in the scene follows on from the first. Must be a multiple of
+  # tags_x*tags_y.
+  tags_x: 4
+  tags_y: 1
+  tag_size: 0.020
+  tag_separation: 0.0075
+  margin: 0.005
+  start_id: 0
+  render_px_per_tag: 120
+
+hand_eye:
+  # T_ee_cam: the camera expressed in the end-effector frame. This is what
+  # OpenCV calibrateHandEye returns for an eye-in-hand rig. Here: 60 mm along
+  # the flange +x, 30 mm back along -z, pitched -15 deg so the camera looks
+  # inward and its optical axis converges on the tool tip. T_ee_cam_true is
+  # where the camera really is in the simulation; leave it null to make the
+  # calibration exact, or set it to inject a calibration error and watch the
+  # reproducibility spread grow.
+  T_ee_cam: [0.06, 0.0, -0.03, 0.0, -0.2618, 0.0]
+  T_ee_cam_true: null
+
+robot:
+  # Repeatability of the simulated arm: the achieved pose differs from the
+  # commanded one by this much. sigma_report adds an extra encoder-readout
+  # error on top, and is zero by default.
+  sigma_pos_m: 5.0e-5
+  sigma_rot_rad: 1.745e-4
+  sigma_report_pos_m: 0.0
+  sigma_report_rot_rad: 0.0
+  home_pose: [0.30, 0.0, 0.45, 3.14159265, 0.0, 0.0]
+
+scene:
+  # The grid lies flat on the table. Rx = pi turns the board's -z (its viewing
+  # normal) to point up, so a camera above the table sees the printed face.
+  # T_grid_centre is what the camera orbits, in the first board's frame: its
+  # origin is aimed at, its -z is the direction the camera looks from, its x is
+  # the zero of roll. Leave it null and the bench uses the centroid of the
+  # printed tags with the board's own axes, which is what you want for a plain
+  # rectangular sheet.
+  T_base_grid: [0.45, -0.05, 0.0, 3.14159265, 0.0, 0.0]
+  T_grid_centre: null
+  T_grid_grid2: [0.0, 0.06, 0.0, 0.0, 0.0, 0.0]
+  T_ee_tool: [0.0, 0.0, 0.12, 0.0, 0.0, 0.0]
+  T_grid_target: [0.05, -0.045, -0.006, 0.0, 0.0, 0.0]
+  background: 210
+  tool_marker_radius_m: 0.004
+  target_marker_radius_m: 0.005
+  tool_marker_bgr: [255, 40, 0]
+  target_marker_bgr: [0, 40, 255]
+
+sampling:
+  # Camera positions on a sphere around the board centre. theta is the polar
+  # angle away from the board's viewing normal, phi the azimuth about it.
+  # shift_m then slides the camera sideways in its own x/y so the board is not
+  # centred in the frame.
+  radius_m: [0.25, 0.60]
+  theta_deg: [0.0, 40.0]
+  phi_deg: [0.0, 360.0]
+  roll_deg: [-30.0, 30.0]
+  shift_m: [-0.06, 0.06]
+  min_visible_fraction: 0.6
+  max_attempts: 200
+
+ensemble:
+  # Several looks per viewpoint instead of one, averaged. The Cartesian product
+  # of the six lists, so this is 9 poses; the count multiplies fast.
+  # orbit_x/y_deg swing the camera around the grid centre about the centre
+  # frame's own x and y axes, still aimed at it -- these change the incidence
+  # angle and are the only offsets that improve a weakly observed axis.
+  # Orbiting about x helps rx and the y translation it trades off against;
+  # about y helps ry and x; d_radius_m helps depth. d_roll_deg and
+  # d_shift_x/y_m only move the board to a different part of the sensor, which
+  # resamples distortion and corner noise but fixes no geometry. Averaging
+  # cannot touch systematic error -- hand-eye, a bowed sheet -- because that is
+  # the same at every pose in so small a pattern.
+  enabled: false
+  orbit_x_deg: [-8.0, 0.0, 8.0]
+  orbit_y_deg: [-8.0, 0.0, 8.0]
+  d_radius_m: [0.0]
+  d_roll_deg: [0.0]
+  d_shift_x_m: [0.0]
+  d_shift_y_m: [0.0]
+  min_detections: 3
+
+degradations:
+  # A settled arm holds still, so motion blur is much smaller than in
+  # simulate.py's photographic presets, and occlusion is disabled because every
+  # test assumes the grid stays visible.
+  blur_sigma: [0.0, 1.2]
+  motion_px: [0.0, 1.5]
+  noise_sigma: [1.0, 6.0]
+  exposure: [0.85, 1.20]
+  vignette: [0.0, 0.35]
+  illumination_ramp: [0.0, 45.0]
+  contrast_loss: [0.0, 0.25]
+  occlusion_prob: 0.0
+  occlusion_radius: [0.05, 0.22]
+  jpeg_quality: [75, 96]
+
+detector:
+  decimate: 1
+  refine_edges: true
+  parallel: true
+
+tests:
+  reproducibility_samples: 30
+  consistency_samples: 30
+  touch_rounds: 5
+  seed: 7
+  min_board_coverage: 0.5
diff --git "a/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/configs/techman.yaml" "b/C:\\Users\\chunghaofan\\Projects\\AprilgridDetector\\bak/tools/robotlab/configs/techman.yaml"
