+//! End-to-end detection: greyscale image in, decoded tags with sub-pixel
+//! corners out.
+//!
+//! Pipeline: optional decimation -> adaptive threshold -> boundary clusters ->
+//! quad fit -> rescale to full resolution -> gradient edge refinement ->
+//! payload decode -> duplicate suppression.
+//!
+//! Decimation only ever drives *detection*; corners and payload are always
+//! measured on the full-resolution image, so speed is traded against the
+//! smallest detectable tag rather than against accuracy.
+
+use rayon::prelude::*;
+
+use crate::decode::{DecodeParams, Detection, decode_quad};
+use crate::geometry::Point2;
+use crate::gray::GrayImage;
+use crate::quad::{Quad, QuadParams, RefineParams, fit_quad, refine_edges};
+use crate::segmentation::boundary_clusters;
+use crate::tag_family::TagFamily;
+use crate::threshold::adaptive_threshold;
+
+/// Configuration for [`Detector`].
+#[derive(Clone, Copy, Debug)]
+pub struct DetectorParams {
+    /// Downscale factor used for candidate search. 1 disables decimation.
+    pub decimate: usize,
+    /// Minimum local contrast for a tile to be binarised at all.
+    pub min_contrast: u8,
+    /// Smallest boundary cluster considered.
+    pub min_cluster_size: usize,
+    pub quad: QuadParams,
+    pub refine: RefineParams,
+    pub decode: DecodeParams,
+    /// Run the gradient edge refinement pass.
+    pub refine_edges: bool,
+    /// Use rayon to process candidate clusters in parallel.
+    pub parallel: bool,
+}
+
+impl Default for DetectorParams {
+    fn default() -> Self {
+        Self {
+            decimate: 1,
+            min_contrast: 12,
+            min_cluster_size: 24,
+            quad: QuadParams::default(),
+            refine: RefineParams::default(),
+            decode: DecodeParams::default(),
+            refine_edges: true,
+            parallel: true,
+        }
+    }
+}
+
+impl DetectorParams {
+    /// Preset for 1080p-class video where tags are comfortably larger than
+    /// ~40 px: halving the search resolution cuts the threshold and
+    /// segmentation cost roughly fourfold.
+    pub fn realtime_hd() -> Self {
+        Self { decimate: 2, ..Self::default() }
+    }
+}
+
+/// Detects tags of one family in greyscale images.
+pub struct Detector {
+    family: TagFamily,
+    params: DetectorParams,
+}
+
+impl Detector {
+    pub fn new(family: TagFamily, params: DetectorParams) -> Self {
+        Self { family, params }
+    }
+
+    /// A detector for the 36h11 family with default tuning.
+    pub fn t36h11() -> Self {
+        Self::new(TagFamily::t36h11(), DetectorParams::default())
+    }
+
+    pub fn params(&self) -> &DetectorParams {
+        &self.params
+    }
+
+    pub fn params_mut(&mut self) -> &mut DetectorParams {
+        &mut self.params
+    }
+
+    pub fn family(&self) -> &TagFamily {
+        &self.family
+    }
+
+    /// Runs the full pipeline.
+    ///
+    /// Results are sorted by tag id; each id appears at most once.
+    pub fn detect(&self, img: &GrayImage) -> Vec<Detection> {
+        let factor = self.params.decimate.max(1);
+        // Avoid copying a full-resolution frame when decimation is disabled.
+        let decimated;
+        let search: &GrayImage = if factor > 1 {
+            decimated = img.decimate(factor);
+            &decimated
+        } else {
+            img
+        };
+        if search.width() < 8 || search.height() < 8 {
+            return Vec::new();
+        }
+
+        let bin = adaptive_threshold(search, self.params.min_contrast);
+        let clusters = boundary_clusters(&bin, self.params.min_cluster_size);
+
+        // At the search resolution a quad must still be big enough to decode;
+        // the caller's threshold is expressed in full-resolution pixels.
+        let search_quad = QuadParams {
+            min_side_px: self.params.quad.min_side_px / factor as f64,
+            ..self.params.quad
+        };
+
+        let process = |cluster: &Vec<crate::segmentation::BoundaryPoint>| -> Option<Detection> {
+            let quad = fit_quad(cluster, &search_quad)?;
+            let full = upscale_quad(&quad, factor);
+            if full.min_side() < self.params.quad.min_side_px {
+                return None;
+            }
+            let refined = if self.params.refine_edges {
+                refine_edges(img, &full, &self.params.refine).unwrap_or(full)
+            } else {
+                full
+            };
+            decode_quad(img, &refined, &self.family, &self.params.decode)
+        };
+
+        let mut found: Vec<Detection> = if self.params.parallel {
+            clusters.par_iter().filter_map(process).collect()
+        } else {
+            clusters.iter().filter_map(process).collect()
+        };
+
+        dedupe(&mut found);
+        found.sort_by_key(|d| d.id);
+        found
+    }
+}
+
+/// Maps a quad found on a decimated image back to full-resolution coordinates.
+///
+/// `GrayImage::decimate` box-averages `factor x factor` blocks, so low-res
+/// pixel `i` is centred on full-res coordinate `i * factor + (factor - 1) / 2`.
+fn upscale_quad(q: &Quad, factor: usize) -> Quad {
+    if factor <= 1 {
+        return *q;
+    }
+    let f = factor as f64;
+    let shift = (f - 1.0) * 0.5;
+    let mut corners = [Point2::default(); 4];
+    for i in 0..4 {
+        corners[i] = Point2::new(q.corners[i].x * f + shift, q.corners[i].y * f + shift);
+    }
+    Quad { corners }
+}
+
+/// Keeps the most confident detection when the same id turns up more than once.
+///
+/// Nested boundaries and near-duplicate clusters can both yield a decode for
+/// one physical tag; emitting both would corrupt any downstream pose fit.
+fn dedupe(dets: &mut Vec<Detection>) {
+    dets.sort_by(|a, b| {
+        a.id.cmp(&b.id).then(
+            b.decision_margin.partial_cmp(&a.decision_margin).unwrap_or(std::cmp::Ordering::Equal),
+        )
+    });
+    let mut kept: Vec<Detection> = Vec::with_capacity(dets.len());
+    for d in dets.iter() {
+        let dup = kept.iter().any(|k| {
+            k.id == d.id && {
+                let span = k.corners[0].distance(k.corners[2]).max(1.0);
+                k.center().distance(d.center()) < 0.5 * span
+            }
+        });
+        if !dup {
+            kept.push(*d);
+        }
+    }
+    *dets = kept;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const CELL: usize = 10;
+
+    /// Board layout in tag-side units, mirroring `generate_aprilgrid.py`:
+    /// tag side 1.0, gap `separation` between neighbours.
+    struct BoardSpec {
+        cols: usize,
+        rows: usize,
+        separation: f64,
+        first_id: u32,
+    }
+
+    /// Renders a board of tags into a white image. Returns the image and the
+    /// exact corner positions of every tag, in printed order.
+    fn render_board(fam: &TagFamily, spec: &BoardSpec) -> (GrayImage, Vec<(u32, [Point2; 4])>) {
+        let side = fam.side_cells();
+        let tag_px = side * CELL;
+        let gap_px = (spec.separation * tag_px as f64).round() as usize;
+        let margin = tag_px / 2;
+        let w = margin * 2 + spec.cols * tag_px + spec.cols.saturating_sub(1) * gap_px;
+        let h = margin * 2 + spec.rows * tag_px + spec.rows.saturating_sub(1) * gap_px;
+        let mut img = GrayImage::filled(w, h, 255);
+        let mut truth = Vec::new();
+
+        for r in 0..spec.rows {
+            for c in 0..spec.cols {
+                let id = spec.first_id + (r * spec.cols + c) as u32;
+                let ox = margin + c * (tag_px + gap_px);
+                let oy = margin + r * (tag_px + gap_px);
+                draw_tag(&mut img, fam, id, ox, oy);
+                // The black square covers pixels [ox, ox + tag_px - 1], whose
+                // outer edges are half a pixel beyond the centres of the first
+                // and last covered pixels.
+                let (x0, y0) = (ox as f64 - 0.5, oy as f64 - 0.5);
+                let (x1, y1) = (x0 + tag_px as f64, y0 + tag_px as f64);
+                truth.push((
+                    id,
+                    [
+                        Point2::new(x0, y0),
+                        Point2::new(x1, y0),
+                        Point2::new(x1, y1),
+                        Point2::new(x0, y1),
+                    ],
+                ));
+            }
+        }
+        (img, truth)
+    }
+
+    fn draw_tag(img: &mut GrayImage, fam: &TagFamily, id: u32, ox: usize, oy: usize) {
+        let side = fam.side_cells();
+        let edge = fam.edge_cells;
+        let code = fam.code(id).unwrap();
+        for r in 0..side {
+            for c in 0..side {
+                let ir = r as isize - fam.border_cells as isize;
+                let ic = c as isize - fam.border_cells as isize;
+                let white = ir >= 0
+                    && ic >= 0
+                    && (ir as usize) < edge
+                    && (ic as usize) < edge
+                    && (code >> (edge * edge - 1 - (ir as usize * edge + ic as usize))) & 1 == 1;
+                let v = if white { 255u8 } else { 0u8 };
+                for y in 0..CELL {
+                    for x in 0..CELL {
+                        img.set(ox + c * CELL + x, oy + r * CELL + y, v);
+                    }
+                }
+            }
+        }
+    }
+
+    /// Worst corner error against ground truth, in pixels.
+    fn corner_error(dets: &[Detection], truth: &[(u32, [Point2; 4])]) -> f64 {
+        let mut worst: f64 = 0.0;
+        for d in dets {
+            let t = truth.iter().find(|(id, _)| *id == d.id).expect("unexpected id");
+            for i in 0..4 {
+                worst = worst.max(d.corners[i].distance(t.1[i]));
+            }
+        }
+        worst
+    }
+
+    #[test]
+    fn detects_every_tag_on_a_four_by_one_strip() {
+        let fam = TagFamily::t36h11();
+        // The user's board: 4x1, 20 mm tags with 7.5 mm separation.
+        let spec = BoardSpec { cols: 4, rows: 1, separation: 7.5 / 20.0, first_id: 0 };
+        let (img, truth) = render_board(&fam, &spec);
+        let dets = Detector::t36h11().detect(&img);
+
+        assert_eq!(dets.len(), 4, "expected 4 tags, got {:?}", dets.iter().map(|d| d.id).collect::<Vec<_>>());
+        assert_eq!(dets.iter().map(|d| d.id).collect::<Vec<_>>(), vec![0, 1, 2, 3]);
+        assert!(dets.iter().all(|d| d.hamming == 0));
+        let err = corner_error(&dets, &truth);
+        assert!(err < 0.5, "worst corner error {err} px");
+    }
+
+    #[test]
+    fn corners_are_reported_in_printed_order_not_detection_order() {
+        let fam = TagFamily::t36h11();
+        let spec = BoardSpec { cols: 4, rows: 1, separation: 0.375, first_id: 0 };
+        let (img, truth) = render_board(&fam, &spec);
+        let dets = Detector::t36h11().detect(&img);
+        for d in &dets {
+            let t = truth.iter().find(|(id, _)| *id == d.id).unwrap();
+            // Corner 0 must be the tag's own top-left, not merely *a* corner.
+            assert!(
+                d.corners[0].distance(t.1[0]) < 0.5,
+                "tag {} corner 0 is at {:?}, expected {:?}",
+                d.id,
+                d.corners[0],
+                t.1[0]
+            );
+        }
+    }
+
+    #[test]
+    fn works_on_a_multi_row_grid_too() {
+        let fam = TagFamily::t36h11();
+        let spec = BoardSpec { cols: 3, rows: 3, separation: 0.375, first_id: 10 };
+        let (img, _) = render_board(&fam, &spec);
+        let dets = Detector::t36h11().detect(&img);
+        assert_eq!(dets.len(), 9);
+        assert_eq!(dets.iter().map(|d| d.id).collect::<Vec<_>>(), (10..19).collect::<Vec<_>>());
+    }
+
+    #[test]
+    fn each_tag_is_reported_exactly_once() {
+        let fam = TagFamily::t36h11();
+        let spec = BoardSpec { cols: 4, rows: 1, separation: 0.375, first_id: 100 };
+        let (img, _) = render_board(&fam, &spec);
+        let dets = Detector::t36h11().detect(&img);
+        let mut ids: Vec<u32> = dets.iter().map(|d| d.id).collect();
+        let before = ids.len();
+        ids.dedup();
+        assert_eq!(ids.len(), before, "duplicate ids in output");
+    }
+
+    #[test]
+    fn survives_additive_noise() {
+        let fam = TagFamily::t36h11();
+        let spec = BoardSpec { cols: 4, rows: 1, separation: 0.375, first_id: 0 };
+        let (mut img, _) = render_board(&fam, &spec);
+        // Deterministic pseudo-noise, +/- 20 grey levels.
+        let mut state = 0x2545_F491_4F6C_DD1Du64;
+        for y in 0..img.height() {
+            for x in 0..img.width() {
+                state ^= state << 13;
+                state ^= state >> 7;
+                state ^= state << 17;
+                let n = (state % 41) as i32 - 20;
+                let v = (img.get(x, y) as i32 + n).clamp(0, 255) as u8;
+                img.set(x, y, v);
+            }
+        }
+        let dets = Detector::t36h11().detect(&img);
+        assert_eq!(dets.len(), 4, "noise cost us tags: {:?}", dets.len());
+    }
+
+    #[test]
+    fn a_partially_covered_tag_is_dropped_and_the_rest_survive() {
+        let fam = TagFamily::t36h11();
+        let spec = BoardSpec { cols: 4, rows: 1, separation: 0.375, first_id: 0 };
+        let (mut img, _) = render_board(&fam, &spec);
+        // Paint a grey block over the second tag.
+        let tag_px = fam.side_cells() * CELL;
+        let gap = (0.375 * tag_px as f64).round() as usize;
+        let ox = tag_px / 2 + (tag_px + gap);
+        let oy = tag_px / 2;
+        for y in 0..tag_px {
+            for x in 0..tag_px {
+                img.set(ox + x, oy + y, 96);
+            }
+        }
+        let dets = Detector::t36h11().detect(&img);
+        let ids: Vec<u32> = dets.iter().map(|d| d.id).collect();
+        assert!(!ids.contains(&1), "occluded tag must not be reported");
+        assert!(ids.contains(&0) && ids.contains(&2) && ids.contains(&3), "got {ids:?}");
+    }
+
+    #[test]
+    fn an_empty_scene_yields_no_detections() {
+        let img = GrayImage::filled(320, 240, 210);
+        assert!(Detector::t36h11().detect(&img).is_empty());
+    }
+
+    #[test]
+    fn a_tiny_image_is_handled_without_panicking() {
+        for n in [1usize, 2, 4, 7] {
+            let img = GrayImage::filled(n, n, 128);
+            assert!(Detector::t36h11().detect(&img).is_empty());
+        }
+    }
+
+    #[test]
+    fn parallel_and_serial_agree() {
+        let fam = TagFamily::t36h11();
+        let spec = BoardSpec { cols: 3, rows: 2, separation: 0.375, first_id: 0 };
+        let (img, _) = render_board(&fam, &spec);
+
+        let par = Detector::new(TagFamily::t36h11(), DetectorParams::default()).detect(&img);
+        let ser = Detector::new(
+            TagFamily::t36h11(),
+            DetectorParams { parallel: false, ..DetectorParams::default() },
+        )
+        .detect(&img);
+        assert_eq!(par, ser);
+    }
+
+    #[test]
+    fn decimated_search_still_finds_and_locates_the_tags() {
+        let fam = TagFamily::t36h11();
+        // Big tags so a factor-2 search still has enough resolution.
+        let spec = BoardSpec { cols: 4, rows: 1, separation: 0.375, first_id: 0 };
+        let (img, truth) = render_board(&fam, &spec);
+
+        let det = Detector::new(TagFamily::t36h11(), DetectorParams::realtime_hd());
+        let dets = det.detect(&img);
+        assert_eq!(dets.len(), 4, "decimated search missed tags");
+        // Accuracy must not degrade: refinement and decoding run at full res.
+        let err = corner_error(&dets, &truth);
+        assert!(err < 0.5, "decimated worst corner error {err} px");
+    }
+
+    #[test]
+    fn upscale_quad_maps_decimated_coordinates_to_block_centres() {
+        let q = Quad {
+            corners: [
+                Point2::new(0.0, 0.0),
+                Point2::new(10.0, 0.0),
+                Point2::new(10.0, 10.0),
+                Point2::new(0.0, 10.0),
+            ],
+        };
+        let up = upscale_quad(&q, 2);
+        // Low-res pixel 0 covers full-res 0..1, centred at 0.5.
+        assert!((up.corners[0].x - 0.5).abs() < 1e-12);
+        assert!((up.corners[1].x - 20.5).abs() < 1e-12);
+        assert_eq!(upscale_quad(&q, 1), q);
+    }
+}
