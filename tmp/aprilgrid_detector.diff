+"""Abstract robot-arm and camera interfaces.
+
+The tests are written against :class:`RobotArm` only, so swapping the
+simulation for real hardware means writing one subclass with two methods:
+
+.. code-block:: python
+
+    class MyArm(RobotArm):
+        def get_pose(self):
+            x, y, z, rx, ry, rz = self.sdk.read_tcp()   # metres, radians
+            return np.array([x, y, z, rx, ry, rz])
+
+        def move_pose(self, pose, speed=None):
+            self.sdk.move_linear(*pose)                 # blocks until settled
+
+    arm = MyArm(hand_eye=[0.06, 0.0, -0.03, 0.0, -0.2618, 0.0])
+
+Everything else -- camera pose, tool pose, relative motion -- is derived from
+those two by this base class.
+
+No inverse kinematics is involved: poses are Cartesian end-effector poses and
+it is the driver's job to reach them. ``move_pose`` should raise if the pose
+is unreachable rather than silently going somewhere else.
+"""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from dataclasses import dataclass
+
+import numpy as np
+
+from . import transforms as tf
+from .camera import CameraModel
+
+__all__ = ["RobotArm", "CameraSource", "UnreachablePose", "Frame", "Marker"]
+
+
+class UnreachablePose(RuntimeError):
+    """Raised by ``move_pose`` when the arm cannot or will not reach a pose.
+
+    Tests treat this as "try another viewpoint" rather than a failure, because
+    a sampled pose landing outside the workspace says nothing about the
+    detector.
+    """
+
+
+@dataclass
+class Frame:
+    """One captured image.
+
+    ``gray`` is what the detector is given -- 2-D, C-contiguous ``uint8``.
+    ``color`` is an optional BGR view for the operator, which may carry
+    overlays the detector must never see.
+    """
+
+    gray: np.ndarray
+    color: np.ndarray | None = None
+
+    @property
+    def display(self) -> np.ndarray:
+        return self.color if self.color is not None else self.gray
+
+
+@dataclass
+class Marker:
+    """A labelled point in the base frame, drawn on the operator's view."""
+
+    position_base: np.ndarray
+    color_bgr: tuple[int, int, int]
+    radius_m: float
+    label: str = ""
+
+
+class RobotArm(ABC):
+    """A Cartesian-controlled arm with a camera rigidly attached to its flange.
+
+    Poses are ``[x, y, z, rx, ry, rz]`` -- metres and radians, fixed-axis XYZ
+    (see :mod:`robotlab.core.transforms`) -- and are expressed in the robot base
+    frame unless the name says otherwise.
+    """
+
+    def __init__(self, hand_eye=None):
+        self._hand_eye = np.zeros(6)
+        if hand_eye is not None:
+            self.hand_eye = hand_eye
+
+    # -- to be implemented by a driver --------------------------------------
+
+    @abstractmethod
+    def get_pose(self) -> np.ndarray:
+        """Current end-effector pose in the base frame, ``T_base_ee``."""
+
+    @abstractmethod
+    def move_pose(self, pose, **kwargs) -> None:
+        """Move the end effector to ``pose`` and return once it has settled."""
+
+    # -- hand-eye calibration ------------------------------------------------
+
+    @property
+    def hand_eye(self) -> np.ndarray:
+        """``T_ee_cam`` as a 6-vector: the camera in the end-effector frame.
+
+        This is what ``cv2.calibrateHandEye`` returns for an eye-in-hand rig
+        (``R_cam2gripper``, ``t_cam2gripper``).
+        """
+        return self._hand_eye.copy()
+
+    @hand_eye.setter
+    def hand_eye(self, value) -> None:
+        self._hand_eye = tf.matrix_to_pose(tf.as_matrix(value))
+
+    @property
+    def hand_eye_matrix(self) -> np.ndarray:
+        return tf.pose_to_matrix(self._hand_eye)
+
+    # -- derived poses -------------------------------------------------------
+
+    def get_pose_matrix(self) -> np.ndarray:
+        return tf.pose_to_matrix(self.get_pose())
+
+    def get_camera_matrix(self) -> np.ndarray:
+        """``T_base_cam`` = ``T_base_ee @ T_ee_cam``."""
+        return self.get_pose_matrix() @ self.hand_eye_matrix
+
+    def get_camera_pose(self) -> np.ndarray:
+        return tf.matrix_to_pose(self.get_camera_matrix())
+
+    def move_camera_to(self, camera_pose, **kwargs) -> None:
+        """Move so the *camera* ends up at ``camera_pose`` in the base frame."""
+        target = tf.as_matrix(camera_pose) @ tf.invert(self.hand_eye_matrix)
+        self.move_pose(tf.matrix_to_pose(target), **kwargs)
+
+    def get_tool_matrix(self, t_ee_tool) -> np.ndarray:
+        """``T_base_tool`` for a tool mounted at ``t_ee_tool`` on the flange."""
+        return self.get_pose_matrix() @ tf.as_matrix(t_ee_tool)
+
+    def move_tool_to(self, tool_pose, t_ee_tool, **kwargs) -> None:
+        """Move so the *tool frame* lands on ``tool_pose`` in the base frame."""
+        target = tf.as_matrix(tool_pose) @ tf.invert(tf.as_matrix(t_ee_tool))
+        self.move_pose(tf.matrix_to_pose(target), **kwargs)
+
+    def move_relative_to_tool(self, offset, t_ee_tool, **kwargs) -> None:
+        """Move by ``offset`` expressed in the tool frame (a 6-vector or 4x4)."""
+        target = self.get_tool_matrix(t_ee_tool) @ tf.as_matrix(offset)
+        self.move_tool_to(tf.matrix_to_pose(target), t_ee_tool, **kwargs)
+
+    # -- lifecycle -----------------------------------------------------------
+
+    def close(self) -> None:
+        """Release any connection. Safe to call more than once."""
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+
+
+class CameraSource(ABC):
+    """Whatever produces the image the detector consumes.
+
+    Kept separate from :class:`RobotArm` so a real setup can plug in a frame
+    grabber without touching the motion driver.
+    """
+
+    @abstractmethod
+    def capture(self) -> np.ndarray:
+        """Return the current view as a 2-D, C-contiguous ``uint8`` image.
+
+        Raise on failure rather than returning ``None``: a caller that gets
+        ``None`` will either crash somewhere less obvious or, worse, quietly
+        record a missing detection as a detector miss.
+        """
+
+    def capture_color(self) -> np.ndarray | None:
+        """Optional BGR view of the same capture, for display only."""
+        return None
+
+    def intrinsics(self) -> CameraModel | None:
+        """Intrinsics the device itself reports, or ``None`` for "ask the config".
+
+        Almost every source should leave this alone: the config is
+        authoritative and a hand-written calibration usually beats the one
+        burned into the firmware. It exists for devices whose intrinsics are
+        not a constant -- a camera with a motorised lens has a different
+        focal length at every focus position, so a model fixed at startup
+        stops describing the images the moment anything refocuses.
+        """
+        return None
+
+    def close(self) -> None:
+        """Release the device. Safe to call more than once."""
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
