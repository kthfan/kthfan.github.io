+"""The printed AprilGrid: its geometry, and how to rasterise it.
+
+This is `core`, not `sim`, because the geometry is not a simulation detail.
+The bench plans viewpoints from the printed layout and turns detected tag ids
+back into object points on hardware too, where nothing is ever rendered.
+Only :meth:`Board.render` is simulator-specific, and it is cheap to carry
+along.
+
+Object frame matches the Rust crate: origin at the top-left corner of the
+top-left tag, x right, y down, z into the sheet, in metres. Corners are
+listed top-left, top-right, bottom-right, bottom-left, as printed.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import cv2
+import numpy as np
+
+__all__ = ["APRILTAG_DICT", "Board"]
+
+APRILTAG_DICT = cv2.aruco.DICT_APRILTAG_36h11
+
+
+@dataclass
+class Board:
+    """A printed grid of AprilTags. Defaults follow references/generate_aprilgrid.py."""
+
+    tags_x: int = 4
+    tags_y: int = 1
+    tag_size: float = 0.020        # metres
+    tag_separation: float = 0.0075  # metres
+    margin: float = 0.005          # white paper border, metres
+    start_id: int = 0
+    # Pixels per tag when rasterising the printed sheet. Higher means the
+    # warp samples a sharper original, at the cost of memory.
+    render_px_per_tag: int = 120
+
+    @property
+    def pitch(self) -> float:
+        return self.tag_size + self.tag_separation
+
+    @property
+    def extent(self) -> tuple[float, float]:
+        w = self.tags_x * self.tag_size + (self.tags_x - 1) * self.tag_separation
+        h = self.tags_y * self.tag_size + (self.tags_y - 1) * self.tag_separation
+        return w, h
+
+    @property
+    def tag_count(self) -> int:
+        return self.tags_x * self.tags_y
+
+    def tag_corners(self, index: int) -> np.ndarray:
+        """Object-frame corners of the tag in the given slot, printed order."""
+        row, col = divmod(index, self.tags_x)
+        x0 = col * self.pitch
+        y0 = row * self.pitch
+        s = self.tag_size
+        return np.array(
+            [[x0, y0, 0.0], [x0 + s, y0, 0.0], [x0 + s, y0 + s, 0.0], [x0, y0 + s, 0.0]],
+            np.float64,
+        )
+
+    def all_corners(self) -> np.ndarray:
+        """Every tag's corners, tag by tag, in slot order."""
+        return np.concatenate(
+            [self.tag_corners(i) for i in range(self.tag_count)], axis=0
+        )
+
+    # -- rasterising ---------------------------------------------------------
+
+    def sheet_size(self, ppm: float) -> tuple[int, int]:
+        """Size in pixels of the rasterised sheet at ``ppm`` pixels per metre."""
+        bw, bh = self.extent
+        return (
+            int(round((bw + 2 * self.margin) * ppm)),
+            int(round((bh + 2 * self.margin) * ppm)),
+        )
+
+    def render(self) -> tuple[np.ndarray, float]:
+        """Rasterise the printed sheet.
+
+        Returns the greyscale sheet and the scale in pixels per metre. The
+        sheet includes the white margin, so the board is surrounded by the
+        quiet zone the decoder needs.
+        """
+        ppm = self.render_px_per_tag / self.tag_size
+        w, h = self.sheet_size(ppm)
+        sheet = np.full((h, w), 255, np.uint8)
+
+        dictionary = cv2.aruco.getPredefinedDictionary(APRILTAG_DICT)
+        for i in range(self.tag_count):
+            marker = cv2.aruco.generateImageMarker(
+                dictionary, self.start_id + i, self.render_px_per_tag
+            )
+            corners = self.tag_corners(i)
+            x0 = int(round((corners[0][0] + self.margin) * ppm))
+            y0 = int(round((corners[0][1] + self.margin) * ppm))
+            sheet[y0:y0 + self.render_px_per_tag, x0:x0 + self.render_px_per_tag] = marker
+        return sheet, ppm
