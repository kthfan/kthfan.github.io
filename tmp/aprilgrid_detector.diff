++                let full = upscale(&q, decimate);
++                if full.min_side() >= params.quad.min_side_px {
++                    quads.push(full);
++                }
++            }
++        }
++        s.quad += ms(t);
++        s.quads += quads.len();
++
++        let t = Instant::now();
++        let refined: Vec<_> = quads
++            .iter()
++            .map(|q| refine_edges(&img, q, &params.refine).unwrap_or(*q))
++            .collect();
++        s.refine += ms(t);
++
++        let t = Instant::now();
++        for q in &refined {
++            if decode_quad(&img, q, family, &params.decode).is_some() {
++                s.detections += 1;
++            }
++        }
++        s.decode += ms(t);
++
++        s.total += ms(t_all);
++        s.frames += 1;
++    }
