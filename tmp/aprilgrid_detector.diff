+//! Tiled adaptive thresholding.
+//!
+//! The image is split into 4x4 pixel tiles; each tile records its local
+//! extrema. Extrema are then dilated over a 3x3 tile neighbourhood so a tile
+//! that happens to contain only black (or only white) still inherits a sane
+//! threshold from its surroundings. Tiles whose local contrast stays below
+//! `min_contrast` are marked [`SKIP`] and ignored by the rest of the pipeline,
+//! which is what keeps flat background regions from generating spurious edges.
+
+use crate::gray::GrayImage;
+
+/// Pixel classified as part of a dark region.
+pub const BLACK: u8 = 0;
+/// Pixel classified as part of a light region.
+pub const WHITE: u8 = 255;
+/// Pixel in a region with too little local contrast to classify.
+pub const SKIP: u8 = 127;
+
+const TILE: usize = 4;
+
+/// Produces a three-valued image containing only [`BLACK`], [`WHITE`], and
+/// [`SKIP`].
+pub fn adaptive_threshold(img: &GrayImage, min_contrast: u8) -> GrayImage {
+    let (w, h) = (img.width(), img.height());
+    let tw = w / TILE;
+    let th = h / TILE;
+    let mut out = GrayImage::filled(w, h, SKIP);
+    if tw == 0 || th == 0 {
+        return out;
+    }
+
+    // Per-tile extrema.
+    let mut tmin = vec![255u8; tw * th];
+    let mut tmax = vec![0u8; tw * th];
+    for ty in 0..th {
+        for y in ty * TILE..ty * TILE + TILE {
+            let row = img.row(y);
+            for tx in 0..tw {
+                let (mut lo, mut hi) = (tmin[ty * tw + tx], tmax[ty * tw + tx]);
+                for &v in &row[tx * TILE..tx * TILE + TILE] {
+                    lo = lo.min(v);
+                    hi = hi.max(v);
+                }
+                tmin[ty * tw + tx] = lo;
+                tmax[ty * tw + tx] = hi;
+            }
+        }
+    }
+
+    // Dilate extrema over the 3x3 tile neighbourhood.
+    let mut nmin = vec![255u8; tw * th];
+    let mut nmax = vec![0u8; tw * th];
+    for ty in 0..th {
+        let y0 = ty.saturating_sub(1);
+        let y1 = (ty + 1).min(th - 1);
+        for tx in 0..tw {
+            let x0 = tx.saturating_sub(1);
+            let x1 = (tx + 1).min(tw - 1);
+            let (mut lo, mut hi) = (255u8, 0u8);
+            for yy in y0..=y1 {
+                for xx in x0..=x1 {
+                    lo = lo.min(tmin[yy * tw + xx]);
+                    hi = hi.max(tmax[yy * tw + xx]);
+                }
+            }
+            nmin[ty * tw + tx] = lo;
+            nmax[ty * tw + tx] = hi;
+        }
+    }
+
+    // Classify row by row rather than tile by tile. Both orders touch every
+    // pixel once, but walking whole rows keeps the source and destination
+    // scans linear in memory and lets the inner loop work on slices, which
+    // drops the per-pixel bounds check that `get`/`set` would otherwise cost
+    // two million times per 1080p frame.
+    for y in 0..h {
+        // The bottom partial tile is folded into the last full tile row so no
+        // pixel is left unclassified.
+        let ty = (y / TILE).min(th - 1);
+        let (src, dst) = (img.row(y), out.row_mut(y));
+        for tx in 0..tw {
+            let lo = nmin[ty * tw + tx];
+            let hi = nmax[ty * tw + tx];
+            if hi.saturating_sub(lo) < min_contrast {
+                continue; // stays SKIP
+            }
+            let thresh = ((lo as u16 + hi as u16) / 2) as u8;
+            let xend = if tx + 1 == tw { w } else { tx * TILE + TILE };
+            for x in tx * TILE..xend {
+                dst[x] = if src[x] > thresh { WHITE } else { BLACK };
+            }
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Builds an image with a black square on a white background.
+    fn square_image(w: usize, h: usize, x0: usize, y0: usize, side: usize) -> GrayImage {
+        let mut img = GrayImage::filled(w, h, 220);
+        for y in y0..y0 + side {
+            for x in x0..x0 + side {
+                img.set(x, y, 25);
+            }
+        }
+        img
+    }
+
+    #[test]
+    fn output_only_contains_the_three_sentinel_values() {
+        let img = square_image(32, 32, 8, 8, 16);
+        let t = adaptive_threshold(&img, 20);
+        assert!(t.data().iter().all(|&v| v == BLACK || v == WHITE || v == SKIP));
+    }
+
+    #[test]
+    fn a_dark_square_becomes_black_and_its_surround_white() {
+        let img = square_image(32, 32, 8, 8, 16);
+        let t = adaptive_threshold(&img, 20);
+        // Pixels adjacent to the boundary, on either side, are what the quad
+        // detector consumes -- those must be classified.
+        assert_eq!(t.get(9, 15), BLACK);
+        assert_eq!(t.get(22, 15), BLACK);
+        assert_eq!(t.get(6, 15), WHITE);
+        assert_eq!(t.get(25, 15), WHITE);
+    }
+
+    #[test]
+    fn the_interior_of_a_large_uniform_blob_is_skipped() {
+        // Documented, intentional behaviour: a 3x3 tile neighbourhood spans 12
+        // pixels, so deep inside a 16px black square there is no local contrast
+        // and the pixels stay SKIP. Only the boundary ring is labelled, which
+        // is all the quad fitter needs.
+        let img = square_image(32, 32, 8, 8, 16);
+        let t = adaptive_threshold(&img, 20);
+        assert_eq!(t.get(15, 15), SKIP);
+    }
+
+    #[test]
+    fn flat_regions_are_skipped() {
+        let img = GrayImage::filled(32, 32, 128);
+        let t = adaptive_threshold(&img, 20);
+        assert!(t.data().iter().all(|&v| v == SKIP));
+    }
+
+    #[test]
+    fn noise_below_min_contrast_is_skipped() {
+        let mut img = GrayImage::filled(32, 32, 128);
+        for (i, px) in img.data_mut().iter_mut().enumerate() {
+            *px = 128 + (i % 5) as u8; // contrast of 4
+        }
+        let t = adaptive_threshold(&img, 20);
+        assert!(t.data().iter().all(|&v| v == SKIP));
+    }
+
+    #[test]
+    fn threshold_adapts_to_a_strong_illumination_gradient() {
+        // A dark square sitting on a background that ramps from 40 to 250. No
+        // single global threshold can segment this: the bright background
+        // (250) and the dark square on the dim side (40-120 -> clipped to 0)
+        // straddle any fixed cut.
+        let (w, h) = (64, 64);
+        let mut img = GrayImage::new(w, h);
+        for y in 0..h {
+            for x in 0..w {
+                img.set(x, y, (40 + (x * 210) / w) as u8);
+            }
+        }
+        for y in 40..56 {
+            for x in 8..24 {
+                img.set(x, y, img.get(x, y).saturating_sub(120));
+            }
+        }
+        let t = adaptive_threshold(&img, 10);
+        // Just inside the dark square, on the dim side of the ramp.
+        assert_eq!(t.get(9, 47), BLACK);
+        // Just outside it.
+        assert_eq!(t.get(5, 47), WHITE);
+        // A global threshold would have failed here: the "white" background at
+        // x=5 is darker than the "black" square would be over on the bright side.
+        assert!(img.get(5, 47) < 100);
+    }
+
+    #[test]
+    fn images_smaller_than_a_tile_are_all_skip() {
+        let img = GrayImage::filled(3, 3, 200);
+        let t = adaptive_threshold(&img, 10);
+        assert_eq!(t.width(), 3);
+        assert!(t.data().iter().all(|&v| v == SKIP));
+    }
+
+    #[test]
+    fn every_pixel_of_a_non_multiple_size_image_is_classified() {
+        // 30x30 is not a multiple of the 4px tile size, so the last row/column
+        // of tiles is ragged; a fine checkerboard guarantees every tile has
+        // contrast, so nothing may be left SKIP.
+        let (w, h) = (30, 30);
+        let mut img = GrayImage::new(w, h);
+        for y in 0..h {
+            for x in 0..w {
+                img.set(x, y, if (x / 2 + y / 2) % 2 == 0 { 30 } else { 220 });
+            }
+        }
+        let t = adaptive_threshold(&img, 20);
+        assert!(t.data().iter().all(|&v| v != SKIP), "ragged border tiles were left unclassified");
+    }
+}
