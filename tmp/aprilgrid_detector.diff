+        let fam = TagFamily::t36h11();
+        let (mut img, quad) = render_tag(&fam, 23);
+        let clean = decode_quad(&img, &quad, &fam, &DecodeParams::default()).unwrap();
+
+        // Flip one payload cell to the opposite colour.
+        let r = 2usize;
