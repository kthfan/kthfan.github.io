+//! Python bindings for the `aprilgrid` detector.
+//!
+//! Images are accepted as any object exposing a C-contiguous 2-D buffer of
+//! `uint8` ??in practice a greyscale `numpy` array. The buffer protocol is used
+//! directly rather than the `numpy` crate so the extension needs no dependency
+//! beyond `pyo3` itself.
+
+use pyo3::buffer::PyBuffer;
+use pyo3::exceptions::{PyTypeError, PyValueError};
+use pyo3::prelude::*;
+
+use aprilgrid::board::{BoardLayout as RsLayout, group_by_board};
+use aprilgrid::camera::{Camera as RsCamera, Distortion};
+use aprilgrid::detector::{Detector as RsDetector, DetectorParams};
+use aprilgrid::geometry::{Point2, Point3};
+use aprilgrid::gray::GrayImage;
+use aprilgrid::pose::{PoseParams, estimate_pose as rs_estimate_pose};
+use aprilgrid::tag_family::TagFamily;
+
+/// Turn a Python object supporting the buffer protocol into a [`GrayImage`].
+///
+/// Only 2-D, C-contiguous `uint8` buffers are accepted. Anything else is
+/// rejected with a message saying how to fix it, because silently
+/// reinterpreting a colour or non-contiguous array would yield detections that
+/// look plausible but are meaningless.
+fn image_from_buffer(obj: &Bound<'_, PyAny>) -> PyResult<GrayImage> {
+    let buf = PyBuffer::<u8>::get(obj).map_err(|_| {
+        PyTypeError::new_err(
+            "expected a uint8 array supporting the buffer protocol; \
+             convert colour images with cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)",
+        )
+    })?;
+    if buf.dimensions() != 2 {
+        return Err(PyValueError::new_err(format!(
+            "expected a 2-D (height, width) uint8 image, got {} dimension(s)",
+            buf.dimensions()
+        )));
+    }
+    if !buf.is_c_contiguous() {
+        return Err(PyValueError::new_err(
+            "image buffer must be C-contiguous; use numpy.ascontiguousarray(img)",
+        ));
+    }
+    let shape = buf.shape();
+    let (height, width) = (shape[0], shape[1]);
+    if width == 0 || height == 0 {
+        return Err(PyValueError::new_err("image must not be empty"));
+    }
+    let data = buf.to_vec(obj.py())?;
+    GrayImage::from_vec(width, height, data)
+        .ok_or_else(|| PyValueError::new_err("image buffer length does not match its shape"))
+}
+
+/// One decoded tag.
+#[pyclass(module = "aprilgrid_detector", frozen, get_all, skip_from_py_object)]
+#[derive(Clone)]
+pub struct Detection {
+    /// Tag id within the family.
+    pub id: u32,
+    /// Bit errors corrected while decoding. 0 is a clean read.
+    pub hamming: u8,
+    /// Corners in printed order: top-left, top-right, bottom-right, bottom-left.
+    pub corners: Vec<(f64, f64)>,
+    /// Separation between the black and white sample populations, in grey
+    /// levels. Higher means a more confident read.
+    pub decision_margin: f64,
+}
+
+#[pymethods]
+impl Detection {
+    /// Centre of the tag, as the mean of its four corners.
+    #[getter]
+    fn center(&self) -> (f64, f64) {
+        let n = self.corners.len() as f64;
+        let (sx, sy) = self
+            .corners
+            .iter()
+            .fold((0.0, 0.0), |(ax, ay), (x, y)| (ax + x, ay + y));
+        (sx / n, sy / n)
+    }
+
+    fn __repr__(&self) -> String {
+        let (cx, cy) = self.center();
+        format!(
+            "Detection(id={}, hamming={}, center=({:.2}, {:.2}), decision_margin={:.1})",
+            self.id, self.hamming, cx, cy, self.decision_margin
+        )
+    }
+}
+
+impl From<aprilgrid::Detection> for Detection {
+    fn from(d: aprilgrid::Detection) -> Self {
+        Self {
+            id: d.id,
+            hamming: d.hamming,
+            corners: d.corners.iter().map(|p| (p.x, p.y)).collect(),
+            decision_margin: d.decision_margin,
+        }
+    }
+}
+
+/// Physical layout of one printed AprilGrid.
+///
+/// Lengths are in metres and follow `generate_aprilgrid.py`: the object frame
+/// has its origin at the top-left corner of the top-left tag, x right, y down,
+/// and the board lying in the z = 0 plane.
+#[pyclass(module = "aprilgrid_detector", frozen, get_all, skip_from_py_object)]
+#[derive(Clone)]
+pub struct BoardLayout {
+    pub tags_x: usize,
+    pub tags_y: usize,
+    pub tag_size: f64,
+    pub tag_separation: f64,
+}
+
+#[pymethods]
+impl BoardLayout {
+    #[new]
+    #[pyo3(signature = (tags_x=4, tags_y=1, tag_size=0.020, tag_separation=0.0075))]
+    fn new(tags_x: usize, tags_y: usize, tag_size: f64, tag_separation: f64) -> PyResult<Self> {
+        RsLayout::new(tags_x, tags_y, tag_size, tag_separation)
+            .map(|_| Self { tags_x, tags_y, tag_size, tag_separation })
+            .ok_or_else(|| {
+                PyValueError::new_err(
+                    "board layout needs a positive tag count, a positive tag size \
+                     and a non-negative separation",
+                )
+            })
+    }
+
+    /// Number of tags on a single board.
+    #[getter]
+    fn tags_per_board(&self) -> usize {
+        self.tags_x * self.tags_y
+    }
+
+    /// Outer size of the board in metres, as `(width, height)`.
+    #[getter]
+    fn extent(&self) -> (f64, f64) {
+        self.inner().extent()
+    }
+
+    /// Object-frame corners of the tag with this id, in printed order.
+    fn tag_corners(&self, tag_id: u32) -> PyResult<Vec<(f64, f64, f64)>> {
+        self.inner()
+            .tag_corners(tag_id)
+            .map(|c| c.iter().map(|p| (p.x, p.y, p.z)).collect())
+            .ok_or_else(|| PyValueError::new_err("tag id is outside this layout"))
+    }
+
+    fn __repr__(&self) -> String {
+        format!(
+            "BoardLayout(tags_x={}, tags_y={}, tag_size={}, tag_separation={})",
+            self.tags_x, self.tags_y, self.tag_size, self.tag_separation
+        )
+    }
+}
+
+impl BoardLayout {
+    fn inner(&self) -> RsLayout {
+        RsLayout {
+            tags_x: self.tags_x,
+            tags_y: self.tags_y,
+            tag_size: self.tag_size,
+            tag_separation: self.tag_separation,
+        }
+    }
+}
+
+/// Pinhole camera with optional OpenCV radial-tangential distortion.
+#[pyclass(module = "aprilgrid_detector", frozen, get_all, skip_from_py_object)]
+#[derive(Clone)]
+pub struct Camera {
+    pub fx: f64,
+    pub fy: f64,
+    pub cx: f64,
+    pub cy: f64,
+    /// `(k1, k2, p1, p2, k3)` in OpenCV order, or `None` for a pure pinhole.
+    pub distortion: Option<(f64, f64, f64, f64, f64)>,
+}
+
+#[pymethods]
+impl Camera {
+    #[new]
+    #[pyo3(signature = (fx, fy, cx, cy, distortion=None))]
+    fn new(
+        fx: f64,
+        fy: f64,
+        cx: f64,
+        cy: f64,
+        distortion: Option<(f64, f64, f64, f64, f64)>,
+    ) -> PyResult<Self> {
+        RsCamera::pinhole(fx, fy, cx, cy)
+            .map(|_| Self { fx, fy, cx, cy, distortion })
+            .ok_or_else(|| PyValueError::new_err("focal lengths must be finite and non-zero"))
+    }
+
+    /// Build a camera from a 3x3 intrinsic matrix and an optional distortion
+    /// vector, matching what `cv2.calibrateCamera` returns.
+    #[staticmethod]
+    #[pyo3(signature = (matrix, distortion=None))]
+    fn from_matrix(matrix: Vec<Vec<f64>>, distortion: Option<Vec<f64>>) -> PyResult<Self> {
+        if matrix.len() != 3 || matrix.iter().any(|r| r.len() != 3) {
+            return Err(PyValueError::new_err("intrinsic matrix must be 3x3"));
+        }
+        let d = match distortion {
+            None => None,
+            Some(v) => {
+                if v.len() < 4 {
+                    return Err(PyValueError::new_err(
+                        "distortion vector needs at least 4 coefficients (k1, k2, p1, p2)",
+                    ));
+                }
+                Some((v[0], v[1], v[2], v[3], v.get(4).copied().unwrap_or(0.0)))
+            }
+        };
+        Self::new(matrix[0][0], matrix[1][1], matrix[0][2], matrix[1][2], d)
+    }
+
+    /// Project a point already expressed in camera coordinates.
+    fn project(&self, x: f64, y: f64, z: f64) -> PyResult<(f64, f64)> {
+        self.inner()
+            .project_point(Point3::new(x, y, z))
+            .map(|p| (p.x, p.y))
+            .ok_or_else(|| PyValueError::new_err("point is at or behind the camera"))
+    }
+
+    fn __repr__(&self) -> String {
+        format!(
+            "Camera(fx={:.3}, fy={:.3}, cx={:.3}, cy={:.3}, distortion={})",
+            self.fx,
+            self.fy,
+            self.cx,
+            self.cy,
+            if self.distortion.is_some() { "radtan" } else { "none" }
+        )
+    }
+}
+
+impl Camera {
+    fn inner(&self) -> RsCamera {
+        let distortion = match self.distortion {
+            Some((k1, k2, p1, p2, k3)) => Distortion::RadTan { k1, k2, p1, p2, k3 },
+            None => Distortion::None,
+        };
+        RsCamera { fx: self.fx, fy: self.fy, cx: self.cx, cy: self.cy, distortion }
+    }
+}
+
+/// A 6-DoF pose plus the reprojection error it achieves.
+#[pyclass(module = "aprilgrid_detector", frozen, get_all, skip_from_py_object)]
+#[derive(Clone)]
+pub struct PoseEstimate {
+    /// Row-major 3x3 rotation matrix, object frame to camera frame.
+    pub rotation: Vec<Vec<f64>>,
+    /// Translation in metres, object frame to camera frame.
+    pub translation: (f64, f64, f64),
+    /// Rotation as an axis-angle vector, matching `cv2.Rodrigues`.
+    pub rvec: (f64, f64, f64),
+    /// Root-mean-square reprojection error in pixels.
+    pub reprojection_rmse: f64,
+    /// Worst single-corner reprojection error in pixels.
+    pub reprojection_max: f64,
+    /// Number of correspondences the pose was fitted to.
+    pub point_count: usize,
+}
+
+#[pymethods]
+impl PoseEstimate {
+    /// Distance from the camera to the object-frame origin, in metres.
+    #[getter]
+    fn distance(&self) -> f64 {
+        let (x, y, z) = self.translation;
+        (x * x + y * y + z * z).sqrt()
+    }
+
+    fn __repr__(&self) -> String {
+        let (x, y, z) = self.translation;
+        format!(
+            "PoseEstimate(t=({:.4}, {:.4}, {:.4}), rmse={:.3}px, max={:.3}px, n={})",
+            x, y, z, self.reprojection_rmse, self.reprojection_max, self.point_count
+        )
+    }
+}
+
+impl From<aprilgrid::PoseEstimate> for PoseEstimate {
+    fn from(e: aprilgrid::PoseEstimate) -> Self {
+        let r = e.pose.rotation;
+        let t = e.pose.translation;
+        let rv = e.pose.rotation_vector();
+        Self {
+            rotation: (0..3).map(|i| (0..3).map(|j| r[(i, j)]).collect()).collect(),
+            translation: (t[0], t[1], t[2]),
+            rvec: (rv[0], rv[1], rv[2]),
+            reprojection_rmse: e.reprojection_rmse,
+            reprojection_max: e.reprojection_max,
+            point_count: e.point_count,
+        }
+    }
+}
+
+/// All tags belonging to one physical board, with a pose if intrinsics were
+/// supplied.
+#[pyclass(module = "aprilgrid_detector", frozen, get_all, skip_from_py_object)]
+#[derive(Clone)]
+pub struct BoardDetection {
+    pub board_id: u32,
+    pub detections: Vec<Detection>,
+    /// Object-frame corner coordinates, 4 per detection, in metres.
+    pub object_points: Vec<(f64, f64, f64)>,
+    /// Matching image-frame corner coordinates, in pixels.
+    pub image_points: Vec<(f64, f64)>,
+    /// Fraction of the board's tags that were found, in `[0, 1]`.
+    pub coverage: f64,
+    pub pose: Option<PoseEstimate>,
+}
+
+#[pymethods]
+impl BoardDetection {
+    fn __repr__(&self) -> String {
+        format!(
+            "BoardDetection(board_id={}, tags={}, coverage={:.2}, pose={})",
+            self.board_id,
+            self.detections.len(),
+            self.coverage,
+            if self.pose.is_some() { "yes" } else { "no" }
+        )
+    }
+}
+
+/// AprilGrid detector.
+#[pyclass(module = "aprilgrid_detector")]
+pub struct Detector {
+    inner: RsDetector,
+}
+
+#[pymethods]
+impl Detector {
+    /// `decimate` only lowers the resolution used to *find* candidates;
+    /// corners and payload are always measured at full resolution.
+    #[new]
+    #[pyo3(signature = (
+        decimate=1,
+        min_contrast=12,
+        min_cluster_size=24,
+        refine_edges=true,
+        parallel=true,
+        min_side_px=None,
+        min_decision_margin=None,
+    ))]
+    fn new(
+        decimate: usize,
+        min_contrast: u8,
+        min_cluster_size: usize,
+        refine_edges: bool,
+        parallel: bool,
+        min_side_px: Option<f64>,
+        min_decision_margin: Option<f64>,
+    ) -> PyResult<Self> {
+        if decimate == 0 {
+            return Err(PyValueError::new_err("decimate must be at least 1"));
+        }
+        let mut p = DetectorParams {
+            decimate,
+            min_contrast,
+            min_cluster_size,
+            refine_edges,
+            parallel,
+            ..DetectorParams::default()
+        };
+        if let Some(v) = min_side_px {
+            p.quad.min_side_px = v;
+        }
+        if let Some(v) = min_decision_margin {
+            p.decode.min_decision_margin = v;
+        }
+        Ok(Self { inner: RsDetector::new(TagFamily::t36h11(), p) })
+    }
+
+    /// Preset tuned for 1080p video where tags are comfortably larger than
+    /// about 40 px.
+    #[staticmethod]
+    fn realtime_hd() -> Self {
+        Self { inner: RsDetector::new(TagFamily::t36h11(), DetectorParams::realtime_hd()) }
+    }
+
+    /// Detect every tag in a greyscale image.
+    fn detect(&self, py: Python<'_>, image: &Bound<'_, PyAny>) -> PyResult<Vec<Detection>> {
+        let img = image_from_buffer(image)?;
+        // Detection is pure compute on owned data, so the GIL can be released.
+        let dets = py.detach(|| self.inner.detect(&img));
+        Ok(dets.into_iter().map(Detection::from).collect())
+    }
+
+    /// Detect tags and group them by the board they belong to.
+    ///
+    /// When `camera` is given, each board also carries a 6-DoF pose.
+    #[pyo3(signature = (image, layout, camera=None))]
+    fn detect_boards(
+        &self,
+        py: Python<'_>,
+        image: &Bound<'_, PyAny>,
+        layout: &BoardLayout,
+        camera: Option<&Camera>,
+    ) -> PyResult<Vec<BoardDetection>> {
+        let img = image_from_buffer(image)?;
+        let rs_layout = layout.inner();
+        let rs_camera = camera.map(|c| c.inner());
+        let params = PoseParams::default();
+
+        let boards = py.detach(|| {
+            let dets = self.inner.detect(&img);
+            let observations = group_by_board(&dets, &rs_layout);
+            observations
+                .into_iter()
+                .map(|obs| {
+                    let pose = rs_camera.as_ref().and_then(|cam| {
+                        rs_estimate_pose(&obs.object_points, &obs.image_points, cam, &params)
+                    });
+                    let coverage = obs.coverage(&rs_layout);
+                    (obs, coverage, pose)
+                })
+                .collect::<Vec<_>>()
+        });
+
+        Ok(boards
+            .into_iter()
+            .map(|(obs, coverage, pose)| BoardDetection {
+                board_id: obs.board_id,
+                coverage,
+                detections: obs.detections.iter().map(|d| Detection::from(*d)).collect(),
+                object_points: obs.object_points.iter().map(|p| (p.x, p.y, p.z)).collect(),
+                image_points: obs.image_points.iter().map(|p| (p.x, p.y)).collect(),
+                pose: pose.map(PoseEstimate::from),
+            })
+            .collect())
+    }
+}
+
+/// Fit a pose to explicit 3-D/2-D correspondences.
+///
+/// `object_points` are `(x, y, z)` in metres and must be coplanar;
+/// `image_points` are `(x, y)` in pixels. At least four pairs are required.
+#[pyfunction]
+fn estimate_pose(
+    object_points: Vec<(f64, f64, f64)>,
+    image_points: Vec<(f64, f64)>,
+    camera: &Camera,
+) -> PyResult<PoseEstimate> {
+    if object_points.len() != image_points.len() {
+        return Err(PyValueError::new_err(format!(
+            "got {} object points but {} image points",
+            object_points.len(),
+            image_points.len()
+        )));
+    }
+    if object_points.len() < 4 {
+        return Err(PyValueError::new_err("at least 4 correspondences are required"));
+    }
+    let obj: Vec<Point3> = object_points.iter().map(|&(x, y, z)| Point3::new(x, y, z)).collect();
+    let img: Vec<Point2> = image_points.iter().map(|&(x, y)| Point2::new(x, y)).collect();
+    rs_estimate_pose(&obj, &img, &camera.inner(), &PoseParams::default())
+        .map(PoseEstimate::from)
+        .ok_or_else(|| {
+            PyValueError::new_err(
+                "pose could not be fitted; the points may be collinear or degenerate",
+            )
+        })
+}
+
+/// Version of the underlying Rust detector.
+#[pyfunction]
+fn version() -> &'static str {
+    env!("CARGO_PKG_VERSION")
+}
+
+#[pymodule]
+fn aprilgrid_detector(m: &Bound<'_, PyModule>) -> PyResult<()> {
+    m.add_class::<Detector>()?;
+    m.add_class::<Detection>()?;
+    m.add_class::<BoardLayout>()?;
+    m.add_class::<BoardDetection>()?;
+    m.add_class::<Camera>()?;
+    m.add_class::<PoseEstimate>()?;
+    m.add_function(wrap_pyfunction!(estimate_pose, m)?)?;
+    m.add_function(wrap_pyfunction!(version, m)?)?;
+    m.add("__version__", env!("CARGO_PKG_VERSION"))?;
+    Ok(())
+}
