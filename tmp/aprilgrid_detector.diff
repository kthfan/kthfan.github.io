++//! Boundary extraction: connected components over the thresholded image, then
++//! grouping of the black/white transitions into per-region boundary clusters.
++//!
++//! This is the step that turns a binary image into candidate tag outlines. A
++//! cluster is keyed by the *pair* of regions it separates, which is what keeps
++//! the outline of one tag from merging with a neighbouring tag that happens to
++//! touch it.
++
++use crate::threshold::{BLACK, SKIP, WHITE};
++use crate::gray::GrayImage;
++use crate::unionfind::UnionFind;
++
++/// A point on the boundary between two regions, in half-pixel units.
++///
++/// Storing doubled integer coordinates keeps the midpoint of two adjacent
++/// pixels exact and keeps the struct small, which matters because a 1080p
++/// frame can produce hundreds of thousands of these.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct BoundaryPoint {
++    /// x coordinate in half-pixels (i.e. `2 * pixel_x`).
++    pub x2: u16,
++    /// y coordinate in half-pixels.
++    pub y2: u16,
++}
++
++impl BoundaryPoint {
++    /// Position in pixel coordinates.
++    #[inline]
++    pub fn to_pixel(self) -> (f64, f64) {
++        (self.x2 as f64 * 0.5, self.y2 as f64 * 0.5)
++    }
++}
++
++/// Labels 4-connected runs of equal value, ignoring [`SKIP`] pixels.
++///
++/// Returns a union-find whose representative acts as the region id for each
++/// pixel index.
++pub fn label_regions(bin: &GrayImage) -> UnionFind {
++    let (w, h) = (bin.width(), bin.height());
++    let mut uf = UnionFind::new(w * h);
++    for y in 0..h {
++        // Row slices rather than `get`: this loop runs once per pixel of a
++        // 1080p frame, so the per-access bounds check is not free.
++        let row = bin.row(y);
++        let below = if y + 1 < h { Some(bin.row(y + 1)) } else { None };
++        for x in 0..w {
++            let v = row[x];
++            if v == SKIP {
++                continue;
++            }
++            let idx = (y * w + x) as u32;
++            if x + 1 < w && row[x + 1] == v {
++                uf.union(idx, idx + 1);
++            }
++            if let Some(b) = below {
++                if b[x] == v {
++                    uf.union(idx, idx + w as u32);
++                }
++            }
++        }
++    }
++    uf
++}
++
++/// Groups black/white transitions into clusters, one per pair of touching
++/// regions.
++///
++/// `min_cluster_size` drops clusters too small to ever be a tag outline.
++///
++/// Transitions are accumulated into one flat `(key, point)` buffer and sorted,
++/// rather than into a map of per-cluster vectors. A noisy frame produces tens
++/// of thousands of one- or two-point clusters, and giving each its own
++/// allocation dominates the runtime; here only the clusters that survive
++/// `min_cluster_size` are ever allocated.
++///
++/// Transitions are also pre-filtered by region area. A 4-connected region of
++/// area `a` has a boundary of at most `2a + 2` points, so a region with
++/// `a < (min_cluster_size - 2) / 2` cannot possibly contribute a large enough
++/// cluster. Sensor noise is overwhelmingly single-pixel specks, so this test
++/// discards the bulk of the work before anything is stored or sorted, without
++/// changing the result.
++pub fn boundary_clusters(
++    bin: &GrayImage,
++    min_cluster_size: usize,
++) -> Vec<Vec<BoundaryPoint>> {
++    let (w, h) = (bin.width(), bin.height());
++    let mut uf = label_regions(bin);
++    let mut entries: Vec<(u64, BoundaryPoint)> = Vec::new();
++
++    let min_area = if min_cluster_size >= 2 {
++        ((min_cluster_size - 2) / 2) as u32
++    } else {
++        0
++    };
++
++    // Only the right and down neighbours are visited so each transition is
++    // recorded exactly once.
++    for y in 0..h {
++        let row = bin.row(y);
++        let below = if y + 1 < h { Some(bin.row(y + 1)) } else { None };
++        for x in 0..w {
++            let v0 = row[x];
++            if v0 == SKIP {
++                continue;
++            }
++            // Fast path. Almost every pixel lies in the interior of a region
++            // and borders nothing, so settle that with three slice loads
++            // before touching the union-find at all - resolving a root per
++            // pixel is what made this the hottest stage in the pipeline.
++            // Substituting `v0` for an off-image neighbour makes the border
++            // pixels take this path too, since a pixel never differs from
++            // itself.
++            let vr = if x + 1 < w { row[x + 1] } else { v0 };
++            let vd = match below {
++                Some(b) => b[x],
++                None => v0,
++            };
++            if vr == v0 && vd == v0 {
++                continue;
++            }
++
++            let r0 = uf.find((y * w + x) as u32);
++            if uf.set_size(r0) < min_area {
++                continue;
++            }
++            // Order the key by colour, not by scan order, so the same tag edge
++            // always hashes to the same bucket regardless of traversal
++            // direction.
++            let black0 = v0 == BLACK;
++            let mut emit = |r1: u32, x2: usize, y2: usize| {
++                let key = if black0 {
++                    (r0 as u64) << 32 | r1 as u64
++                } else {
++                    (r1 as u64) << 32 | r0 as u64
++                };
++                entries.push((key, BoundaryPoint { x2: x2 as u16, y2: y2 as u16 }));
++            };
++
++            if vr != v0 && vr != SKIP {
++                let r1 = uf.find((y * w + x + 1) as u32);
++                if uf.set_size(r1) >= min_area {
++                    emit(r1, 2 * x + 1, 2 * y);
++                }
++            }
++            if vd != v0 && vd != SKIP {
++                let r1 = uf.find(((y + 1) * w + x) as u32);
++                if uf.set_size(r1) >= min_area {
++                    emit(r1, 2 * x, 2 * y + 1);
++                }
++            }
++        }
++    }
++
++    // Sorting on the point as well as the key keeps each cluster in scan
++    // order, which downstream quad fitting and the tie-break below rely on.
++    entries.sort_unstable_by_key(|(key, p)| (*key, p.y2, p.x2));
++
++    let mut out: Vec<Vec<BoundaryPoint>> = Vec::new();
++    let mut i = 0;
++    while i < entries.len() {
++        let key = entries[i].0;
++        let mut j = i + 1;
++        while j < entries.len() && entries[j].0 == key {
++            j += 1;
++        }
++        if j - i >= min_cluster_size {
++            out.push(entries[i..j].iter().map(|(_, p)| *p).collect());
++        }
++        i = j;
++    }
++    // Deterministic order, largest first: the detector must not depend on the
++    // region-label numbering that produced the keys.
++    out.sort_unstable_by(|a, b| {
++        b.len().cmp(&a.len()).then_with(|| (a[0].y2, a[0].x2).cmp(&(b[0].y2, b[0].x2)))
++    });
++    out
++}
++
++/// Convenience: true when the value is a classified (non-skipped) pixel.
++#[inline]
++pub const fn is_classified(v: u8) -> bool {
++    v == BLACK || v == WHITE
++}
