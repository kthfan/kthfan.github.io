+# fetch-remote-file.ps1 - copy a file FROM the remote host into the workspace.
+#
+# The .crosshost wrappers only push (sync.ps1) and run (execute.ps1); there is
+# no pull. Generated sources, evaluation reports, and rendered debug images all
+# need to come back the other way, so this rides on top of execute.ps1 rather
+# than inventing a second ssh path: the remote file is base64-encoded between
+# sentinel markers, and decoded locally. That keeps binary content intact
+# through the PowerShell/ssh pipeline and keeps every remote action inside the
+# audited wrapper contract.
+#
+# Usage: .\scripts\fetch-remote-file.ps1 -RemotePath crates/x.rs -LocalPath crates/x.rs
+#   RemotePath is relative to the remote workdir (or absolute).
+
+param(
+    [Parameter(Mandatory = $true)][string]$RemotePath,
+    [Parameter(Mandatory = $true)][string]$LocalPath,
+    [int]$TimeoutSeconds = 120
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+$root = Split-Path -Parent $PSScriptRoot
+$cfg = Get-Content (Join-Path $root '.crosshost\config.json') -Raw | ConvertFrom-Json
+$workdir = $cfg.remoteWorkdir
+
+$begin = '===CROSSHOST_B64_BEGIN==='
+$end = '===CROSSHOST_B64_END==='
+
+$cmdDir = Join-Path $root '.crosshost\commands'
+New-Item -ItemType Directory -Force -Path $cmdDir | Out-Null
+$stamp = (Get-Date).ToUniversalTime().ToString('yyyyMMddTHHmmss')
+$cmdFile = Join-Path $cmdDir "cmd_${stamp}_fetch.sh"
+
+$script = @(
+    "cd '$workdir'",
+    "if [ ! -f '$RemotePath' ]; then echo 'MISSING: $RemotePath'; exit 1; fi",
+    "echo $begin",
+    "base64 -w 0 '$RemotePath'",
+    "echo",
+    "echo $end"
+) -join [Environment]::NewLine
+Set-Content -LiteralPath $cmdFile -Value $script -Encoding ASCII
+
+# execute.ps1 relays remote stdout through Write-Host, which lands on the
+# *information* stream (6), not stdout -- a plain `2>&1` capture comes back
+# empty. Redirect stream 6 as well or the payload is invisible here.
+$out = & (Join-Path $root '.crosshost\execute.ps1') -File $cmdFile -TimeoutSeconds $TimeoutSeconds 6>&1 2>&1 |
+    Out-String
+
+$startIdx = $out.IndexOf($begin)
+$endIdx = $out.IndexOf($end)
+if ($startIdx -lt 0 -or $endIdx -lt 0) {
+    Write-Host "fetch failed; remote output was:" -ForegroundColor Red
+    Write-Host $out
+    exit 1
+}
+$payload = $out.Substring($startIdx + $begin.Length, $endIdx - $startIdx - $begin.Length)
+# Strip every kind of whitespace the terminal pipeline may have injected.
+$payload = ($payload -replace '\s', '')
+if ([string]::IsNullOrWhiteSpace($payload)) {
+    Write-Host "fetch produced an empty payload for $RemotePath" -ForegroundColor Red
+    exit 1
+}
+
+$fullLocal = if ([IO.Path]::IsPathRooted($LocalPath)) { $LocalPath } else { Join-Path $root $LocalPath }
+$parent = Split-Path -Parent $fullLocal
+if ($parent) { New-Item -ItemType Directory -Force -Path $parent | Out-Null }
+[IO.File]::WriteAllBytes($fullLocal, [Convert]::FromBase64String($payload))
+
+$size = (Get-Item $fullLocal).Length
+Write-Host "Fetched $RemotePath -> $LocalPath ($size bytes)" -ForegroundColor Green
