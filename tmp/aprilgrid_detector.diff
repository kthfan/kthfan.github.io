@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Generate the Rust tag-family table from OpenCV's APRILTAG_36h11 dictionary.
+
+The boards this detector targets are produced by ``generate_aprilgrid.py``,
+which draws markers with ``cv2.aruco``.  Hard-coding a table copied from the
+upstream AprilTag project risks a silent mismatch in either the *id ordering*
+or the *bit ordering* between the two projects, which would surface much later
+as "detects a tag, reports the wrong id".
+
+The table is therefore read back from ``generateImageMarker`` -- the very call
+that rasterises the boards -- rather than from the packed ``bytesList``.  What
+the detector matches against is then, by construction, exactly what the printer
+puts on paper.
+
+Bit convention (must match ``tag_family.rs``):
+    index i = row * 6 + col, counted from the top-left, row-major
+    code bit (35 - i);  1 = white cell, 0 = black cell
+
+Run on the remote host (it needs cv2):
+    python3 tools/gen_tag_family.py > crates/aprilgrid/src/tag_family_data.rs
+"""
+
+import sys
+
+import cv2
+import numpy as np
+
+FAMILY = "DICT_APRILTAG_36h11"
+EDGE = 6  # data cells per side
+BORDER = 1  # black border cells drawn around the data
+SIDE = EDGE + 2 * BORDER
+CELL_PX = 10
+EXPECTED_COUNT = 587
+EXPECTED_MIN_HAMMING = 11
+
+
+def render_cells(dictionary, marker_id: int) -> np.ndarray:
+    """Rasterise a marker and read it back as a SIDE x SIDE grid of 0/1 cells."""
+    px = SIDE * CELL_PX
+    img = dictionary.generateImageMarker(marker_id, px)
+    blocks = img.reshape(SIDE, CELL_PX, SIDE, CELL_PX).mean(axis=(1, 3))
+    return (blocks > 127).astype(np.uint8)
+
+
+def bits_to_code(bits: np.ndarray) -> int:
+    code = 0
+    for r in range(EDGE):
+        for c in range(EDGE):
+            if bits[r, c]:
+                code |= 1 << (EDGE * EDGE - 1 - (r * EDGE + c))
+    return code
+
+
+def rotate_cw(a: np.ndarray) -> np.ndarray:
+    return np.rot90(a, k=-1)
+
+
+def main() -> int:
+    dictionary = cv2.aruco.getPredefinedDictionary(getattr(cv2.aruco, FAMILY))
+    n = dictionary.bytesList.shape[0]
+    if n != EXPECTED_COUNT:
+        print(f"expected {EXPECTED_COUNT} markers, dictionary has {n}", file=sys.stderr)
+        return 1
+    if dictionary.markerSize != EDGE:
+        print(f"expected markerSize {EDGE}, got {dictionary.markerSize}", file=sys.stderr)
+        return 1
+
+    codes = []
+    rotations = []
+    for i in range(n):
+        grid = render_cells(dictionary, i)
+        # The drawn border must be black all the way round; if that ever stops
+        # holding, the sampling geometry in the decoder would be wrong too.
+        if grid[0].any() or grid[-1].any() or grid[:, 0].any() or grid[:, -1].any():
+            print(f"marker {i} does not have a solid black border", file=sys.stderr)
+            return 1
+        data = grid[BORDER:-BORDER, BORDER:-BORDER]
+        rots = []
+        b = data
+        for _ in range(4):
+            rots.append(bits_to_code(b))
+            b = rotate_cw(b)
+        codes.append(rots[0])
+        rotations.append(rots)
+
+    # --- self-validation -------------------------------------------------
+    if len(set(codes)) != n:
+        print("duplicate codes -- bit packing is wrong", file=sys.stderr)
+        return 1
+
+    # A 36h11 family keeps a minimum Hamming distance of 11 between any two
+    # distinct tags *under every rotation*. If the packing or the rotation
+    # convention were wrong, this would collapse -- so it doubles as a check
+    # that the readback above is faithful.
+    min_d = 64
+    for i in range(n):
+        ci = codes[i]
+        for j in range(i + 1, n):
+            for r in range(4):
+                d = bin(ci ^ rotations[j][r]).count("1")
+                if d < min_d:
+                    min_d = d
+    if min_d < EXPECTED_MIN_HAMMING:
+        print(f"min hamming distance {min_d} < {EXPECTED_MIN_HAMMING}", file=sys.stderr)
+        return 1
+
+    # A tag must also stay far from its *own* rotations, otherwise orientation
+    # could not be recovered reliably.
+    self_min = min(
+        bin(codes[i] ^ rotations[i][r]).count("1") for i in range(n) for r in (1, 2, 3)
+    )
+    if self_min < EXPECTED_MIN_HAMMING:
+        print(f"min self-rotation distance {self_min} < {EXPECTED_MIN_HAMMING}", file=sys.stderr)
+        return 1
+
+    print(
+        f"// validated {n} codes: min inter-tag distance {min_d}, "
+        f"min self-rotation distance {self_min}",
+        file=sys.stderr,
+    )
+
+    # --- emit ------------------------------------------------------------
+    out = sys.stdout
+    out.write("//! AprilTag 36h11 code table.\n//!\n")
+    out.write(f"//! GENERATED by `tools/gen_tag_family.py` from OpenCV `{FAMILY}`.\n")
+    out.write("//! Do not edit by hand; re-run the generator instead.\n//!\n")
+    out.write("//! Bit `35 - (row * 6 + col)` of each code is the cell at (row, col),\n")
+    out.write("//! counted from the top-left of the tag in its canonical orientation.\n")
+    out.write("//! A set bit is a *white* cell.\n//!\n")
+    out.write(f"//! Verified minimum inter-tag Hamming distance (all rotations): {min_d}.\n")
+    out.write(f"//! Verified minimum distance to a tag's own rotations: {self_min}.\n\n")
+
+    out.write("/// Number of data cells along one edge of a 36h11 tag.\n")
+    out.write(f"pub const EDGE_CELLS: usize = {EDGE};\n\n")
+    out.write("/// Black border cells drawn around the data area by `cv2.aruco`.\n")
+    out.write(f"pub const BORDER_CELLS: usize = {BORDER};\n\n")
+    out.write("/// Canonical-orientation codes, indexed by tag id.\n")
+    out.write(f"pub const T36H11: [u64; {n}] = [\n")
+    for i in range(0, n, 4):
+        chunk = ", ".join(f"0x{c:09x}" for c in codes[i : i + 4])
+        out.write(f"    {chunk},\n")
+    out.write("];\n\n")
+
+    sample_ids = [0, 1, 2, 7, 42, 100, 300, n - 1]
+    out.write("/// `[tag_id, rot0, rot90cw, rot180, rot270cw]` fixtures that pin the\n")
+    out.write("/// decoder's rotation convention to the rasterised markers.\n")
+    out.write(f"pub const ROTATION_FIXTURES: [[u64; 5]; {len(sample_ids)}] = [\n")
+    for i in sample_ids:
+        r = rotations[i]
+        out.write(f"    [{i}, 0x{r[0]:09x}, 0x{r[1]:09x}, 0x{r[2]:09x}, 0x{r[3]:09x}],\n")
+    out.write("];\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
