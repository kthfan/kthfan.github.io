@@ -0,0 +1,369 @@
+"""Turning a board pose into pixels, and then ruining them realistically.
+
+Two jobs live here, both shared by the two things that render: the standalone
+dataset generator (``tools/simulate.py``) and the robot bench's
+:class:`~robotlab.sim.scene.Scene`.
+
+* *geometry* -- project object points through the lens model, build the
+  homography that lays a rasterised sheet onto the image, and build the remap
+  that bends an ideal pinhole render into a distorted one.
+* *degradation* -- the sensor/optics stack (blur, motion, noise, exposure,
+  vignette, illumination ramp, contrast loss, occlusion, JPEG), plus the
+  ranges it samples from.
+
+Everything takes a :class:`~robotlab.core.camera.CameraModel`; there is no
+second camera type.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import cv2
+import numpy as np
+
+from ..core.board import Board
+from ..core.camera import CameraModel
+
+__all__ = [
+    "Degradations",
+    "Shadow",
+    "add_occlusion",
+    "cast_shadow",
+    "degrade",
+    "disc_touches_quad",
+    "distortion_maps",
+    "project",
+    "sheet_homography",
+    "visible",
+]
+
+
+# ---------------------------------------------------------------------------
+# Geometry
+# ---------------------------------------------------------------------------
+
+
+def project(points: np.ndarray, rvec, tvec, cam: CameraModel) -> np.ndarray:
+    """Project object points to pixels, including lens distortion."""
+    out, _ = cv2.projectPoints(
+        np.asarray(points, np.float64).reshape(-1, 1, 3),
+        np.asarray(rvec, np.float64), np.asarray(tvec, np.float64),
+        cam.matrix, cam.dist_array,
+    )
+    return out.reshape(-1, 2)
+
+
+def visible(pts: np.ndarray, cam: CameraModel, slack: float = 2.0) -> bool:
+    """True when every pixel lies inside the frame, give or take ``slack``."""
+    return bool(
+        np.all(pts[:, 0] > -slack)
+        and np.all(pts[:, 0] < cam.width + slack)
+        and np.all(pts[:, 1] > -slack)
+        and np.all(pts[:, 1] < cam.height + slack)
+    )
+
+
+def sheet_homography(board: Board, ppm: float, rvec, tvec, cam: CameraModel):
+    """Homography mapping the rasterised sheet onto the *undistorted* image."""
+    bw, bh = board.extent
+    m = board.margin
+    # Sheet corners in object coordinates (the margin extends beyond the tags).
+    obj = np.array(
+        [[-m, -m, 0.0], [bw + m, -m, 0.0], [bw + m, bh + m, 0.0], [-m, bh + m, 0.0]],
+        np.float64,
+    )
+    # Project with zero distortion; distortion is applied afterwards as a
+    # remap so that straight printed edges bend exactly like real optics.
+    dst = project(obj, rvec, tvec, cam.pinhole())
+    # Pixel centres sit at integer coordinates, so the sheet raster spans
+    # [-0.5, W-0.5]. Using [0, W-1] here would shrink the board by half a
+    # sheet pixel and bias every ground-truth corner.
+    w, h = board.sheet_size(ppm)
+    src = np.array(
+        [[-0.5, -0.5], [w - 0.5, -0.5], [w - 0.5, h - 0.5], [-0.5, h - 0.5]],
+        np.float64,
+    )
+    return cv2.getPerspectiveTransform(src.astype(np.float32), dst.astype(np.float32))
+
+
+# `undistortPoints` over a full-resolution grid takes a noticeable moment, and
+# the maps depend only on the intrinsics, so build them once per camera.
+_DIST_MAPS: dict[tuple, tuple[np.ndarray, np.ndarray]] = {}
+
+
+def distortion_maps(cam: CameraModel) -> tuple[np.ndarray, np.ndarray]:
+    """Maps that bend an ideal pinhole render into a distorted one.
+
+    `cv2.remap` pulls: output(u) = source(map(u)). The output is the
+    *distorted* image and the source is the pinhole render, so for each output
+    pixel we need the pinhole pixel carrying the same ray -- that is, the
+    output pixel *undistorted*. Getting this backwards silently distorts the
+    image twice while the projected ground truth is distorted once, which
+    shows up as a few pixels of corner error that grows toward the edges.
+
+    Results are cached per distinct camera.
+    """
+    key = (cam.width, cam.height, cam.fx, cam.fy, cam.cx, cam.cy, tuple(cam.dist))
+    cached = _DIST_MAPS.get(key)
+    if cached is not None:
+        return cached
+
+    ys, xs = np.mgrid[0:cam.height, 0:cam.width].astype(np.float32)
+    if not np.any(cam.dist_array):
+        maps = (xs, ys)
+    else:
+        pts = np.stack([xs.ravel(), ys.ravel()], axis=1).reshape(-1, 1, 2)
+        # Distorted pixel -> normalised undistorted ray.
+        rays = cv2.undistortPoints(pts, cam.matrix, cam.dist_array).reshape(-1, 2)
+        map_x = (rays[:, 0] * cam.fx + cam.cx).reshape(cam.height, cam.width)
+        map_y = (rays[:, 1] * cam.fy + cam.cy).reshape(cam.height, cam.width)
+        maps = (map_x.astype(np.float32), map_y.astype(np.float32))
+
+    _DIST_MAPS[key] = maps
+    return maps
+
+
+# ---------------------------------------------------------------------------
+# Degradations
+# ---------------------------------------------------------------------------
+
+
+@dataclass
+class Degradations:
+    """Per-frame degradation ranges. Each is sampled uniformly."""
+
+    # Gaussian defocus, sigma in pixels.
+    blur_sigma: tuple[float, float] = (0.0, 1.4)
+    # Linear motion blur length in pixels, and its angle in degrees.
+    motion_px: tuple[float, float] = (0.0, 7.0)
+    # Additive sensor noise, sigma in grey levels.
+    noise_sigma: tuple[float, float] = (1.0, 7.0)
+    # Global exposure gain; >1 brightens and can clip highlights.
+    exposure: tuple[float, float] = (0.75, 1.30)
+    # Strength of the cos^4-style vignette, 0 disables.
+    vignette: tuple[float, float] = (0.0, 0.45)
+    # Amplitude of a linear illumination ramp across the frame, grey levels.
+    illumination_ramp: tuple[float, float] = (0.0, 55.0)
+    # Contrast compression toward mid grey; 0 keeps full contrast.
+    contrast_loss: tuple[float, float] = (0.0, 0.30)
+    # Probability that a frame has an occluding blob, and its radius range
+    # as a fraction of the board's on-screen width.
+    occlusion_prob: float = 0.25
+    occlusion_radius: tuple[float, float] = (0.05, 0.22)
+    # JPEG quality; None disables recompression artefacts.
+    jpeg_quality: tuple[int, int] | None = (70, 96)
+
+    @staticmethod
+    def easy() -> "Degradations":
+        return Degradations(
+            blur_sigma=(0.0, 0.5),
+            motion_px=(0.0, 1.0),
+            noise_sigma=(0.0, 2.0),
+            exposure=(0.95, 1.05),
+            vignette=(0.0, 0.1),
+            illumination_ramp=(0.0, 10.0),
+            contrast_loss=(0.0, 0.05),
+            occlusion_prob=0.0,
+            jpeg_quality=None,
+        )
+
+    @staticmethod
+    def hard() -> "Degradations":
+        return Degradations(
+            blur_sigma=(0.5, 2.6),
+            motion_px=(0.0, 16.0),
+            noise_sigma=(4.0, 14.0),
+            exposure=(0.55, 1.55),
+            vignette=(0.2, 0.7),
+            illumination_ramp=(20.0, 95.0),
+            contrast_loss=(0.1, 0.5),
+            occlusion_prob=0.5,
+            occlusion_radius=(0.08, 0.32),
+            jpeg_quality=(45, 80),
+        )
+
+    @staticmethod
+    def from_config(d: dict | None) -> "Degradations | None":
+        """Build from a config block, or None when the backend has no such block."""
+        if d is None:
+            return None
+        jpeg = d.get("jpeg_quality")
+        return Degradations(
+            blur_sigma=tuple(d["blur_sigma"]), motion_px=tuple(d["motion_px"]),
+            noise_sigma=tuple(d["noise_sigma"]), exposure=tuple(d["exposure"]),
+            vignette=tuple(d["vignette"]),
+            illumination_ramp=tuple(d["illumination_ramp"]),
+            contrast_loss=tuple(d["contrast_loss"]),
+            occlusion_prob=float(d["occlusion_prob"]),
+            occlusion_radius=tuple(d["occlusion_radius"]),
+            jpeg_quality=None if jpeg is None else (int(jpeg[0]), int(jpeg[1])),
+        )
+
+
+def _motion_kernel(length: float, angle_deg: float) -> np.ndarray | None:
+    if length < 1.0:
+        return None
+    n = int(math.ceil(length)) | 1  # odd so the kernel is centred
+    k = np.zeros((n, n), np.float32)
+    cv2.line(
+        k,
+        (0, n // 2),
+        (n - 1, n // 2),
+        1.0,
+        1,
+    )
+    m = cv2.getRotationMatrix2D((n / 2 - 0.5, n / 2 - 0.5), angle_deg, 1.0)
+    k = cv2.warpAffine(k, m, (n, n))
+    s = k.sum()
+    return k / s if s > 0 else None
+
+
+def degrade(img: np.ndarray, rng: np.random.Generator,
+            deg: Degradations) -> tuple[np.ndarray, dict]:
+    """Apply the degradation stack. Returns the image and what was applied."""
+    applied: dict[str, float] = {}
+    out = img.astype(np.float32)
+
+    motion = rng.uniform(*deg.motion_px)
+    kernel = _motion_kernel(motion, rng.uniform(0.0, 180.0))
+    if kernel is not None:
+        out = cv2.filter2D(out, -1, kernel)
+        applied["motion_px"] = float(motion)
+
+    sigma = rng.uniform(*deg.blur_sigma)
+    if sigma > 0.05:
+        out = cv2.GaussianBlur(out, (0, 0), sigma)
+        applied["blur_sigma"] = float(sigma)
+
+    loss = rng.uniform(*deg.contrast_loss)
+    if loss > 0.01:
+        out = 128.0 + (out - 128.0) * (1.0 - loss)
+        applied["contrast_loss"] = float(loss)
+
+    ramp = rng.uniform(*deg.illumination_ramp)
+    if ramp > 0.5:
+        h, w = out.shape
+        gx, gy = rng.uniform(-1.0, 1.0), rng.uniform(-1.0, 1.0)
+        xs = np.linspace(-0.5, 0.5, w, dtype=np.float32)
+        ys = np.linspace(-0.5, 0.5, h, dtype=np.float32)
+        out = out + ramp * (gx * xs[None, :] + gy * ys[:, None])
+        applied["illumination_ramp"] = float(ramp)
+
+    vig = rng.uniform(*deg.vignette)
+    if vig > 0.01:
+        h, w = out.shape
+        yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
+        r = np.hypot((xx - w / 2) / (w / 2), (yy - h / 2) / (h / 2))
+        out = out * (1.0 - vig * np.clip(r, 0.0, 1.4) ** 2)
+        applied["vignette"] = float(vig)
+
+    gain = rng.uniform(*deg.exposure)
+    if abs(gain - 1.0) > 0.01:
+        out = out * gain
+        applied["exposure"] = float(gain)
+
+    noise = rng.uniform(*deg.noise_sigma)
+    if noise > 0.1:
+        out = out + rng.normal(0.0, noise, out.shape)
+        applied["noise_sigma"] = float(noise)
+
+    out = np.clip(out, 0, 255).astype(np.uint8)
+
+    if deg.jpeg_quality is not None:
+        q = int(rng.integers(deg.jpeg_quality[0], deg.jpeg_quality[1] + 1))
+        ok, buf = cv2.imencode(".jpg", out, [int(cv2.IMWRITE_JPEG_QUALITY), q])
+        if ok:
+            out = cv2.imdecode(buf, cv2.IMREAD_GRAYSCALE)
+            applied["jpeg_quality"] = q
+
+    return out, applied
+
+
+def add_occlusion(img: np.ndarray, rng: np.random.Generator, deg: Degradations,
+                  corners: np.ndarray) -> dict:
+    """Draw an opaque blob over part of the board. Mutates `img` in place.
+
+    Returns metadata describing the occluder so evaluation can distinguish
+    "missed a visible tag" from "the tag was covered up".
+    """
+    if rng.random() >= deg.occlusion_prob:
+        return {}
+    span = float(np.ptp(corners[:, 0]))
+    radius = rng.uniform(*deg.occlusion_radius) * max(span, 1.0)
+    # Centre the blob on a randomly chosen tag corner so it actually covers
+    # something interesting rather than empty background.
+    anchor = corners[rng.integers(0, len(corners))]
+    cx = float(anchor[0] + rng.uniform(-radius, radius) * 0.4)
+    cy = float(anchor[1] + rng.uniform(-radius, radius) * 0.4)
+    shade = int(rng.integers(0, 90))
+    cv2.circle(img, (int(round(cx)), int(round(cy))), int(round(radius)), shade, -1)
+    return {"center": [cx, cy], "radius": float(radius), "shade": shade}
+
+
+@dataclass
+class Shadow:
+    """A shadow cast onto the board plane, defined in object-frame metres.
+
+    The edge is the line ``n . p = offset`` with ``n = (cos a, sin a)`` in the
+    object frame (x right, y down); the shadow lies on the side ``n`` points
+    to. With ``width`` set it is instead a bar ``|n . p - offset| < width/2``,
+    like the shadow of a cable or a rod.
+
+    A shadow removes *light*, so it scales radiance: white paper and black
+    ink are both multiplied by ``1 - strength`` in the umbra. Contrast falls
+    but the ink never gets darker than black -- unlike an occluder, which
+    paints over the pattern.
+    """
+
+    angle_deg: float
+    offset: float
+    # Fraction of the light blocked in the umbra, 0..1.
+    strength: float
+    # Width of the soft edge, centred on the geometric edge. It grows with the
+    # light source's angular size and the occluder's distance from the board.
+    penumbra: float = 0.0
+    width: float | None = None
+
+    def cover(self, x: np.ndarray, y: np.ndarray) -> np.ndarray:
+        """How much of the light is hidden at each point, 0 (lit) to 1 (umbra)."""
+        a = math.radians(self.angle_deg)
+        d = math.cos(a) * np.asarray(x, np.float64) + math.sin(a) * np.asarray(y, np.float64)
+        # Signed depth into the shadow, positive inside.
+        if self.width is None:
+            s = d - self.offset
+        else:
+            s = self.width / 2.0 - np.abs(d - self.offset)
+        if self.penumbra <= 0.0:
+            return (s > 0.0).astype(np.float64)
+        t = np.clip(s / self.penumbra + 0.5, 0.0, 1.0)
+        return t * t * (3.0 - 2.0 * t)
+
+
+def cast_shadow(sheet: np.ndarray, board: Board, ppm: float, shadow: Shadow) -> np.ndarray:
+    """Return a copy of the rasterised sheet with ``shadow`` cast on it.
+
+    Applied to the sheet, before the perspective warp, so the shadow sits on
+    the paper and is foreshortened and lens-distorted along with the tags.
+    """
+    if shadow.strength <= 0.0:
+        return sheet.copy()
+    h, w = sheet.shape
+    # The sheet raster spans [-0.5, W-0.5] over [-margin, extent+margin], so
+    # pixel u has its centre at object x = -margin + (u + 0.5) / ppm.
+    xs = -board.margin + (np.arange(w) + 0.5) / ppm
+    ys = -board.margin + (np.arange(h) + 0.5) / ppm
+    gain = 1.0 - shadow.strength * shadow.cover(xs[None, :], ys[:, None])
+    return np.clip(np.rint(sheet * gain), 0, 255).astype(np.uint8)
+
+
+def disc_touches_quad(quad: np.ndarray, cx: float, cy: float, r: float) -> bool:
+    """True if a disc overlaps a quad, counting edge contact."""
+    # pointPolygonTest returns a signed distance: positive inside, negative
+    # outside. The disc overlaps exactly when the centre is no further than
+    # `r` outside the polygon.
+    return bool(
+        cv2.pointPolygonTest(np.asarray(quad, np.float32), (float(cx), float(cy)), True)
+        >= -r
+    )
